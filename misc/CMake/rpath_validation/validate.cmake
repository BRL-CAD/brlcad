cmake_minimum_required(VERSION 3.22)
foreach(required IN ITEMS TEST_ROOT TEST_CXX_COMPILER)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "${required} must be specified")
  endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/../RPath_Setup.cmake")

function(assert_path actual expected)
  if(NOT "${actual}" STREQUAL "${expected}")
    message(FATAL_ERROR "Runtime path '${actual}' should be '${expected}'")
  endif()
endfunction()

function(run_checked)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE errors)
  file(APPEND "${TEST_ROOT}/validation.log" "${output}\n${errors}\n")
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Command failed (${result}): ${ARGN}\n${output}\n${errors}")
  endif()
endfunction()

function(expect_version expected)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env
    --unset=LD_LIBRARY_PATH --unset=LD_PRELOAD -- ${ARGN}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors
    OUTPUT_STRIP_TRAILING_WHITESPACE)
  file(APPEND "${TEST_ROOT}/validation.log" "${ARGN}: ${output}\n${errors}\n")
  if(NOT result EQUAL 0 OR NOT output STREQUAL "${expected}")
    message(FATAL_ERROR "Expected installed version ${expected}, got '${output}' (${result})\n${errors}")
  endif()
endfunction()

file(REMOVE_RECURSE "${TEST_ROOT}")
file(MAKE_DIRECTORY "${TEST_ROOT}")
foreach(layout IN ITEMS lib lib64 nested)
  set(BIN_DIR bin)
  set(LIB_DIR "${layout}")
  set(LIBEXEC_DIR libexec)
  if(layout STREQUAL nested)
    set(BIN_DIR tools/bin)
    set(LIB_DIR lib/platform)
    set(LIBEXEC_DIR tools/plugins)
  endif()
  set(CMAKE_INSTALL_PREFIX "${TEST_ROOT}/${layout}/configured prefix")
  relative_rpath(executable_path)
  relative_rpath(library_path SUFFIX "${LIB_DIR}")
  relative_rpath(plugin_path SUFFIX "${LIBEXEC_DIR}/ged")
  relative_rpath(repeated_path)
  assert_path("${executable_path}" "${repeated_path}")
  assert_path("${library_path}" "$ORIGIN")
  if(layout STREQUAL nested)
    assert_path("${executable_path}" "$ORIGIN/../../lib/platform")
    assert_path("${plugin_path}" "$ORIGIN/../../../lib/platform")
  else()
    assert_path("${executable_path}" "$ORIGIN/../${LIB_DIR}")
    assert_path("${plugin_path}" "$ORIGIN/../../${LIB_DIR}")
  endif()

  set(build "${TEST_ROOT}/${layout}/build")
  set(installed "${TEST_ROOT}/${layout}/installed")
  set(relocated "${TEST_ROOT}/${layout}/relocated application")
  run_checked("${CMAKE_COMMAND}" -S "${CMAKE_CURRENT_LIST_DIR}" -B "${build}"
    "-DCMAKE_CXX_COMPILER=${TEST_CXX_COMPILER}"
    "-DCMAKE_INSTALL_PREFIX=${CMAKE_INSTALL_PREFIX}"
    "-DRPATH_MODULE=${CMAKE_CURRENT_LIST_DIR}/../RPath_Setup.cmake"
    "-DBIN_DIR=${BIN_DIR}" "-DLIB_DIR=${LIB_DIR}" "-DLIBEXEC_DIR=${LIBEXEC_DIR}")
  run_checked("${CMAKE_COMMAND}" --build "${build}" --parallel 2)
  run_checked("${CMAKE_COMMAND}" --install "${build}" --prefix "${installed}")
  include("${build}/legacy.cmake")
  file(MAKE_DIRECTORY "${CMAKE_INSTALL_PREFIX}/${LIB_DIR}")
  file(COPY_FILE "${legacy_library}" "${CMAKE_INSTALL_PREFIX}/${LIB_DIR}/${legacy_soname}")
  file(RENAME "${installed}" "${relocated}")
  expect_version(2 "${relocated}/${BIN_DIR}/driver")
  expect_version(1 "${relocated}/${BIN_DIR}/control")
  foreach(name IN ITEMS module module_control)
    include("${build}/${name}.cmake")
    set(expected 2)
    if(name STREQUAL module_control)
      set(expected 1)
    endif()
    expect_version(${expected} "${relocated}/${BIN_DIR}/host"
      "${relocated}/${LIBEXEC_DIR}/ged/${${name}_file}")
  endforeach()
endforeach()
message(STATUS "Relocated executables and plugins passed three conflicting-prefix layouts")
