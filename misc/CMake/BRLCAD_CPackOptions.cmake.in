###
# This file is configured at cmake time, and loaded at cpack time.
# To pass variables to cpack from cmake, they must be configured
# in this file.

if(NOT DEFINED BRLCAD_BUNDLE_MANIFESTS)
  set(BRLCAD_BUNDLE_MANIFESTS "@BRLCAD_BUNDLE_MANIFESTS@")
endif()
if(NOT DEFINED BRLCAD_BUNDLE_CONFLICT_POLICY)
  set(BRLCAD_BUNDLE_CONFLICT_POLICY "@BRLCAD_BUNDLE_CONFLICT_POLICY@")
endif()
if(BRLCAD_BUNDLE_MANIFESTS AND NOT CPACK_INSTALLED_DIRECTORIES)
  set(BRLCAD_BUNDLE_SYSTEM_NAME "@CMAKE_SYSTEM_NAME@")
  set(BRLCAD_BUNDLE_INSTALL_PREFIX "@CMAKE_INSTALL_PREFIX@")
  set(BRLCAD_BUNDLE_LIB_DIR "@LIB_DIR@")
  set(BRLCAD_BUNDLE_AUDIT_DIR "@CMAKE_BINARY_DIR@/bundle-audit")
  set(BRLCAD_BUNDLE_STRCLEAR "@STRCLEAR_EXECUTABLE@")
  set(BRLCAD_BUNDLE_PLIEF "@P_RPATH_EXECUTABLE@")
  list(APPEND CPACK_PRE_BUILD_SCRIPTS
    "@BRLCAD_CMAKE_DIR@/BRLCAD_Package_Bundle.cmake")
endif()

# Resolve development checkout revisions when CPack runs so package names
# cannot retain a commit recorded by an earlier CMake configuration.
if(NOT CPACK_INSTALLED_DIRECTORIES)
  include("@BRLCAD_CMAKE_DIR@/BRLCAD_Package_Name.cmake")
  brlcad_binary_package_suffix(_brlcad_package_revision_suffix "@CMAKE_SOURCE_DIR@")
  string(APPEND CPACK_PACKAGE_FILE_NAME "${_brlcad_package_revision_suffix}")
  unset(_brlcad_package_revision_suffix)
endif()

# Target a source directory created in the build dir to avoid bundling
# anything we don't want bundled.
if(CPACK_INSTALLED_DIRECTORIES)
  if(CPACK_GENERATOR MATCHES "ZIP" OR CPACK_GENERATOR MATCHES "TGZ" OR CPACK_GENERATOR MATCHES "TBZ2")
    include("@CMAKE_BINARY_DIR@/CMakeTmp/source_archive_setup.cmake")
    set(CPACK_INSTALLED_DIRECTORIES "@CMAKE_BINARY_DIR@/source_archive_contents;/")
  endif(CPACK_GENERATOR MATCHES "ZIP" OR CPACK_GENERATOR MATCHES "TGZ" OR CPACK_GENERATOR MATCHES "TBZ2")
endif(CPACK_INSTALLED_DIRECTORIES)

# Null out the install prefix, unless we're working on an RPM
if(NOT CPACK_GENERATOR MATCHES "RPM")
  set(CPACK_PACKAGING_INSTALL_PREFIX "")
endif(NOT CPACK_GENERATOR MATCHES "RPM")

