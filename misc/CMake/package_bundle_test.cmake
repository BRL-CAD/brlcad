foreach(required IN ITEMS TEST_ROOT MODULE_FILE TEST_SYSTEM_NAME)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "Missing test argument: ${required}")
  endif()
endforeach()

if(INVALID_CASE)
  set(CPACK_TEMPORARY_DIRECTORY "${TEST_ROOT}/stage-invalid")
  file(MAKE_DIRECTORY "${CPACK_TEMPORARY_DIRECTORY}")
  set(CPACK_GENERATOR TGZ)
  set(CPACK_PACKAGE_FILE_NAME bundle-invalid)
  set(BRLCAD_BUNDLE_MANIFESTS "${TEST_ROOT}/invalid.json")
  set(BRLCAD_BUNDLE_CONFLICT_POLICY BRLCAD_WINS)
  set(BRLCAD_BUNDLE_SYSTEM_NAME "${TEST_SYSTEM_NAME}")
  set(BRLCAD_BUNDLE_INSTALL_PREFIX "/opt/brlcad")
  set(BRLCAD_BUNDLE_LIB_DIR lib)
  set(BRLCAD_BUNDLE_AUDIT_DIR "${TEST_ROOT}/audit")
  set(BRLCAD_BUNDLE_SKIP_RELOCATION TRUE)
  include("${MODULE_FILE}")
  message(FATAL_ERROR "Escaping manifest entry was accepted")
endif()

if(EXCLUDED_CASE)
  set(CPACK_TEMPORARY_DIRECTORY "${TEST_ROOT}/stage-excluded")
  file(MAKE_DIRECTORY "${CPACK_TEMPORARY_DIRECTORY}")
  set(CPACK_GENERATOR TGZ)
  set(CPACK_PACKAGE_FILE_NAME bundle-excluded)
  set(BRLCAD_BUNDLE_MANIFESTS "${TEST_ROOT}/one.json")
  set(BRLCAD_BUNDLE_CONFLICT_POLICY BRLCAD_WINS)
  set(BRLCAD_BUNDLE_EXCLUDE_MANIFEST "${TEST_ROOT}/excluded.json")
  set(BRLCAD_BUNDLE_SYSTEM_NAME "${TEST_SYSTEM_NAME}")
  set(BRLCAD_BUNDLE_INSTALL_PREFIX "/opt/brlcad")
  set(BRLCAD_BUNDLE_LIB_DIR lib)
  set(BRLCAD_BUNDLE_AUDIT_DIR "${TEST_ROOT}/audit")
  set(BRLCAD_BUNDLE_SKIP_RELOCATION TRUE)
  include("${MODULE_FILE}")
  message(FATAL_ERROR "Excluded bext file was accepted from an external manifest")
endif()

function(write_manifest path root files)
  file(TO_CMAKE_PATH "${root}" root)
  set(json "{\n  \"schema\": 1,\n  \"platform\": \"${TEST_SYSTEM_NAME}\",\n  \"install_root\": \"${root}\",\n  \"files\": [")
  set(separator "")
  foreach(entry IN LISTS files)
    file(TO_CMAKE_PATH "${entry}" entry)
    string(APPEND json "${separator}\n    \"${entry}\"")
    set(separator ",")
  endforeach()
  string(APPEND json "\n  ]\n}\n")
  file(WRITE "${path}" "${json}")
endfunction()

function(run_case policy expected_same)
  set(stage "${TEST_ROOT}/stage-${policy}")
  file(MAKE_DIRECTORY "${stage}/bin" "${stage}/share")
  file(WRITE "${stage}/bin/same.txt" "BRL-CAD\n")
  set(CPACK_TEMPORARY_DIRECTORY "${stage}")
  set(CPACK_GENERATOR TGZ)
  set(CPACK_PACKAGE_FILE_NAME "bundle-${policy}")
  set(BRLCAD_BUNDLE_MANIFESTS "${TEST_ROOT}/one.json;${TEST_ROOT}/two.json")
  set(BRLCAD_BUNDLE_CONFLICT_POLICY "${policy}")
  set(BRLCAD_BUNDLE_SYSTEM_NAME "${TEST_SYSTEM_NAME}")
  set(BRLCAD_BUNDLE_INSTALL_PREFIX "/opt/brlcad")
  set(BRLCAD_BUNDLE_LIB_DIR lib)
  set(BRLCAD_BUNDLE_AUDIT_DIR "${TEST_ROOT}/audit")
  set(BRLCAD_BUNDLE_SKIP_RELOCATION TRUE)
  include("${MODULE_FILE}")
  file(READ "${stage}/bin/same.txt" same)
  file(READ "${stage}/share/order.txt" order)
  file(READ "${stage}/share/absolute.txt" absolute)
  if(NOT same STREQUAL "${expected_same}\n")
    message(FATAL_ERROR "${policy} selected unexpected colliding file: ${same}")
  endif()
  if(NOT order STREQUAL "two\n")
    message(FATAL_ERROR "${policy} did not give the later manifest precedence")
  endif()
  if(NOT absolute STREQUAL "absolute\n")
    message(FATAL_ERROR "${policy} did not normalize an absolute source entry")
  endif()
  file(READ "${TEST_ROOT}/audit/bundle-${policy}-TGZ.log" audit)
  if(NOT audit MATCHES "COMPLETE" OR NOT audit MATCHES "SKIP BRL-CAD|REPLACE BASE")
    message(FATAL_ERROR "${policy} audit is incomplete:\n${audit}")
  endif()
endfunction()

function(run_text_replacement)
  if(NOT TEST_STRCLEAR OR NOT EXISTS "${TEST_STRCLEAR}")
    return()
  endif()
  set(stage "${TEST_ROOT}/stage-text")
  file(MAKE_DIRECTORY "${stage}")
  file(TO_CMAKE_PATH "${TEST_ROOT}/text" root_text)
  file(WRITE "${TEST_ROOT}/text/config.txt" "prefix=${root_text}/assets\n")
  write_manifest("${TEST_ROOT}/text.json" "${TEST_ROOT}/text" "config.txt")
  set(CPACK_TEMPORARY_DIRECTORY "${stage}")
  set(CPACK_GENERATOR TGZ)
  set(CPACK_PACKAGE_FILE_NAME bundle-text)
  set(BRLCAD_BUNDLE_MANIFESTS "${TEST_ROOT}/text.json")
  set(BRLCAD_BUNDLE_CONFLICT_POLICY BRLCAD_WINS)
  set(BRLCAD_BUNDLE_SYSTEM_NAME "${TEST_SYSTEM_NAME}")
  set(BRLCAD_BUNDLE_INSTALL_PREFIX "/opt/brlcad")
  set(BRLCAD_BUNDLE_LIB_DIR lib)
  set(BRLCAD_BUNDLE_AUDIT_DIR "${TEST_ROOT}/audit")
  set(BRLCAD_BUNDLE_STRCLEAR "${TEST_STRCLEAR}")
  set(BRLCAD_BUNDLE_PLIEF "")
  set(BRLCAD_BUNDLE_SKIP_RELOCATION FALSE)
  include("${MODULE_FILE}")
  file(READ "${stage}/config.txt" config)
  if(NOT config STREQUAL "prefix=/opt/brlcad/assets\n")
    message(FATAL_ERROR "Text prefix was not replaced: ${config}")
  endif()
  file(READ "${TEST_ROOT}/audit/bundle-text-TGZ.log" audit)
  if(NOT audit MATCHES "TEXT REPLACE: config.txt" OR
      NOT audit MATCHES "to: /opt/brlcad")
    message(FATAL_ERROR "Text replacement audit is incomplete:\n${audit}")
  endif()
endfunction()

function(run_prefixed_stage)
  set(stage "${TEST_ROOT}/stage-prefixed")
  file(MAKE_DIRECTORY "${stage}/opt/brlcad/bin")
  file(WRITE "${stage}/opt/brlcad/bin/same.txt" "BRL-CAD\n")
  set(CPACK_TEMPORARY_DIRECTORY "${stage}")
  set(CPACK_PACKAGING_INSTALL_PREFIX "/opt/brlcad")
  set(CPACK_GENERATOR RPM)
  set(CPACK_PACKAGE_FILE_NAME bundle-prefixed)
  set(BRLCAD_BUNDLE_MANIFESTS "${TEST_ROOT}/one.json")
  set(BRLCAD_BUNDLE_CONFLICT_POLICY BRLCAD_WINS)
  set(BRLCAD_BUNDLE_SYSTEM_NAME "${TEST_SYSTEM_NAME}")
  set(BRLCAD_BUNDLE_INSTALL_PREFIX "/opt/brlcad")
  set(BRLCAD_BUNDLE_LIB_DIR lib)
  set(BRLCAD_BUNDLE_AUDIT_DIR "${TEST_ROOT}/audit")
  set(BRLCAD_BUNDLE_SKIP_RELOCATION TRUE)
  include("${MODULE_FILE}")
  if(NOT EXISTS "${stage}/opt/brlcad/share/order.txt" OR
      EXISTS "${stage}/share/order.txt")
    message(FATAL_ERROR "Prefixed generator used the wrong staging root")
  endif()
endfunction()

file(REMOVE_RECURSE "${TEST_ROOT}")
file(MAKE_DIRECTORY "${TEST_ROOT}/one/bin" "${TEST_ROOT}/one/share"
  "${TEST_ROOT}/two/bin" "${TEST_ROOT}/two/share")
file(WRITE "${TEST_ROOT}/one/bin/same.txt" "one\n")
file(WRITE "${TEST_ROOT}/one/share/order.txt" "one\n")
file(WRITE "${TEST_ROOT}/one/share/absolute.txt" "absolute\n")
file(WRITE "${TEST_ROOT}/two/bin/same.txt" "two\n")
file(WRITE "${TEST_ROOT}/two/share/order.txt" "two\n")
set(one_files "bin/same.txt;share/order.txt;${TEST_ROOT}/one/share/absolute.txt")
set(two_files "bin/same.txt;share/order.txt")
write_manifest("${TEST_ROOT}/one.json" "${TEST_ROOT}/one" "${one_files}")
write_manifest("${TEST_ROOT}/two.json" "${TEST_ROOT}/two" "${two_files}")
file(WRITE "${TEST_ROOT}/excluded.json"
  "{\n  \"schema\": 2,\n  \"platform\": \"${TEST_SYSTEM_NAME}\",\n"
  "  \"files\": [\n    \"share/order.txt\"\n  ]\n}\n")
run_case(BRLCAD_WINS BRL-CAD)
run_case(MANIFEST_WINS two)
run_prefixed_stage()
file(MAKE_DIRECTORY "${TEST_ROOT}/text")
run_text_replacement()

file(MAKE_DIRECTORY "${TEST_ROOT}/invalid-root")
file(WRITE "${TEST_ROOT}/outside.txt" "outside\n")
write_manifest("${TEST_ROOT}/invalid.json" "${TEST_ROOT}/invalid-root" "../outside.txt")
execute_process(
  COMMAND "${CMAKE_COMMAND}" "-DTEST_ROOT=${TEST_ROOT}"
    "-DMODULE_FILE=${MODULE_FILE}" "-DTEST_SYSTEM_NAME=${TEST_SYSTEM_NAME}"
    -DINVALID_CASE=TRUE -P "${CMAKE_CURRENT_LIST_FILE}"
  RESULT_VARIABLE invalid_result OUTPUT_VARIABLE invalid_output ERROR_VARIABLE invalid_error
)
if(invalid_result EQUAL 0)
  message(FATAL_ERROR "Escaping manifest test unexpectedly succeeded")
endif()
file(READ "${TEST_ROOT}/audit/bundle-invalid-TGZ.log" invalid_audit)
if(NOT invalid_audit MATCHES "ERROR: Manifest file is outside install_root")
  message(FATAL_ERROR "Escaping path failure was not audited:\n${invalid_audit}\n${invalid_output}\n${invalid_error}")
endif()

execute_process(
  COMMAND "${CMAKE_COMMAND}" "-DTEST_ROOT=${TEST_ROOT}"
    "-DMODULE_FILE=${MODULE_FILE}" "-DTEST_SYSTEM_NAME=${TEST_SYSTEM_NAME}"
    -DEXCLUDED_CASE=TRUE -P "${CMAKE_CURRENT_LIST_FILE}"
  RESULT_VARIABLE excluded_result OUTPUT_VARIABLE excluded_output ERROR_VARIABLE excluded_error
)
if(excluded_result EQUAL 0)
  message(FATAL_ERROR "Excluded destination test unexpectedly succeeded")
endif()
file(READ "${TEST_ROOT}/audit/bundle-excluded-TGZ.log" excluded_audit)
if(NOT excluded_audit MATCHES
    "ERROR: External manifest destination is excluded by bext package policy: share/order.txt")
  message(FATAL_ERROR
    "Excluded destination failure was not audited:\n${excluded_audit}\n${excluded_output}\n${excluded_error}")
endif()
