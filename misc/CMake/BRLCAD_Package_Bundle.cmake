# Merge external manifests into CPack's completed binary-package staging tree.

if(NOT BRLCAD_BUNDLE_MANIFESTS)
  return()
endif()
cmake_policy(PUSH)
cmake_policy(VERSION 3.22)

function(_brlcad_bundle_log text)
  file(APPEND "${BRLCAD_BUNDLE_AUDIT_LOG}" "${text}\n")
endfunction()

function(_brlcad_bundle_relocate path relative prefixes)
  if(IS_SYMLINK "${path}")
    return()
  endif()
  execute_process(COMMAND "${BRLCAD_BUNDLE_STRCLEAR}" -B "${path}"
    RESULT_VARIABLE classification ERROR_VARIABLE classification_error)
  if(classification EQUAL 1)
    foreach(prefix IN LISTS prefixes)
      if(prefix STREQUAL "")
        continue()
      endif()
      file(SHA256 "${path}" before)
      execute_process(COMMAND "${BRLCAD_BUNDLE_STRCLEAR}" -v -p -r "${path}" "${prefix}"
        "${BRLCAD_BUNDLE_INSTALL_PREFIX}" RESULT_VARIABLE result
        OUTPUT_VARIABLE output ERROR_VARIABLE error)
      if(NOT result EQUAL 0)
        _brlcad_bundle_fail("Text prefix replacement failed for ${relative}: ${error}")
      endif()
      file(SHA256 "${path}" after)
      if(NOT before STREQUAL after)
        string(STRIP "${output}${error}" report)
        _brlcad_bundle_log("TEXT REPLACE: ${relative}")
        _brlcad_bundle_log("  from: ${prefix}")
        _brlcad_bundle_log("  to: ${BRLCAD_BUNDLE_INSTALL_PREFIX}")
        if(NOT report STREQUAL "")
          _brlcad_bundle_log("  strclear: ${report}")
        endif()
      endif()
    endforeach()
    return()
  elseif(NOT classification EQUAL 0)
    _brlcad_bundle_fail("Cannot classify package file ${relative}: ${classification_error}")
  endif()

  file(READ "${path}" magic OFFSET 0 LIMIT 4 HEX)
  set(is_elf FALSE)
  if(magic STREQUAL "7f454c46")
    set(is_elf TRUE)
    if(NOT BRLCAD_BUNDLE_PLIEF)
      _brlcad_bundle_fail("plief is required to relocate ELF file ${relative}")
    endif()
  endif()
  set(clear_args)
  foreach(prefix IN LISTS prefixes)
    if(NOT prefix STREQUAL "")
      list(APPEND clear_args "${prefix}")
    endif()
  endforeach()
  if(clear_args)
    execute_process(COMMAND "${BRLCAD_BUNDLE_STRCLEAR}" -p -b -c "${path}" ${clear_args}
      RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
      _brlcad_bundle_fail("Binary path cleanup failed for ${relative}: ${error}")
    endif()
    _brlcad_bundle_log("BINARY SCRUB: ${relative}")
  endif()
  if(is_elf)
    get_filename_component(directory "${path}" DIRECTORY)
    set(library_directory "${BRLCAD_BUNDLE_STAGE_ROOT}/${BRLCAD_BUNDLE_LIB_DIR}")
    file(RELATIVE_PATH relative_library "${directory}" "${library_directory}")
    if(relative_library STREQUAL ".")
      set(rpath "\$ORIGIN")
    else()
      set(rpath "\$ORIGIN/${relative_library}")
    endif()
    execute_process(COMMAND "${BRLCAD_BUNDLE_PLIEF}" --set-rpath "${rpath}" "${path}"
      RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
      _brlcad_bundle_fail("RPATH update failed for ${relative}: ${error}")
    endif()
    _brlcad_bundle_log("RPATH: ${relative} -> ${rpath}")
  endif()
endfunction()

function(_brlcad_bundle_fail text)
  _brlcad_bundle_log("ERROR: ${text}")
  message(FATAL_ERROR "${text}\nBundle audit log: ${BRLCAD_BUNDLE_AUDIT_LOG}")
endfunction()

function(_brlcad_bundle_key out path)
  cmake_path(NORMAL_PATH path OUTPUT_VARIABLE normalized)
  if(BRLCAD_BUNDLE_SYSTEM_NAME STREQUAL "Windows" OR BRLCAD_BUNDLE_SYSTEM_NAME STREQUAL "Darwin")
    string(TOLOWER "${normalized}" normalized)
  endif()
  string(SHA256 key "${normalized}")
  set(${out} "${key}" PARENT_SCOPE)
endfunction()

function(_brlcad_bundle_json_strings json key required out)
  string(JSON type ERROR_VARIABLE error TYPE "${json}" "${key}")
  if(NOT "${error}" STREQUAL "NOTFOUND")
    if(required)
      _brlcad_bundle_fail("Manifest is missing the ${key} array")
    endif()
    set(${out} "" PARENT_SCOPE)
    return()
  endif()
  if(NOT type STREQUAL "ARRAY")
    _brlcad_bundle_fail("Manifest ${key} value is not an array")
  endif()
  string(JSON count LENGTH "${json}" "${key}")
  set(values)
  if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
      string(JSON value ERROR_VARIABLE error GET "${json}" "${key}" ${index})
      if(NOT "${error}" STREQUAL "NOTFOUND")
        _brlcad_bundle_fail("Manifest ${key} contains a non-string value")
      endif()
      string(REPLACE ";" "\;" value "${value}")
      list(APPEND values "${value}")
    endforeach()
  endif()
  set(${out} "${values}" PARENT_SCOPE)
endfunction()

function(_brlcad_bundle_source_path root entry out_source out_relative)
  if(IS_ABSOLUTE "${entry}")
    cmake_path(NORMAL_PATH entry OUTPUT_VARIABLE source)
  else()
    set(source "${root}/${entry}")
    cmake_path(NORMAL_PATH source OUTPUT_VARIABLE source)
  endif()
  cmake_path(IS_PREFIX root "${source}" NORMALIZE inside)
  if(NOT inside)
    _brlcad_bundle_fail("Manifest file is outside install_root: ${entry}")
  endif()
  file(RELATIVE_PATH relative "${root}" "${source}")
  cmake_path(NORMAL_PATH relative OUTPUT_VARIABLE relative)
  if(relative STREQUAL "" OR relative STREQUAL "." OR relative MATCHES "(^|/)[.][.](/|$)")
    _brlcad_bundle_fail("Manifest file has an invalid destination: ${entry}")
  endif()
  set(${out_source} "${source}" PARENT_SCOPE)
  set(${out_relative} "${relative}" PARENT_SCOPE)
endfunction()

function(_brlcad_bundle_validate_link source relative root stage)
  file(READ_SYMLINK "${source}" target)
  if(IS_ABSOLUTE "${target}")
    _brlcad_bundle_fail("Absolute symbolic link is not permitted: ${relative}")
  endif()
  get_filename_component(source_dir "${source}" DIRECTORY)
  set(source_target "${source_dir}/${target}")
  cmake_path(NORMAL_PATH source_target OUTPUT_VARIABLE source_target)
  cmake_path(IS_PREFIX root "${source_target}" NORMALIZE source_inside)
  if(NOT source_inside OR NOT EXISTS "${source_target}")
    _brlcad_bundle_fail("Broken or escaping symbolic link: ${relative}")
  endif()
  get_filename_component(relative_dir "${relative}" DIRECTORY)
  set(stage_target "${stage}/${relative_dir}/${target}")
  cmake_path(NORMAL_PATH stage_target OUTPUT_VARIABLE stage_target)
  cmake_path(IS_PREFIX stage "${stage_target}" NORMALIZE stage_inside)
  if(NOT stage_inside)
    _brlcad_bundle_fail("Symbolic link escapes the package root: ${relative}")
  endif()
endfunction()

function(_brlcad_bundle_copy source destination relative)
  get_filename_component(destination_dir "${destination}" DIRECTORY)
  file(MAKE_DIRECTORY "${destination_dir}")
  if(EXISTS "${destination}" OR IS_SYMLINK "${destination}")
    file(REMOVE "${destination}")
  endif()
  if(IS_SYMLINK "${source}")
    file(READ_SYMLINK "${source}" target)
    file(CREATE_LINK "${target}" "${destination}" SYMBOLIC RESULT result)
    if(NOT result STREQUAL "0")
      _brlcad_bundle_fail("Cannot create symbolic link ${relative}: ${result}")
    endif()
  else()
    file(COPY "${source}" DESTINATION "${destination_dir}")
  endif()
  if(NOT EXISTS "${destination}" AND NOT IS_SYMLINK "${destination}")
    _brlcad_bundle_fail("Copy did not create package file: ${relative}")
  endif()
endfunction()

foreach(required IN ITEMS CPACK_TEMPORARY_DIRECTORY BRLCAD_BUNDLE_SYSTEM_NAME
    BRLCAD_BUNDLE_INSTALL_PREFIX BRLCAD_BUNDLE_LIB_DIR BRLCAD_BUNDLE_AUDIT_DIR)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Package bundle processing requires ${required}")
  endif()
endforeach()
string(REGEX REPLACE "[^A-Za-z0-9_.-]" "_" generator "${CPACK_GENERATOR}")
set(BRLCAD_BUNDLE_STAGE_ROOT "${CPACK_TEMPORARY_DIRECTORY}")
if(CPACK_PACKAGING_INSTALL_PREFIX)
  string(REGEX REPLACE "^[/\\]+" "" package_prefix "${CPACK_PACKAGING_INSTALL_PREFIX}")
  if(NOT package_prefix STREQUAL "")
    set(BRLCAD_BUNDLE_STAGE_ROOT "${CPACK_TEMPORARY_DIRECTORY}/${package_prefix}")
  endif()
endif()
file(MAKE_DIRECTORY "${BRLCAD_BUNDLE_AUDIT_DIR}")
set(BRLCAD_BUNDLE_AUDIT_LOG "${BRLCAD_BUNDLE_AUDIT_DIR}/${CPACK_PACKAGE_FILE_NAME}-${generator}.log")
file(WRITE "${BRLCAD_BUNDLE_AUDIT_LOG}"
  "BRL-CAD external package bundle audit\nGenerator: ${CPACK_GENERATOR}\nStage: ${BRLCAD_BUNDLE_STAGE_ROOT}\nPolicy: ${BRLCAD_BUNDLE_CONFLICT_POLICY}\n")
if(NOT BRLCAD_BUNDLE_CONFLICT_POLICY MATCHES "^(BRLCAD_WINS|MANIFEST_WINS)$")
  _brlcad_bundle_fail("Invalid BRLCAD_BUNDLE_CONFLICT_POLICY: ${BRLCAD_BUNDLE_CONFLICT_POLICY}")
endif()
if(NOT BRLCAD_BUNDLE_STRCLEAR AND NOT BRLCAD_BUNDLE_SKIP_RELOCATION)
  _brlcad_bundle_fail("Package bundle processing requires strclear")
endif()
file(GLOB_RECURSE base_files LIST_DIRECTORIES FALSE RELATIVE "${BRLCAD_BUNDLE_STAGE_ROOT}"
  "${BRLCAD_BUNDLE_STAGE_ROOT}/*")
foreach(relative IN LISTS base_files)
  _brlcad_bundle_key(key "${relative}")
  set(owner_${key} BASE)
endforeach()

set(manifest_index 0)
set(external_keys)
foreach(manifest IN LISTS BRLCAD_BUNDLE_MANIFESTS)
  math(EXPR manifest_index "${manifest_index} + 1")
  get_filename_component(manifest "${manifest}" ABSOLUTE)
  if(NOT EXISTS "${manifest}")
    _brlcad_bundle_fail("Bundle manifest does not exist: ${manifest}")
  endif()
  file(READ "${manifest}" json)
  string(JSON schema ERROR_VARIABLE error GET "${json}" schema)
  if(NOT "${error}" STREQUAL "NOTFOUND" OR NOT schema STREQUAL "1")
    _brlcad_bundle_fail("Unsupported or invalid manifest schema: ${manifest}")
  endif()
  string(JSON platform ERROR_VARIABLE error GET "${json}" platform)
  if(NOT "${error}" STREQUAL "NOTFOUND" OR
      NOT "${platform}" STREQUAL "${BRLCAD_BUNDLE_SYSTEM_NAME}")
    _brlcad_bundle_fail("Manifest platform does not match ${BRLCAD_BUNDLE_SYSTEM_NAME}: ${manifest}")
  endif()
  string(JSON install_root ERROR_VARIABLE error GET "${json}" install_root)
  if(NOT "${error}" STREQUAL "NOTFOUND" OR install_root STREQUAL "")
    _brlcad_bundle_fail("Manifest has no valid install_root: ${manifest}")
  endif()
  get_filename_component(manifest_directory "${manifest}" DIRECTORY)
  get_filename_component(root "${install_root}" ABSOLUTE BASE_DIR "${manifest_directory}")
  cmake_path(NORMAL_PATH root OUTPUT_VARIABLE root)
  if(NOT IS_DIRECTORY "${root}")
    _brlcad_bundle_fail("Manifest install_root is not a directory: ${root}")
  endif()
  file(REAL_PATH "${root}" real_root)
  _brlcad_bundle_json_strings("${json}" install_prefixes FALSE prefixes)
  list(PREPEND prefixes "${root}" "${real_root}")
  list(REMOVE_DUPLICATES prefixes)
  foreach(prefix IN LISTS prefixes)
    if(NOT IS_ABSOLUTE "${prefix}")
      _brlcad_bundle_fail("Manifest install_prefix is not absolute: ${prefix}")
    endif()
  endforeach()
  _brlcad_bundle_json_strings("${json}" files TRUE entries)
  _brlcad_bundle_log("MANIFEST ${manifest_index}: ${manifest}")
  _brlcad_bundle_log("  root: ${root}")
  set(manifest_keys)
  foreach(entry IN LISTS entries)
    _brlcad_bundle_source_path("${root}" "${entry}" source relative)
    if(NOT EXISTS "${source}" AND NOT IS_SYMLINK "${source}")
      _brlcad_bundle_fail("Manifest references a missing file: ${entry}")
    endif()
    file(REAL_PATH "${source}" physical_source)
    cmake_path(IS_PREFIX real_root "${physical_source}" NORMALIZE physical_inside)
    if(NOT physical_inside)
      _brlcad_bundle_fail("Manifest file resolves outside install_root: ${entry}")
    endif()
    if(IS_DIRECTORY "${source}")
      _brlcad_bundle_fail("Manifest entry is a directory: ${entry}")
    endif()
    if(IS_SYMLINK "${source}")
      _brlcad_bundle_validate_link("${source}" "${relative}" "${root}" "${BRLCAD_BUNDLE_STAGE_ROOT}")
    endif()
    _brlcad_bundle_key(key "${relative}")
    if(key IN_LIST manifest_keys)
      _brlcad_bundle_fail("Manifest contains a duplicate destination: ${relative}")
    endif()
    list(APPEND manifest_keys "${key}")
    set(owner "${owner_${key}}")
    if(owner STREQUAL "BASE" AND BRLCAD_BUNDLE_CONFLICT_POLICY STREQUAL "BRLCAD_WINS")
      _brlcad_bundle_log("SKIP BRL-CAD: ${relative}")
      continue()
    endif()
    if(owner)
      _brlcad_bundle_log("REPLACE ${owner}: ${relative}")
    else()
      _brlcad_bundle_log("ADD: ${relative}")
    endif()
    set(destination "${BRLCAD_BUNDLE_STAGE_ROOT}/${relative}")
    _brlcad_bundle_copy("${source}" "${destination}" "${relative}")
    set(owner_${key} "manifest ${manifest_index}")
    set(path_${key} "${destination}")
    set(relative_${key} "${relative}")
    set(prefixes_${key} "${prefixes}")
    if(NOT key IN_LIST external_keys)
      list(APPEND external_keys "${key}")
    endif()
  endforeach()
endforeach()

foreach(key IN LISTS external_keys)
  if(IS_SYMLINK "${path_${key}}" AND NOT EXISTS "${path_${key}}")
    _brlcad_bundle_fail("Bundled symbolic link has no packaged target: ${relative_${key}}")
  endif()
endforeach()
if(NOT BRLCAD_BUNDLE_SKIP_RELOCATION)
  foreach(key IN LISTS external_keys)
    _brlcad_bundle_relocate("${path_${key}}" "${relative_${key}}" "${prefixes_${key}}")
  endforeach()
endif()
_brlcad_bundle_log("COMPLETE")
message(STATUS "External package bundle audit: ${BRLCAD_BUNDLE_AUDIT_LOG}")
cmake_policy(POP)
