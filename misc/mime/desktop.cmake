# Exercise the published aliases using a private desktop MIME database.
file(READ "${SOURCE_DIR}/misc/mime/supplement.json" supplement)
string(JSON count LENGTH "${supplement}" aliases)
math(EXPR last "${count} - 1")
set(aliases)
foreach(i RANGE ${last})
  string(JSON canonical GET "${supplement}" aliases ${i} canonical)
  if(canonical STREQUAL "model/vnd.brlcad")
    string(JSON alias GET "${supplement}" aliases ${i} name)
    list(APPEND aliases "${alias}")
  endif()
endforeach()
file(READ "${SOURCE_DIR}/misc/debian/brlcad.xml" package)
if(NOT package MATCHES "<mime-type type=\"model/vnd.brlcad\">")
  message(FATAL_ERROR "Desktop package does not use the catalog identity")
endif()
foreach(alias IN LISTS aliases)
  if(NOT package MATCHES "<alias type=\"${alias}\"/>")
    message(FATAL_ERROR "Desktop package omits published alias ${alias}")
  endif()
endforeach()
find_program(mime_compiler update-mime-database)
find_program(desktop_validator desktop-file-validate)
find_program(shell_program sh)
find_program(gio_program gio)
if(mime_compiler)
  set(data_home "${WORK_DIR}/share")
  set(mime_directory "${data_home}/mime")
  file(MAKE_DIRECTORY "${mime_directory}/packages" "${WORK_DIR}/data")
  configure_file("${SOURCE_DIR}/misc/debian/brlcad.xml" "${mime_directory}/packages/brlcad.xml" COPYONLY)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "XDG_DATA_HOME=${data_home}" "${mime_compiler}" "${mime_directory}"
    RESULT_VARIABLE status ERROR_VARIABLE messages)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Cannot compile desktop MIME definitions: ${messages}")
  endif()
  file(READ "${mime_directory}/aliases" compiled)
  foreach(alias IN LISTS aliases)
    string(FIND "${compiled}" "${alias} model/vnd.brlcad\n" at)
    if(at LESS 0)
      message(FATAL_ERROR "Desktop database did not canonicalize ${alias}")
    endif()
  endforeach()
  if(gio_program AND shell_program)
    function(check_detection name expected script)
      set(path "${WORK_DIR}/data/${name}")
      execute_process(COMMAND "${shell_program}" -c "${script}" _ "${path}" RESULT_VARIABLE status)
      if(NOT status EQUAL 0)
        message(FATAL_ERROR "Cannot create desktop detection fixture ${name}")
      endif()
      execute_process(COMMAND "${CMAKE_COMMAND}" -E env "XDG_DATA_HOME=${data_home}" "XDG_DATA_DIRS=${data_home}" "LC_ALL=C"
        "${gio_program}" info -a standard::content-type "${path}"
        RESULT_VARIABLE status OUTPUT_VARIABLE info ERROR_VARIABLE messages)
      if(NOT status EQUAL 0 OR NOT info MATCHES "standard::content-type: ([^\r\n]+)")
        message(FATAL_ERROR "Cannot inspect desktop fixture ${name}: ${info}\n${messages}")
      endif()
      set(detected "${CMAKE_MATCH_1}")
      if(expected AND NOT detected STREQUAL "model/vnd.brlcad")
        message(FATAL_ERROR "Desktop detected ${name} as ${detected}")
      elseif(NOT expected AND detected STREQUAL "model/vnd.brlcad")
        message(FATAL_ERROR "Desktop accepted invalid BRL-CAD header ${name}")
      endif()
    endfunction()
    # Neutral names exercise content rules independently of extension globs.
    # V4 fixtures pad the five-byte prefix to a full 128-byte ident record.
    check_detection(v5-header TRUE [=[printf '\166\001\000\000\000\000\001\065' > "$1"]=])
    check_detection(v5-next-object TRUE [=[printf '\166\001\000\000\000\000\001\065\166' > "$1"]=])
    check_detection(v4-ident TRUE [=[printf 'I\001v4\000%123s' "" > "$1"]=])
    check_detection(v4-final-byte TRUE [=[printf 'I\001v4\000%122s\377' "" > "$1"]=])
    check_detection(v4-short FALSE [=[printf 'I\001v4\000' > "$1"]=])
    check_detection(v4-short-record FALSE [=[printf 'I\001v4\000%122s' "" > "$1"]=])
    check_detection(v5-short FALSE [=[printf '\166\001\000\000\000\000\001' > "$1"]=])
    check_detection(v5-invalid FALSE [=[printf '\166\000\000\000\000\000\001\065\166' > "$1"]=])
    check_detection(v4-invalid FALSE [=[printf 'I\001v40%123s' "" > "$1"]=])
  else()
    message(STATUS "Desktop content detection requires gio and sh")
  endif()
else()
  message(STATUS "Desktop MIME compilation requires update-mime-database")
endif()
foreach(application archer mged rtwizard)
  set(desktop "${SOURCE_DIR}/misc/debian/${application}.desktop")
  file(READ "${desktop}" contents)
  if(NOT contents MATCHES "MimeType=model/vnd.brlcad;")
    message(FATAL_ERROR "${application} does not advertise the canonical type")
  endif()
  if(desktop_validator)
    execute_process(COMMAND "${desktop_validator}" "${desktop}" RESULT_VARIABLE status ERROR_VARIABLE messages)
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "Invalid desktop entry: ${messages}")
    endif()
  endif()
endforeach()
if(shell_program)
  foreach(script brlcad.postinst brlcad.prerm)
    execute_process(COMMAND "${shell_program}" -n "${SOURCE_DIR}/misc/debian/${script}" RESULT_VARIABLE status)
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "Invalid packaging script: ${script}")
    endif()
  endforeach()
endif()
