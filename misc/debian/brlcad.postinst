#!/bin/sh

association_file="/etc/xdg/mimeapps.list"
association_section="Default Applications"
canonical_type="model/vnd.brlcad"
application="archer.desktop"

mkdir -p "$(dirname "$association_file")" || :
crudini --set "$association_file" "$association_section" "$canonical_type" "$application" || :

update-mime-database /usr/share/mime || :
update-desktop-database /usr/share/applications || :
