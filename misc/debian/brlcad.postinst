#!/bin/sh


FILE="/etc/xdg/mimeapps.list"

SECTION="Default Applications"

MIME_1="application/brlcad-v4"
MIME_2="application/brlcad-v5"

APP="archer.desktop"


# create dir if missing
mkdir -p $(dirname ${FILE}) || :


# add/update default app for specific mime type
crudini --set "${FILE}" "${SECTION}" "${MIME_1}" "${APP}" || :
crudini --set "${FILE}" "${SECTION}" "${MIME_2}" "${APP}" || :


update-mime-database /usr/share/mime || :
update-desktop-database /usr/share/applications || :
