<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="model/vnd.brlcad">
    <comment>BRL-CAD geometry database</comment>
    <glob pattern="*.g"/>
    <glob pattern="*.brlcad"/>
    <magic priority="50">
      <match value="\x49" type="string" offset="0">
        <match value="\x76\x34\x00" type="string" offset="2">
          <!-- Check for a complete V4 record without constraining
               the final byte's value. -->
          <match value="0" type="byte" offset="127" mask="0x00"/>
        </match>
      </match>
      <match value="\x76\x01\x00\x00\x00\x00\x01\x35" type="string" offset="0"/>
    </magic>
    <alias type="application/brlcad-v4"/>
    <alias type="application/brlcad-v5"/>
    <alias type="application/brlcad-unknown"/>
    <icon name="model-vnd.brlcad"/>
    <generic-icon name="image-x-generic"/>
  </mime-type>
</mime-info>
