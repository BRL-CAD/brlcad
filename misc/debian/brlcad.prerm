#!/bin/sh

association_file="/etc/xdg/mimeapps.list"
association_section="Default Applications"

# Remove associations left by both current and earlier package versions.
for mime_type in model/vnd.brlcad application/brlcad-v4 application/brlcad-v5 application/brlcad-unknown; do
    crudini --del "$association_file" "$association_section" "$mime_type" || :
done
