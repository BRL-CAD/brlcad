if(NOT DEFINED CHANGES_SOURCE_DIR)
  message(FATAL_ERROR "CHANGES_SOURCE_DIR is not defined")
endif()
if(NOT DEFINED CHANGES_API_BASELINE)
  message(FATAL_ERROR "CHANGES_API_BASELINE is not defined")
endif()

file(GLOB_RECURSE _headers RELATIVE "${CHANGES_SOURCE_DIR}" "${CHANGES_SOURCE_DIR}/include/*.h")
list(SORT _headers)

set(_api "= BRL-CAD Public API Baseline\n\n")
string(APPEND _api "This file is generated by `changes-api-snapshot`. It records public declarations detected in installed headers for policy-change checking.\n\n")
string(APPEND _api "[source,text]\n----\n")

set(_export "^(DEPRECATED[ \t]+)?(extern[ \t]+)?[A-Z][A-Z0-9_]*_EXPORT($|[ \t])")
set(_define "^#[ \t]*define[ \t]+[A-Za-z_][A-Za-z0-9_]*")
set(_guard "${_define}_H($|[ \t])")
set(_comments "/\\*([^*]|\\*+[^*/])*\\*+/|//[^\n]*")

foreach(_hdr IN LISTS _headers)
  file(READ "${CHANGES_SOURCE_DIR}/${_hdr}" _header)
  # CMake lists treat semicolons, backslashes and square brackets specially.
  # Encode them before splitting the header into physical lines.
  string(REPLACE "%" "%25" _header "${_header}")
  string(REPLACE ";" "%3B" _header "${_header}")
  string(REPLACE "\\" "%5C" _header "${_header}")
  string(REPLACE "[" "%5B" _header "${_header}")
  string(REPLACE "]" "%5D" _header "${_header}")
  string(REPLACE "\n" ";" _lines "${_header}")

  set(_declaration "")
  set(_continuation OFF)
  foreach(_line IN LISTS _lines)
    string(STRIP "${_line}" _line)
    if(_continuation)
      if(NOT _line MATCHES "%5C$")
        set(_continuation OFF)
      endif()
      continue()
    endif()
    if(_declaration STREQUAL "" AND NOT (_line MATCHES "${_export}" OR _line MATCHES "${_define}"))
      continue()
    endif()

    string(REPLACE "%5D" "]" _line "${_line}")
    string(REPLACE "%5B" "[" _line "${_line}")
    string(REPLACE "%5C" "\\" _line "${_line}")
    string(REPLACE "%3B" ";" _line "${_line}")
    string(REPLACE "%25" "%" _line "${_line}")
    if(_line MATCHES "${_define}")
      if(_line MATCHES "\\\$")
        set(_continuation ON)
      endif()
      if(NOT _line MATCHES "${_guard}")
        string(APPEND _api "${_hdr}: ${_line}\n")
      endif()
      continue()
    endif()

    string(APPEND _declaration "\n${_line}")
    if(_line MATCHES ";")
      # Comments can contain semicolons before the actual terminator.
      string(REGEX REPLACE "${_comments}" " " _signature "${_declaration}")
      string(REGEX MATCH "^[^;]*;" _signature "${_signature}")
      if(NOT _signature STREQUAL "" AND NOT _signature MATCHES "/\\*")
        string(REGEX REPLACE "[ \t\r\n]+" " " _signature "${_signature}")
        string(STRIP "${_signature}" _signature)
        string(APPEND _api "${_hdr}: ${_signature}\n")
        set(_declaration "")
      endif()
    endif()
  endforeach()
  if(NOT _declaration STREQUAL "")
    message(FATAL_ERROR "Unterminated public API declaration in ${_hdr}:${_declaration}")
  endif()
endforeach()

string(APPEND _api "----\n")
file(WRITE "${CHANGES_API_BASELINE}" "${_api}")
message(STATUS "Wrote ${CHANGES_API_BASELINE}")
