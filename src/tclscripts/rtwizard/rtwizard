namespace eval RtWizard {
    variable wizard_state

    foreach {name value} {
	pid_filename {}
	log_file {}
	dbFile {}
	init_azimuth 35
	init_elevation 25
	init_twist 0
	zoom 1
	perspective 0
	bg_color {255 255 255}
	e_color {0 0 0}
	ne_color {0 0 0}
	occmode 1
	ghost_intensity 6
	width 512
	scanlines 512
	animation_fps 10
	ao_samples 0
	ao_radius 0
	verbose 0
    } {
	if {![info exists wizard_state($name)]} {
	    set wizard_state($name) $value
	}
    }

    proc render {type render_settings} {
	variable wizard_state

	if {[info exists wizard_state(output_filename)]} {
	    dict set render_settings _output_file $wizard_state(output_filename)
	}
	foreach {state setting} {
	    log_file _log_file
	    pid_filename _pid_filename
	    process_timeout _process_timeout
	} {
	    if {[info exists wizard_state($state)] &&
		[string length $wizard_state($state)]} {
		dict set render_settings $setting $wizard_state($state)
	    }
	}
	if {[info exists ::benchmark_mode]} {
	    dict set render_settings _benchmark_mode $::benchmark_mode
	}
	if {[info exists wizard_state(make_animation)] && $wizard_state(make_animation)} {
	    dict set render_settings _cut_steps $wizard_state(cut_steps)
	    dict set render_settings _animation_fps $wizard_state(animation_fps)
	    if {[info exists wizard_state(cut_direction)] &&
		[string length $wizard_state(cut_direction)]} {
		dict set render_settings _cut_direction $wizard_state(cut_direction)
	    }
	}

	return [::brlcad::rtwizard render $type $render_settings]
    }
}

package require RaytraceWizard

