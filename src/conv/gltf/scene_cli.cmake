file(MAKE_DIRECTORY "${WORK_DIR}")

function(run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE messages)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "glTF conversion failed: ${output}\n${messages}")
  endif()
endfunction()

function(reject_output output_path)
  file(REMOVE "${output_path}")
  execute_process(COMMAND "${GLTF_G}" ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE messages)
  if(status EQUAL 0 OR EXISTS "${output_path}")
    message(FATAL_ERROR "Unsupported glTF conversion created output: ${output}\n${messages}")
  endif()
endfunction()

configure_file("${SOURCE_DIR}/regress/gcv/gltf/tetra.bin" "${WORK_DIR}/tetra.bin" COPYONLY)
configure_file("${SOURCE_DIR}/regress/gcv/gltf/tetra-glb2.0.glb" "${WORK_DIR}/binary.payload" COPYONLY)
file(READ "${SOURCE_DIR}/regress/gcv/gltf/tetra-gltf2.0.gltf" source)
string(JSON source SET "${source}" nodes 0 rotation "[0,0,0.7071067811865476,0.7071067811865476]")
string(JSON source SET "${source}" nodes 0 translation "[10,20,30]")
string(JSON source SET "${source}" nodes 0 scale "[2,3,4]")
string(JSON source SET "${source}" nodes 1 translation "[1,2,3]")
file(WRITE "${WORK_DIR}/json.payload" "${source}")
string(JSON library REMOVE "${source}" scenes)
string(JSON library REMOVE "${library}" scene)
string(JSON library REMOVE "${library}" nodes)
file(WRITE "${WORK_DIR}/library.payload" "${library}")

foreach(kind json binary library)
  foreach(backend native standalone)
    set(database "${WORK_DIR}/${kind}-${backend}.g")
    set(mesh "${WORK_DIR}/${kind}-${backend}.stl")
    file(REMOVE "${database}" "${mesh}")
    if(backend STREQUAL "native")
      run("${GCV}" --input-handler "GLTF Reader" "${WORK_DIR}/${kind}.payload" "${database}")
    else()
      run("${GLTF_G}" -v -E -o "${database}" "${WORK_DIR}/${kind}.payload")
    endif()
    run("${GCV}" --output-handler "STL Writer" --output-trait encoding=ascii "${database}" "${mesh}")
  endforeach()
  file(READ "${WORK_DIR}/${kind}-native.stl" native)
  file(READ "${WORK_DIR}/${kind}-standalone.stl" standalone)
  if(NOT native MATCHES "facet normal" OR NOT native STREQUAL standalone)
    message(FATAL_ERROR "Native and standalone glTF geometry differ for ${kind}")
  endif()
endforeach()

string(JSON unsupported SET "${source}" extensionsRequired "[\"KHR_draco_mesh_compression\"]")
file(WRITE "${WORK_DIR}/unsupported.gltf" "${unsupported}")
reject_output("${WORK_DIR}/unsupported.g" "${WORK_DIR}/unsupported.gltf" "${WORK_DIR}/unsupported.g")
string(JSON invalid SET "${source}" nodes 1 mesh "999")
file(WRITE "${WORK_DIR}/invalid.gltf" "${invalid}")
reject_output("${WORK_DIR}/invalid.g" "${WORK_DIR}/invalid.gltf" "${WORK_DIR}/invalid.g")
reject_output("${WORK_DIR}/missing-input.g" -o "${WORK_DIR}/missing-input.g")
reject_output("${WORK_DIR}/missing-option.g" -o)
reject_output("${WORK_DIR}/extra-output.g" -o "${WORK_DIR}/extra-output.g" "${WORK_DIR}/json.payload" "${WORK_DIR}/other.g")
reject_output("${WORK_DIR}/unknown-option.g" --unknown-option "${WORK_DIR}/json.payload" "${WORK_DIR}/unknown-option.g")
reject_output("${WORK_DIR}/missing-directory/output.g" "${WORK_DIR}/json.payload" "${WORK_DIR}/missing-directory/output.g")

reject_output("${WORK_DIR}/appearance-rejected.g" --reject-loss appearance "${WORK_DIR}/json.payload" "${WORK_DIR}/appearance-rejected.g")
file(REMOVE "${WORK_DIR}/geometry-preserved.g" "${WORK_DIR}/native-geometry-preserved.g")
run("${GLTF_G}" --reject-loss geometry "${WORK_DIR}/json.payload" "${WORK_DIR}/geometry-preserved.g")
run("${GCV}" --reject-loss geometry --input-handler "GLTF Reader"
  "${WORK_DIR}/json.payload" "${WORK_DIR}/native-geometry-preserved.g")
file(REMOVE "${WORK_DIR}/native-appearance-rejected.g")
execute_process(COMMAND "${GCV}" --reject-loss appearance --input-handler "GLTF Reader"
  "${WORK_DIR}/json.payload" "${WORK_DIR}/native-appearance-rejected.g"
  RESULT_VARIABLE status ERROR_VARIABLE messages)
if(status EQUAL 0 OR EXISTS "${WORK_DIR}/native-appearance-rejected.g" OR NOT messages MATCHES "gltf.materials")
  message(FATAL_ERROR "Appearance rejection did not report glTF material loss: ${messages}")
endif()

string(JSON morph SET "${source}" meshes 0 primitives 0 targets "[{\"POSITION\":0}]")
string(JSON morph SET "${morph}" meshes 0 weights "[1]")
file(WRITE "${WORK_DIR}/morph.gltf" "${morph}")
reject_output("${WORK_DIR}/morph-rejected.g" --reject-loss geometry "${WORK_DIR}/morph.gltf" "${WORK_DIR}/morph-rejected.g")
file(REMOVE "${WORK_DIR}/native-morph-rejected.g")
execute_process(COMMAND "${GCV}" --reject-loss geometry --input-handler "GLTF Reader"
  "${WORK_DIR}/morph.gltf" "${WORK_DIR}/native-morph-rejected.g"
  RESULT_VARIABLE status ERROR_VARIABLE messages)
if(status EQUAL 0 OR EXISTS "${WORK_DIR}/native-morph-rejected.g" OR NOT messages MATCHES "gltf.morph-targets")
  message(FATAL_ERROR "Geometry rejection did not report glTF morph loss: ${messages}")
endif()

string(JSON animated SET "${source}" buffers 1 "{\"byteLength\":32,\"uri\":\"data:application/octet-stream;base64,AAAAAAAAgD8AAIA/AAAAQAAAQEAAAIBAAACgQAAAwEA=\"}")
string(JSON animated SET "${animated}" bufferViews 3 "{\"buffer\":1,\"byteLength\":8}")
string(JSON animated SET "${animated}" bufferViews 4 "{\"buffer\":1,\"byteOffset\":8,\"byteLength\":24}")
string(JSON animated SET "${animated}" accessors 3 "{\"bufferView\":3,\"componentType\":5126,\"count\":2,\"type\":\"SCALAR\",\"min\":[0],\"max\":[1]}")
string(JSON animated SET "${animated}" accessors 4 "{\"bufferView\":4,\"componentType\":5126,\"count\":2,\"type\":\"VEC3\"}")
string(JSON animated SET "${animated}" animations "[{\"samplers\":[{\"input\":3,\"output\":4}],\"channels\":[{\"sampler\":0,\"target\":{\"node\":1,\"path\":\"translation\"}}]}]")
file(WRITE "${WORK_DIR}/animated.gltf" "${animated}")
reject_output("${WORK_DIR}/animation-rejected.g" --reject-loss behavior "${WORK_DIR}/animated.gltf" "${WORK_DIR}/animation-rejected.g")
file(REMOVE "${WORK_DIR}/native-animation-rejected.g")
execute_process(COMMAND "${GCV}" --reject-loss behavior --input-handler "GLTF Reader"
  "${WORK_DIR}/animated.gltf" "${WORK_DIR}/native-animation-rejected.g"
  RESULT_VARIABLE status ERROR_VARIABLE messages)
if(status EQUAL 0 OR EXISTS "${WORK_DIR}/native-animation-rejected.g" OR NOT messages MATCHES "gltf.animations")
  message(FATAL_ERROR "Behavior rejection did not report glTF animation loss: ${messages}")
endif()
