# Verify MIME listing and early output-profile rejection without loading a
# geometry schema.  Actual writer fixtures exercise the emitted wire format.
cmake_policy(SET CMP0057 NEW)

if(NOT DEFINED STEP_HOST OR NOT DEFINED WORK_DIR)
  message(FATAL_ERROR "STEP_HOST and WORK_DIR are required")
endif()
file(MAKE_DIRECTORY "${WORK_DIR}")
execute_process(COMMAND "${STEP_HOST}" --list-schemas
  RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "STEP schema listing failed: ${stdout}${stderr}")
endif()
set(schemas "${stdout}${stderr}")
string(REGEX MATCHALL "ap[0-9]+(e[0-9]+)?" schemas "${schemas}")
execute_process(COMMAND "${STEP_HOST}" --list-formats
  RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "STEP MIME listing failed: ${stdout}${stderr}")
endif()
set(formats "${stdout}${stderr}")
foreach(schema IN LISTS schemas)
  foreach(type model/step application/p21)
    if(NOT formats MATCHES "${type} write ${schema} ")
      message(FATAL_ERROR "Missing configured writer profile: ${type} ${schema}: ${formats}")
    endif()
  endforeach()
endforeach()
set(output "${WORK_DIR}/existing.step")
set(report "${WORK_DIR}/existing.json")
set(marker "existing destination\n")
function(reject diagnostic)
  file(WRITE "${output}" "${marker}")
  file(WRITE "${report}" "${marker}")
  execute_process(COMMAND "${STEP_HOST}" ${ARGN} --report "${report}" -o "${output}" "${WORK_DIR}/absent.g"
    RESULT_VARIABLE status OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
  if(NOT status EQUAL 1 OR NOT "${stdout}${stderr}" MATCHES "${diagnostic}")
    message(FATAL_ERROR "STEP output MIME rejection failed: ${status}: ${stdout}${stderr}")
  endif()
  foreach(destination "${output}" "${report}")
    file(READ "${destination}" actual)
    if(NOT actual STREQUAL marker)
      message(FATAL_ERROR "Rejected STEP profile changed a destination")
    endif()
  endforeach()
endfunction()
reject("unsupported STEP output MIME" --output-format image/png)
reject("unsupported STEP output MIME" --output-format unknown-format)
reject("selected STEP schema cannot satisfy" --schema ap203 --output-trait step.edition=4)
reject("selected STEP schema cannot satisfy" --schema ap242e4 --output-trait step.ap=203)
reject("no configured STEP writer supports" --output-trait version=1)
reject("no configured STEP writer supports" --output-trait encoding=ascii)
reject("no configured STEP writer supports" --output-format application/p21 --output-trait step.ap=242)
reject("no configured STEP writer supports" --output-trait [=[step.application-protocols[]=[]]=])
reject("no configured STEP writer supports" --output-trait [=[step.application-protocols[]=["203","242"]]=])
reject("no configured STEP writer supports" --output-trait step.oid=1.0.10303.442.7.1.4)
if("ap203e2" IN_LIST schemas AND "ap242e2" IN_LIST schemas)
  reject("ambiguous STEP output profile" --output-trait step.edition=2)
endif()
