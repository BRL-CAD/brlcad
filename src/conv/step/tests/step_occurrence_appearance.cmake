if(SCHEMA STREQUAL "ap214")
  set(SCHEMA_ID "AUTOMOTIVE_DESIGN")
  set(GREEN_ASSIGNMENT "PRESENTATION_STYLE_BY_CONTEXT((#402),#393)")
  set(GREEN_STYLE "STYLED_ITEM('green occurrence',(#403),#37)")
else()
  set(SCHEMA_ID "AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF")
  set(GREEN_ASSIGNMENT "PRESENTATION_STYLE_ASSIGNMENT((#402))")
  set(GREEN_STYLE "CONTEXT_DEPENDENT_OVER_RIDING_STYLED_ITEM('green occurrence',(#403),#37,#413,(#378))")
endif()

set(input "${WORK}/appearance_${SCHEMA}.stp")
set(output "${WORK}/appearance_${SCHEMA}.g")
set(report "${WORK}/appearance_${SCHEMA}.json")
configure_file("${INPUT_TEMPLATE}" "${input}" @ONLY)
file(REMOVE "${output}" "${report}")

execute_process(COMMAND "${STEP_G}" --schema "${SCHEMA}" -o "${output}" --report "${report}" "${input}"
  RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE errors)
if(NOT result EQUAL 0 OR NOT EXISTS "${output}")
  message(FATAL_ERROR "STEP import failed for ${SCHEMA}\n${log}${errors}")
endif()

function(require_text text expected)
  string(FIND "${text}" "${expected}" index)
  if(index EQUAL -1)
    message(FATAL_ERROR "Missing '${expected}' in ${SCHEMA} readback\n${text}")
  endif()
endfunction()

function(read_database out)
  execute_process(COMMAND "${MGED}" -c "${output}" ${ARGN}
    RESULT_VARIABLE status OUTPUT_VARIABLE text ERROR_VARIABLE errors)
  string(APPEND text "${errors}")
  if(NOT status STREQUAL "0" OR "${text}" STREQUAL "")
    message(FATAL_ERROR "Could not read ${ARGN} from ${SCHEMA} (status ${status})\n${text}")
  endif()
  set(${out} "${text}" PARENT_SCOPE)
endfunction()

file(READ "${report}" stats)
require_text("${stats}" "\"geometry_written\":1")
require_text("${stats}" "\"occurrences\":2")
require_text("${stats}" "\"styles_applied\":3")

read_database(assembly db get Assembly)
require_text("${assembly}" "{l RedBox}")
require_text("${assembly}" "{l GreenBox {1 0 0 10")
foreach(instance RedBox GreenBox)
  read_database(member db get "${instance}")
  require_text("${member}" "{l Box}")
  require_text("${member}" "inherit yes")
endforeach()

read_database(first attr get RedBox rgb)
read_database(second attr get GreenBox rgb)
read_database(stock attr get Box_item rgb)
read_database(shader attr get GreenBox shader)
string(STRIP "${first}" first)
string(STRIP "${second}" second)
string(STRIP "${stock}" stock)
if(NOT first STREQUAL "51/89/153" OR NOT second STREQUAL "26/153/51" OR NOT stock STREQUAL "0/0/255")
  message(FATAL_ERROR "Wrong colors for ${SCHEMA} occurrences or base definition\n${first}\n${second}\n${stock}")
endif()
require_text("${shader}" "plastic tr 0.75")
