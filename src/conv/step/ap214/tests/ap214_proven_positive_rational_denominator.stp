FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 1 }'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('',(0.,0.,0.));
#2=CARTESIAN_POINT('',(0.,5.,0.));
#3=CARTESIAN_POINT('',(0.,10.,0.));
#4=CARTESIAN_POINT('',(10.,0.,0.));
#5=CARTESIAN_POINT('',(10.,5.,0.));
#6=CARTESIAN_POINT('',(10.,10.,0.));
#11=VERTEX_POINT('',#1);
#12=VERTEX_POINT('',#4);
#13=VERTEX_POINT('',#6);
#14=VERTEX_POINT('',#3);
#20=DIRECTION('',(1.,0.,0.));
#21=VECTOR('',#20,1.);
#22=LINE('',#1,#21);
#23=DIRECTION('',(-1.,0.,0.));
#24=VECTOR('',#23,1.);
#25=LINE('',#6,#24);
/* Each quadratic denominator has exact minimum
 * (1 + -0.25) / 2 = 0.375, despite its negative middle coefficient. */
#30=(BOUNDED_CURVE()
B_SPLINE_CURVE(2,(#4,#5,#6),.UNSPECIFIED.,.F.,.F.)
B_SPLINE_CURVE_WITH_KNOTS((3,3),(0.,1.),.UNSPECIFIED.)
CURVE()
GEOMETRIC_REPRESENTATION_ITEM()
RATIONAL_B_SPLINE_CURVE((1.,-0.25,1.))
REPRESENTATION_ITEM(''));
#31=(BOUNDED_CURVE()
B_SPLINE_CURVE(2,(#1,#2,#3),.UNSPECIFIED.,.F.,.F.)
B_SPLINE_CURVE_WITH_KNOTS((3,3),(0.,1.),.UNSPECIFIED.)
CURVE()
GEOMETRIC_REPRESENTATION_ITEM()
RATIONAL_B_SPLINE_CURVE((1.,-0.25,1.))
REPRESENTATION_ITEM(''));
#40=EDGE_CURVE('',#11,#12,#22,.T.);
#41=EDGE_CURVE('',#12,#13,#30,.T.);
#42=EDGE_CURVE('',#13,#14,#25,.T.);
#43=EDGE_CURVE('',#14,#11,#31,.F.);
#50=ORIENTED_EDGE('',*,*,#40,.T.);
#51=ORIENTED_EDGE('',*,*,#41,.T.);
#52=ORIENTED_EDGE('',*,*,#42,.T.);
#53=ORIENTED_EDGE('',*,*,#43,.T.);
#54=EDGE_LOOP('',(#50,#51,#52,#53));
#55=FACE_OUTER_BOUND('',#54,.T.);
#60=(BOUNDED_SURFACE()
B_SPLINE_SURFACE(1,2,((#1,#2,#3),(#4,#5,#6)),.UNSPECIFIED.,.F.,.F.,.F.)
B_SPLINE_SURFACE_WITH_KNOTS((2,2),(3,3),(0.,1.),(0.,1.),.UNSPECIFIED.)
GEOMETRIC_REPRESENTATION_ITEM()
RATIONAL_B_SPLINE_SURFACE(((1.,-0.25,1.),(1.,-0.25,1.)))
REPRESENTATION_ITEM('')
SURFACE());
#61=ADVANCED_FACE('',(#55),#60,.T.);
#62=OPEN_SHELL('proven positive rational denominator shell',(#61));
#63=SHELL_BASED_SURFACE_MODEL('proven positive rational denominator',(#62));
#70=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#71=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#72=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#73=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.00001),#70,'distance_accuracy_value','maximum gap value');
#74=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#73)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#70,#71,#72)) REPRESENTATION_CONTEXT('fixture','3D'));
#80=APPLICATION_CONTEXT('automotive design');
#81=APPLICATION_PROTOCOL_DEFINITION('fixture','automotive_design',2010,#80);
#82=PRODUCT_CONTEXT('',#80,'mechanical');
#83=PRODUCT_DEFINITION_CONTEXT('part definition',#80,'design');
#84=PRODUCT('proven_positive_rational_denominator','Proven Positive Rational Denominator','nonconforming weight with a rigorously positive complete denominator',(#82));
#85=PRODUCT_DEFINITION_FORMATION_WITH_SPECIFIED_SOURCE('1','',#84,.MADE.);
#86=PRODUCT_DEFINITION('design','',#85,#83);
#87=PRODUCT_DEFINITION_SHAPE('','',#86);
#88=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#63),#74);
#89=SHAPE_DEFINITION_REPRESENTATION(#87,#88);
