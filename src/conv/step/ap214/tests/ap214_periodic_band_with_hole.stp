ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BRL-CAD AP214 periodic band-with-hole regression fixture'),'2;1');
FILE_NAME('ap214_periodic_band_with_hole.stp','2026-07-23T00:00:00',('BRL-CAD'),('BRL-CAD'),'','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 1 }'));
ENDSEC;
DATA;
/* A radius-10 sphere with two winding latitude boundaries and one
 * contractible radius-4 hole in the x=sqrt(84) plane.  Every curve is
 * exactly on the sphere and the hole stays strictly between z=-5 and z=5;
 * the third loop must not make either latitude look like a cap.
 */
#1=CARTESIAN_POINT('',(0.,0.,0.));
#2=CARTESIAN_POINT('',(0.,0.,-5.));
#3=CARTESIAN_POINT('',(0.,0.,5.));
#4=CARTESIAN_POINT('',(9.16515138991168,0.,0.));
#5=CARTESIAN_POINT('',(8.660254037844386,0.,-5.));
#6=CARTESIAN_POINT('',(8.660254037844386,0.,5.));
#7=CARTESIAN_POINT('',(9.16515138991168,4.,0.));
#10=DIRECTION('',(0.,0.,1.));
#11=DIRECTION('',(1.,0.,0.));
#12=DIRECTION('',(0.,1.,0.));
#13=AXIS2_PLACEMENT_3D('',#1,#10,#11);
#14=AXIS2_PLACEMENT_3D('',#2,#10,#11);
#15=AXIS2_PLACEMENT_3D('',#3,#10,#11);
#16=AXIS2_PLACEMENT_3D('',#4,#11,#12);
#20=VERTEX_POINT('',#5);
#21=VERTEX_POINT('',#6);
#22=VERTEX_POINT('',#7);
#30=CIRCLE('',#14,8.660254037844386);
#31=CIRCLE('',#15,8.660254037844386);
#32=CIRCLE('',#16,4.);
#40=EDGE_CURVE('',#20,#20,#30,.T.);
#41=EDGE_CURVE('',#21,#21,#31,.T.);
#42=EDGE_CURVE('',#22,#22,#32,.T.);
#50=ORIENTED_EDGE('',*,*,#40,.T.);
#51=ORIENTED_EDGE('',*,*,#41,.F.);
#52=ORIENTED_EDGE('',*,*,#42,.F.);
#60=EDGE_LOOP('',(#50));
#61=EDGE_LOOP('',(#51));
#62=EDGE_LOOP('',(#52));
#70=FACE_OUTER_BOUND('',#60,.T.);
#71=FACE_BOUND('',#61,.T.);
#72=FACE_BOUND('',#62,.T.);
#73=SPHERICAL_SURFACE('',#13,10.);
#74=ADVANCED_FACE('',(#70,#71,#72),#73,.T.);
#80=OPEN_SHELL('periodic band with hole shell',(#74));
#81=SHELL_BASED_SURFACE_MODEL('periodic band with hole',(#80));
#90=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#91=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#92=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#93=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-4),#90,'distance_accuracy_value','maximum gap value');
#94=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#93)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#90,#91,#92)) REPRESENTATION_CONTEXT('fixture','3D'));
#100=APPLICATION_CONTEXT('automotive design');
#101=APPLICATION_PROTOCOL_DEFINITION('fixture','automotive_design',2010,#100);
#102=PRODUCT_CONTEXT('',#100,'mechanical');
#103=PRODUCT_DEFINITION_CONTEXT('part definition',#100,'design');
#104=PRODUCT('periodic_band_with_hole','Periodic Band With Hole','synthetic three-loop periodic face regression',(#102));
#105=PRODUCT_DEFINITION_FORMATION_WITH_SPECIFIED_SOURCE('1','',#104,.MADE.);
#106=PRODUCT_DEFINITION('design','',#105,#103);
#107=PRODUCT_DEFINITION_SHAPE('','',#106);
#108=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#13,#81),#94);
#109=SHAPE_DEFINITION_REPRESENTATION(#107,#108);
ENDSEC;
END-ISO-10303-21;
