ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BRL-CAD AP214 repeated-vertex periodic lobe fixture'),'2;1');
FILE_NAME('ap214_repeated_vertex_periodic_lobe.stp','2026-08-04T00:00:00',('BRL-CAD'),('BRL-CAD'),'','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 1 }'));
ENDSEC;
DATA;
/* The first two edges form a complete noncontractible winding on the
 * cylinder and return to #20.  The following four edges form an ordinary
 * contractible rectangular face boundary from the same repeated vertex.
 * This models an in-the-wild EDGE_LOOP which concatenates two closed cycles
 * without a reciprocal keyhole bridge. */
#1=CARTESIAN_POINT('',(0.,0.,0.));
#2=CARTESIAN_POINT('',(10.,0.,0.));
#3=CARTESIAN_POINT('',(9.950041652780259,0.998334166468282,0.));
#4=CARTESIAN_POINT('',(9.800665778412416,1.986693307950612,0.));
#5=CARTESIAN_POINT('',(9.800665778412416,1.986693307950612,5.));
#6=CARTESIAN_POINT('',(10.,0.,5.));
#7=CARTESIAN_POINT('',(0.,0.,5.));
#10=DIRECTION('',(0.,0.,1.));
#11=DIRECTION('',(1.,0.,0.));
#12=AXIS2_PLACEMENT_3D('',#1,#10,#11);
#13=AXIS2_PLACEMENT_3D('',#7,#10,#11);
#20=VERTEX_POINT('',#2);
#21=VERTEX_POINT('',#3);
#22=VERTEX_POINT('',#4);
#23=VERTEX_POINT('',#5);
#24=VERTEX_POINT('',#6);
#30=CIRCLE('',#12,10.);
#31=CIRCLE('',#13,10.);
#32=TRIMMED_CURVE('',#30,(PARAMETER_VALUE(0.)),(PARAMETER_VALUE(0.1)),.T.,.PARAMETER.);
#33=TRIMMED_CURVE('',#30,(PARAMETER_VALUE(0.1)),(PARAMETER_VALUE(6.283185307179586)),.T.,.PARAMETER.);
#34=TRIMMED_CURVE('',#30,(PARAMETER_VALUE(0.)),(PARAMETER_VALUE(0.2)),.T.,.PARAMETER.);
#35=TRIMMED_CURVE('',#31,(PARAMETER_VALUE(0.)),(PARAMETER_VALUE(0.2)),.T.,.PARAMETER.);
#36=VECTOR('',#10,1.);
#37=LINE('',#4,#36);
#38=LINE('',#2,#36);
#40=EDGE_CURVE('',#20,#21,#32,.T.);
#41=EDGE_CURVE('',#21,#20,#33,.T.);
#42=EDGE_CURVE('',#20,#22,#34,.T.);
#43=EDGE_CURVE('',#22,#23,#37,.T.);
#44=EDGE_CURVE('',#24,#23,#35,.T.);
#45=EDGE_CURVE('',#20,#24,#38,.T.);
#50=ORIENTED_EDGE('',*,*,#40,.T.);
#51=ORIENTED_EDGE('',*,*,#41,.T.);
#52=ORIENTED_EDGE('',*,*,#42,.T.);
#53=ORIENTED_EDGE('',*,*,#43,.T.);
#54=ORIENTED_EDGE('',*,*,#44,.F.);
#55=ORIENTED_EDGE('',*,*,#45,.F.);
#56=EDGE_LOOP('',(#50,#51,#52,#53,#54,#55));
#57=FACE_OUTER_BOUND('',#56,.T.);
#58=CYLINDRICAL_SURFACE('',#12,10.);
#59=ADVANCED_FACE('',(#57),#58,.T.);
#60=OPEN_SHELL('',(#59));
#61=SHELL_BASED_SURFACE_MODEL('repeated vertex periodic lobe',(#60));
#70=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#71=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#72=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#73=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.000001),#70,'distance_accuracy_value','maximum gap value');
#74=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#73)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#70,#71,#72)) REPRESENTATION_CONTEXT('fixture','3D'));
#80=APPLICATION_CONTEXT('automotive design');
#81=APPLICATION_PROTOCOL_DEFINITION('fixture','automotive_design',2010,#80);
#82=PRODUCT_CONTEXT('',#80,'mechanical');
#83=PRODUCT_DEFINITION_CONTEXT('part definition',#80,'design');
#84=PRODUCT('repeated_vertex_periodic_lobe','Repeated Vertex Periodic Lobe','contractible cylinder patch concatenated with one full winding',(#82));
#85=PRODUCT_DEFINITION_FORMATION_WITH_SPECIFIED_SOURCE('1','',#84,.MADE.);
#86=PRODUCT_DEFINITION('design','',#85,#83);
#87=PRODUCT_DEFINITION_SHAPE('','',#86);
#88=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#12,#61),#74);
#89=SHAPE_DEFINITION_REPRESENTATION(#87,#88);
ENDSEC;
END-ISO-10303-21;
