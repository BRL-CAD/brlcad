ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BRL-CAD AP214 invalid single winding cylinder boundary fixture'),'2;1');
FILE_NAME('ap214_single_winding_cylinder_boundary_invalid.stp','2026-07-25T00:00:00',('BRL-CAD'),('BRL-CAD'),'','','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 3 1 1 1 }'));
ENDSEC;
DATA;
/* One circle winding around a cylinder is not a contractible face boundary.
 * It can be one side of a two-boundary cylindrical band, but by itself it
 * does not bound a finite patch on this nonsingular surface.  Splitting the
 * circle at an arbitrary parameter seam only moves the unresolved
 * discontinuity and must not turn this source defect into accepted geometry. */
#1=CARTESIAN_POINT('',(0.,0.,0.));
#2=CARTESIAN_POINT('',(10.,0.,0.));
#3=VERTEX_POINT('',#2);
#10=DIRECTION('',(0.,0.,1.));
#11=DIRECTION('',(1.,0.,0.));
#12=AXIS2_PLACEMENT_3D('',#1,#10,#11);
#20=CIRCLE('',#12,10.);
#21=EDGE_CURVE('',#3,#3,#20,.T.);
#22=ORIENTED_EDGE('',*,*,#21,.T.);
#23=EDGE_LOOP('',(#22));
#24=FACE_OUTER_BOUND('',#23,.T.);
#25=CYLINDRICAL_SURFACE('',#12,10.);
#26=ADVANCED_FACE('',(#24),#25,.T.);
#27=OPEN_SHELL('',(#26));
#28=SHELL_BASED_SURFACE_MODEL('invalid single winding cylinder boundary',(#27));

#40=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#41=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#42=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#43=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.000001),#40,'distance_accuracy_value','maximum gap value');
#44=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#43)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#40,#41,#42)) REPRESENTATION_CONTEXT('fixture','3D'));
#50=APPLICATION_CONTEXT('automotive design');
#51=APPLICATION_PROTOCOL_DEFINITION('fixture','automotive_design',2010,#50);
#52=PRODUCT_CONTEXT('',#50,'mechanical');
#53=PRODUCT_DEFINITION_CONTEXT('part definition',#50,'design');
#54=PRODUCT('single_winding_cylinder_boundary','Single Winding Cylinder Boundary','invalid noncontractible one-boundary cylindrical face',(#52));
#55=PRODUCT_DEFINITION_FORMATION_WITH_SPECIFIED_SOURCE('1','',#54,.MADE.);
#56=PRODUCT_DEFINITION('design','',#55,#53);
#57=PRODUCT_DEFINITION_SHAPE('','',#56);
#58=MANIFOLD_SURFACE_SHAPE_REPRESENTATION('',(#12,#28),#44);
#59=SHAPE_DEFINITION_REPRESENTATION(#57,#58);
ENDSEC;
END-ISO-10303-21;
