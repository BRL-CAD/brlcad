ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('unsupported product geometry coverage'),'2;1');
FILE_NAME('ap203_unsupported_geometry.stp','2026-08-01T00:00:00',(''),(''),'BRL-CAD STEP coverage fixture','','');
FILE_SCHEMA(('CONFIG_CONTROL_DESIGN'));
ENDSEC;
DATA;
#1=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.05),#2,'DISTANCE_ACCURACY_VALUE','fixture tolerance');
#2=(LENGTH_UNIT()NAMED_UNIT(*)SI_UNIT(.MILLI.,.METRE.));
#3=(NAMED_UNIT(*)SI_UNIT($,.STERADIAN.)SOLID_ANGLE_UNIT());
#4=(NAMED_UNIT(*)PLANE_ANGLE_UNIT()SI_UNIT($,.RADIAN.));
#5=(GEOMETRIC_REPRESENTATION_CONTEXT(3)GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#1))GLOBAL_UNIT_ASSIGNED_CONTEXT((#2,#4,#3))REPRESENTATION_CONTEXT('FIXTURE','3D'));
#6=APPLICATION_CONTEXT('CONFIGURATION CONTROLLED 3D DESIGNS OF MECHANICAL PARTS AND ASSEMBLIES');
#7=DESIGN_CONTEXT('',#6,'design');
#8=SHAPE_DEFINITION_REPRESENTATION(#9,#14);
#9=PRODUCT_DEFINITION_SHAPE('','',#10);
#10=PRODUCT_DEFINITION('','',#11,#7);
#11=PRODUCT_DEFINITION_FORMATION('','',#12);
#12=PRODUCT('unsupported-point','unsupported-point','',(#13));
#13=MECHANICAL_CONTEXT('',#6,'');
#14=SHAPE_REPRESENTATION('unsupported-point',(#15),#5);
#15=CARTESIAN_POINT('product geometry with no BRL-CAD point-object mapping',(1.,2.,3.));
ENDSEC;
END-ISO-10303-21;
