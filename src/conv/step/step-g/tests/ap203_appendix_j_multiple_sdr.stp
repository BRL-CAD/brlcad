#111=CONNECTED_EDGE_SET('',(#120));
#120=EDGE_CURVE('',#130,#131,#140,.T.);
#130=VERTEX_POINT('',#150);
#131=VERTEX_POINT('',#151);
#140=LINE('',#150,#160);
#150=CARTESIAN_POINT('',(0.,0.,0.));
#151=CARTESIAN_POINT('',(10.,0.,0.));
#160=VECTOR('',#170,10.);
#170=DIRECTION('',(1.,0.,0.));
#200=SHELL_BASED_WIREFRAME_SHAPE_REPRESENTATION('secondary shell shape',(#500,#210),#600);
#210=SHELL_BASED_WIREFRAME_MODEL('secondary shell',(#211));
#211=WIRE_SHELL('',(#212));
#212=EDGE_LOOP('',(#213));
#213=ORIENTED_EDGE('',*,*,#220,.T.);
#220=EDGE_CURVE('',#230,#231,#240,.T.);
#230=VERTEX_POINT('',#250);
#231=VERTEX_POINT('',#251);
#240=LINE('',#250,#260);
#250=CARTESIAN_POINT('',(0.,5.,0.));
#251=CARTESIAN_POINT('',(10.,5.,0.));
#260=VECTOR('',#270,10.);
#270=DIRECTION('',(1.,0.,0.));
#300=GEOMETRICALLY_BOUNDED_SURFACE_SHAPE_REPRESENTATION('secondary point',(#310),#600);
