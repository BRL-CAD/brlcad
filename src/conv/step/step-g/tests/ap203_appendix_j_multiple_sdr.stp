#311=CARTESIAN_POINT('',(2.,3.,4.));
#500=AXIS2_PLACEMENT_3D('',#501,#502,#503);
#501=CARTESIAN_POINT('',(0.,0.,0.));
#502=DIRECTION('',(0.,0.,1.));
#503=DIRECTION('',(1.,0.,0.));
#600=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#604)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#601,#602,#603)) REPRESENTATION_CONTEXT('',''));
#601=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#602=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#603=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
