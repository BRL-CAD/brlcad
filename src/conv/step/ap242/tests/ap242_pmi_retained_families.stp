/* GPS-data placeholders obtain their actual note text through the retained
 * draughting model item association, not from a text_literal. */
#300=PROPERTY_DEFINITION('semantic text','',#26);
#301=DESCRIPTIVE_REPRESENTATION_ITEM('','OWNED SEMANTIC');
#302=DESCRIPTIVE_REPRESENTATION_ITEM('','/n');
#303=DESCRIPTIVE_REPRESENTATION_ITEM('','NOTE THIS OWNED ANNOTATION STRING IS DELIBERATELY LONGER THAN THE HISTORICAL DESCRIPTION SCRATCH BUFFER SO VERBOSE DATABASE INSPECTION EXERCISES DYNAMIC TEXT FORMATTING. IT ALSO CONFIRMS THAT LONG MULTILINE DRAWING NOTES REMAIN INTACT WHILE OSIFONT OUTLINES ARE GENERATED FOR DISPLAY. THE REMAINDER OF THIS SENTENCE PROVIDES ENOUGH DATA TO CROSS THE TWO HUNDRED AND FIFTY SIX BYTE BOUNDARY WITHOUT RELYING ON AN EXTERNAL CORPUS.');
#304=REPRESENTATION('owned semantic note',(#301,#302,#303),#14);
#305=PROPERTY_DEFINITION_REPRESENTATION(#300,#304);
