#309=ANNOTATION_PLACEHOLDER_OCCURRENCE('owned semantic note',(#202),#308,.GPS_DATA.,3.5);

/* A placement may be retained placeholder geometry rather than a text frame.
 * Its X axis is normal to the annotation plane, so its 2D projection is
 * deliberately singular.  A strict importer must preserve the sibling
 * presentation without treating this valid placeholder as corrupt. */
#311=CARTESIAN_POINT('',(18.,18.,0.));
#312=DIRECTION('',(0.,1.,0.));
#313=AXIS2_PLACEMENT_3D('owned retained-only placement',#311,#3,#2);
