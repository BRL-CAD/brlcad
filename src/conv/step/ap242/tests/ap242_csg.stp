DATA;
#1=CARTESIAN_POINT('',(0.,0.,0.));
#2=CARTESIAN_POINT('',(20.,3.,4.));
#3=DIRECTION('',(0.,0.,1.));
#4=DIRECTION('',(1.,0.,0.));
#5=AXIS2_PLACEMENT_3D('',#1,#3,#4);
#6=AXIS2_PLACEMENT_3D('',#2,#3,#4);
#10=RECTANGULAR_PYRAMID('exact pyramid',#5,12.,8.,10.);
#11=ELLIPSOID('triaxial boss',#6,4.,6.,8.);
#12=BOOLEAN_RESULT('pyramid and ellipsoid',.UNION.,#10,#11);
#13=CSG_SOLID('AP242 native CSG',#12);
#20=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#21=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#22=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#23=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#20,'distance_accuracy_value','maximum gap value');
#24=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#23)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#21,#22)) REPRESENTATION_CONTEXT('fixture','3D'));
#30=CSG_SHAPE_REPRESENTATION('',(#13),#24);
#40=APPLICATION_CONTEXT('managed model based 3D engineering');
#41=PRODUCT_CONTEXT('',#40,'mechanical');
#42=PRODUCT_DEFINITION_CONTEXT('part definition',#40,'design');
#43=PRODUCT('ap242_csg_product','AP242 CSG Product','independent AP242 primitive and Boolean fixture',(#41));
