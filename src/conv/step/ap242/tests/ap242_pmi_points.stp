ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('BRL-CAD owned AP242 PMI point fixture'),'2;1');
FILE_NAME('ap242_pmi_points.stp','2026-08-05T00:00:00',('BRL-CAD'),('BRL-CAD'),'','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF'));
ENDSEC;
DATA;
#1=CARTESIAN_POINT('',(0.,0.,0.));
#2=CARTESIAN_POINT('direct annotation point',(12.,8.,0.));
#3=DIRECTION('',(0.,0.,1.));
#4=DIRECTION('',(1.,0.,0.));
#5=AXIS2_PLACEMENT_3D('',#1,#3,#4);
#10=BLOCK('fixture block',#5,20.,15.,2.);
#11=CSG_SOLID('owned PMI point geometry',#10);
#20=(LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.));
#21=(NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.));
#22=(NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT());
#23=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(0.001),#20,'distance_accuracy_value','maximum gap value');
#24=(GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#23)) GLOBAL_UNIT_ASSIGNED_CONTEXT((#20,#21,#22)) REPRESENTATION_CONTEXT('fixture','3D'));
#30=CSG_SHAPE_REPRESENTATION('',(#11),#24);
#40=APPLICATION_CONTEXT('managed model based 3D engineering');
#41=PRODUCT_CONTEXT('',#40,'mechanical');
#42=PRODUCT_DEFINITION_CONTEXT('part definition',#40,'design');
#43=PRODUCT('ap242_pmi_points','AP242 PMI Points','BRL-CAD owned AP242 PMI point fixture',(#41));
#44=PRODUCT_DEFINITION_FORMATION('1','initial revision',#43);
#45=PRODUCT_DEFINITION('design','owned PMI point definition',#44,#42);
#46=PRODUCT_DEFINITION_SHAPE('','',#45);
#47=PROPERTY_DEFINITION_REPRESENTATION(#46,#30);

/* Exercise both indexed tessellated points and a direct point occurrence. */
#70=PLANE('point annotation plane',#5);
#80=COLOUR_RGB('PMI black',0.,0.,0.);
#81=POINT_STYLE('two millimetre plus',MARKER_TYPE(.PLUS.),POSITIVE_LENGTH_MEASURE(2.),#80);
#82=PRESENTATION_STYLE_ASSIGNMENT((#81));
#83=FILL_AREA_STYLE_COLOUR('',#80);
#84=FILL_AREA_STYLE('',(#83));
#85=PRESENTATION_STYLE_ASSIGNMENT((#84));
#86=PRE_DEFINED_MARKER('x');
#87=POINT_STYLE('three millimetre x',#86,POSITIVE_LENGTH_MEASURE(3.),#80);
#88=PRESENTATION_STYLE_ASSIGNMENT((#87));
#90=TESSELLATED_ANNOTATION_OCCURRENCE('owned tessellated points',(#82),#91);
#91=TESSELLATED_GEOMETRIC_SET('owned point set',(#92));
#92=TESSELLATED_POINT_SET('indexed annotation points',#93,(1,3));
#93=COORDINATES_LIST('point coordinates',3,((3.,4.,0.),(7.,6.,0.),(9.,4.,0.)));
#94=ANNOTATION_POINT_OCCURRENCE('owned direct point',(#88),#2);
#95=ANNOTATION_PLANE('owned point plane',(#85),#70,(#96,#94));
#96=DRAUGHTING_CALLOUT('owned point callout',(#90));
#97=DRAUGHTING_MODEL('owned point model',(#95,#96,#94),#24);
#98=MECHANICAL_DESIGN_AND_DRAUGHTING_RELATIONSHIP('','',#97,#30);
ENDSEC;
END-ISO-10303-21;
