                                                                                 <* QUERY(bnds
                                                                                          <* fa.bounds
                                                                                          | 'AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF.EDGE_LOOP' IN
                                                                                            TYPEOF(bnds.bound))
                                                                                 | NOT (SIZEOF(QUERY(oe
                                                                                                     <* elp_fbnds\path.edge_list
                                                                                                     | NOT ('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF.EDGE_CURVE' IN
                                                                                                            TYPEOF(oe.edge_element)))) =
                                                                                        0))) =
                                                                    0)))) =
                                               0))) =
                           0))) =
