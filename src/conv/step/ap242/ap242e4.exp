  WR12: SIZEOF(QUERY(sbsm
                     <* QUERY(it
                              <* items
                              | 'AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF.SHELL_BASED_SURFACE_MODEL' IN
                                TYPEOF(it))
                     | NOT (SIZEOF(QUERY(cfs
                                         <* sbsm\shell_based_surface_model.sbsm_boundary
                                         | NOT (SIZEOF(QUERY(fa
