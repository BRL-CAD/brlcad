END_ENTITY;

ENTITY pre_defined_marker
  SUBTYPE OF (pre_defined_item);
END_ENTITY;

ENTITY pre_defined_point_marker_symbol
  SUBTYPE OF (pre_defined_marker, pre_defined_symbol);
WHERE
  WR1: SELF.name IN ['asterisk','circle','dot','plus','square','triangle','x'];
END_ENTITY;

