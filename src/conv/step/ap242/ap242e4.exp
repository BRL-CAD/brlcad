TYPE planar_curve_select = SELECT
  (conic,
   line,
   pcurve,
   surface_curve,
   trimmed_curve);
WHERE
  WR1: SELF\geometric_representation_item.dim = 3;
  WR2: check_curve_planarity(SELF);
