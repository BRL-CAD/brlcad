                                                                                        1)))) =
                                                                   0))) =
                                               0))) =
                           0))) =
       0;
  WR10: SIZEOF(QUERY(si
                     <* QUERY(it
                              <* SELF.items
                              | 'AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF.STYLED_ITEM' IN TYPEOF(it))
                     | NOT (SIZEOF(QUERY(psa
