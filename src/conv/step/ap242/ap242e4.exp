FUNCTION get_name_value(obj : name_attribute_select) : label;
LOCAL
  name_bag : BAG OF name_attribute := (USEDIN(obj,
                                              'AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF.NAME_ATTRIBUTE.NAMED_ITEM'));
