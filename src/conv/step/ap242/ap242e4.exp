                                                                                                'AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF.VERTEX_LOOP'] *
                                                                                               TYPEOF(bnds.bound)) =
                                                                                        1))) =
                                                                    0)))) =
                                               0))) =
                           0))) =
       0;
  WR7: SIZEOF(QUERY(sbsm
                    <* QUERY(it
                             <* SELF.items
                             | 'AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF.SHELL_BASED_SURFACE_MODEL' IN
