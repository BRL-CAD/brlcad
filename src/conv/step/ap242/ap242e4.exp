             0)) OR
       (SIZEOF(QUERY(pds
                     <* QUERY(pd
                              <* USEDIN(SELF,
                                        'AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF.PROPERTY_DEFINITION.DEFINITION')
                              | 'AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF.PRODUCT_DEFINITION_SHAPE' IN
