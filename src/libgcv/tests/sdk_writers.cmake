set(obj_input "v 0 0 0\nv 1 0 0\nv 0 1 0\nf 1 2 3\n")
string(REPEAT " " 70000 obj_comment_padding)
string(ASCII 195 169 obj_e_acute)
foreach(handler "OBJ Reader" "Assetimport Reader")
  foreach(form plain bom unicode reference preamble)
    set(body "${obj_input}")
    set(charset ascii)
    set(bom false)
    set(repertoire true)
    set(reference false)
    if(form STREQUAL "bom")
      set(body "${utf8_bom}${body}")
      set(charset utf-8)
      set(bom true)
    elseif(form STREQUAL "unicode")
      string(APPEND body "#${obj_comment_padding}caf${obj_e_acute}\n")
      set(charset utf-8)
      set(repertoire false)
    elseif(form STREQUAL "preamble")
      set(body "#${obj_comment_padding}\n${body}")
    elseif(form STREQUAL "reference")
      string(APPEND body "#${obj_comment_padding}\nmtllib missing-sidecar.mtl\n")
      set(reference true)
    endif()
    set(input obj-input.payload)
    if(handler STREQUAL "Assetimport Reader" AND form STREQUAL "preamble")
      set(input obj-input.obj)
    endif()
    file(WRITE "${WORK_DIR}/${input}" "${body}")
    file(REMOVE "${WORK_DIR}/obj-input.g" "${WORK_DIR}/obj-input.asc")
    convert(--input-handler "${handler}" --input-format model/obj
      --input-trait obj.serialization=text --input-trait text.code-unit-width=8 --input-trait "encoding=${charset}"
      --input-trait "obj.text-bom=${bom}" --input-trait "text.ascii-only=${repertoire}"
      --input-trait "obj.material-library-reference=${reference}" "${input}" obj-input.g)
    convert(--output-format application/vnd.brlcad.script obj-input.g obj-input.asc)
    file(READ "${WORK_DIR}/obj-input.asc" geometry)
    if(NOT geometry MATCHES " bot " OR NOT geometry MATCHES "F [{][ ]*[{][ ]*0[ ]+1[ ]+2[ ]*[}][ ]*[}]")
      message(FATAL_ERROR "${handler} ${form} profile did not retain the OBJ triangle")
    endif()
  endforeach()
endforeach()

string(ASCII 195 169 utf8_e_acute)
set(unicode_name "caf${utf8_e_acute}")
set(box "arb8 V1 {0 0 0} V2 {1 0 0} V3 {1 1 0} V4 {0 1 0} V5 {0 0 1} V6 {1 0 1} V7 {1 1 1} V8 {0 1 1}")
