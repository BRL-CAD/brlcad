  "units mm\nput {box.s} ${box}\nput {${unicode_name}.s} ${box}\nput {plain.r} comb region yes tree {l box.s}\nput {${unicode_name}.r} comb region yes tree {l box.s}\nput {leaf-name.r} comb region yes tree {l {${unicode_name}.s}}\nput {group${utf8_e_acute}} comb region no tree {l plain.r}\nput {shader.r} comb region yes tree {l box.s}\nattr set {shader.r} shader {plastic {label ${unicode_name}}}\n")
file(REMOVE "${WORK_DIR}/fbx-charset.g")
convert(fbx-charset.asc fbx-charset.g)
foreach(object plain.r leaf-name.r)
  set(target "ascii-${object}.fbx")
  file(REMOVE "${WORK_DIR}/${target}")
  convert(--output-handler "Assetimport Writer" --output-format application/vnd.autodesk.fbx --output-trait encoding=ascii
    -i fbx-charset.g -o "${target}" -O --format fbxa --model "${object}")
  file(READ "${WORK_DIR}/${target}" hex HEX)
  string(REGEX MATCHALL ".." octets "${hex}")
