foreach(object "${unicode_name}.r" "group${utf8_e_acute}/plain.r" shader.r)
  if(object MATCHES "^group")
    set(expected_name "group${utf8_e_acute}")
  else()
    set(expected_name "${unicode_name}")
  endif()
  string(HEX "${expected_name}" expected_hex)
  set(request --output-handler "Assetimport Writer" --output-format application/vnd.autodesk.fbx --output-trait encoding=ascii
    -i fbx-charset.g -o rejected-charset.fbx -O --format fbxa --model "${object}")
  reject_profile(rejected-charset.fbx ${request})
  file(REMOVE "${WORK_DIR}/rejected-charset.fbx")
  execute_process(COMMAND "${GCV}" ${request} WORKING_DIRECTORY "${WORK_DIR}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE messages TIMEOUT 30)
  if(NOT status EQUAL 1 OR EXISTS "${WORK_DIR}/rejected-charset.fbx")
    message(FATAL_ERROR "SDK FBX ASCII rejection created output: ${status}\n${output}\n${messages}")
  endif()
  foreach(mode text explicit-backend binary)
    set(target "unicode-${mode}.fbx")
    set(request --output-handler "Assetimport Writer" --output-format application/vnd.autodesk.fbx -i fbx-charset.g -o "${target}")
    if(mode STREQUAL "explicit-backend")
      list(APPEND request -O --format fbxa --model "${object}")
    else()
      list(APPEND request --output-trait "fbx.serialization=${mode}" -O --model "${object}")
    endif()
    file(REMOVE "${WORK_DIR}/${target}")
    convert(${request})
    file(READ "${WORK_DIR}/${target}" hex HEX)
    string(FIND "${hex}" "${expected_hex}" offset)
    if(offset LESS 0)
      message(FATAL_ERROR "SDK FBX ${mode} output discarded an emitted UTF-8 name")
    endif()
    if(mode STREQUAL "binary")
      file(REMOVE "${WORK_DIR}/unicode-result.g" "${WORK_DIR}/unicode-result.asc")
      convert(--input-handler "Assetimport Reader" --input-format application/vnd.autodesk.fbx
        --input-trait version=7.5.0 "${target}" unicode-result.g)
      convert(--output-format application/vnd.brlcad.script unicode-result.g unicode-result.asc)
      file(READ "${WORK_DIR}/unicode-result.asc" geometry)
      if(NOT geometry MATCHES " bot ")
        message(FATAL_ERROR "SDK FBX binary Unicode round trip did not retain geometry")
      endif()
    endif()
  endforeach()
endforeach()

function(check_obj_ascii backend object target accepted)
  string(REGEX REPLACE "[.][^.]*$" ".mtl" material "${target}")
  set(request --output-handler "Assetimport Writer" --output-format model/obj
    --output-trait obj.serialization=text --output-trait encoding=ascii
    -i fbx-charset.g -o "${target}" -O --format "${backend}" --model "${object}")
  file(REMOVE "${WORK_DIR}/${target}" "${WORK_DIR}/${material}")
  if(accepted)
    convert(${request})
    set(files "${target}")
    if(backend STREQUAL "obj")
      list(APPEND files "${material}")
    elseif(EXISTS "${WORK_DIR}/${material}")
      message(FATAL_ERROR "SDK objnomtl unexpectedly created a material file")
    endif()
    foreach(path IN LISTS files)
      file(READ "${WORK_DIR}/${path}" hex HEX)
      string(REGEX MATCHALL ".." octets "${hex}")
      foreach(octet IN LISTS octets)
        if(octet STRGREATER_EQUAL "80")
          message(FATAL_ERROR "SDK OBJ ASCII output contains a non-ASCII byte")
        endif()
      endforeach()
    endforeach()
    file(READ "${WORK_DIR}/${target}" geometry)
    if(NOT geometry MATCHES "\nf ")
      message(FATAL_ERROR "SDK OBJ ASCII fixture contains no faces")
    endif()
  else()
    set(marker "Preserve the companion material file.\n")
    file(WRITE "${WORK_DIR}/${material}" "${marker}")
    reject_profile("${target}" ${request})
    file(READ "${WORK_DIR}/${material}" contents)
    if(NOT contents STREQUAL marker)
      message(FATAL_ERROR "Rejected OBJ ASCII request changed its material file")
    endif()
    file(REMOVE "${WORK_DIR}/${target}" "${WORK_DIR}/${material}")
    execute_process(COMMAND "${GCV}" ${request} WORKING_DIRECTORY "${WORK_DIR}"
      RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE messages TIMEOUT 30)
    if(NOT status EQUAL 1 OR EXISTS "${WORK_DIR}/${target}" OR EXISTS "${WORK_DIR}/${material}")
      message(FATAL_ERROR "Rejected OBJ ASCII request created output: ${status}\n${output}\n${messages}")
    endif()
    convert(--output-handler "Assetimport Writer" --output-format model/obj --output-trait obj.serialization=text
      -i fbx-charset.g -o "${target}" -O --format "${backend}" --model "${object}")
    file(READ "${WORK_DIR}/${target}" hex HEX)
    string(FIND "${hex}" "c3a9" unicode_offset)
    if(unicode_offset LESS 0)
      message(FATAL_ERROR "Unasserted OBJ text output discarded an emitted Unicode name")
    endif()
  endif()
endfunction()

file(MAKE_DIRECTORY "${WORK_DIR}/group${utf8_e_acute}")
foreach(backend obj objnomtl)
  foreach(object plain.r leaf-name.r "group${utf8_e_acute}/plain.r")
    check_obj_ascii("${backend}" "${object}" "selected-${backend}.obj" TRUE)
  endforeach()
  check_obj_ascii("${backend}" plain.r "group${utf8_e_acute}/parent-${backend}.obj" TRUE)
  check_obj_ascii("${backend}" "${unicode_name}.r" "unicode-${backend}.obj" FALSE)
  if(backend STREQUAL "obj")
    set(omits_materials FALSE)
  else()
    set(omits_materials TRUE)
  endif()
  check_obj_ascii("${backend}" shader.r "shader-${backend}.obj" "${omits_materials}")
  check_obj_ascii("${backend}" plain.r "${unicode_name}-${backend}.obj" "${omits_materials}")
endforeach()

