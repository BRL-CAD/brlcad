# Native PLY remains available while the SDK encoders need correction.
foreach(encoding ascii binary)
  set(target "native-${encoding}.ply")
  set(request --output-trait "encoding=${encoding}" --output-trait version=1.0)
  if(encoding STREQUAL "binary")
    list(APPEND request --output-trait byte-order=little-endian)
  endif()
  file(REMOVE "${WORK_DIR}/${target}" "${WORK_DIR}/native-${encoding}.g" "${WORK_DIR}/native-${encoding}.asc")
  convert(--output-handler "PLY Writer" ${request} source.g "${target}")
  convert(--input-handler "PLY Reader" "${target}" "native-${encoding}.g")
  convert(--output-format application/vnd.brlcad.script "native-${encoding}.g" "native-${encoding}.asc")
  file(READ "${WORK_DIR}/native-${encoding}.asc" geometry)
  if(NOT geometry MATCHES " bot ")
    message(FATAL_ERROR "Native PLY output did not retain geometry")
  endif()
endforeach()
foreach(id ply plyb)
  reject_profile("unavailable-${id}.ply" --output-handler "Assetimport Writer" --output-format application/x-ply
    -i source.g -o "unavailable-${id}.ply" -O --format "${id}")
endforeach()
