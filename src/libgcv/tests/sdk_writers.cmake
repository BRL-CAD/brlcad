file(MAKE_DIRECTORY "${WORK_DIR}")

function(convert)
  execute_process(COMMAND "${GCV}" ${ARGN} WORKING_DIRECTORY "${WORK_DIR}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE messages TIMEOUT 30)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "SDK writer conversion failed (${status}): ${output}\n${messages}")
  endif()
endfunction()

function(reject_profile target)
  set(marker "Preserve the destination on profile rejection.\n")
  file(WRITE "${WORK_DIR}/${target}" "${marker}")
  execute_process(COMMAND "${GCV}" ${ARGN} WORKING_DIRECTORY "${WORK_DIR}"
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE messages TIMEOUT 30)
  file(READ "${WORK_DIR}/${target}" contents)
  if(NOT status EQUAL 1 OR NOT contents STREQUAL marker)
    message(FATAL_ERROR "SDK writer did not reject the profile before output: ${status}\n${output}\n${messages}")
  endif()
endfunction()

function(check_byte_order mime id extension order)
  if(order STREQUAL "little-endian")
    set(other_order big-endian)
  else()
    set(other_order little-endian)
  endif()
  set(target "ordered-${id}.${extension}")
  file(REMOVE "${WORK_DIR}/${target}")
  convert(--output-handler "Assetimport Writer" --output-format "${mime}"
    --output-trait "byte-order=${order}" -i source.g -o "${target}" -O --format "${id}")
  set(rejected "wrong-order-${id}.${extension}")
  reject_profile("${rejected}" --output-handler "Assetimport Writer" --output-format "${mime}"
    --output-trait "byte-order=${other_order}" -i source.g -o "${rejected}" -O --format "${id}")
endfunction()

file(REMOVE "${WORK_DIR}/source.g")
convert("${SOURCE_DIR}/regress/gcv/stl/tetra.stl" source.g)
execute_process(COMMAND "${GCV}" --list-formats RESULT_VARIABLE formats_status
  OUTPUT_VARIABLE formats_stdout ERROR_VARIABLE formats_stderr)
if(NOT formats_status EQUAL 0)
  message(FATAL_ERROR "Cannot inspect configured SDK writer capabilities")
endif()
set(available_formats "${formats_stdout}${formats_stderr}")

# These are wire-format declarations, independent of SDK release numbers.
set(profiles
  "stl|model/stl|stl|encoding=ascii,stl.serialization=text,stl.utf8-bom=false|stl.serialization=binary"
  "stlb|model/stl|stl|encoding=binary,stl.serialization=binary,byte-order=little-endian|stl.serialization=text"
  "collada|model/vnd.collada+xml|dae|encoding=utf-8,version=1.4.1,collada.schema-version=1.4|version=1.5.0"
  "x|model/vnd.microsoft.x|x|encoding=ascii,version=3.3,x.float-width=32,compression=none,x.serialization=text,x.header-code-unit-width=8|x.float-width=64"
  "3ds|image/x-3ds|3ds|encoding=binary,byte-order=little-endian|byte-order=big-endian"
  "assbin|model/vnd.assimp.binary|assbin|encoding=binary,version=1.0,compression=none,assimp.shortened=false|assimp.shortened=true"
  "assxml|model/vnd.assimp+xml|assxml|encoding=utf-8,assimp.format-id=1,assimp.shortened=false|assimp.format-id=2"
  "assjson|model/vnd.assimp+json|assjson|encoding=utf-8,version=100|version=101"
  "fbx|application/vnd.autodesk.fbx|fbx|encoding=binary,version=7.5.0,byte-order=little-endian,fbx.serialization=binary,fbx.binary-header-version-code=7500,fbx.document-version-code=7500|version=7.4.0"
  "fbxa|application/vnd.autodesk.fbx|fbx|encoding=ascii,version=7.5.0,fbx.serialization=text,text.code-unit-width=8,fbx.text-bom=false,fbx.document-version-code=7500|version=7.4.0"
  "3mf|model/3mf|3mf|encoding=binary,container=zip,3mf.model-encoding=utf-8|container=gzip"
)
foreach(profile IN LISTS profiles)
  string(REPLACE "|" ";" fields "${profile}")
  list(GET fields 0 id)
  list(GET fields 1 mime)
  list(GET fields 2 extension)
  list(GET fields 3 properties)
  list(GET fields 4 unsupported)
  if(id STREQUAL "assbin" AND NOT available_formats MATCHES "model/vnd[.]assimp[.]binary[ ]+write[ ]+Assetimport Writer")
    continue()
  endif()
  set(target "${id}.${extension}")
  string(REPLACE "," ";" properties "${properties}")
  set(request)
  foreach(property IN LISTS properties)
    list(APPEND request --output-trait "${property}")
  endforeach()
  file(REMOVE "${WORK_DIR}/${target}")
  convert(--output-handler "Assetimport Writer" --output-format "${mime}" ${request}
    -i source.g -o "${target}" -O --format "${id}")
  file(READ "${WORK_DIR}/${target}" hex HEX)
  file(READ "${WORK_DIR}/${target}" text)
  if(id STREQUAL "stl")
    if(NOT text MATCHES "^solid" OR NOT text MATCHES "facet normal")
      message(FATAL_ERROR "SDK STL text output differs from its declared layout")
    endif()
  elseif(id STREQUAL "stlb")
    file(SIZE "${WORK_DIR}/${target}" binary_size)
    string(SUBSTRING "${hex}" 160 8 count)
    if(binary_size LESS 134 OR NOT count MATCHES "^[0-9a-f]+$")
      message(FATAL_ERROR "SDK STL binary output has an invalid record layout")
    endif()
    # The count is little endian; verify the actual number of records.
    string(SUBSTRING "${count}" 0 2 byte0)
    string(SUBSTRING "${count}" 2 2 byte1)
    string(SUBSTRING "${count}" 4 2 byte2)
    string(SUBSTRING "${count}" 6 2 byte3)
    math(EXPR expected_size "84 + 50 * 0x${byte3}${byte2}${byte1}${byte0}")
    if(NOT binary_size EQUAL expected_size)
      message(FATAL_ERROR "SDK STL binary facet count does not match the file size")
    endif()
  elseif(id STREQUAL "collada")
    if(NOT text MATCHES "encoding=\"UTF-8\"" OR NOT text MATCHES "<COLLADA xmlns=\"http://www.collada.org/2005/11/COLLADASchema\" version=\"1.4.1\"")
      message(FATAL_ERROR "COLLADA output differs from its declared profile")
    endif()
  elseif(id STREQUAL "x")
    string(SUBSTRING "${text}" 0 16 header)
    if(NOT header STREQUAL "xof 0303txt 0032")
      message(FATAL_ERROR "DirectX output differs from its declared profile: ${header}")
    endif()
  elseif(id STREQUAL "3ds")
    if(NOT hex MATCHES "^4d4d")
      message(FATAL_ERROR "3DS output has no little-endian main chunk")
    endif()
    reject_profile(unestablished.3ds --output-handler "Assetimport Writer" --output-format "${mime}"
      --output-trait version=3 -i source.g -o unestablished.3ds -O --format 3ds)
    file(COPY_FILE "${WORK_DIR}/${target}" "${WORK_DIR}/3ds.payload")
    file(REMOVE "${WORK_DIR}/3ds-observed.g" "${WORK_DIR}/3ds-observed.asc")
    convert(3ds.payload 3ds-observed.g)
    convert(--output-format application/vnd.brlcad.script 3ds-observed.g 3ds-observed.asc)
    file(READ "${WORK_DIR}/3ds-observed.asc" geometry)
    if(NOT geometry MATCHES " bot ")
      message(FATAL_ERROR "Content-selected 3DS input did not retain geometry")
    endif()
  elseif(id STREQUAL "assbin")
    string(SUBSTRING "${hex}" 88 16 version)
    string(SUBSTRING "${hex}" 120 8 flags)
    if(version STREQUAL "0100000000000000")
      set(order little-endian)
    elseif(version STREQUAL "0000000100000000")
      set(order big-endian)
    else()
      message(FATAL_ERROR "Assimp binary output has an unexpected wire version: ${version}")
    endif()
    if(NOT text MATCHES "^ASSIMP[.]binary-dump[.]" OR NOT flags STREQUAL "00000000")
      message(FATAL_ERROR "Assimp binary output is not a full uncompressed dump")
    endif()
    check_byte_order("${mime}" "${id}" "${extension}" "${order}")
    if(order STREQUAL "little-endian")
      set(flags_byte_at 112)
    else()
      set(flags_byte_at 118)
    endif()
    string(SUBSTRING "${hex}" ${flags_byte_at} 2 flags_byte)
    math(EXPR double_support "0x${flags_byte} & 32")
    if(double_support)
      set(real_width 64)
      set(other_width 32)
    else()
      set(real_width 32)
      set(other_width 64)
    endif()
    file(REMOVE "${WORK_DIR}/assbin-precision.assbin")
    convert(--output-handler "Assetimport Writer" --output-format "${mime}"
      --output-trait "assimp.real-width=${real_width}" -i source.g -o assbin-precision.assbin -O --format assbin)
    reject_profile(assbin-other-precision.assbin --output-handler "Assetimport Writer" --output-format "${mime}"
      --output-trait "assimp.real-width=${other_width}" -i source.g -o assbin-other-precision.assbin -O --format assbin)
  elseif(id STREQUAL "assxml")
    if(NOT text MATCHES "encoding=\"utf-8\"" OR NOT text MATCHES "<ASSIMP format_id=\"1\">" OR NOT text MATCHES "<Positions num=\"[1-9]")
      message(FATAL_ERROR "Assimp XML output differs from its declared format or lacks geometry")
    endif()
  elseif(id STREQUAL "assjson")
    string(JSON format GET "${text}" __metadata__ format)
    string(JSON version GET "${text}" __metadata__ version)
    string(JSON meshes LENGTH "${text}" meshes)
    if(NOT format STREQUAL "assimp2json" OR NOT version EQUAL 100 OR meshes LESS 1)
      message(FATAL_ERROR "Assimp JSON output differs from its declared format or lacks geometry")
    endif()
  elseif(id STREQUAL "fbx")
    if(NOT hex MATCHES "^4b617964617261204642582042696e6172792020001a004c1d0000")
      message(FATAL_ERROR "FBX binary output differs from its declared 7.5.0 profile")
    endif()
    reject_profile(conflicting.fbx --output-handler "Assetimport Writer" --output-format "${mime}" ${request}
      -i source.g -o conflicting.fbx -O --format fbxa)
  elseif(id STREQUAL "fbxa")
    if(NOT text MATCHES "^; FBX 7[.]5[.]0 project file" OR NOT text MATCHES "FBXVersion: 7500")
      message(FATAL_ERROR "FBX text output differs from its declared 7.5.0 profile")
    endif()
  elseif(id STREQUAL "3mf")
    if(NOT hex MATCHES "^504b0304")
      message(FATAL_ERROR "3MF output has no ZIP container")
    endif()
    file(MAKE_DIRECTORY "${WORK_DIR}/members")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xf "${WORK_DIR}/${target}" 3D/3DModel.model
      WORKING_DIRECTORY "${WORK_DIR}/members" RESULT_VARIABLE status)
    if(NOT status EQUAL 0)
      message(FATAL_ERROR "Cannot inspect the exported 3MF model member")
    endif()
    file(READ "${WORK_DIR}/members/3D/3DModel.model" model)
    if(NOT model MATCHES "encoding=\"UTF-8\"" OR NOT model MATCHES "http://schemas.microsoft.com/3dmanufacturing/core/2015/02")
      message(FATAL_ERROR "3MF model member differs from its declared profile")
    endif()
    reject_profile(unestablished.3mf --output-handler "Assetimport Writer" --output-format "${mime}"
      --output-trait version=1.0 -i source.g -o unestablished.3mf -O --format 3mf)
  endif()
  reject_profile("unsupported-${target}" --output-handler "Assetimport Writer" --output-format "${mime}"
    --output-trait "${unsupported}" -i source.g -o "unsupported-${target}" -O --format "${id}")
  reject_profile("unknown-${target}" --output-handler "Assetimport Writer" --output-format "${mime}"
    --output-trait writer.unestablished=assertion -i source.g -o "unknown-${target}" -O --format "${id}")
  if(NOT id STREQUAL "assxml" AND NOT id STREQUAL "assjson")
    file(REMOVE "${WORK_DIR}/${id}.g" "${WORK_DIR}/${id}.asc")
    set(input_request)
    if(id STREQUAL "3ds")
      set(input_request --input-trait encoding=binary --input-trait byte-order=little-endian)
    elseif(id STREQUAL "3mf")
      set(input_request --input-trait encoding=binary --input-trait container=zip)
    elseif(id STREQUAL "fbx")
      set(input_request --input-trait encoding=binary --input-trait version=7.5.0
        --input-trait fbx.binary-header-version-code=7500 --input-trait fbx.document-version-code=7500)
    elseif(id STREQUAL "fbxa")
      set(input_request --input-trait encoding=ascii --input-trait version=7.5.0
        --input-trait fbx.serialization=text --input-trait fbx.text-bom=false --input-trait fbx.document-version-code=7500)
    endif()
    convert(--input-handler "Assetimport Reader" --input-format "${mime}" ${input_request} "${target}" "${id}.g")
    convert(--output-format application/vnd.brlcad.script "${id}.g" "${id}.asc")
    file(READ "${WORK_DIR}/${id}.asc" geometry)
    if(NOT geometry MATCHES " bot ")
      message(FATAL_ERROR "SDK ${id} profile round trip did not retain geometry")
    endif()
  endif()
endforeach()

