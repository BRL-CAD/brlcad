title {Offset planar cut through nested planetary-scale spheroids}
units km
put {outer.s} ell V {0 0 0} A {6468100000 0 0} B {0 6468100000 0} C {0 0 6446800000}
put {inner.s} ell V {0 0 0} A {6428100000 0 0} B {0 6428100000 0} C {0 0 6406800000}
put {shell.c} comb region no tree {- {l outer.s} {l inner.s}}
put {offset_tetra.s} arb8 V1 {1000000 1000000 1000000} V2 {1000000 11550000000 1000000} V3 {11550000000 1000000 1000000} V4 {1000000 1000000 1000000} V5 {1000000 1000000 11550000000} V6 {1000000 1000000 11550000000} V7 {1000000 1000000 11550000000} V8 {1000000 1000000 11550000000}
put {offset_spheroid_cut.c} comb region no tree {- {l shell.c} {l offset_tetra.s}}
