if(NOT DEFINED MGED OR NOT DEFINED SOURCE_DB OR NOT DEFINED TEST_DB)
  message(FATAL_ERROR "MGED, SOURCE_DB, and TEST_DB must be defined")
endif()

get_filename_component(TEST_DIR "${TEST_DB}" DIRECTORY)
file(MAKE_DIRECTORY "${TEST_DIR}")
file(COPY_FILE "${SOURCE_DB}" "${TEST_DB}")

function(execute_brep_command COMMAND_TEXT)
  execute_process(
    COMMAND "${MGED}" -c "${TEST_DB}" "${COMMAND_TEXT}"
    RESULT_VARIABLE RESULT
    OUTPUT_VARIABLE STDOUT
    ERROR_VARIABLE STDERR)
  if(NOT RESULT EQUAL 0)
    message(FATAL_ERROR "${COMMAND_TEXT} failed with ${RESULT}: ${STDOUT}${STDERR}")
  endif()

  set(BREP_COMMAND_OUTPUT "${STDOUT}${STDERR}" PARENT_SCOPE)
endfunction()

function(run_brep_command COMMAND_TEXT EXPECTED_OUTPUT)
  execute_brep_command("${COMMAND_TEXT}")

  string(STRIP "${BREP_COMMAND_OUTPUT}" OUTPUT)
  if(NOT OUTPUT MATCHES "${EXPECTED_OUTPUT}")
    message(FATAL_ERROR "${COMMAND_TEXT} produced unexpected output: ${OUTPUT}")
  endif()
endfunction()

if(SHARED_EDGE_CONTACT)
  function(check_shared_edge_contact CASE_NAME SECOND_OBJECT)
    set(LEFT_BREP ${CASE_NAME}_left.brep)
    set(RIGHT_BREP ${CASE_NAME}_right.brep)
    set(DIFFERENCE_RESULT ${CASE_NAME}_difference.brep)
    set(INTERSECTION_RESULT ${CASE_NAME}_intersection.brep)

    run_brep_command("brep arb8_1.s brep ${LEFT_BREP}" "is made")
    run_brep_command("brep ${SECOND_OBJECT} brep ${RIGHT_BREP}" "is made")
    run_brep_command("brep ${LEFT_BREP} bool - ${RIGHT_BREP} ${DIFFERENCE_RESULT}" "^$")
    run_brep_command("brep ${DIFFERENCE_RESULT} valid" "brep is valid")
    run_brep_command("brep ${DIFFERENCE_RESULT} solid" "brep is solid")
    run_brep_command("brep ${LEFT_BREP} bool + ${RIGHT_BREP} ${INTERSECTION_RESULT}" "Boolean result is empty")
    run_brep_command("exists -e ${INTERSECTION_RESULT}" "^0$")
  endfunction()

  check_shared_edge_contact(partial_shared_edge arb8_4.s)
  check_shared_edge_contact(full_shared_edge arb8_5.s)
  return()
endif()

if(NOT DEFINED COMBINATION)
  set(COMBINATION 00004_non-trivally_disjoint_union.c)
endif()
set(RESULT ${COMBINATION}.brep)
if(ALLOW_FAILURE)
  execute_brep_command("brep ${COMBINATION} brep")
  if(DEFINED REJECT_OUTPUT AND BREP_COMMAND_OUTPUT MATCHES "${REJECT_OUTPUT}")
    message(FATAL_ERROR "brep ${COMBINATION} produced rejected output: ${BREP_COMMAND_OUTPUT}")
  endif()
  if(DEFINED EXPECT_FAILURE_OUTPUT AND
     NOT BREP_COMMAND_OUTPUT MATCHES "${EXPECT_FAILURE_OUTPUT}")
    message(FATAL_ERROR
      "brep ${COMBINATION} did not report the expected structured failure: ${BREP_COMMAND_OUTPUT}")
  endif()
  if(EXPECT_NO_RESULT)
    run_brep_command("exists -e ${RESULT}" "^0$")
  endif()
  return()
endif()
if(EXPECT_EMPTY)
  run_brep_command("brep ${COMBINATION} brep" "Boolean result is empty")
  run_brep_command("exists -e ${RESULT}" "^0$")
  if(DIRECT_BOOLEAN)
    set(LEFT_BREP direct_sph1.brep)
    set(RIGHT_BREP direct_sph3.brep)
    set(DIRECT_RESULT direct_empty.brep)
    run_brep_command("brep sph1.s brep ${LEFT_BREP}" "is made")
    run_brep_command("brep sph3.s brep ${RIGHT_BREP}" "is made")
    run_brep_command("brep ${LEFT_BREP} bool + ${RIGHT_BREP} ${DIRECT_RESULT}" "Boolean result is empty")
    run_brep_command("exists -e ${DIRECT_RESULT}" "^0$")
  endif()
else()
  run_brep_command("brep ${COMBINATION} brep" "is made")
  run_brep_command("brep ${RESULT} valid" "brep is valid")
  run_brep_command("brep ${RESULT} solid" "brep is solid")
endif()
