if(NOT EXEC)
  message(FATAL_ERROR "EXEC is required")
endif()
execute_process(COMMAND "${EXEC}" --emit COMMAND "${EXEC}" --copy
  COMMAND "${EXEC}" --check-stream RESULTS_VARIABLE results
  ERROR_VARIABLE errors TIMEOUT 30)
foreach(result IN LISTS results)
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "EXR pipe roundtrip failed (${results}): ${errors}")
  endif()
endforeach()
