file(MAKE_DIRECTORY "${WORK_DIR}")
file(REMOVE "${WORK_DIR}/plugin.unknown" "${WORK_DIR}/restored.png" "${WORK_DIR}/invalid.output")
execute_process(COMMAND "${CODEC_TEST}" --emit OUTPUT_FILE "${WORK_DIR}/input.unknown" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Could not create input image")
endif()
function(convert)
  execute_process(COMMAND "${ICV}" ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE messages)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Image conversion failed: ${output}\n${messages}")
  endif()
endfunction()
convert(--plugin "${PLUGIN}" --output-format image/vnd.example.codec "${WORK_DIR}/input.unknown" "${WORK_DIR}/plugin.unknown")
convert(--plugin "${PLUGIN}" "${WORK_DIR}/plugin.unknown" "${WORK_DIR}/restored.png")
execute_process(COMMAND "${CODEC_TEST}" --stdin INPUT_FILE "${WORK_DIR}/restored.png" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Plugin image round trip changed the pixel")
endif()

file(REMOVE "${WORK_DIR}/plugin.codecseq" "${WORK_DIR}/sequence.payload" "${WORK_DIR}/sequence.PNG")
convert(anim --plugin "${PLUGIN}" add "${WORK_DIR}/plugin.codecseq" "${WORK_DIR}/input.unknown" "${WORK_DIR}/input.unknown")
file(RENAME "${WORK_DIR}/plugin.codecseq" "${WORK_DIR}/sequence.payload")
convert(anim --plugin "${PLUGIN}" add "${WORK_DIR}/sequence.payload" "${WORK_DIR}/input.unknown")
convert(anim --plugin "${PLUGIN}" extract "${WORK_DIR}/sequence.payload" "${WORK_DIR}/plugin-frame-")
foreach(frame 001 002 003)
  execute_process(COMMAND "${CODEC_TEST}" --stdin INPUT_FILE "${WORK_DIR}/plugin-frame-${frame}_ctrl.png" RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Plugin sequence changed frame ${frame}")
  endif()
endforeach()
execute_process(COMMAND "${ICV}" --plugin "${PLUGIN}" --identify "${WORK_DIR}/sequence.payload"
  RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE messages)
if(NOT status EQUAL 0 OR NOT "${output}${messages}" MATCHES "read-sequence write-sequence")
  message(FATAL_ERROR "Sequence operations are missing from codec discovery: ${output}\n${messages}")
endif()
execute_process(COMMAND "${ICV}" anim extract "${WORK_DIR}/sequence.payload" "${WORK_DIR}/unloaded-frame-" RESULT_VARIABLE status)
if(status EQUAL 0)
  message(FATAL_ERROR "Sequence input succeeded without its plugin")
endif()
convert(anim add "${WORK_DIR}/sequence.PNG" "${WORK_DIR}/input.unknown" "${WORK_DIR}/input.unknown")
convert(anim extract "${WORK_DIR}/sequence.PNG" "${WORK_DIR}/apng-frame-")
foreach(frame 001 002)
  execute_process(COMMAND "${CODEC_TEST}" --stdin INPUT_FILE "${WORK_DIR}/apng-frame-${frame}_ctrl.png" RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "APNG sequence changed frame ${frame}")
  endif()
endforeach()
file(REMOVE_RECURSE "${WORK_DIR}/missing-frames")
foreach(animation sequence.payload sequence.PNG)
  execute_process(COMMAND "${ICV}" anim --plugin "${PLUGIN}" extract
    "${WORK_DIR}/${animation}" "${WORK_DIR}/missing-frames/frame-"
    RESULT_VARIABLE status ERROR_VARIABLE messages)
  if(NOT status EQUAL 1 OR NOT messages MATCHES "Failed to write frame" OR EXISTS "${WORK_DIR}/missing-frames")
    message(FATAL_ERROR "Animation extraction did not propagate the PNG writer failure: ${status} ${messages}")
  endif()
endforeach()

set(marker "Keep the unrecognized existing animation")
file(WRITE "${WORK_DIR}/corrupt.apng" "${marker}")
execute_process(COMMAND "${ICV}" anim add "${WORK_DIR}/corrupt.apng" "${WORK_DIR}/input.unknown" RESULT_VARIABLE status)
file(READ "${WORK_DIR}/corrupt.apng" stored)
if(status EQUAL 0 OR NOT stored STREQUAL marker)
  message(FATAL_ERROR "Animation add replaced an input whose format could not be read")
endif()
file(REMOVE "${WORK_DIR}/archive.png.payload")
execute_process(COMMAND "${ICV}" anim add "${WORK_DIR}/archive.png.payload" "${WORK_DIR}/input.unknown" RESULT_VARIABLE status)
if(status EQUAL 0 OR EXISTS "${WORK_DIR}/archive.png.payload")
  message(FATAL_ERROR "Animation output used a substring as a format association")
endif()
execute_process(COMMAND "${ICV}" --output-format invalid/type "${WORK_DIR}/input.unknown" "${WORK_DIR}/invalid.output" RESULT_VARIABLE status ERROR_VARIABLE messages)
if(status EQUAL 0 OR EXISTS "${WORK_DIR}/invalid.output")
  message(FATAL_ERROR "Unknown output type was not rejected before creating output")
endif()

execute_process(COMMAND "${CODEC_TEST}" --emit
  COMMAND "${ICV}" --output-format image/png
  COMMAND "${CODEC_TEST}" --stdin
  RESULTS_VARIABLE statuses)
if(NOT "${statuses}" STREQUAL "0;0;0")
  message(FATAL_ERROR "Converter pipe round trip failed: ${statuses}")
endif()

convert(info "${WORK_DIR}/input.unknown")
convert(--output-trait bit-depth=8 "${WORK_DIR}/input.unknown" "${WORK_DIR}/jpeg-profile.jpg")
convert(info --input-trait color-space=ycbcr "${WORK_DIR}/jpeg-profile.jpg")
file(REMOVE "${WORK_DIR}/jpeg-conflict.png" "${WORK_DIR}/jpeg-unsupported.jpg")
execute_process(COMMAND "${ICV}" --input-trait color-space=rgb
  "${WORK_DIR}/jpeg-profile.jpg" "${WORK_DIR}/jpeg-conflict.png"
  RESULT_VARIABLE status ERROR_VARIABLE messages)
if(status EQUAL 0 OR EXISTS "${WORK_DIR}/jpeg-conflict.png")
  message(FATAL_ERROR "Contradictory JPEG input profile was not rejected before output: ${messages}")
endif()
execute_process(COMMAND "${ICV}" --output-trait bit-depth=12
  "${WORK_DIR}/input.unknown" "${WORK_DIR}/jpeg-unsupported.jpg"
  RESULT_VARIABLE status ERROR_VARIABLE messages)
if(status EQUAL 0 OR EXISTS "${WORK_DIR}/jpeg-unsupported.jpg")
  message(FATAL_ERROR "Unsupported JPEG output profile was not rejected before output: ${messages}")
endif()
convert(--output-trait bit-depth=64 "${WORK_DIR}/input.unknown" "${WORK_DIR}/raw-profile.dpix")
convert(--input-trait byte-order=big-endian "${WORK_DIR}/raw-profile.dpix" "${WORK_DIR}/raw-profile.png")
execute_process(COMMAND "${CODEC_TEST}" --stdin INPUT_FILE "${WORK_DIR}/raw-profile.png" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "DPIX profile round trip changed the pixel")
endif()
file(REMOVE "${WORK_DIR}/raw-conflict.dpix")
execute_process(COMMAND "${ICV}" --output-trait byte-order=little-endian
  "${WORK_DIR}/input.unknown" "${WORK_DIR}/raw-conflict.dpix"
  RESULT_VARIABLE status ERROR_VARIABLE messages)
if(status EQUAL 0 OR EXISTS "${WORK_DIR}/raw-conflict.dpix")
  message(FATAL_ERROR "Unsupported DPIX output profile was not rejected before output: ${messages}")
endif()
file(WRITE "${WORK_DIR}/ascii.ppm" "P3\n1 1\n65535\n65535 0 0\n")
convert(--input-trait encoding=ascii --input-trait ppm.maxval=65535
  "${WORK_DIR}/ascii.ppm" "${WORK_DIR}/ppm-profile.png")
file(REMOVE "${WORK_DIR}/ppm-conflict.png")
execute_process(COMMAND "${ICV}" --input-trait encoding=binary
  "${WORK_DIR}/ascii.ppm" "${WORK_DIR}/ppm-conflict.png"
  RESULT_VARIABLE status ERROR_VARIABLE messages)
if(status EQUAL 0 OR EXISTS "${WORK_DIR}/ppm-conflict.png")
  message(FATAL_ERROR "Contradictory PPM input profile was not rejected before output: ${messages}")
endif()
convert(info --plugin "${PLUGIN}" "${WORK_DIR}/plugin.unknown")
convert(diff --plugin "${PLUGIN}" "${WORK_DIR}/plugin.unknown" "${WORK_DIR}/input.unknown")
execute_process(COMMAND "${IMGDIFF}" --plugin "${PLUGIN}" "${WORK_DIR}/plugin.unknown" "${WORK_DIR}/input.unknown" RESULT_VARIABLE status ERROR_VARIABLE messages)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Image comparison caller migration failed: ${messages}")
endif()
execute_process(COMMAND "${ICV}" --plugin "${PLUGIN}" --list-formats RESULT_VARIABLE status ERROR_VARIABLE formats)
if(NOT status EQUAL 0 OR NOT formats MATCHES "image/vnd.example.codec2")
  message(FATAL_ERROR "Runtime codec listing failed: ${formats}")
endif()
execute_process(COMMAND "${ICV}" --plugin "${PLUGIN}" --identify "${WORK_DIR}/plugin.unknown" RESULT_VARIABLE status ERROR_VARIABLE identified)
if(NOT status EQUAL 0 OR NOT identified MATCHES "image/vnd.example.codec: signature")
  message(FATAL_ERROR "Image inspection failed: ${identified}")
endif()

execute_process(COMMAND "${CODEC_TEST}" --emit-header OUTPUT_FILE "${WORK_DIR}/header.png" RESULT_VARIABLE status)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Could not create header-only image")
endif()
execute_process(COMMAND "${ICV}" info "${WORK_DIR}/header.png" RESULT_VARIABLE status ERROR_VARIABLE properties)
if(NOT status EQUAL 0 OR NOT properties MATCHES "1x1")
  message(FATAL_ERROR "Header-only metadata inspection failed: ${properties}")
endif()
execute_process(COMMAND "${ICV}" info --decode "${WORK_DIR}/header.png" RESULT_VARIABLE status ERROR_VARIABLE messages)
if(status EQUAL 0)
  message(FATAL_ERROR "Header-only image unexpectedly decoded")
endif()

file(REMOVE "${WORK_DIR}/eight-bit.png" "${WORK_DIR}/sixteen-bit.png" "${WORK_DIR}/contradiction.png")
convert(--output-trait bit-depth=8 "${WORK_DIR}/input.unknown" "${WORK_DIR}/eight-bit.png")
execute_process(COMMAND "${ICV}" --output-trait bit-depth=16 "${WORK_DIR}/input.unknown" "${WORK_DIR}/sixteen-bit.png"
  RESULT_VARIABLE status ERROR_VARIABLE messages)
if(status EQUAL 0 OR EXISTS "${WORK_DIR}/sixteen-bit.png")
  message(FATAL_ERROR "Unsupported PNG sample depth was accepted: ${messages}")
endif()
execute_process(COMMAND "${ICV}" --input-trait bit-depth=16 "${WORK_DIR}/eight-bit.png" "${WORK_DIR}/contradiction.png"
  RESULT_VARIABLE status ERROR_VARIABLE messages)
if(status EQUAL 0 OR EXISTS "${WORK_DIR}/contradiction.png")
  message(FATAL_ERROR "PNG input depth assertion overrode observed properties: ${messages}")
endif()

convert(--output-format pix "${WORK_DIR}/input.unknown" "${WORK_DIR}/raw.payload")
convert(--input-format pix -w 1 -n 1 "${WORK_DIR}/raw.payload" "${WORK_DIR}/raw-roundtrip.png")

convert(--output-format pix "${WORK_DIR}/input.unknown" "${WORK_DIR}/red.pix")
execute_process(COMMAND "${ICV}" info "${WORK_DIR}/red.pix"
  RESULT_VARIABLE status ERROR_VARIABLE properties)
if(NOT status EQUAL 0 OR NOT properties MATCHES "image/vnd.brlcad.pix.*1x1")
  message(FATAL_ERROR "Contextual raw metadata selection failed: ${properties}")
endif()
convert(info --decode "${WORK_DIR}/red.pix")
convert(info --input-format pix "${WORK_DIR}/raw.payload")
execute_process(COMMAND "${ICV}" info --input-trait bit-depth=16 "${WORK_DIR}/eight-bit.png"
  RESULT_VARIABLE status ERROR_VARIABLE messages)
if(status EQUAL 0)
  message(FATAL_ERROR "Image info accepted contradictory trait assertion: ${messages}")
endif()

# A difference exits with status 1 even when writing succeeds, so verify
# actual output bytes and diagnostics rather than exit status alone.
file(WRITE "${WORK_DIR}/diff-red.ppm" "P3\n1 1\n255\n255 0 0\n")
file(WRITE "${WORK_DIR}/diff-green.ppm" "P3\n1 1\n255\n0 255 0\n")
file(MAKE_DIRECTORY "${WORK_DIR}/parent.v1")
function(difference output)
  file(REMOVE "${output}")
  execute_process(COMMAND "${ICV}" diff ${ARGN} -o "${output}"
    "${WORK_DIR}/diff-red.ppm" "${WORK_DIR}/diff-green.ppm"
    RESULT_VARIABLE status ERROR_VARIABLE messages)
  if(NOT status EQUAL 1 OR NOT EXISTS "${output}" OR messages MATCHES "cannot write difference image")
    message(FATAL_ERROR "Difference image output failed for ${output}: ${status}: ${messages}")
  endif()
endfunction()
difference("${WORK_DIR}/diff-control.pix" --output-format image/vnd.brlcad.pix)
file(READ "${WORK_DIR}/diff-control.pix" reference HEX)
string(LENGTH "${reference}" length)
# One RGB pixel in the fixed raw PIX layout.
if(NOT length EQUAL 6)
  message(FATAL_ERROR "Difference control did not contain one RGB pixel")
endif()
foreach(name diff-unassociated diff.unlisted-image-format parent.v1/frame diff.PIX)
  difference("${WORK_DIR}/${name}")
  file(READ "${WORK_DIR}/${name}" pixels HEX)
  if(NOT pixels STREQUAL reference)
    message(FATAL_ERROR "Difference output default changed for ${name}")
  endif()
endforeach()
execute_process(COMMAND "${ICV}" diff "${WORK_DIR}/diff-red.ppm" "${WORK_DIR}/diff-green.ppm"
  RESULT_VARIABLE status OUTPUT_FILE "${WORK_DIR}/diff-stdout.pix" ERROR_VARIABLE messages)
file(READ "${WORK_DIR}/diff-stdout.pix" pixels HEX)
if(NOT status EQUAL 1 OR NOT pixels STREQUAL reference OR messages MATCHES "cannot write difference image")
  message(FATAL_ERROR "Difference stdout lost its PIX default: ${messages}")
endif()
foreach(name diff.png diff-forced.payload diff.codecimg diff-alias.png)
  set(options)
  if(name STREQUAL "diff-forced.payload")
    list(APPEND options --output-format image/png)
  elseif(name STREQUAL "diff.codecimg")
    list(APPEND options --plugin "${PLUGIN}")
  elseif(name STREQUAL "diff-alias.png")
    list(APPEND options --plugin "${PLUGIN}" --output-format image/x-example-codec2)
  endif()
  difference("${WORK_DIR}/${name}" ${options})
  convert(--plugin "${PLUGIN}" --output-format image/vnd.brlcad.pix
    "${WORK_DIR}/${name}" "${WORK_DIR}/diff-decoded.pix")
  file(READ "${WORK_DIR}/diff-decoded.pix" pixels HEX)
  if(NOT pixels STREQUAL reference)
    message(FATAL_ERROR "Difference format selection changed the pixel: ${name}")
  endif()
endforeach()
foreach(extension tif avi)
  set(output "${WORK_DIR}/diff-unavailable.${extension}")
  foreach(existing FALSE TRUE)
    file(REMOVE "${output}")
    set(marker "Keep the existing difference destination")
    if(existing)
      file(WRITE "${output}" "${marker}")
    endif()
    execute_process(COMMAND "${ICV}" diff -o "${output}"
      "${WORK_DIR}/diff-red.ppm" "${WORK_DIR}/diff-green.ppm"
      RESULT_VARIABLE status ERROR_VARIABLE messages)
    if(NOT status EQUAL 1 OR NOT messages MATCHES "cannot write difference image")
      message(FATAL_ERROR "Unavailable difference writer was not diagnosed: ${status}: ${messages}")
    endif()
    if(existing)
      file(READ "${output}" retained)
      if(NOT retained STREQUAL marker)
        message(FATAL_ERROR "Rejected difference output changed the destination")
      endif()
    elseif(EXISTS "${output}")
      message(FATAL_ERROR "Rejected difference output created a destination")
    endif()
  endforeach()
endforeach()
