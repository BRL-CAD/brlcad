# Values set at CMake configure time
set(CBDIR "@CMAKE_CURRENT_BINARY_DIR@")
set(LOGFILE "${CBDIR}/regress-ged_lint_brep.log")

set(BU_DIR_CACHE ${CBDIR}/cache_lint_brep)
set(LIBRT_CACHE ${CBDIR}/rtcache_lint_brep)
set(ENV{BU_DIR_CACHE} ${BU_DIR_CACHE})
set(ENV{LIBRT_CACHE} ${LIBRT_CACHE})
file(REMOVE_RECURSE "${BU_DIR_CACHE}")
file(REMOVE_RECURSE "${LIBRT_CACHE}")
file(MAKE_DIRECTORY "${BU_DIR_CACHE}")
file(MAKE_DIRECTORY "${LIBRT_CACHE}")

set(TMPDIR "${CBDIR}/lint_brep_regress_tmp")
file(REMOVE_RECURSE "${TMPDIR}")
file(MAKE_DIRECTORY "${TMPDIR}")
file(WRITE "${LOGFILE}" "Starting B-Rep lint regression test run\n")

string(REPLACE "\\" "" LINT_BREP_EXEC "${EXEC}")
if(NOT EXISTS "${LINT_BREP_EXEC}")
  file(READ "${LOGFILE}" LOG)
  message(FATAL_ERROR "B-Rep lint regression program not found.\n${LOG}")
endif(NOT EXISTS "${LINT_BREP_EXEC}")

execute_process(
  COMMAND "${LINT_BREP_EXEC}"
  RESULT_VARIABLE lint_brep_result
  OUTPUT_VARIABLE lint_brep_log
  ERROR_VARIABLE lint_brep_log
  WORKING_DIRECTORY "${TMPDIR}"
)
file(APPEND "${LOGFILE}" "${lint_brep_log}")
if(lint_brep_result)
  file(READ "${LOGFILE}" LOG)
  message(FATAL_ERROR "[regress-ged_lint_brep] Failure: ${lint_brep_result}.\n${LOG}")
endif(lint_brep_result)

file(REMOVE_RECURSE "${TMPDIR}")
execute_process(COMMAND "@CMAKE_COMMAND@" -E rm -rf "${BU_DIR_CACHE}")
execute_process(COMMAND "@CMAKE_COMMAND@" -E rm -rf "${LIBRT_CACHE}")

