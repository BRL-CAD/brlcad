set(WORK "@CMAKE_CURRENT_BINARY_DIR@/display-output")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
function(run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE output TIMEOUT 30)
  file(APPEND "${WORK}/display.log" "${ARGV}\n${output}\n")
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Command failed (${result}): ${ARGV}\n${output}")
  endif()
endfunction()
run("${VEXEC}" create "${WORK}/scene.g")
foreach(dimensions IN ITEMS "37;35" "65;49" "61;91" "513;35")
  list(GET dimensions 0 width)
  list(GET dimensions 1 height)
  foreach(workers IN ITEMS 1 2)
    set(stem "${WORK}/${width}-${height}-${workers}")
    run("${EXEC}" -a 270 -e 20 -P ${workers} -c "set samples=4"
      -w ${width} -n ${height} -F "${stem}.fb" -o "${stem}.png" "${WORK}/scene.g" all.g)
    set(fb_width 512)
    if(width GREATER fb_width)
      set(fb_width ${width})
    endif()
    run("${FEXEC}" "${stem}.fb" "${stem}.png" ${width} ${height} ${fb_width} 512)
  endforeach()
endforeach()
# Reopening a device for a second saved-view frame must retain valid ownership.
set(stream "${WORK}/frames.view")
file(WRITE "${stream}" "start 0; end;\nstart 1; end;\n")
execute_process(COMMAND "${EXEC}" -M -a 270 -e 20 -P 2 -c "set samples=4"
  -w 65 -n 49 -F "${WORK}/frames.fb" -o "${WORK}/frames.png" "${WORK}/scene.g" all.g
  INPUT_FILE "${stream}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE output TIMEOUT 30)
if(NOT "${result}" STREQUAL "0")
  message(FATAL_ERROR "Saved-view framebuffer failed: ${result}\n${output}")
endif()
run("${FEXEC}" "${WORK}/frames.fb" "${WORK}/frames.png" 65 49 512 512)

# Device failures must not replace an existing image.
file(MAKE_DIRECTORY "${WORK}/unwritable.fb")
foreach(device IN ITEMS "${WORK}/missing/device.fb" "${WORK}/unwritable.fb")
  set(blocked "${WORK}/blocked.png")
  set(sentinel "preserve existing output")
  file(WRITE "${blocked}" "${sentinel}")
  execute_process(COMMAND "${EXEC}" -w 37 -n 35 -P 2
    -F "${device}" -o "${blocked}" "${WORK}/scene.g" all.g
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE output TIMEOUT 30)
  if("${result}" STREQUAL "0" OR NOT "${result}" MATCHES "^[0-9]+$" OR
      NOT output MATCHES "art: (cannot open framebuffer|could not write framebuffer|could not flush framebuffer)")
    message(FATAL_ERROR "Expected a regular framebuffer error exit: ${result}\n${output}")
  endif()
  file(READ "${blocked}" retained)
  if(NOT retained STREQUAL sentinel)
    message(FATAL_ERROR "Framebuffer failure replaced existing image output")
  endif()
endforeach()
