set(INPUT_FILE "@CMAKE_CURRENT_SOURCE_DIR@/../tetra.g")
set(TEST_DIR "@CMAKE_CURRENT_BINARY_DIR@")
string(REPLACE "\\" "" GCV_EXEC "${EXEC}")

function(export_pbrt destination)
  execute_process(COMMAND "${GCV_EXEC}" --input-format=g --output-format=assetimport
    "${INPUT_FILE}" "${destination}" -O --format pbrt
    WORKING_DIRECTORY "${TEST_DIR}"
    RESULT_VARIABLE export_status OUTPUT_VARIABLE export_messages ERROR_VARIABLE export_messages)
  set(status "${export_status}" PARENT_SCOPE)
  set(messages "${export_messages}" PARENT_SCOPE)
endfunction()

file(REMOVE "${TEST_DIR}/scene.pbrt" "${TEST_DIR}/relative.pbrt"
  "${TEST_DIR}/invalid.payload" "${TEST_DIR}/invalid.pbrt")
foreach(destination IN ITEMS "${TEST_DIR}/scene.pbrt" "relative.pbrt")
  export_pbrt("${destination}")
  if(messages MATCHES "Non-supported file format [(]pbrt[)]")
    message(STATUS "PBRT exporter unavailable in this SDK build")
    return()
  endif()
  get_filename_component(output_file "${destination}" ABSOLUTE BASE_DIR "${TEST_DIR}")
  if(NOT status EQUAL 0 OR NOT EXISTS "${output_file}")
    message(FATAL_ERROR "PBRT export to ${destination} failed (${status}): ${messages}")
  endif()
  file(READ "${output_file}" scene)
  if(NOT scene MATCHES "WorldBegin" OR NOT scene MATCHES "trianglemesh")
    message(FATAL_ERROR "PBRT export did not contain scene geometry")
  endif()
endforeach()

export_pbrt("${TEST_DIR}/invalid.payload")
if(status EQUAL 0 OR EXISTS "${TEST_DIR}/invalid.payload" OR EXISTS "${TEST_DIR}/invalid.pbrt")
  message(FATAL_ERROR "PBRT export changed the requested filename: ${messages}")
endif()
file(REMOVE "${TEST_DIR}/scene.pbrt" "${TEST_DIR}/relative.pbrt")
