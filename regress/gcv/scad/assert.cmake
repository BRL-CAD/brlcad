file(MAKE_DIRECTORY "${WORK_DIR}")
foreach(condition true false)
  set(input "${WORK_DIR}/assert-${condition}.scad")
  set(output "${WORK_DIR}/assert-${condition}.g")
  file(WRITE "${input}" "cube(1); assert(${condition}); cube(2);\n")
  file(REMOVE "${output}")
  execute_process(COMMAND "${GCV}" --input-format=scad "${input}" "${output}"
    RESULT_VARIABLE status OUTPUT_VARIABLE text ERROR_VARIABLE messages)
  if(condition STREQUAL "true")
    if(NOT status EQUAL 0 OR NOT EXISTS "${output}")
      message(FATAL_ERROR "A successful assertion prevented conversion: ${text}\n${messages}")
    endif()
  elseif(status EQUAL 0 OR EXISTS "${output}")
    message(FATAL_ERROR "A failed assertion produced successful conversion output: ${text}\n${messages}")
  endif()
endforeach()
