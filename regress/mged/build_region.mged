puts "*** Testing 'build_region' command ***"

batch_insert build_region epa .s 0 15 1

set command_set [::brlcad::mged::regression::hide_compatibility_commands {
    adjust exists expand get put regdef
}]
try {
    build_region build_region_epa 0 15
    build_region -a 42 build_region_epa 5 8
} finally {
    ::brlcad::mged::regression::restore_compatibility_commands $command_set
}
unset command_set

puts "*** 'build_region' testing completed ***"
