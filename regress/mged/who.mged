puts "*** Testing 'who' command ***"

Z
in_sph who 1
in_sph who 2
comb who.c u who_sph1.s u who_sph2.s
e who_sph1.s
e who.c
who
d who.c
d who_sph1.s

in_sph order_first 1
in_sph order_second 2
e order_second.s
e order_first.s
set forward_order [who]
Z
e order_first.s
e order_second.s
set reverse_order [who]
if {$forward_order ne $reverse_order} {
    puts "FAIL who ordering differs: '$forward_order' != '$reverse_order'"
    exit 1
}

puts "*** 'who' testing completed ***"
