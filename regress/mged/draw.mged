puts "*** Testing 'draw' command ***"

Z
in_sph draw 1
comb draw.c u draw_sph1.s
e draw.c
who
e draw_sph1.s
who
erase draw.c
erase draw_sph1.s

# Attribute-selected names must survive the internal argv reconstruction.
set draw_attr_names [list {draw space.s} {draw"quote.s} {draw\slash.s}]
foreach name $draw_attr_names {
    in $name sph 0 0 0 1
    set pattern [string map [list "\\" "\\\\"] $name]
    attr set $pattern draw_attr_regress yes
}
set draw_attr_output ""
proc draw_attr_capture {text} {
    append ::draw_attr_output $text
}
output_hook draw_attr_capture
set draw_attr_status [catch {draw -A draw_attr_regress yes} draw_attr_result]
output_hook
if {$draw_attr_status || [string first "failed" $draw_attr_output] >= 0} {
    error "FAIL: attribute-selected drawing: $draw_attr_result $draw_attr_output"
}
# Display-list paths use absolute paths with escaped component separators.
foreach name $draw_attr_names path [list {/draw space.s} {/draw"quote.s} {/draw\\slash.s}] {
    if {[string first $path [who]] < 0} {
	error "FAIL: attribute-selected drawing omitted '$name'"
    }
}
erase -A draw_attr_regress yes
if {[who] ne ""} {
    error "FAIL: attribute-selected erasing left objects displayed: [who]"
}

if {[catch {shaded_mode -a 2} msg]} {
    puts stderr "shaded_mode -a failed: $msg"
    exit 1
}

puts "*** 'draw' testing completed ***"
