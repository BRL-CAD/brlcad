puts "*** Testing 'bot_vertex_fuse_all' command ***"

set object namespace_fuse.s
::brlcad::mged put $object bot mode surface orient no flags {} V {
    {0 0 0} {10 0 0} {0 10 0} {0 0 0}
} F {
    {0 1 2} {3 1 2}
}

set command_set [::brlcad::mged::regression::hide_compatibility_commands {
    bot_vertex_fuse kill l mv search
}]
try {
    bot_vertex_fuse_all
} finally {
    ::brlcad::mged::regression::restore_compatibility_commands $command_set
}
unset command_set

if {![::brlcad::mged exists $object]} {
    error "FAIL bot_vertex_fuse_all removed $object"
}
set vertices [::brlcad::mged get $object V]
if {[llength $vertices] != 3} {
    error "FAIL bot_vertex_fuse_all left [llength $vertices] vertices: $vertices"
}

puts "PASS bot_vertex_fuse_all namespaced commands"
puts "*** 'bot_vertex_fuse_all' testing completed ***"
