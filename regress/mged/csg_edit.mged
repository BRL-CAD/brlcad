} [list csg_edit_point_at V0 {5 5 0}]
csg_mouse_case csg_mouse_pipe_topology.s {{Split Segment}} "mouse split segment" {
    {csg_edit_prepare_mouse_view}
    {press {Select Point}}
    {p 0 0 0}
    {press {Split Segment}}
    {M 1 512 512}
} [list csg_edit_point_at V1 {5 5 0}]
foreach {item attribute initial} {
    {Set Point OD} O0 5
    {Set Point ID} I0 3
    {Set Point Bend} R0 6
} {
    csg_mouse_case csg_lifecycle_pipe.s [list $item] "mouse $item" [list \
        {csg_edit_prepare_mouse_view} \
        {press {Select Point}} {p 0 0 0} [list press $item] \
        {M 1 0 -1024}] \
        [list csg_edit_scalar_at $attribute [expr {$initial * $csg_special_mouse_shrink}]]
}
foreach {item attributes initial} {
    {Set Pipe OD} {O0 O1 O2 O3} {5 5 6 6}
    {Set Pipe ID} {I0 I1 I2 I3} {3 3 2 0}
    {Set Pipe Bend} {R0 R1 R2 R3} {6 7 10 8}
} {
    set expected {}
    foreach value $initial {
        lappend expected [expr {$value * $csg_special_mouse_shrink}]
    }
    csg_mouse_case csg_lifecycle_pipe.s [list $item] "mouse $item" [list \
        {csg_edit_prepare_mouse_view} \
        [list press $item] {M 1 0 -1024}] \
        [list csg_edit_scalar_values_at $attributes $expected]
}
proc csg_edit_bot_vertices_moved {source moved delta prim} {
    set vertices [db get $source V]
    for {set index 0} {$index < [llength $vertices]} {incr index} {
        set expected [lindex $vertices $index]
        if {[lsearch -exact $moved $index] >= 0} {
            set translated {}
            foreach value $expected shift $delta {
                lappend translated [expr {$value + $shift}]
            }
            set expected $translated
        }
        csg_edit_list_value_at V $index $expected $prim
    }
}
