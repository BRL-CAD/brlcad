        [list csg_edit_matrix_component_at stom $index $csg_special_mouse_scale]
}
foreach type {arbn brep} {
    set source csg_lifecycle_${type}.s
    csg_edit_sequence_check $source "generic mouse translation" {
        {csg_edit_prepare_mouse_view}
        {keypoint 0 0 0}
        {press sxy}
        {M 1 512 512}
    } [list csg_edit_bbox_translated $source $csg_special_mouse_target]
}

# Every specialized menu entry must be accounted for.  Exclusions are menu
# headings, non-positional actions/settings, or the BOT triangle picker (tested
# under Xmin because it needs Tk).  A new entry without a mouse case or
# explicit exclusion fails here.
foreach {source ignored} {
    csg_lifecycle_pipe.s {
        {PIPE MENU} {Next Point} {Previous Point} {Delete Point}
    }
    csg_lifecycle_bot.s {
        {BOT MENU} {Pick Triangle} {Move Vertex List}
        {Split Edge} {Split Face} {Fuse Vertices} {Fuse Faces}
        {Delete Triangle} {Select Mode} {Select Orientation}
        {Set flags} {Set Face Thickness} {Set Face Mode}
    }
    csg_lifecycle_dsp.s {
        {DSP MENU} Name {Toggle Smooth} {Set Data Source}
    }
    csg_lifecycle_ebm.s {
        {EBM MENU} {File Name} {File Size (W N)}
    }
    csg_lifecycle_vol.s {
        {VOL MENU} {File Name} {File Size (X Y Z)}
    }
    csg_lifecycle_arbn.s {}
    csg_lifecycle_brep.s {}
} {
    csg_edit_menu_inventory_check $source $ignored
}

# A view-space request must remain view-space even when the editor's current
# coordinate system is object-relative.  This is the fast path underlying the
# corresponding real mouse drag in the Xmin GUI test.
set csg_saved_coords [rset var coords]
set csg_saved_transform [rset var transform]
if {[catch {
    Z
    e csg_lifecycle_bot.s
    sed csg_lifecycle_bot.s
    center 0 0 0
    rset var coords o
    rset var transform v
    knob -i -v aX 1
    if {[csg_edit_point_distance [center] {-1 0 0}] > 0.000001} {
        error "explicit view knob left center at [center]"
    }
} csg_view_override_error]} {
    puts "  FAIL: view-space translation with object coordinates ($csg_view_override_error)"
} else {
    puts "  PASS: view-space translation with object coordinates"
}
catch {press reject}
catch {Z}
rset var coords $csg_saved_coords
rset var transform $csg_saved_transform

file delete -force $csg_data_file
file delete -force $csg_dsp_file

puts "PASS: broad MGED CSG edit coverage completed"
puts "*** Broad MGED CSG edit integration testing completed ***"
