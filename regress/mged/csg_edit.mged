puts "--- Specialized mouse editing and menu inventory ---"
proc csg_edit_prepare_mouse_view {} {
    global csg_dispatch_view_size
    center 0 0 0
    size $csg_dispatch_view_size
    setview 0 0 0
}
array set csg_mouse_covered {}
proc csg_mouse_case {source menu_items label commands validator} {
    global csg_mouse_covered
    csg_edit_sequence_check $source $label $commands $validator
    set type [lindex [db get $source] 0]
    if {![info exists csg_mouse_covered($type)]} {
        set csg_mouse_covered($type) {}
    }
    foreach item $menu_items {
        if {[lsearch -exact $csg_mouse_covered($type) $item] < 0} {
            lappend csg_mouse_covered($type) $item
        }
    }
}
proc csg_edit_menu_inventory_check {source ignored} {
    global csg_mouse_covered
    if {[catch {
        Z
        e $source
        sed $source
        set actual [mmenu_get 0]
        set type [lindex [db get $source] 0]
        set covered {}
        if {[info exists csg_mouse_covered($type)]} {
            set covered $csg_mouse_covered($type)
        }
        foreach item $actual {
            set tested [expr {[lsearch -exact $covered $item] >= 0}]
            set exempt [expr {[lsearch -exact $ignored $item] >= 0}]
            if {$tested == $exempt} {
                error "menu entry '$item' needs exactly one mouse-test or exclusion"
            }
        }
        foreach item [concat $covered $ignored] {
            if {[lsearch -exact $actual $item] < 0} {
                error "recorded menu entry '$item' is absent from $actual"
            }
        }
        press reject
        d $source
    } failure]} {
        puts "  FAIL: menu inventory $source ($failure)"
        catch {press reject}
        catch {Z}
    } else {
        puts "  PASS: menu inventory $source"
    }
}

csg_edit_prepare_mouse_view
set csg_special_mouse_target [list \
    [expr {512.0 / $csg_bv_coord_half_range * $csg_dispatch_view_size / 2.0}] \
    [expr {512.0 / $csg_bv_coord_half_range * $csg_dispatch_view_size / 2.0}] 0]
set csg_special_mouse_scale [expr {1.0 + 2047.0 / ($csg_bv_coord_half_range * 4.0)}]
set csg_special_mouse_shrink [expr {
    1.0 / (1.0 + 1024.0 / ($csg_bv_coord_half_range * 4.0))}]
csg_mouse_case csg_lifecycle_pipe.s {{Move Point}} "mouse select and move point" {
    {csg_edit_prepare_mouse_view}
    {press {Select Point}}
    {p 0 0 0}
    {press {Move Point}}
    {M 1 512 512}
} [list csg_edit_point_at V0 $csg_special_mouse_target]
in csg_mouse_pipe_topology.s pipe 4 \
    0 0 0 1 2 3 \
    0 0 30 1 2 3 \
    30 40 80 1 2 3 \
    80 80 100 1 2 3
