cmake_minimum_required(VERSION 3.22)
project(art_osl_sdk LANGUAGES CXX)
find_package(OSL CONFIG REQUIRED)
file(REAL_PATH "@renderer_prefix@" sdk_prefix)
foreach(name IN ITEMS oslcomp oslquery oslexec oslnoise)
  get_target_property(includes OSL::${name} INTERFACE_INCLUDE_DIRECTORIES)
  foreach(path IN LISTS includes)
    file(REAL_PATH "${path}" real_include)
    cmake_path(IS_PREFIX sdk_prefix "${real_include}" NORMALIZE inside)
    if(NOT inside OR NOT IS_DIRECTORY "${real_include}")
      message(FATAL_ERROR "OSL header path escapes installed SDK: ${name}: ${path}")
    endif()
  endforeach()
endforeach()
add_executable(art_osl_sdk "@CMAKE_CURRENT_SOURCE_DIR@/art_osl_sdk.cpp")
target_link_libraries(art_osl_sdk PRIVATE
  OSL::oslcomp OSL::oslquery OSL::oslexec OSL::oslnoise)
enable_testing()
add_test(NAME art-osl-sdk-execute COMMAND art_osl_sdk "@ART_OSL_SHADER_INCLUDE_DIR@/stdosl.h")
if(WIN32)
  set_tests_properties(art-osl-sdk-execute PROPERTIES
    ENVIRONMENT_MODIFICATION "PATH=path_list_prepend:@renderer_prefix@/bin")
endif()
