// Count only camera evaluations: emission queries execute the shader again.
surface art_sampling(int in_varying = 0)
{
    if (raytype("camera"))
        printf("art_sampling_evaluation\n");
    color value = in_varying ? color(u * u, v * v, u * v) : color(0.25, 0.5, 0.75);
    Ci = value * emission();
}
