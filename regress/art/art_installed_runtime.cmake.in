cmake_minimum_required(VERSION 3.22)
set(prefix "@renderer_prefix@")
set(programs art oslc maketx oiiotool)
if(EXISTS "${prefix}/bin/mged")
  list(APPEND programs mged)
endif()
set(objects)
foreach(program IN LISTS programs)
  list(APPEND objects "${prefix}/bin/${program}")
endforeach()
set(plugin "${prefix}/@LIBEXEC_DIR@/ged/libged-bot.so")
if(EXISTS "${plugin}")
  list(APPEND objects "${plugin}")
endif()

function(audit_runtime_path object)
  execute_process(COMMAND "@ART_READELF_EXECUTABLE@" -d "${object}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
  file(APPEND "@CMAKE_CURRENT_BINARY_DIR@/runtime-paths.log" "${object}\n${output}\n${errors}\n")
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot inspect installed runtime paths: ${object}\n${errors}")
  endif()
  string(REGEX MATCHALL "\\((RPATH|RUNPATH)\\)[^\n]*" records "${output}")
  get_filename_component(directory "${object}" DIRECTORY)
  foreach(record IN LISTS records)
    if(NOT record MATCHES "\\[([^]]*)\\]")
      message(FATAL_ERROR "Unrecognized installed runtime path: ${object}: ${record}")
    endif()
    set(runtime_path "${CMAKE_MATCH_1}")
    if(runtime_path STREQUAL "" OR runtime_path MATCHES "^:|::|:$")
      message(FATAL_ERROR "Empty runtime path entry in ${object}")
    endif()
    string(REPLACE ":" ";" entries "${runtime_path}")
    foreach(entry IN LISTS entries)
      if(NOT entry MATCHES "^[$]ORIGIN(/.*)?$")
        message(FATAL_ERROR "Nonrelative installed runtime path in ${object}: ${entry}")
      endif()
      string(REPLACE "$ORIGIN" "${directory}" destination "${entry}")
      file(REAL_PATH "${destination}" destination)
      string(FIND "${destination}/" "${prefix}/" offset)
      if(NOT offset EQUAL 0)
        message(FATAL_ERROR "Runtime path escapes installed prefix in ${object}: ${entry}")
      endif()
    endforeach()
  endforeach()
endfunction()

file(WRITE "@CMAKE_CURRENT_BINARY_DIR@/runtime-paths.log" "")
set(audited)
foreach(object IN LISTS objects)
  get_filename_component(program "${object}" NAME)
  execute_process(COMMAND "@ART_LDD_EXECUTABLE@" "${object}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors)
  file(WRITE "@CMAKE_CURRENT_BINARY_DIR@/runtime-${program}.log" "${output}\n${errors}")
  if(NOT result EQUAL 0 OR output MATCHES "not found|=>[ \t]+None")
    message(FATAL_ERROR "Cannot resolve installed ${program} libraries\n${output}\n${errors}")
  endif()
  if(output MATCHES "libboost_")
    message(FATAL_ERROR "Installed ${program} still loads Boost\n${output}")
  endif()
  string(REGEX MATCHALL "[^\n]+ => [^\n]+" dependencies "${output}")
  list(APPEND audited "${object}")
  set(resolved 0)
  foreach(line IN LISTS dependencies)
    if(NOT line MATCHES " => (/[^\n]+) \\(0x[0-9a-fA-F]+\\)")
      message(FATAL_ERROR "Unrecognized runtime dependency for ${program}: ${line}")
    endif()
    file(REAL_PATH "${CMAKE_MATCH_1}" dependency)
    set(allowed FALSE)
    foreach(root IN ITEMS "${prefix}/" /lib/ /lib64/ /usr/lib/ /usr/lib64/)
      string(FIND "${dependency}" "${root}" offset)
      if(offset EQUAL 0)
        set(allowed TRUE)
        break()
      endif()
    endforeach()
    if(NOT allowed)
      message(FATAL_ERROR "Installed ${program} loads a library outside the installation and base system: ${dependency}")
    endif()
    string(FIND "${dependency}" "${prefix}/" offset)
    if(offset EQUAL 0)
      list(APPEND audited "${dependency}")
    endif()
    math(EXPR resolved "${resolved} + 1")
  endforeach()
  if(resolved EQUAL 0)
    message(FATAL_ERROR "No dynamic library dependencies were inspected for ${program}")
  endif()
endforeach()
list(REMOVE_DUPLICATES audited)
foreach(object IN LISTS audited)
  audit_runtime_path("${object}")
endforeach()
list(LENGTH audited count)
message(STATUS "Audited ${count} installed executables, plugins, and libraries")
