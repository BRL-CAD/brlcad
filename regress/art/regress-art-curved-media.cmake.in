cmake_minimum_required(VERSION 3.22)
set(WORK "@CMAKE_CURRENT_BINARY_DIR@/curved-media-output")
set(LOG "${WORK}/art.log")
set(TOOL "@ART_OIIOTOOL_EXECUTABLE@")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_curved_test_commands.cmake")
foreach(shape IN ITEMS sphere ellipsoid)
  create_curved_pair("${shape}")
  foreach(profile IN ITEMS equal clear absorbing)
    set_nested_profile("${profile}" outer inner)
    foreach(location IN ITEMS outside glass inner)
      if(location STREQUAL "outside")
        set(z 12)
      elseif(location STREQUAL "glass")
        set(z "${CURVED_GLASS_Z}")
      else()
        set(z 0)
      endif()
      foreach(tilt orientation IN ZIP_LISTS CURVED_TILTS CURVED_ORIENTATIONS)
        if(tilt GREATER 10)
          continue()
        endif()
        set(stem "${WORK}/${shape}-${profile}-${location}-${tilt}")
        set(reference "${stem}-reference.exr")
        render_curved("${reference}" "${REFERENCE_DB}" "${z}" "${orientation}"
          curved.outer.r curved.inner.r target.r)
        check_curved_reference("${reference}")
        foreach(variant IN ITEMS overlap shell_first filling_first)
          if(variant STREQUAL "overlap")
            set(objects curved.outer.r curved.inner.r)
          elseif(variant STREQUAL "shell_first")
            set(objects curved.shell.r curved.inner.r)
          else()
            set(objects curved.inner.r curved.shell.r)
          endif()
          set(image "${stem}-${variant}.exr")
          render_curved("${image}" "${ACTUAL_DB}" "${z}" "${orientation}" ${objects} target.r)
          compare_optical_transport("${image}" "${reference}")
        endforeach()
      endforeach()
    endforeach()
  endforeach()
endforeach()
