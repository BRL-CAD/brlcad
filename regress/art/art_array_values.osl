shader art_array_values(
    float in_unsized[] = {0},
    output float out_uv[2] = {0, 0},
    output float out_three[3] = {0, 0, 0},
    output int out_ints[2] = {0, 0},
    output float out_scalar = 0)
{
    out_uv[0] = u;
    out_uv[1] = v;
    out_scalar = u;
}
