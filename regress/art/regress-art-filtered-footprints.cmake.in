set(WORK "@CMAKE_CURRENT_BINARY_DIR@/filtered-footprints-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders" "${WORK}/cache")
set(ENV{BU_DIR_CACHE} "${WORK}/cache")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_footprint_test_commands.cmake")
foreach(shader IN ITEMS art_glass_footprint_field art_glass_footprint_reference)
  configure_file("@CMAKE_CURRENT_BINARY_DIR@/${shader}.oso" "${WORK}/shaders/${shader}.oso" COPYONLY)
endforeach()
set(TOOL "@ART_OIIOTOOL_EXECUTABLE@")
set(ACTUAL_DB "${WORK}/actual.g")
set(REFERENCE_DB "${WORK}/reference.g")
set(SIZE 16)
# Bound every pixel so an isolated discontinuity cannot hide in the mean.
# The shared comparison adds one binary16 relative step separately.
set(TOLERANCE 0.0001)
set(RENDER_ARGS -P 1 -c "viewsize 0.5" -c "orientation 0 0 0 1"
  -c "set sampling=uniform samples=1 max_bounces=16 max_specular_bounces=16 rr_min_path_length=0 light_intensity=0 environment_intensity=0 background_color=black")
run("${TOOL}" --pattern checker:width=4:height=4 1024x1024 3 -d float -o "${WORK}/texture.tif")
run("@ART_MAKETX_EXECUTABLE@" -d float --filter box --wrap periodic
  -o "${WORK}/texture.tx" "${WORK}/texture.tif")
run("${VEXEC}" create-material "${ACTUAL_DB}" as_glass)
run("${VEXEC}" create-material "${REFERENCE_DB}" art_glass_footprint_reference)
create_footprint_receivers()
foreach(parameter IN ITEMS "OSL.version;2" "OSL.param.in_roughness;float 0"
    "OSL.param.in_ior;float 1.5" "OSL.param.in_transmittance_amount;float 1"
    "OSL.param.in_surface_transmittance;color 1 1 1" "OSL.param.in_volume_transmittance_distance;float 0")
  list(GET parameter 0 name)
  list(GET parameter 1 value)
  run("${VEXEC}" set-material "${ACTUAL_DB}" "${name}" "${value}")
endforeach()
set_footprint_reference(mode "int 2")
set_footprint_reference(filename "string texture.tx")
foreach(db IN ITEMS "${ACTUAL_DB}" "${REFERENCE_DB}")
  run("${VEXEC}" set-named-material "${db}" receiver.material OSL.param.in_mode "int 2")
  run("${VEXEC}" set-named-material "${db}" receiver.material OSL.param.in_filename "string texture.tx")
endforeach()
run("${TOOL}" --pattern constant:color=0,0,0 ${SIZE}x${SIZE} 3 -o "${WORK}/black.exr")
foreach(shape IN ITEMS cube mesh)
  foreach(reflection IN ITEMS 0 1)
    set(reflection_tint "0 0 0")
    set(refraction_tint "1 1 1")
    set(target receiver.r)
    if(reflection)
      set(reflection_tint "1 1 1")
      set(refraction_tint "0 0 0")
      set(target front.r)
    endif()
    run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.param.in_reflection_tint "color ${reflection_tint}")
    run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.param.in_refraction_tint "color ${refraction_tint}")
    set_footprint_reference(reflection "int ${reflection}")
    foreach(mapping IN ITEMS direct bump)
      set_footprint_mapping("${mapping}" "0 0 0" ${reflection} 0 in_bump_normal)
      foreach(projection IN ITEMS 0 2)
        set(label "${shape}-${reflection}-${mapping}-${projection}")
        compare_footprint_paths("${label}" ${SIZE} ${projection} 2 "${shape}" "${target}" 2 0)
      endforeach()
    endforeach()
  endforeach()
endforeach()
