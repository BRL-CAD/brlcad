surface art_mirror_mixture(color in_color = color(0.5), float in_weight = 0.5)
{
    // Distinct normals prevent the optimizer from combining the closures.
    // Tilting toward the view keeps both reflections outside a convex solid.
    normal tilted = normalize(N - 0.2 * normalize(I));
    Ci = in_color * (in_weight * reflection(N) +
        (1 - in_weight) * reflection(tilted));
}
