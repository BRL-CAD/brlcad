set(WORK "@CMAKE_CURRENT_BINARY_DIR@/progress-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders" "${WORK}/cache")
set(ENV{BU_DIR_CACHE} "${WORK}/cache")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
configure_file("@CMAKE_CURRENT_BINARY_DIR@/art_emission.oso"
  "${WORK}/shaders/art_emission.oso" COPYONLY)
set(DB "${WORK}/scene.g")
run("${VEXEC}" create-material "${DB}" art_emission)
set(RENDER_ARGS -P 2 -w 37 -n 35 -c "set samples=4"
  -c "viewsize 80" -c "eye_pt 0 0 40" -c "orientation 0 0 0 1")

foreach(workers IN ITEMS 1 2)
  run_command("${CMAKE_CURRENT_BINARY_DIR}" FALSE "${EXEC}" ${RENDER_ARGS} -P ${workers}
    -o "${WORK}/default-${workers}.png" "${DB}" all.g)
  if(NOT command_output MATCHES "art: frame 0 rendering" OR
      NOT command_output MATCHES "art: frame 0 complete: 4/4 tiles [(]100%[)]")
    message(FATAL_ERROR "Default rendering did not report complete tile progress: ${workers} workers")
  endif()
endforeach()
foreach(mode IN ITEMS "progress=0" "progress=1 progress=!")
  run_command("${CMAKE_CURRENT_BINARY_DIR}" FALSE "${EXEC}" ${RENDER_ARGS} -c "set ${mode}" -o "${WORK}/quiet.png" "${DB}" all.g)
  if(command_output MATCHES "art: frame [0-9]+ (rendering|progress|complete)")
    message(FATAL_ERROR "Disabled progress still reported frame status")
  endif()
  run("${VEXEC}" check-matching-image "${WORK}/quiet.png" "${WORK}/default-2.png" 37 35)
endforeach()

# Each frame retains settings until changed, and counts partial tiles anew.
set(stream "${WORK}/frames.view")
file(WRITE "${stream}" "start 7; set progress=1; end;\n"
  "start 8; set progress=0; end;\nstart 9; clean; set progress=!; end;\n")
run_command("${CMAKE_CURRENT_BINARY_DIR}" FALSE INPUT_FILE "${stream}" "${EXEC}" ${RENDER_ARGS} -M -o "${WORK}/frames.png" "${DB}" all.g)
foreach(frame IN ITEMS 7 9)
  if(NOT command_output MATCHES "art: frame ${frame} complete: 4/4 tiles [(]100%[)]")
    message(FATAL_ERROR "Missing per-frame progress: ${frame}")
  endif()
endforeach()
if(command_output MATCHES "art: frame 8 (rendering|progress|complete)")
  message(FATAL_ERROR "Quiet saved-view frame reported progress")
endif()
foreach(frame IN ITEMS 7 8 9)
  run("${VEXEC}" check-matching-image "${WORK}/frames.${frame}.png" "${WORK}/default-2.png" 37 35)
endforeach()
run_command("${CMAKE_CURRENT_BINARY_DIR}" FALSE "${EXEC}" -h)
if(NOT command_output MATCHES "-F framebuffer")
  message(FATAL_ERROR "The supported framebuffer option is absent from help")
endif()
