set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders" "${WORK}/cache")
set(ENV{BU_DIR_CACHE} "${WORK}/cache")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_nested_test_commands.cmake")
foreach(shader IN ITEMS art_diffuse art_glass_lighting_reference)
  configure_file("@CMAKE_CURRENT_BINARY_DIR@/${shader}.oso" "${WORK}/shaders/${shader}.oso" COPYONLY)
endforeach()
configure_file("@CMAKE_CURRENT_SOURCE_DIR@/art_rough_box.obj" "${WORK}/art_rough_box.obj" COPYONLY)
set(TOOL "@ART_OIIOTOOL_EXECUTABLE@")
set(NATIVE_RENDERER "@ART_APPLESEED_CLI_EXECUTABLE@")
get_filename_component(REFERENCE_SHADER_PATH "@ART_OSL_HELPER_INCLUDE_DIR@" DIRECTORY)
string(APPEND REFERENCE_SHADER_PATH "/appleseed")
string(REPLACE "&" "&amp;" REFERENCE_SHADER_PATH "${REFERENCE_SHADER_PATH}")
string(REPLACE "<" "&lt;" REFERENCE_SHADER_PATH "${REFERENCE_SHADER_PATH}")
string(REPLACE ">" "&gt;" REFERENCE_SHADER_PATH "${REFERENCE_SHADER_PATH}")
set(ACTUAL_DB "${WORK}/actual.g")
set(REFERENCE_DB "${WORK}/reference.g")
run("${VEXEC}" create-lit-glass "${ACTUAL_DB}")
configure_file("${ACTUAL_DB}" "${REFERENCE_DB}" COPYONLY)
run("${VEXEC}" set-named-material "${REFERENCE_DB}" receiver.material OSL art_glass_lighting_reference)
set(SIZE 16)
set(SAMPLES 1024)
if(CAUSTIC_TEST STREQUAL "state")
  # Four frames share one command timeout; this test checks setting lifetime.
  set(SAMPLES 256)
endif()
set(WORKERS 2)
set(SURFACE_BOUNCES 64)
set(ENVIRONMENT_POWER 0.4)
set(RECEIVER_COLOR "0.25 0.5 0.75")
set(VOLUME_COLOR "0.25 0.5 0.8")
set(ILLUMINATION_RELATIVE_BOUND 0.01)
set(REFERENCE_RELATIVE_BOUND 0.0011) # Binary16 reference rounding.
set(DARK_BOUND 0.0005) # Finite-plane grazing rays may miss the wide slab.
set(RENDER_ARGS -P ${WORKERS} -w ${SIZE} -n ${SIZE} -p 0.02 -c "viewsize 1"
  -c "eye_pt 0 0 2" -c "orientation 0 0 0 1"
  -c "set sampling=uniform samples=${SAMPLES} light_intensity=0 environment_color=white environment_intensity=${ENVIRONMENT_POWER} background_color=black max_bounces=-1 max_diffuse_bounces=0 max_glossy_bounces=${SURFACE_BOUNCES} max_specular_bounces=${SURFACE_BOUNCES} rr_min_path_length=0")
foreach(db IN ITEMS "${ACTUAL_DB}" "${REFERENCE_DB}")
  set_nested_parameter("${db}" receiver in_color "color ${RECEIVER_COLOR}")
  foreach(parameter IN ITEMS "in_transmittance_amount;float 1"
      "in_surface_transmittance;color 1 1 1" "in_roughness;float 0"
      "in_reflection_tint;color 1 1 1" "in_refraction_tint;color 1 1 1"
      "in_volume_transmittance;color ${VOLUME_COLOR}")
    list(GET parameter 0 name)
    list(GET parameter 1 value)
    set_nested_parameter("${db}" glass "${name}" "${value}")
  endforeach()
endforeach()
run("${TOOL}" --pattern constant:color=0,0,0 ${SIZE}x${SIZE} 3 -o "${WORK}/black.exr")
function(require_dark image)
  run("${TOOL}" --fail ${DARK_BOUND} --hardfail ${DARK_BOUND}
    --warn ${DARK_BOUND} --hardwarn ${DARK_BOUND}
    "${image}" --ch R,G,B "${WORK}/black.exr" --diff)
endfunction()
function(set_lighting_profile ior distance roughness)
  set_nested_parameter("${ACTUAL_DB}" glass in_ior "float ${ior}")
  set_nested_parameter("${ACTUAL_DB}" glass in_volume_transmittance_distance "float ${distance}")
  set_nested_parameter("${ACTUAL_DB}" glass in_roughness "float ${roughness}")
  set_nested_parameter("${REFERENCE_DB}" receiver in_ior "float ${ior}")
  set_nested_parameter("${REFERENCE_DB}" receiver in_volume_transmittance "color ${VOLUME_COLOR}")
  set_nested_parameter("${REFERENCE_DB}" receiver in_volume_transmittance_distance "float ${distance}")
endfunction()

function(render_lighting_reference stem)
  foreach(intervals IN ITEMS 8192 16384)
    set_nested_parameter("${REFERENCE_DB}" receiver in_intervals "int ${intervals}")
    run("${EXEC}" ${RENDER_ARGS} -w 1 -n 1 -c "set samples=1"
      -o "${stem}-reference-${intervals}.exr" "${REFERENCE_DB}" receiver.box.r)
    run("${VEXEC}" check-image "${stem}-reference-${intervals}.exr" 1 1)
  endforeach()
  set(refined "${stem}-reference-16384.exr")
  compare_radiance_mean("${stem}-reference-8192.exr" "${refined}" ${REFERENCE_RELATIVE_BOUND} FALSE)
  set(reference "${refined}" PARENT_SCOPE)
endfunction()

if(CAUSTIC_TEST STREQUAL "clear" OR CAUSTIC_TEST STREQUAL "absorption")
  if(CAUSTIC_TEST STREQUAL "clear")
    set(distance 0)
  else()
    set(distance 2)
  endif()
  foreach(ior IN ITEMS 1.5 2)
    set_lighting_profile(${ior} ${distance} 0)
    set(stem "${WORK}/${ior}-${distance}")
    render_lighting_reference("${stem}")
    foreach(kind IN ITEMS box mesh)
      foreach(enabled IN ITEMS 0 1)
        set(image "${stem}-${kind}-${enabled}.exr")
        run("${EXEC}" ${RENDER_ARGS} -c "set enable_caustics=${enabled}"
          -o "${image}" "${ACTUAL_DB}" "receiver.${kind}.r" "slab.${kind}.r")
        run("${VEXEC}" check-image "${image}" ${SIZE} ${SIZE})
        if(enabled)
          compare_radiance_mean("${image}" "${reference}" ${ILLUMINATION_RELATIVE_BOUND} FALSE)
        else()
          require_dark("${image}")
        endif()
      endforeach()
    endforeach()
  endforeach()
elseif(CAUSTIC_TEST STREQUAL "state")
  set_lighting_profile(2 2 0)
  render_lighting_reference("${WORK}/state")
  # The native default is off; an explicit value survives clean and frame
  # rebuilds, and inherit restores that default in the next project.
  file(WRITE "${WORK}/frames.view"
    "start 0; set enable_caustics=0; end; start 1; set enable_caustics=1; end; start 2; clean; end; start 3; set enable_caustics=inherit; end;\n")
  run(INPUT_FILE "${WORK}/frames.view" "${EXEC}" ${RENDER_ARGS} -M
    -o "${WORK}/frames.exr" "${ACTUAL_DB}" receiver.box.r slab.box.r)
  require_dark("${WORK}/frames.exr")
  require_dark("${WORK}/frames.3.exr")
  foreach(frame IN ITEMS 1 2)
    compare_radiance_mean("${WORK}/frames.${frame}.exr" "${reference}" ${ILLUMINATION_RELATIVE_BOUND} FALSE)
  endforeach()

elseif(CAUSTIC_TEST STREQUAL "rough")
  # Rough dielectric paths after a diffuse bounce use the same control.
  # Compare them with the selected SDK's native triangle geometry.
  set(REFERENCE_IOR 1.5)
  set(REFERENCE_DISTANCE 2)
  set(REFERENCE_ROUGHNESS 0.35)
  set_lighting_profile(${REFERENCE_IOR} ${REFERENCE_DISTANCE} ${REFERENCE_ROUGHNESS})
  configure_file("@CMAKE_CURRENT_SOURCE_DIR@/art_lit_glass.appleseed.in" "${WORK}/rough.appleseed" @ONLY)
  run("${NATIVE_RENDERER}" --output "${WORK}/rough-reference.exr" "${WORK}/rough.appleseed")
  run("${VEXEC}" check-image "${WORK}/rough-reference.exr" ${SIZE} ${SIZE})
  foreach(kind IN ITEMS box mesh)
    set(image "${WORK}/rough-${kind}.exr")
    run("${EXEC}" ${RENDER_ARGS} -c "set enable_caustics=1" -o "${image}"
      "${ACTUAL_DB}" "receiver.${kind}.r" "slab.${kind}.r")
    run("${VEXEC}" check-image "${image}" ${SIZE} ${SIZE})
    compare_radiance_mean("${image}" "${WORK}/rough-reference.exr" ${ILLUMINATION_RELATIVE_BOUND} FALSE)
  endforeach()
  run("${EXEC}" ${RENDER_ARGS} -c "set enable_caustics=0" -o "${WORK}/rough-disabled.exr"
    "${ACTUAL_DB}" receiver.mesh.r slab.mesh.r)
  require_dark("${WORK}/rough-disabled.exr")
else()
  message(FATAL_ERROR "Unknown caustic test: ${CAUSTIC_TEST}")
endif()
