#include "appleseed/color/as_transfer_functions.h"

shader art_transfer(
    color in_color = color(0),
    string in_function = "Rec.709 encode",
    int in_bitdepth = 12,
    output color out_color = color(0))
{
    if (in_function == "Rec.709 encode")
        out_color = Rec709_OETF(in_color);
    else if (in_function == "Rec.2020 decode")
        out_color = Rec2020_EOTF(in_color, in_bitdepth);
    else
        error("Unknown test transfer function '%s'.", in_function);
}
