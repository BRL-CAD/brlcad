cmake_minimum_required(VERSION 3.22)
set(WORK "@CMAKE_CURRENT_BINARY_DIR@/standard-transmission-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders" "${WORK}/cache")
set(ENV{BU_DIR_CACHE} "${WORK}/cache")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_nested_test_commands.cmake")
foreach(shader IN ITEMS art_standard_transmission art_nested_reference art_refraction_reference)
  configure_file("@CMAKE_CURRENT_BINARY_DIR@/${shader}.oso" "${WORK}/shaders/${shader}.oso" COPYONLY)
endforeach()
set(TOOL "@ART_OIIOTOOL_EXECUTABLE@")
set(SIZE 16)
set(TOLERANCE 0.00002)
set(MEAN_CONTROL_BOUND 0.001)
set(BASE_DB "${WORK}/base.g")
set(ACTUAL_DB "${WORK}/actual.g")
set(REFERENCE_DB "${WORK}/reference.g")
set(CONTROL_DB "${WORK}/air-control.g")
set(layers outer inner core)
set(indices 1.5 2.4 1.1)
set(priorities 1 2 3)
run("${VEXEC}" create-nested "${BASE_DB}")
configure_file("${BASE_DB}" "${REFERENCE_DB}" COPYONLY)
foreach(kind IN ITEMS box mesh)
  foreach(layer IN LISTS layers)
    run("${VEXEC}" material "${REFERENCE_DB}" assign "${kind}.${layer}.r" outer.material)
  endforeach()
endforeach()
run("${VEXEC}" set-named-material "${REFERENCE_DB}" outer.material OSL art_nested_reference)
set_nested_parameter("${REFERENCE_DB}" outer in_initial_camera "int 1")
set_nested_parameter("${REFERENCE_DB}" outer in_core "int 1")
foreach(layer ior IN ZIP_LISTS layers indices)
  set_nested_parameter("${REFERENCE_DB}" outer "in_${layer}_ior" "float ${ior}")
endforeach()
set(RENDER_ARGS -P 1 -w ${SIZE} -n ${SIZE} -c "viewsize 0.5"
  -c "set sampling=uniform samples=4 light_intensity=0 environment_intensity=0 background_color=black max_bounces=-1 max_specular_bounces=16 rr_min_path_length=0")
run("${TOOL}" --pattern constant:color=0,0,0 ${SIZE}x${SIZE} 3 -o "${WORK}/black.exr")

function(camera z angle)
  # Saved five/ten-degree poses keep the analytic reference on its Z faces.
  set(eye "0 0 ${z}")
  set(quaternion "0 0 0 1")
  if(angle EQUAL 10)
    set(eye "6.945927106677213 0 39.39231012048832")
    set(quaternion "0 0.08715574274765817 0 0.9961946980917455")
  elseif(angle EQUAL 5)
    set(quaternion "0 0.043619387365336 0 0.9990482215818578")
  endif()
  set(CAMERA_ARGS -c "eye_pt ${eye}" -c "orientation ${quaternion}" PARENT_SCOPE)
endfunction()

foreach(distribution IN ITEMS ggx beckmann)
  foreach(assignment IN ITEMS all outer-core inner)
    configure_file("${BASE_DB}" "${ACTUAL_DB}" COPYONLY)
    foreach(layer ior priority IN ZIP_LISTS layers indices priorities)
      run("${VEXEC}" set-named-material "${ACTUAL_DB}" "${layer}.material" OSL.medium_priority "${priority}")
      set_nested_parameter("${ACTUAL_DB}" "${layer}" in_ior "float ${ior}")
      if(assignment STREQUAL "all" OR
          (assignment STREQUAL "outer-core" AND NOT layer STREQUAL "inner") OR
          (assignment STREQUAL "inner" AND layer STREQUAL "inner"))
        run("${VEXEC}" set-named-material "${ACTUAL_DB}" "${layer}.material" OSL art_standard_transmission)
        set_nested_parameter("${ACTUAL_DB}" "${layer}" in_distribution "string ${distribution}")
      else()
        set_nested_parameter("${ACTUAL_DB}" "${layer}" in_roughness "float 0")
        set_nested_parameter("${ACTUAL_DB}" "${layer}" in_transmittance_amount "float 1")
        set_nested_parameter("${ACTUAL_DB}" "${layer}" in_surface_transmittance "color 1 1 1")
        set_nested_parameter("${ACTUAL_DB}" "${layer}" in_reflection_tint "color 0 0 0")
        set_nested_parameter("${ACTUAL_DB}" "${layer}" in_volume_transmittance_distance "float 0")
      endif()
    endforeach()
    if(distribution STREQUAL "ggx" AND assignment STREQUAL "all")
      configure_file("${ACTUAL_DB}" "${CONTROL_DB}" COPYONLY)
    endif()
    foreach(kind IN ITEMS box mesh)
      foreach(z IN ITEMS 40 8 4 0)
        set(angles 0 5)
        set(projections 2)
        if(z EQUAL 40)
          set(angles 0 10)
          set(projections 0 2)
        endif()
        foreach(angle IN LISTS angles)
          camera("${z}" "${angle}")
          foreach(projection IN LISTS projections)
            set(label "${distribution}-${assignment}-${kind}-${z}-${angle}-${projection}")
            set(actual "${WORK}/${label}.exr")
            set(reference "${WORK}/reference-${kind}-${z}-${angle}-${projection}.exr")
            if(NOT EXISTS "${reference}")
              run("${EXEC}" ${RENDER_ARGS} ${CAMERA_ARGS} -p ${projection}
                -o "${reference}" "${REFERENCE_DB}" "${kind}.core.g")
              run("${VEXEC}" check-image "${reference}" ${SIZE} ${SIZE})
              expect_failure("${TOOL}" --fail ${TOLERANCE} --hardfail ${TOLERANCE}
                "${reference}" --ch R,G,B "${WORK}/black.exr" --diff)
            endif()
            run("${EXEC}" ${RENDER_ARGS} ${CAMERA_ARGS} -p ${projection}
              -o "${actual}" "${ACTUAL_DB}" "${kind}.core.g")
            run("${VEXEC}" check-image "${actual}" ${SIZE} ${SIZE})
            compare_optical_transport("${actual}" "${reference}")
          endforeach()
        endforeach()
      endforeach()
    endforeach()
  endforeach()
endforeach()

# Ignoring the containing dielectric must change the transported radiance.
foreach(layer IN LISTS layers)
  set_nested_parameter("${CONTROL_DB}" "${layer}" in_assume_air "int 1")
endforeach()
camera(40 10)
run("${EXEC}" ${RENDER_ARGS} ${CAMERA_ARGS} -p 0 -o "${WORK}/air-control.exr" "${CONTROL_DB}" box.core.g)
run("${VEXEC}" check-image "${WORK}/air-control.exr" ${SIZE} ${SIZE})
compare_radiance_mean("${WORK}/air-control.exr" "${WORK}/reference-box-40-10-0.exr" ${MEAN_CONTROL_BOUND} TRUE)
foreach(layer IN LISTS layers)
  set_nested_parameter("${CONTROL_DB}" "${layer}" in_assume_air "int 0")
endforeach()
foreach(ior IN ITEMS 0 -1)
  set_nested_parameter("${CONTROL_DB}" outer in_ior "float ${ior}")
  set(image "${WORK}/invalid.exr")
  file(WRITE "${image}" "preserve existing output")
  expect_failure_matching("Invalid or unavailable dielectric medium indices|Relative dielectric index is not representable"
    "${EXEC}" ${RENDER_ARGS} ${CAMERA_ARGS} -p 0 -o "${image}" "${CONTROL_DB}" box.core.g)
  file(READ "${image}" retained)
  if(NOT retained STREQUAL "preserve existing output")
    message(FATAL_ERROR "Invalid dielectric index replaced the existing output")
  endif()
endforeach()

# A subnormal authored parameter is rejected before OSL evaluates the helper.
set_nested_parameter("${CONTROL_DB}" outer in_ior "float 1e-45")
file(WRITE "${image}" "preserve existing output")
expect_failure_matching("expected finite numeric components"
  "${EXEC}" ${RENDER_ARGS} ${CAMERA_ARGS} -p 0 -o "${image}" "${CONTROL_DB}" box.core.g)
file(READ "${image}" retained)
if(NOT retained STREQUAL "preserve existing output")
  message(FATAL_ERROR "Unrepresentable authored index replaced the existing output")
endif()

# OSL sanitizes an overflowing reciprocal to zero. The helper must reject
# that scale even though the two authored indices are finite normal values.
set_nested_parameter("${CONTROL_DB}" outer in_ior "float 1e20")
set_nested_parameter("${CONTROL_DB}" inner in_ior "float 1e-20")
camera(8 0)
file(WRITE "${image}" "preserve existing output")
expect_failure_matching("Relative dielectric index is not representable"
  "${EXEC}" ${RENDER_ARGS} ${CAMERA_ARGS} -p 2 -o "${image}" "${CONTROL_DB}" box.core.g)
file(READ "${image}" retained)
if(NOT retained STREQUAL "preserve existing output")
  message(FATAL_ERROR "Unrepresentable dielectric ratio replaced the existing output")
endif()

# A representable reciprocal may still have an overflowing square. Normal
# incidence must remain a finite mirror, rather than discarded radiance.
set(EXTREME_DB "${WORK}/extreme.g")
run("${VEXEC}" create-material "${EXTREME_DB}" art_standard_transmission)
run("${VEXEC}" set-material "${EXTREME_DB}" OSL.param.in_mode "int 0")
run("${TOOL}" --pattern constant:color=1,1,1,1 ${SIZE}x${SIZE} 4 -o "${WORK}/white.exr")
set(EXTREME_ARGS -P 1 -w ${SIZE} -n ${SIZE} -p 0 -c "viewsize 1"
  -c "eye_pt 0 0 40" -c "orientation 0 0 0 1"
  -c "set sampling=uniform samples=1 light_intensity=0 environment_color=white environment_intensity=1 background_color=black max_bounces=4 rr_min_path_length=0")
foreach(ior IN ITEMS 1e-20 1e20)
  run("${VEXEC}" set-material "${EXTREME_DB}" OSL.param.in_ior "float ${ior}")
  foreach(distribution IN ITEMS ggx beckmann)
    run("${VEXEC}" set-material "${EXTREME_DB}" OSL.param.in_distribution "string ${distribution}")
    foreach(kind IN ITEMS cube mesh)
      set(image "${WORK}/extreme-${ior}-${distribution}-${kind}.exr")
      run("${EXEC}" ${EXTREME_ARGS} -o "${image}" "${EXTREME_DB}" "${kind}.r")
      run("${VEXEC}" check-image "${image}" ${SIZE} ${SIZE})
      compare_optical_transport("${image}" "${WORK}/white.exr")
    endforeach()
  endforeach()
endforeach()
