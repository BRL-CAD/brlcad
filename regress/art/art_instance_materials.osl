surface art_instance_materials(color in_left = color(0, 1, 0),
    color in_right = color(0, 0, 1))
{
    // The two fixture spheres lie wholly on opposite sides of world X=0.
    Ci = (P[0] < 0 ? in_left : in_right) * emission();
}
