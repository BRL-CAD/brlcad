#include "appleseed/as_osl_extensions.h"

surface art_canonical_glass(
    float in_ior = 1.5,
    float in_alpha = 0.12,
    int in_mode = 2,
    vector in_tangent = vector(0))
{
    normal n = as_shading_normal();
    // Canonical glass uses perceptual roughness; the standard closure
    // takes the distribution width directly.
    Ci = as_glass(n, in_tangent, color(1),
        in_mode == 2 ? color(1) : color(0), color(1), sqrt(in_alpha), 0,
        in_ior, color(1), 0, "normal_derivatives", 1,
        "dNdx", vector(Dx(n)), "dNdy", vector(Dy(n)),
        "dTdx", Dx(in_tangent), "dTdy", Dy(in_tangent));
}
