set(WORK "@CMAKE_CURRENT_BINARY_DIR@/normal-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
foreach(shader IN ITEMS art_bump_normal art_normal_reference)
  configure_file("@CMAKE_CURRENT_BINARY_DIR@/${shader}.oso" "${WORK}/shaders/${shader}.oso" COPYONLY)
endforeach()
# Odd/even dimensions avoid sampling the authored diagonal chart seam.
set(RENDER_ARGS -a 270 -P 2 -c "set samples=1" -w 65 -n 64)
set(ACTUAL_DB "${WORK}/normal.g")
set(REFERENCE_DB "${WORK}/reference.g")
run("${VEXEC}" create-material "${ACTUAL_DB}" art_bump_normal)
run("${VEXEC}" create-material "${REFERENCE_DB}" art_normal_reference)
run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.version 2)
run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.node.map as_bump)
run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.param.map.in_mode "string Normal Map")
run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.connect.material.in_normal "map.out_normal")

function(compare_normal name object elevation perspective)
  set(image "${WORK}/${name}.png")
  set(reference "${WORK}/${name}_reference.png")
  run("${EXEC}" ${RENDER_ARGS} -e ${elevation} -p ${perspective} -o "${image}" "${ACTUAL_DB}" "${object}")
  run("${EXEC}" ${RENDER_ARGS} -e ${elevation} -p ${perspective} -o "${reference}" "${REFERENCE_DB}" "${object}")
  run("${VEXEC}" check-matching-image "${image}" "${reference}" 65 64)
endfunction()

# Independent chart frames make positive U/V, sign changes, and UV mirrors
# observable without using renderer tangents in the reference shader.
foreach(object IN ITEMS mesh.r smooth_mesh.r mirror_u_mesh.r mirror_v_mesh.r)
  if(object STREQUAL "mirror_u_mesh.r")
    set(mirror_u 1)
  else()
    set(mirror_u 0)
  endif()
  if(object STREQUAL "mirror_v_mesh.r")
    set(mirror_v 1)
  else()
    set(mirror_v 0)
  endif()
  if(object STREQUAL "smooth_mesh.r")
    set(smooth 1)
  else()
    set(smooth 0)
  endif()
  run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_smooth "int ${smooth}")
  run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_mirror_u "int ${mirror_u}")
  run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_mirror_v "int ${mirror_v}")
  foreach(direction IN ITEMS u v mixed)
    if(direction STREQUAL "u")
      set(map "color 1 0.5 1")
      set(expected "vector 1 0 1")
    elseif(direction STREQUAL "v")
      set(map "color 0.5 1 1")
      set(expected "vector 0 1 1")
    else()
      set(map "color 0.85 0.65 1")
      set(expected "vector 0.7 0.3 1")
    endif()
    run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.param.map.in_normal_map "${map}")
    run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_direction "${expected}")
    compare_normal("${object}_${direction}" "${object}" 90 0)
  endforeach()
endforeach()

# An upstream normal changes the tangent plane. Raw Tn cannot be used as
# an orthogonal axis until projected onto the supplied normal's plane.
run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_mirror_v "int 0")
run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_tilted "int 1")
set(BASE_ACTUAL_DB "${ACTUAL_DB}")
set(ACTUAL_DB "${WORK}/chained_normal.g")
configure_file("${BASE_ACTUAL_DB}" "${ACTUAL_DB}" COPYONLY)
run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.node.upstream as_bump)
run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.param.upstream.in_mode "string Normal Map")
run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.param.upstream.in_normal_map_coordsys "string World Space")
run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.param.upstream.in_normal_map "color 0.8 0.5 0.9")
run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.connect.map.in_surface_normal "upstream.out_normal")
foreach(weight IN ITEMS 0.25 1)
  run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.param.map.in_normal_map_weight "float ${weight}")
  run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_weight "float ${weight}")
  compare_normal("tilted_${weight}" mesh.r 90 0)
endforeach()

# Native primitive chart directions are independently known in world space.
set(ACTUAL_DB "${BASE_ACTUAL_DB}")
run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.param.map.in_normal_map_weight "float 1")
run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_tilted "int 0")
run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_weight "float 1")
foreach(object IN ITEMS ball.r ellipsoid.r)
  if(object STREQUAL "ball.r")
    set(chart 1)
  else()
    set(chart 2)
  endif()
  run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_chart "int ${chart}")
  foreach(perspective IN ITEMS 0 85)
    compare_normal("${object}_${perspective}" "${object}" 20 ${perspective})
  endforeach()
endforeach()

run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_chart "int 0")
function(check_control name mode map direction flip_r flip_g swap weight)
  set(actual "${WORK}/${name}.g")
  set(reference "${WORK}/${name}_reference.g")
  configure_file("${ACTUAL_DB}" "${actual}" COPYONLY)
  configure_file("${REFERENCE_DB}" "${reference}" COPYONLY)
  set(ACTUAL_DB "${actual}")
  set(REFERENCE_DB "${reference}")
  run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.param.map.in_normal_map_mode "string ${mode}")
  run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.param.map.in_normal_map "${map}")
  run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.param.map.in_normal_map_flip_r "int ${flip_r}")
  run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.param.map.in_normal_map_flip_g "int ${flip_g}")
  run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.param.map.in_normal_map_swap_rg "int ${swap}")
  run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.param.map.in_normal_map_weight "float ${weight}")
  run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_direction "${direction}")
  run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_weight "float ${weight}")
  compare_normal("${name}" mesh.r 90 0)
endfunction()
check_control(signed_map Signed "color 0.7 0.3 1" "vector 0.7 0.3 1" 0 0 0 1)
check_control(clamp_unsigned Unsigned "color 2 -1 1" "vector 1 -1 1" 0 0 0 1)
check_control(clamp_signed Signed "color 2 -2 1" "vector 1 -1 1" 0 0 0 1)
check_control(flip_r Unsigned "color 0.85 0.65 1" "vector -0.7 0.3 1" 1 0 0 1)
check_control(flip_g Unsigned "color 0.85 0.65 1" "vector 0.7 -0.3 1" 0 1 0 1)
check_control(swap_rg Unsigned "color 0.85 0.65 1" "vector 0.3 0.7 1" 0 0 1 1)
check_control(flip_swap Unsigned "color 0.85 0.65 1" "vector -0.3 -0.7 1" 1 1 1 1)
check_control(zero_vector Unsigned "color 0.5 0.5 0.5" "vector 0 0 1" 0 0 0 1)
check_control(cancelled_vector Unsigned "color 0.5 0.5 0" "vector 0 0 1" 0 0 0 0.5)

# Geometry-interpolated Tn/Bn inputs need connections to override their
# per-hit values; literal parameters on lockgeom=0 inputs are defaults.
# The native Maya vector utility in passthrough mode supplies those values.
function(check_frame name tangent bitangent direction fixed_frame)
  set(actual "${WORK}/${name}.g")
  set(reference "${WORK}/${name}_reference.g")
  configure_file("${ACTUAL_DB}" "${actual}" COPYONLY)
  configure_file("${REFERENCE_DB}" "${reference}" COPYONLY)
  set(ACTUAL_DB "${actual}")
  set(REFERENCE_DB "${reference}")
  if(NOT tangent STREQUAL "automatic")
    run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.node.tangent as_maya_vectorProduct)
    run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.param.tangent.in_operation "int 0")
    run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.param.tangent.in_input1 "${tangent}")
    run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.connect.map.Tn "tangent.out_output")
  endif()
  run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.node.bitangent as_maya_vectorProduct)
  run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.param.bitangent.in_operation "int 0")
  run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.param.bitangent.in_input1 "${bitangent}")
  run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.connect.map.Bn "bitangent.out_output")
  run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_direction "${direction}")
  run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_fixed_frame "int ${fixed_frame}")
  compare_normal("${name}" mesh.r 90 0)
endfunction()
check_frame(legacy_bitangent automatic "vector 0 0 0" "vector 0.7 -0.3 1" 0)
check_frame(explicit_frame "vector 1 0 0" "vector 0 1 0" "vector 0.7 0.3 1" 1)
check_frame(small_frame "vector 1e-25 0 0" "vector 0 1e-25 0" "vector 0.7 0.3 1" 1)
check_frame(large_frame "vector 1e25 0 0" "vector 0 1e25 0" "vector 0.7 0.3 1" 1)
check_frame(zero_tangent "vector 0 0 0" "vector 0 1 0" "vector 0 0 1" 1)
check_frame(parallel_tangent "vector 0 0 1" "vector 0 1 0" "vector 0 0 1" 1)

# Parallel vectors remain degenerate even when a float unit normal's squared
# length differs slightly from one. An opposing map must preserve that N.
set(DIAGONAL_DB "${WORK}/diagonal_parallel.g")
configure_file("${ACTUAL_DB}" "${DIAGONAL_DB}" COPYONLY)
run("${VEXEC}" set-material "${DIAGONAL_DB}" OSL.node.tangent as_maya_vectorProduct)
run("${VEXEC}" set-material "${DIAGONAL_DB}" OSL.param.tangent.in_operation "int 0")
run("${VEXEC}" set-material "${DIAGONAL_DB}" OSL.param.tangent.in_input1 "vector 1 1 1")
run("${VEXEC}" set-material "${DIAGONAL_DB}" OSL.connect.map.Tn "tangent.out_output")
run("${VEXEC}" set-material "${DIAGONAL_DB}" OSL.param.map.in_surface_normal "normal 1 1 1")
run("${VEXEC}" set-material "${DIAGONAL_DB}" OSL.param.map.in_normal_map_mode "string Signed")
run("${VEXEC}" set-material "${DIAGONAL_DB}" OSL.param.map.in_normal_map "color -1 0 0.1")
set(DIAGONAL_REFERENCE_DB "${WORK}/diagonal_reference.g")
run("${VEXEC}" create-material "${DIAGONAL_REFERENCE_DB}" art_bump_normal)
run("${VEXEC}" set-material "${DIAGONAL_REFERENCE_DB}" OSL.param.in_normal "normal 0.577350269 0.577350269 0.577350269")
run("${EXEC}" ${RENDER_ARGS} -e 90 -p 0 -o "${WORK}/diagonal_parallel.png" "${DIAGONAL_DB}" mesh.r)
run("${EXEC}" ${RENDER_ARGS} -e 90 -p 0 -o "${WORK}/diagonal_reference.png" "${DIAGONAL_REFERENCE_DB}" mesh.r)
run("${VEXEC}" check-matching-image "${WORK}/diagonal_parallel.png" "${WORK}/diagonal_reference.png" 65 64)
