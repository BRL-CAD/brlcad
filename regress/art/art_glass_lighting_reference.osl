#include "art_glass_reference.h"

surface art_glass_lighting_reference(
    color in_color = color(0.25, 0.5, 0.75),
    float in_ior = 1.5,
    color in_volume_transmittance = color(1),
    float in_volume_transmittance_distance = 0,
    float in_environment = 0.4,
    int in_intervals = 8192)
{
    if (in_ior < 1 || in_intervals < 2) {
        error("Glass lighting reference requires an index of at least one and positive quadrature");
        Ci = 0;
        return;
    }
    float SlabThickness = 1;
    color integral = 0;
    for (int i = 0; i < in_intervals; ++i) {
        float cosine = (i+0.5)/in_intervals;
        float inside_cosine = sqrt(1-(1-cosine*cosine)/(in_ior*in_ior));
        float transmission = interface_transmission(1, in_ior, cosine, inside_cosine);
        float reflection = 1-transmission;
        color attenuation = color(1);
        if (in_volume_transmittance_distance > 0)
            attenuation = pow(in_volume_transmittance,
                SlabThickness/(inside_cosine*in_volume_transmittance_distance));
        // Sum every round trip between the parallel interfaces. Index
        // factors cancel on the complete air-to-air radiance path.
        color effective = transmission*transmission * attenuation /
            (1-reflection*reflection*attenuation*attenuation);
        integral += 2*cosine * effective/in_intervals;
    }
    Ci = in_color * in_environment * integral * emission();
}
