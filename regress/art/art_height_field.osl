#include "appleseed/as_osl_extensions.h"

shader art_height_field(float in_base = 0.3, float in_slope = 0.05,
    float in_depth = 1, vector in_global_shift = vector(0),
    output float out_height = 0, output normal out_reference = N)
{
    P += in_global_shift;
    // Keep fixture heights away from the bump clamp. The reference uses
    // the polynomial's ambient gradient projected onto the actual surface.
    out_height = 0.5 - in_base * P[0] - 0.5 * in_slope * P[0] * P[0] -
        0.4 * in_slope * P[1] * P[1];
    normal surface_normal = as_shading_normal();
    vector gradient = in_depth * vector(-in_base - in_slope * P[0],
        -0.8 * in_slope * P[1], 0);
    out_reference = normalize(surface_normal - normal(gradient) +
        surface_normal * dot(surface_normal, gradient));
}
