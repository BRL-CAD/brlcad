set(WORK "@CMAKE_CURRENT_BINARY_DIR@/curved-footprints-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders" "${WORK}/cache")
set(ENV{BU_DIR_CACHE} "${WORK}/cache")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_nested_test_commands.cmake")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_rough_test_commands.cmake")
configure_file("@CMAKE_CURRENT_BINARY_DIR@/art_rough_footprint_reference.oso"
  "${WORK}/shaders/art_rough_footprint_reference.oso" COPYONLY)
set(TOOL "@ART_OIIOTOOL_EXECUTABLE@")
set(ACTUAL_DB "${WORK}/actual.g")
set(REFERENCE_DB "${WORK}/reference.g")
# Retain the planar test's independent-estimator budget and receiver gate.
set(SAMPLES 131072)
# The strongly tilted clipping receiver has higher estimator variance.
set(CLIPPING_SAMPLES 524288)
set(RELATIVE_BOUND 0.01)
set(MIN_RADIANCE 0.001)
set(ART_COMMAND_TIMEOUT 120)
set(RENDER_VIEW_ARGS -P 1 -w 1 -n 1 -c "viewsize 0.05"
  -c "eye_pt -13 -2 40" -c "orientation 0 0 0 1")
function(set_curved_sample_count samples)
  set(RENDER_ARGS ${RENDER_VIEW_ARGS}
    -c "set sampling=uniform samples=${samples} next_event_estimation=0 max_bounces=4 light_intensity=0 environment_intensity=0 background_color=black"
    PARENT_SCOPE)
endfunction()
set(REFLECTION_HOLE_BOUNDS -14 -12 -3 -1 29 32)

foreach(shape IN ITEMS ball ellipsoid)
  set_curved_sample_count(${SAMPLES})
  set(axes "10 10 10")
  set(TRANSMISSION_RECEIVER_BOUNDS -21 -9 -6 6 0 1)
  if(shape STREQUAL "ellipsoid")
    set(axes "8 10 6")
    set(TRANSMISSION_RECEIVER_BOUNDS -19.8 -10.2 -6 6 0 1)
  endif()
  # Each receiver is wholly inside its quadric. The independent reference
  # rejects paths whose next glass exit precedes the diagnostic receiver.
  foreach(mode IN ITEMS 0 1 2)
    create_rough_databases(${mode})
    set_rough_parameter(in_curved "int 1")
    set_rough_parameter(in_axes "vector ${axes}")
    set_rough_parameter(in_mode "int ${mode}")
    set_rough_parameter(in_roughness "float 0.6")
    foreach(projection IN ITEMS 0 2)
      set(anisotropy 0.5)
      if(projection EQUAL 2)
        set(anisotropy -0.5)
      endif()
      set_rough_parameter(in_anisotropy "float ${anisotropy}")
      foreach(mapped IN ITEMS 0 1)
        set_rough_parameter(in_mapped_normal "int ${mapped}")
        # Default frame, explicit Tn userdata, and an authored world tangent.
        foreach(tangent IN ITEMS 0 1 2)
          set_rough_parameter(in_tangent_source "int ${tangent}")
          foreach(position IN ITEMS 1 0)
            render_rough_pair("${shape}-${mode}-${projection}-${mapped}-${tangent}-${position}"
              "${shape}" ${projection} ${position})
          endforeach()
        endforeach()
      endforeach()
    endforeach()
  endforeach()

  # Constant shader normals and tangents isolate geometric-normal changes
  # in the metal lobe's correction back onto the geometric side.
  set_curved_sample_count(${CLIPPING_SAMPLES})
  create_rough_databases(0)
  set_rough_parameter(in_curved "int 1")
  set_rough_parameter(in_axes "vector ${axes}")
  set_rough_parameter(in_mode "int 0")
  set_rough_parameter(in_mapped_normal "int 2")
  set_rough_parameter(in_tangent_source "int 3")
  set_rough_parameter(in_roughness "float 0.6")
  foreach(projection IN ITEMS 0 2)
    set(anisotropy 0.5)
    if(projection EQUAL 2)
      set(anisotropy -0.5)
    endif()
    set_rough_parameter(in_anisotropy "float ${anisotropy}")
    foreach(position IN ITEMS 1 0)
      render_rough_pair("${shape}-clipping-${projection}-${position}"
        "${shape}" ${projection} ${position})
    endforeach()
  endforeach()
endforeach()
