set(WORK "@CMAKE_CURRENT_BINARY_DIR@/surface-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
foreach(shader IN ITEMS art_surface_reference art_emission)
  configure_file("@CMAKE_CURRENT_BINARY_DIR@/${shader}.oso"
    "${WORK}/shaders/${shader}.oso" COPYONLY)
endforeach()
set(PLASTIC_DB "${WORK}/plastic.g")
set(METAL_DB "${WORK}/metal.g")
set(REFERENCE_DB "${WORK}/reference.g")
run("${VEXEC}" create-material "${PLASTIC_DB}" as_plastic)
run("${VEXEC}" create-material "${METAL_DB}" as_metal)
run("${VEXEC}" create-material "${REFERENCE_DB}" art_surface_reference)
foreach(db IN ITEMS "${PLASTIC_DB}" "${REFERENCE_DB}")
  run("${VEXEC}" set-material "${db}" OSL.param.in_color "color 0.3 0.5 0.7")
  run("${VEXEC}" set-material "${db}" OSL.param.in_ior "float 1.5")
  run("${VEXEC}" set-material "${db}" OSL.param.in_scattering "float 1")
endforeach()
run("${VEXEC}" set-material "${PLASTIC_DB}" OSL.param.in_specular_color "color 1 1 1")
run("${VEXEC}" set-material "${PLASTIC_DB}" OSL.param.in_specular_weight "float 1")
run("${VEXEC}" set-material "${PLASTIC_DB}" OSL.param.in_diffuse_weight "float 1")
run("${VEXEC}" set-material "${METAL_DB}" OSL.param.in_face_reflectance "color 0.7 0.4 0.2")
run("${VEXEC}" set-material "${METAL_DB}" OSL.param.in_energy_compensation "float 0")
set(RENDER_ARGS -a 0 -e 65 -E 2 -P 2 -w 64 -n 64 -c "viewsize 50")
foreach(model IN ITEMS PLASTIC METAL)
  if(model STREQUAL "PLASTIC")
    set(kind plastic)
    set(roughness_input in_specular_roughness)
    set(intensity 1000)
    set(tint "color 0.3 0.5 0.7")
  else()
    set(kind metal)
    set(roughness_input in_roughness)
    set(intensity 100)
    set(tint "color 0.7 0.4 0.2")
  endif()
  run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_model "string ${kind}")
  run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_color "${tint}")
  run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_light_intensity "float ${intensity}")
  foreach(roughness IN ITEMS 0.35 0.55 0.8)
    run("${VEXEC}" set-material "${${model}_DB}" "OSL.param.${roughness_input}" "float ${roughness}")
    run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_roughness "float ${roughness}")
    foreach(object IN ITEMS cube.r mesh.r ball.r ellipsoid.r)
      foreach(perspective IN ITEMS 0 50)
        set(label "${kind}_${roughness}_${object}_${perspective}")
        foreach(form IN ITEMS ACTUAL REFERENCE)
          if(form STREQUAL "ACTUAL")
            set(db "${${model}_DB}")
          else()
            set(db "${REFERENCE_DB}")
          endif()
          run("${EXEC}" ${RENDER_ARGS} -p ${perspective} -C 0/0/0
            -c "set samples=16 light_intensity=${intensity}"
            -o "${WORK}/${form}_${label}.png" "${db}" "${object}" key_light.r)
        endforeach()
        run("${VEXEC}" check-matching-image "${WORK}/ACTUAL_${label}.png" "${WORK}/REFERENCE_${label}.png" 64 64)
      endforeach()
    endforeach()
  endforeach()
endforeach()

# A tighter foreground-mean check isolates rough plastic's sampling bias.
# The independent hemisphere integral is axisymmetric at normal incidence.
run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_model "string plastic")
run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_color "color 0.3 0.5 0.7")
run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_environment "float 0.4")
foreach(roughness IN ITEMS 0.35 0.55 0.8)
  run("${VEXEC}" set-material "${PLASTIC_DB}" OSL.param.in_specular_roughness "float ${roughness}")
  run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_roughness "float ${roughness}")
  foreach(object IN ITEMS cube.r mesh.r)
    set(label "energy_${roughness}_${object}")
    run("${EXEC}" ${RENDER_ARGS} -e 90 -p 0 -C 255/255/255
      -c "set samples=256 light_intensity=0"
      -o "${WORK}/ACTUAL_${label}.png" "${PLASTIC_DB}" "${object}")
    run("${EXEC}" ${RENDER_ARGS} -e 90 -p 0 -C 255/255/255
      -c "set samples=16 light_intensity=0"
      -o "${WORK}/REFERENCE_${label}.png" "${REFERENCE_DB}" "${object}")
    run("${VEXEC}" check-mean-image "${WORK}/ACTUAL_${label}.png" "${WORK}/REFERENCE_${label}.png" 64 64)
  endforeach()
endforeach()

# Smooth plastic combines an ideal Fresnel reflection with the diffuse base.
run("${VEXEC}" set-material "${PLASTIC_DB}" OSL.param.in_specular_roughness "float 0")
run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_roughness "float 0")
run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_color "color 0.3 0.5 0.7")
run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_environment "float 0.4")
foreach(object IN ITEMS cube.r mesh.r ball.r ellipsoid.r)
  foreach(perspective IN ITEMS 0 50)
    set(label "smooth_${object}_${perspective}")
    run("${EXEC}" ${RENDER_ARGS} -p ${perspective} -C 255/255/255
      -c "set samples=256 light_intensity=0"
      -o "${WORK}/ACTUAL_${label}.png" "${PLASTIC_DB}" "${object}")
    run("${EXEC}" ${RENDER_ARGS} -p ${perspective} -C 255/255/255
      -c "set samples=16 light_intensity=0"
      -o "${WORK}/REFERENCE_${label}.png" "${REFERENCE_DB}" "${object}")
    run("${VEXEC}" check-matching-image "${WORK}/ACTUAL_${label}.png" "${WORK}/REFERENCE_${label}.png" 64 64)
  endforeach()
endforeach()

# A broad highlight cannot satisfy the narrow-highlight reference.
run("${VEXEC}" check-different-image "${WORK}/ACTUAL_metal_0.8_cube.r_0.png" "${WORK}/REFERENCE_metal_0.35_cube.r_0.png" 64 64)
expect_failure("${VEXEC}" check-matching-image "${WORK}/ACTUAL_metal_0.8_cube.r_0.png" "${WORK}/REFERENCE_metal_0.35_cube.r_0.png" 64 64)

# A darker diffuse base must also fail the mean-response check.
run("${VEXEC}" set-material "${PLASTIC_DB}" OSL.param.in_color "color 0.1 0.15 0.2")
run("${VEXEC}" set-material "${PLASTIC_DB}" OSL.param.in_specular_roughness "float 0.55")
run("${EXEC}" ${RENDER_ARGS} -e 90 -p 0 -C 255/255/255
  -c "set samples=256 light_intensity=0"
  -o "${WORK}/dark.png" "${PLASTIC_DB}" cube.r)
expect_failure("${VEXEC}" check-mean-image "${WORK}/dark.png" "${WORK}/REFERENCE_energy_0.55_cube.r.png" 64 64)
