#include "appleseed/maya/as_maya_helpers.h"

surface art_sdk_helpers()
{
    // This overload comes from the generated Appleseed extension header.
    float largest = max(vector(0.25, 1, 0.5));
    Ci = color(0, largest, 0) * emission();
}
