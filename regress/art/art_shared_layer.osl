#include "appleseed/as_osl_extensions.h"

surface art_shared_layer(float in_opacity = 0.5, float in_ior = 2.4)
{
    Ci = in_opacity * as_glass(normalize(N), vector(0), color(1),
        color(0), color(1), 0, 0, in_ior, color(1), 0)
        + (1 - in_opacity) * transparent();
}
