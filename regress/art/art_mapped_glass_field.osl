shader art_mapped_glass_field(
    int in_uv = 0,
    output color out_map = color(0, 0, 1))
{
    // The authored field varies between slab faces or across each UV chart.
    float x = in_uv ? 2 * u - 1 : P[2] / 10;
    float y = in_uv ? 2 * v - 1 : P[2] / 10;
    out_map = color(0.04 + 0.1 * x, -0.03 + 0.05 * y, 1);
}
