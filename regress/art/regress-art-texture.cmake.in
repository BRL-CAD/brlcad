set(WORK "@CMAKE_CURRENT_BINARY_DIR@/texture-output")
set(PROJECT "${WORK}/project")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${PROJECT}/shaders" "${PROJECT}/textures")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
foreach(shader IN ITEMS art_bump_normal art_emission art_graph_value)
  configure_file("@CMAKE_CURRENT_BINARY_DIR@/${shader}.oso" "${PROJECT}/shaders/${shader}.oso" COPYONLY)
endforeach()
set(RENDER_ARGS -a 270 -e 20 -P 2 -c "set samples=1" -w 64 -n 64 -p 0)
set(IMAGE_DB "${PROJECT}/missing.g")
set(REFERENCE_DB "${PROJECT}/reference.g")
run("${VEXEC}" create-material "${IMAGE_DB}" art_emission)
run("${VEXEC}" create-material "${REFERENCE_DB}" art_emission)
run("${VEXEC}" set-material "${IMAGE_DB}" OSL.version 2)
run("${VEXEC}" set-material "${IMAGE_DB}" OSL.node.image as_texture)
run("${VEXEC}" set-material "${IMAGE_DB}" OSL.param.image.in_filename "string textures/absent image.tx")
run("${VEXEC}" set-material "${IMAGE_DB}" OSL.connect.material.in_color "image.out_color")

# A named missing texture must fail without creating or replacing output.
set(MISSING_IMAGE "${WORK}/missing.png")
expect_failure("${EXEC}" ${RENDER_ARGS} -o "${MISSING_IMAGE}" "${IMAGE_DB}" mesh.r)
if(EXISTS "${MISSING_IMAGE}")
  message(FATAL_ERROR "A native texture node published a missing asset")
endif()
set(SENTINEL "previous native texture output")
file(WRITE "${MISSING_IMAGE}" "${SENTINEL}")
expect_failure("${EXEC}" ${RENDER_ARGS} -o "${MISSING_IMAGE}" "${IMAGE_DB}" mesh.r)
file(READ "${MISSING_IMAGE}" preserved)
if(NOT preserved STREQUAL SENTINEL)
  message(FATAL_ERROR "A missing native texture replaced existing output")
endif()

function(compare_texture name)
  set(image "${WORK}/${name}.png")
  set(reference "${WORK}/${name}_reference.png")
  run("${EXEC}" ${RENDER_ARGS} -o "${image}" "${IMAGE_DB}" mesh.r)
  run("${EXEC}" ${RENDER_ARGS} -o "${reference}" "${REFERENCE_DB}" mesh.r)
  run("${VEXEC}" check-matching-image "${image}" "${reference}" 64 64)
endfunction()

# Fill is explicit for named assets. An unassigned filename also uses fill.
run("${VEXEC}" set-material "${IMAGE_DB}" OSL.param.image.in_error_on_missing "int 0")
run("${VEXEC}" set-material "${IMAGE_DB}" OSL.param.image.in_color "color 0.2 0.4 0.6")
run("${VEXEC}" set-material "${IMAGE_DB}" OSL.param.image.in_alpha "float 0.25")
run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_color "color 0.2 0.4 0.6")
compare_texture(explicit_fill)
set(FILL_DB "${PROJECT}/fill.g")
configure_file("${IMAGE_DB}" "${FILL_DB}" COPYONLY)
run("${VEXEC}" remove-material "${IMAGE_DB}" OSL.param.image.in_filename)
run("${VEXEC}" set-material "${IMAGE_DB}" OSL.param.image.in_error_on_missing "int 1")
compare_texture(empty_filename)
set(IMAGE_DB "${FILL_DB}")

# Both scalar outputs must agree with the configured fallback values.
run("${VEXEC}" set-material "${IMAGE_DB}" OSL.node.scalar art_graph_value)
run("${VEXEC}" set-material "${IMAGE_DB}" OSL.param.scalar.in_color "color 0 1 0")
run("${VEXEC}" set-material "${IMAGE_DB}" OSL.connect.material.in_color "scalar.out_color")
run("${VEXEC}" set-material "${IMAGE_DB}" OSL.connect.scalar.in_weight "image.out_alpha")
run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_color "color 0 0.25 0")
compare_texture(fill_alpha)
run("${VEXEC}" set-material "${IMAGE_DB}" OSL.connect.scalar.in_weight "image.out_channel")
run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_color "color 0 0.4 0")
compare_texture(fill_channel)

# Floating-point data preserves the exact neutral normal components.
# Tag the source as sRGB to catch accidental conversion in the raw-data path.
# Keep the shortest perspective-sphere footprint above the base mip level.
set(TEXTURE_SIZE 2048)
run("@ART_OIIOTOOL_EXECUTABLE@" --pattern
  "checker:width=1:height=1:color1=1,0.5,1:color2=0,0.5,1"
  "${TEXTURE_SIZE}x${TEXTURE_SIZE}" 3 --attrib oiio:ColorSpace sRGB -d float
  -o "${PROJECT}/textures/normal map.tif")
run("@ART_OIIOTOOL_EXECUTABLE@" --pattern "checker:width=1:height=1"
  "${TEXTURE_SIZE}x${TEXTURE_SIZE}" 1 --attrib oiio:ColorSpace sRGB -d float
  -o "${PROJECT}/textures/height map.tif")
foreach(kind IN ITEMS normal height)
  run("@ART_MAKETX_EXECUTABLE@" -d float --filter box --wrap periodic
    -o "${PROJECT}/textures/${kind} map.tx" "${PROJECT}/textures/${kind} map.tif")
endforeach()

# Sampling a fully minified one-channel data image must return 0.5 as data.
set(IMAGE_DB "${PROJECT}/raw_scalar.g")
run("${VEXEC}" create-material "${IMAGE_DB}" art_emission)
run("${VEXEC}" set-material "${IMAGE_DB}" OSL.version 2)
run("${VEXEC}" set-material "${IMAGE_DB}" OSL.node.image as_texture)
run("${VEXEC}" set-material "${IMAGE_DB}" OSL.param.image.in_filename "string textures/height map.tx")
run("${VEXEC}" set-material "${IMAGE_DB}" OSL.param.image.in_enable_cms "int 0")
run("${VEXEC}" set-material "${IMAGE_DB}" OSL.node.scalar art_graph_value)
run("${VEXEC}" set-material "${IMAGE_DB}" OSL.param.scalar.in_color "color 0 1 0")
run("${VEXEC}" set-material "${IMAGE_DB}" OSL.connect.scalar.in_weight "image.out_channel")
run("${VEXEC}" set-material "${IMAGE_DB}" OSL.connect.material.in_color "scalar.out_color")
run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_color "color 0 0.5 0")
compare_texture(raw_scalar)

set(PLAIN_DB "${PROJECT}/plain.g")
run("${VEXEC}" create-material "${PLAIN_DB}" art_bump_normal)
foreach(kind IN ITEMS normal height)
  set(database "${PROJECT}/${kind}.g")
  run("${VEXEC}" create-material "${database}" art_bump_normal)
  run("${VEXEC}" set-material "${database}" OSL.version 2)
  run("${VEXEC}" set-material "${database}" OSL.node.image as_texture)
  run("${VEXEC}" set-material "${database}" OSL.param.image.in_filename "string textures/${kind} map.tx")
  run("${VEXEC}" set-material "${database}" OSL.param.image.in_enable_cms "int 0")
  run("${VEXEC}" set-material "${database}" OSL.node.map as_bump)
  run("${VEXEC}" set-material "${database}" OSL.connect.material.in_normal "map.out_normal")
  if(kind STREQUAL "normal")
    run("${VEXEC}" set-material "${database}" OSL.param.map.in_mode "string Normal Map")
    run("${VEXEC}" set-material "${database}" OSL.param.image.in_interpolation_method "int 3")
    run("${VEXEC}" set-material "${database}" OSL.connect.map.in_normal_map "image.out_color")
  else()
    run("${VEXEC}" set-material "${database}" OSL.param.image.in_interpolation_method "int 2")
    run("${VEXEC}" set-material "${database}" OSL.connect.map.in_bump_value "image.out_channel")
  endif()
endforeach()
set(RENDER_ARGS -a 270 -e 20 -P 2 -c "set samples=1" -w 64 -n 64)

# At minification, the normal checker averages to the neutral (0.5,0.5,1)
# and the height checker averages to a constant with zero gradient.
foreach(object IN ITEMS ball.r ellipsoid.r mesh.r smooth_mesh.r mirror_u_mesh.r mirror_v_mesh.r)
  foreach(perspective IN ITEMS 0 85)
    set(reference "${WORK}/plain_${object}_${perspective}.png")
    run("${EXEC}" ${RENDER_ARGS} -p ${perspective} -o "${reference}" "${PLAIN_DB}" "${object}")
    foreach(kind IN ITEMS normal height)
      set(image "${WORK}/${kind}_${object}_${perspective}.png")
      run("${EXEC}" ${RENDER_ARGS} -p ${perspective} -o "${image}" "${PROJECT}/${kind}.g" "${object}")
      run("${VEXEC}" check-matching-image "${image}" "${reference}" 64 64)
    endforeach()
  endforeach()
endforeach()

# Disabling the footprint must expose both normal aliasing and height slopes.
foreach(kind IN ITEMS normal height)
  set(database "${PROJECT}/${kind}_unfiltered.g")
  configure_file("${PROJECT}/${kind}.g" "${database}" COPYONLY)
  run("${VEXEC}" set-material "${database}" OSL.param.image.in_s_filter_width "float 0")
  run("${VEXEC}" set-material "${database}" OSL.param.image.in_t_filter_width "float 0")
  foreach(perspective IN ITEMS 0 85)
    set(image "${WORK}/${kind}_unfiltered_${perspective}.png")
    run("${EXEC}" ${RENDER_ARGS} -p ${perspective} -o "${image}" "${database}" smooth_mesh.r)
    run("${VEXEC}" check-different-image "${image}" "${WORK}/plain_smooth_mesh.r_${perspective}.png" 64 64)
  endforeach()
endforeach()

# Applying a display transfer to normal data must be observably wrong.
set(CMS_DB "${PROJECT}/normal_cms.g")
configure_file("${PROJECT}/normal.g" "${CMS_DB}" COPYONLY)
run("${VEXEC}" set-material "${CMS_DB}" OSL.param.image.in_enable_cms "int 1")
run("${VEXEC}" set-material "${CMS_DB}" OSL.param.image.in_rgb_primaries "string Raw")
run("${EXEC}" ${RENDER_ARGS} -p 0 -o "${WORK}/normal_cms.png" "${CMS_DB}" smooth_mesh.r)
run("${VEXEC}" check-different-image "${WORK}/normal_cms.png" "${WORK}/plain_smooth_mesh.r_0.png" 64 64)

# Moving a project must not retain an implicit dependency on the old assets.
set(RELOCATED "${WORK}/relocated project")
file(COPY "${PROJECT}/" DESTINATION "${RELOCATED}")
file(RENAME "${PROJECT}/textures" "${PROJECT}/textures.unavailable")
foreach(kind IN ITEMS normal height)
  set(image "${WORK}/${kind}_relocated.png")
  run("${EXEC}" ${RENDER_ARGS} -p 0 -o "${image}" "${RELOCATED}/${kind}.g" smooth_mesh.r)
  run("${VEXEC}" check-matching-image "${image}" "${WORK}/plain_smooth_mesh.r_0.png" 64 64)
endforeach()
file(RENAME "${PROJECT}/textures.unavailable" "${PROJECT}/textures")
