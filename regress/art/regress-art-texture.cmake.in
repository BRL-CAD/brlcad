set(WORK "@CMAKE_CURRENT_BINARY_DIR@/texture-output")
set(PROJECT "${WORK}/project")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${PROJECT}/shaders" "${PROJECT}/textures")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
foreach(shader IN ITEMS art_bump_normal art_emission art_graph_value)
  configure_file("@CMAKE_CURRENT_BINARY_DIR@/${shader}.oso" "${PROJECT}/shaders/${shader}.oso" COPYONLY)
endforeach()
set(RENDER_ARGS -a 270 -e 20 -P 2 -c "set samples=1" -w 64 -n 64 -p 0)
set(IMAGE_DB "${PROJECT}/missing.g")
set(REFERENCE_DB "${PROJECT}/reference.g")
run("${VEXEC}" create-material "${IMAGE_DB}" art_emission)
run("${VEXEC}" create-material "${REFERENCE_DB}" art_emission)
run("${VEXEC}" set-material "${IMAGE_DB}" OSL.version 2)
run("${VEXEC}" set-material "${IMAGE_DB}" OSL.node.image as_texture)
run("${VEXEC}" set-material "${IMAGE_DB}" OSL.param.image.in_filename "string textures/absent image.tx")
run("${VEXEC}" set-material "${IMAGE_DB}" OSL.connect.material.in_color "image.out_color")

# A named missing texture must fail without creating or replacing output.
set(MISSING_IMAGE "${WORK}/missing.png")
expect_failure("${EXEC}" ${RENDER_ARGS} -o "${MISSING_IMAGE}" "${IMAGE_DB}" mesh.r)
if(EXISTS "${MISSING_IMAGE}")
  message(FATAL_ERROR "A native texture node published a missing asset")
endif()
set(SENTINEL "previous native texture output")
file(WRITE "${MISSING_IMAGE}" "${SENTINEL}")
expect_failure("${EXEC}" ${RENDER_ARGS} -o "${MISSING_IMAGE}" "${IMAGE_DB}" mesh.r)
file(READ "${MISSING_IMAGE}" preserved)
if(NOT preserved STREQUAL SENTINEL)
  message(FATAL_ERROR "A missing native texture replaced existing output")
endif()

function(compare_texture name)
  set(image "${WORK}/${name}.png")
  set(reference "${WORK}/${name}_reference.png")
  run("${EXEC}" ${RENDER_ARGS} -o "${image}" "${IMAGE_DB}" mesh.r)
  run("${EXEC}" ${RENDER_ARGS} -o "${reference}" "${REFERENCE_DB}" mesh.r)
  run("${VEXEC}" check-matching-image "${image}" "${reference}" 64 64)
endfunction()

# Fill is explicit for named assets. An unassigned filename also uses fill.
run("${VEXEC}" set-material "${IMAGE_DB}" OSL.param.image.in_error_on_missing "int 0")
run("${VEXEC}" set-material "${IMAGE_DB}" OSL.param.image.in_color "color 0.2 0.4 0.6")
run("${VEXEC}" set-material "${IMAGE_DB}" OSL.param.image.in_alpha "float 0.25")
run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_color "color 0.2 0.4 0.6")
compare_texture(explicit_fill)
set(FILL_DB "${PROJECT}/fill.g")
configure_file("${IMAGE_DB}" "${FILL_DB}" COPYONLY)
run("${VEXEC}" remove-material "${IMAGE_DB}" OSL.param.image.in_filename)
run("${VEXEC}" set-material "${IMAGE_DB}" OSL.param.image.in_error_on_missing "int 1")
compare_texture(empty_filename)
set(IMAGE_DB "${FILL_DB}")

# Both scalar outputs must agree with the configured fallback values.
run("${VEXEC}" set-material "${IMAGE_DB}" OSL.node.scalar art_graph_value)
run("${VEXEC}" set-material "${IMAGE_DB}" OSL.param.scalar.in_color "color 0 1 0")
run("${VEXEC}" set-material "${IMAGE_DB}" OSL.connect.material.in_color "scalar.out_color")
run("${VEXEC}" set-material "${IMAGE_DB}" OSL.connect.scalar.in_weight "image.out_alpha")
run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_color "color 0 0.25 0")
compare_texture(fill_alpha)
run("${VEXEC}" set-material "${IMAGE_DB}" OSL.connect.scalar.in_weight "image.out_channel")
run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_color "color 0 0.4 0")
compare_texture(fill_channel)
