surface art_embedded_surface(
    color in_emission = color(0.2, 0.8, 0.1))
{
    // A diffuse closure keeps the opaque material's BSDF present even when
    // emission supplies the controlled observable in an unlit scene.
    Ci = color(0.8, 0.1, 0.05) * diffuse(N) + in_emission * emission();
}
