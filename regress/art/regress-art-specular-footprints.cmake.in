set(WORK "@CMAKE_CURRENT_BINARY_DIR@/specular-footprints-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders" "${WORK}/cache")
set(ENV{BU_DIR_CACHE} "${WORK}/cache")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_footprint_test_commands.cmake")
foreach(shader IN ITEMS art_glass_footprint_field art_glass_footprint_reference art_specular_footprint)
  configure_file("@CMAKE_CURRENT_BINARY_DIR@/${shader}.oso" "${WORK}/shaders/${shader}.oso" COPYONLY)
endforeach()
set(TOOL "@ART_OIIOTOOL_EXECUTABLE@")
set(TOLERANCE 0.00002)
# First-order ray footprints converge with pixel size. Binary16 rounding
# is included separately from the 1% and 0.5% approximation budgets.
set(FOOTPRINT_RELATIVE_BOUND 0.0109765625)
set(REFINED_FOOTPRINT_RELATIVE_BOUND 0.0059765625)
set(RENDER_ARGS -P 1 -c "viewsize 0.5" -c "orientation 0 0 0 1"
  -c "set sampling=uniform samples=1 max_bounces=16 max_specular_bounces=16 rr_min_path_length=0 light_intensity=0 environment_intensity=0 background_color=black")

foreach(material IN ITEMS mirror dielectric_mirror glossy metal plastic coat)
  set(ACTUAL_DB "${WORK}/${material}.g")
  set(REFERENCE_DB "${WORK}/${material}-reference.g")
  set(shader art_specular_footprint)
  set(NORMAL_INPUT in_bump_normal)
  set(parameters "OSL.param.in_ior|float 1.5")
  set(unweighted 0)
  if(material STREQUAL "mirror")
    set(parameters "OSL.param.in_ior|float 0")
    set(unweighted 1)
  elseif(material STREQUAL "glossy")
    list(APPEND parameters "OSL.param.in_glossy|int 1")
  elseif(material STREQUAL "metal")
    set(shader as_metal)
    set(unweighted 1)
    set(parameters "OSL.output|out_outColor" "OSL.param.in_roughness|float 0"
      "OSL.param.in_face_reflectance|color 1 1 1" "OSL.param.in_edge_reflectance|color 1 1 1"
      "OSL.param.in_edge_reflectance_weight|float 1")
  elseif(material STREQUAL "plastic")
    set(shader as_plastic)
    set(parameters "OSL.output|out_outColor" "OSL.param.in_specular_roughness|float 0"
      "OSL.param.in_specular_color|color 1 1 1" "OSL.param.in_specular_weight|float 1"
      "OSL.param.in_ior|float 1.5" "OSL.param.in_diffuse_weight|float 0" "OSL.param.in_scattering|float 0")
  elseif(material STREQUAL "coat")
    set(shader as_glossy_layer)
    set(NORMAL_INPUT in_normal)
    set(parameters "OSL.output|out_color" "OSL.param.in_roughness|float 0"
      "OSL.param.in_reflectance|color 1 1 1" "OSL.param.in_ior|float 1.5" "OSL.param.in_thickness|float 0")
  endif()
  run("${VEXEC}" create-material "${ACTUAL_DB}" "${shader}")
  run("${VEXEC}" create-material "${REFERENCE_DB}" art_glass_footprint_reference)
  run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.version 2)
  foreach(parameter IN LISTS parameters)
    string(REPLACE "|" ";" parameter "${parameter}")
    list(GET parameter 0 name)
    list(GET parameter 1 value)
    run("${VEXEC}" set-material "${ACTUAL_DB}" "${name}" "${value}")
  endforeach()
  create_footprint_receivers()
  set_footprint_reference(reflection "int 1")
  set_footprint_reference(ior "float 1.5")
  set_footprint_reference(unweighted "int ${unweighted}")
  foreach(SIZE IN ITEMS 16 32)
    run("${TOOL}" --pattern constant:color=0,0,0 ${SIZE}x${SIZE} 3 -o "${WORK}/black.exr")
    set(relative_bound ${FOOTPRINT_RELATIVE_BOUND})
    if(SIZE EQUAL 32)
      set(relative_bound ${REFINED_FOOTPRINT_RELATIVE_BOUND})
    endif()
    foreach(shape IN ITEMS cube mesh ball ellipsoid)
      set(curved 0)
      set(center "0 0 0")
      set(eye_x 2)
      set(axes "10 10 10")
      set(target front.r)
      if(shape STREQUAL "ball" OR shape STREQUAL "ellipsoid")
        set(curved 1)
        set(center "-15 0 0")
        set(eye_x -13)
        set(target curved_front.r)
      endif()
      if(shape STREQUAL "ellipsoid")
        set(axes "8 10 6")
      endif()
      if(SIZE EQUAL 32 AND NOT curved)
        continue()
      endif()
      set_footprint_reference(curved "int ${curved}")
      set_footprint_reference(center "point ${center}")
      set_footprint_reference(axes "vector ${axes}")
      foreach(mapping IN ITEMS unmapped direct bump)
        if(SIZE EQUAL 32 AND mapping STREQUAL "unmapped")
          continue()
        endif()
        set_footprint_mapping("${mapping}" "${center}" 1 ${curved} "${NORMAL_INPUT}")
        foreach(mode IN ITEMS 0 1)
          if(SIZE EQUAL 32 AND mode EQUAL 1)
            continue()
          endif()
          set_footprint_reference(mode "int ${mode}")
          run("${VEXEC}" set-named-material "${ACTUAL_DB}" receiver.material OSL.param.in_mode "int ${mode}")
          foreach(projection IN ITEMS 0 2)
            if(SIZE EQUAL 32 AND projection EQUAL 0)
              continue()
            endif()
            set(label "${material}-${SIZE}-${shape}-${mapping}-${mode}-${projection}")
            compare_footprint_paths("${label}" ${SIZE} ${projection} ${eye_x}
              "${shape}" "${target}" ${mode} ${relative_bound})
          endforeach()
        endforeach()
      endforeach()
    endforeach()
  endforeach()
endforeach()
