#include "appleseed/as_osl_extensions.h"
#include "appleseed/material/as_material_helpers.h"

surface art_standard_transmission(
    float in_ior = 1.5,
    string in_distribution = "ggx",
    float in_alpha = 0,
    int in_mode = 1,
    int in_assume_air = 0,
    vector in_tangent = vector(0))
{
    normal n = as_shading_normal();
    // The air shortcut is an intentionally wrong nested-medium control.
    float eta = in_assume_air ? (backfacing() ? 1 / in_ior : in_ior) :
        as_relative_ior(in_ior);
    Ci = microfacet(in_distribution, n, in_tangent, in_alpha, in_alpha, eta, in_mode,
        "normal_derivatives", 1, "dNdx", vector(Dx(n)), "dNdy", vector(Dy(n)),
        "dTdx", Dx(in_tangent), "dTdy", Dy(in_tangent));
}
