set(WORK "@CMAKE_CURRENT_BINARY_DIR@/transmission-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
foreach(shader IN ITEMS art_absorption_reference art_emission)
  configure_file("@CMAKE_CURRENT_BINARY_DIR@/${shader}.oso" "${WORK}/shaders/${shader}.oso" COPYONLY)
endforeach()
set(GLASS_DB "${WORK}/glass.g")
set(REFERENCE_DB "${WORK}/reference.g")
set(UNIFORM_DB "${WORK}/uniform.g")
run("${VEXEC}" create-material "${GLASS_DB}" as_glass)
run("${VEXEC}" create-material "${REFERENCE_DB}" art_absorption_reference)
run("${VEXEC}" create-material "${UNIFORM_DB}" art_emission)
run("${VEXEC}" set-material "${UNIFORM_DB}" OSL.param.in_color "color 0.4 0.4 0.4")
foreach(db IN ITEMS "${GLASS_DB}" "${REFERENCE_DB}")
  run("${VEXEC}" set-material "${db}" OSL.param.in_volume_transmittance "color 0.25 0.5 0.8")
  run("${VEXEC}" set-material "${db}" OSL.param.in_volume_transmittance_distance "float 20")
endforeach()
run("${VEXEC}" set-material "${GLASS_DB}" OSL.param.in_ior "float 1")
run("${VEXEC}" set-material "${GLASS_DB}" OSL.param.in_roughness "float 0")
run("${VEXEC}" set-material "${GLASS_DB}" OSL.param.in_transmittance_amount "float 1")
run("${VEXEC}" set-material "${GLASS_DB}" OSL.param.in_surface_transmittance "color 1 1 1")
set(RENDER_ARGS -a 0 -e 90 -P 2 -w 64 -n 64 -C 255/255/255
  -c "set samples=16 light_intensity=0" -c "viewsize 40")
foreach(object IN ITEMS cube.r mesh.r smooth_mesh.r ball.r ellipsoid.r box.r)
  if(object STREQUAL "ball.r" OR object STREQUAL "ellipsoid.r")
    set(shape ellipsoid)
    set(center "point -15 0 0")
  else()
    set(shape box)
    set(center "point 0 0 0")
  endif()
  if(object STREQUAL "box.r")
    set(shape bored_box)
    set(center "point 15 0 0")
  endif()
  if(object STREQUAL "ellipsoid.r")
    set(axes "vector 8 10 6")
  else()
    set(axes "vector 10 10 10")
  endif()
  run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_shape "string ${shape}")
  run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_center "${center}")
  run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_axes "${axes}")
  foreach(perspective IN ITEMS 0 50)
    set(actual "${WORK}/absorbing_${object}_${perspective}.png")
    set(reference "${WORK}/reference_${object}_${perspective}.png")
    run("${EXEC}" ${RENDER_ARGS} -p ${perspective} -o "${actual}" "${GLASS_DB}" "${object}")
    run("${EXEC}" ${RENDER_ARGS} -p ${perspective} -o "${reference}" "${REFERENCE_DB}" "${object}")
    run("${VEXEC}" check-matching-image "${actual}" "${reference}" 64 64)
  endforeach()
endforeach()

# A disabled absorption control must disagree with the analytic attenuation.
run("${VEXEC}" set-material "${GLASS_DB}" OSL.param.in_volume_transmittance_distance "float 0")
run("${EXEC}" ${RENDER_ARGS} -p 0 -o "${WORK}/clear.png" "${GLASS_DB}" mesh.r)
run("${EXEC}" ${RENDER_ARGS} -p 0 -o "${WORK}/uniform.png" "${UNIFORM_DB}" mesh.r)
run("${VEXEC}" check-different-image "${WORK}/clear.png" "${WORK}/reference_mesh.r_0.png" 64 64)
run("${VEXEC}" check-uniform-image "${WORK}/clear.png" "${WORK}/uniform.png" 64 64)
expect_failure("${VEXEC}" check-uniform-image "${WORK}/absorbing_mesh.r_0.png" "${WORK}/uniform.png" 64 64)

# Nonmatching glass must agree on geometrically identical CSG and BOT cubes.
run("${VEXEC}" set-material "${GLASS_DB}" OSL.param.in_ior "float 1.5")
foreach(perspective IN ITEMS 0 50)
  foreach(object IN ITEMS cube.r mesh.r)
    run("${EXEC}" ${RENDER_ARGS} -p ${perspective} -o "${WORK}/dielectric_${object}_${perspective}.png" "${GLASS_DB}" "${object}")
  endforeach()
  run("${VEXEC}" check-uniform-image "${WORK}/dielectric_mesh.r_${perspective}.png" "${WORK}/dielectric_cube.r_${perspective}.png" 64 64)
endforeach()

# Looking out of a solid must use the same material as its entry faces.
run("${VEXEC}" set-material "${UNIFORM_DB}" OSL.param.in_color "color 0 1 0")
foreach(object IN ITEMS cube.r mesh.r)
  run("${EXEC}" -a 0 -e 90 -p 85 -E 0 -P 1 -w 32 -n 32
    -c "set samples=1" -o "${WORK}/inside_${object}.png" "${UNIFORM_DB}" "${object}")
  run("${VEXEC}" check-parameters "${WORK}/inside_${object}.png" 32 32)
endforeach()
