cmake_minimum_required(VERSION 3.22)
set(WORK "@CMAKE_CURRENT_BINARY_DIR@/curved-contact-output")
set(LOG "${WORK}/art.log")
set(TOOL "@ART_OIIOTOOL_EXECUTABLE@")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_curved_test_commands.cmake")
set(CURVED_LIGHTING_ARGS -c "set environment_color=white environment_intensity=0.4 max_diffuse_bounces=0")
foreach(shape IN ITEMS sphere ellipsoid)
  create_curved_pair("${shape}")
  set_nested_profile(absorbing outer inner)
  run("${VEXEC}" material "${ACTUAL_DB}" create emitter.material Opaque)
  run("${VEXEC}" set-named-material "${ACTUAL_DB}" emitter.material OSL art_embedded_surface)
  run("${VEXEC}" material "${ACTUAL_DB}" create mirror.material Opaque)
  run("${VEXEC}" set-named-material "${ACTUAL_DB}" mirror.material OSL art_mirror_node)
  run("${VEXEC}" set-named-material "${ACTUAL_DB}" mirror.material OSL.output out_color)
  set_nested_parameter("${ACTUAL_DB}" mirror in_color "color 1 1 1")
  set(modes emitter mirror)
  set(reference_modes 1 2)
  foreach(mode reference_mode IN ZIP_LISTS modes reference_modes)
    run("${VEXEC}" material "${ACTUAL_DB}" assign curved.inner.r "${mode}.material")
    set_nested_parameter("${REFERENCE_DB}" outer in_opaque_inner "int ${reference_mode}")
    foreach(location IN ITEMS outside glass)
      if(location STREQUAL "outside")
        set(z 12)
      else()
        set(z "${CURVED_GLASS_Z}")
      endif()
      foreach(tilt orientation IN ZIP_LISTS CURVED_TILTS CURVED_ORIENTATIONS)
        set(stem "${WORK}/${shape}-${mode}-${location}-${tilt}")
        set(reference "${stem}-reference.exr")
        render_curved("${reference}" "${REFERENCE_DB}" "${z}" "${orientation}"
          curved.outer.r curved.inner.r)
        check_curved_reference("${reference}")
        foreach(order IN ITEMS shell_first filling_first)
          if(order STREQUAL "shell_first")
            set(objects curved.shell.r curved.inner.r)
          else()
            set(objects curved.inner.r curved.shell.r)
          endif()
          set(image "${stem}-${order}.exr")
          render_curved("${image}" "${ACTUAL_DB}" "${z}" "${orientation}" ${objects})
          compare_optical_transport("${image}" "${reference}")
        endforeach()
      endforeach()
    endforeach()
  endforeach()
endforeach()
