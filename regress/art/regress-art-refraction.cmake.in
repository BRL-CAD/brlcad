set(WORK "@CMAKE_CURRENT_BINARY_DIR@/refraction-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
foreach(shader IN ITEMS art_refraction_reference art_emission)
  configure_file("@CMAKE_CURRENT_BINARY_DIR@/${shader}.oso"
    "${WORK}/shaders/${shader}.oso" COPYONLY)
endforeach()
set(GLASS_DB "${WORK}/glass.g")
set(REFERENCE_DB "${WORK}/reference.g")
set(VISIBILITY_DB "${WORK}/visibility.g")
run("${VEXEC}" create-material "${GLASS_DB}" as_glass)
run("${VEXEC}" create-material "${REFERENCE_DB}" art_refraction_reference)
run("${VEXEC}" create-material "${VISIBILITY_DB}" art_emission)
run("${VEXEC}" set-material "${VISIBILITY_DB}" OSL.param.in_color "color 0 1 0")
run("${VEXEC}" set-named-material "${VISIBILITY_DB}" receiver.material OSL.param.in_target "int 2")
run("${VEXEC}" set-material "${GLASS_DB}" OSL.param.in_roughness "float 0")
run("${VEXEC}" set-material "${GLASS_DB}" OSL.param.in_transmittance_amount "float 1")
run("${VEXEC}" set-material "${GLASS_DB}" OSL.param.in_surface_transmittance "color 1 1 1")
run("${VEXEC}" set-material "${GLASS_DB}" OSL.param.in_volume_transmittance_distance "float 0")
# Suppress reflected paths to isolate the two transmitted interfaces.
run("${VEXEC}" set-material "${GLASS_DB}" OSL.param.in_reflection_tint "color 0 0 0")
set(RENDER_ARGS -a 0 -E 2 -P 2 -w 64 -n 64 -C 0/0/0
  -c "set samples=16 light_intensity=0" -c "viewsize 40")
foreach(object IN ITEMS cube.r mesh.r refraction_ball.g refraction_ellipsoid.g)
  if(object STREQUAL "refraction_ball.g" OR object STREQUAL "refraction_ellipsoid.g")
    set(shape ellipsoid)
  else()
    set(shape box)
  endif()
  if(object STREQUAL "refraction_ellipsoid.g")
    set(axes "vector 8 10 6")
  else()
    set(axes "vector 10 10 10")
  endif()
  run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_shape "string ${shape}")
  run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_center "point 0 0 0")
  run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_axes "${axes}")
  foreach(elevation IN ITEMS 90 65)
    foreach(perspective IN ITEMS 0 50)
      set(visible "${WORK}/visible_${object}_${elevation}_${perspective}.png")
      run("${EXEC}" ${RENDER_ARGS} -e ${elevation} -p ${perspective}
        -o "${visible}" "${VISIBILITY_DB}" "${object}" receiver.r)
      run("${VEXEC}" check-parameters "${visible}" 64 64)
    endforeach()
  endforeach()
  foreach(ior IN ITEMS 1.5 2)
    foreach(db IN ITEMS "${GLASS_DB}" "${REFERENCE_DB}")
      run("${VEXEC}" set-material "${db}" OSL.param.in_ior "float ${ior}")
    endforeach()
    foreach(elevation IN ITEMS 90 65)
      foreach(perspective IN ITEMS 0 50)
        set(label "${object}_${ior}_${elevation}_${perspective}")
        set(actual "${WORK}/actual_${label}.png")
        set(reference "${WORK}/reference_${label}.png")
        run("${EXEC}" ${RENDER_ARGS} -e ${elevation} -p ${perspective}
          -o "${actual}" "${GLASS_DB}" "${object}" receiver.r)
        run("${EXEC}" ${RENDER_ARGS} -e ${elevation} -p ${perspective}
          -o "${reference}" "${REFERENCE_DB}" "${object}" receiver.r)
        run("${VEXEC}" check-matching-image "${actual}" "${reference}" 64 64)
      endforeach()
    endforeach()
  endforeach()
endforeach()

# Straight-through target coordinates must fail the bent-path comparison.
run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_ior "float 1")
run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_shape "string box")
run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_center "point 0 0 0")
run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_axes "vector 10 10 10")
run("${EXEC}" ${RENDER_ARGS} -e 65 -p 50 -o "${WORK}/straight.png" "${REFERENCE_DB}" cube.r receiver.r)
run("${VEXEC}" check-different-image "${WORK}/actual_cube.r_2_65_50.png" "${WORK}/straight.png" 64 64)
expect_failure("${VEXEC}" check-matching-image "${WORK}/actual_cube.r_2_65_50.png" "${WORK}/straight.png" 64 64)
