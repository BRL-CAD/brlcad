set(WORK "@CMAKE_CURRENT_BINARY_DIR@/image-maps-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders" "${WORK}/textures")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
foreach(shader IN ITEMS art_image_field art_normal_reference art_bump_normal art_emission)
  configure_file("@CMAKE_CURRENT_BINARY_DIR@/${shader}.oso" "${WORK}/shaders/${shader}.oso" COPYONLY)
endforeach()
# Odd/even dimensions avoid the authored diagonal seam.  At this size the
# 16-texel ramps are magnified; clamped linear interpolation is analytic.
set(RENDER_ARGS -a 270 -e 90 -P 2 -c "set samples=1" -w 129 -n 128)
set(TEXTURE_SIZE 16)
set(BUMP_DEPTH 5)
run("@ART_OIIOTOOL_EXECUTABLE@" --pattern
  "fill:topleft=0.25,0.375,1:topright=0.75,0.375,1:bottomleft=0.25,0.625,1:bottomright=0.75,0.625,1"
  "${TEXTURE_SIZE}x${TEXTURE_SIZE}" 3 -d float -o "${WORK}/textures/normal.tif")
run("@ART_OIIOTOOL_EXECUTABLE@" --pattern
  "fill:topleft=0.2:topright=0.6:bottomleft=0.4:bottomright=0.8"
  "${TEXTURE_SIZE}x${TEXTURE_SIZE}" 1 -d float -o "${WORK}/textures/height.tif")
foreach(kind IN ITEMS normal height)
  run("@ART_MAKETX_EXECUTABLE@" -d float --filter box --wrap clamp
    -o "${WORK}/textures/${kind}.tx" "${WORK}/textures/${kind}.tif")
endforeach()

foreach(kind IN ITEMS color normal height)
  set(database "${WORK}/${kind}.g")
  set(reference "${WORK}/${kind}_reference.g")
  if(kind STREQUAL "color")
    set(actual_shader art_emission)
    set(reference_shader art_emission)
    set(reference_input in_color)
    set(reference_output out_color)
    set(filename normal)
  elseif(kind STREQUAL "normal")
    set(actual_shader art_bump_normal)
    set(reference_shader art_normal_reference)
    set(reference_input in_direction)
    set(reference_output out_direction)
    set(filename normal)
  else()
    set(actual_shader art_bump_normal)
    set(reference_shader art_bump_normal)
    set(reference_input in_normal)
    set(reference_output out_height_normal)
    set(filename height)
  endif()
  run("${VEXEC}" create-material "${database}" "${actual_shader}")
  run("${VEXEC}" create-material "${reference}" "${reference_shader}")
  foreach(db IN ITEMS "${database}" "${reference}")
    run("${VEXEC}" set-material "${db}" OSL.version 2)
  endforeach()
  run("${VEXEC}" set-material "${database}" OSL.node.image as_texture)
  run("${VEXEC}" set-material "${database}" OSL.param.image.in_filename "string textures/${filename}.tx")
  run("${VEXEC}" set-material "${database}" OSL.param.image.in_interpolation_method "int 2")
  if(kind STREQUAL "color")
    run("${VEXEC}" set-material "${database}" OSL.connect.material.in_color image.out_color)
  else()
    run("${VEXEC}" set-material "${database}" OSL.node.map as_bump)
    run("${VEXEC}" set-material "${database}" OSL.connect.material.in_normal map.out_normal)
    if(kind STREQUAL "normal")
      run("${VEXEC}" set-material "${database}" OSL.param.map.in_mode "string Normal Map")
      run("${VEXEC}" set-material "${database}" OSL.connect.map.in_normal_map image.out_color)
    else()
      run("${VEXEC}" set-material "${database}" OSL.param.map.in_bump_depth "float ${BUMP_DEPTH}")
      run("${VEXEC}" set-material "${database}" OSL.connect.map.in_bump_value image.out_channel)
    endif()
  endif()
  run("${VEXEC}" set-material "${reference}" OSL.node.field art_image_field)
  run("${VEXEC}" set-material "${reference}" OSL.param.field.in_size "float ${TEXTURE_SIZE}")
  run("${VEXEC}" set-material "${reference}" OSL.param.field.in_depth "float ${BUMP_DEPTH}")
  run("${VEXEC}" set-material "${reference}" "OSL.connect.material.${reference_input}" "field.${reference_output}")
  foreach(object IN ITEMS mesh.r smooth_mesh.r mirror_u_mesh.r mirror_v_mesh.r)
    foreach(axis IN ITEMS u v)
      if(object STREQUAL "mirror_${axis}_mesh.r")
        set(mirror 1)
      else()
        set(mirror 0)
      endif()
      run("${VEXEC}" set-material "${reference}" "OSL.param.field.in_mirror_${axis}" "int ${mirror}")
      if(kind STREQUAL "normal")
        run("${VEXEC}" set-material "${reference}" "OSL.param.in_mirror_${axis}" "int ${mirror}")
      endif()
    endforeach()
    if(kind STREQUAL "normal")
      if(object STREQUAL "smooth_mesh.r")
        set(smooth 1)
      else()
        set(smooth 0)
      endif()
      run("${VEXEC}" set-material "${reference}" OSL.param.in_smooth "int ${smooth}")
    endif()
    foreach(perspective IN ITEMS 0 85)
      set(image "${WORK}/${kind}_${object}_${perspective}.png")
      set(reference_image "${WORK}/${kind}_reference_${object}_${perspective}.png")
      run("${EXEC}" ${RENDER_ARGS} -p ${perspective} -o "${image}" "${database}" "${object}")
      run("${EXEC}" ${RENDER_ARGS} -p ${perspective} -o "${reference_image}" "${reference}" "${object}")
      run("${VEXEC}" check-matching-image "${image}" "${reference_image}" 129 128)
    endforeach()
  endforeach()

  # The opposite image-row convention must visibly disagree for each map.
  foreach(axis IN ITEMS u v)
    run("${VEXEC}" set-material "${reference}" "OSL.param.field.in_mirror_${axis}" "int 0")
    if(kind STREQUAL "normal")
      run("${VEXEC}" set-material "${reference}" "OSL.param.in_mirror_${axis}" "int 0")
    endif()
  endforeach()
  run("${VEXEC}" set-material "${reference}" OSL.param.field.in_flip_t "int 0")
  if(kind STREQUAL "normal")
    run("${VEXEC}" set-material "${reference}" OSL.param.in_smooth "int 0")
  endif()
  set(control "${WORK}/${kind}_wrong_origin.png")
  run("${EXEC}" ${RENDER_ARGS} -p 0 -o "${control}" "${reference}" mesh.r)
  run("${VEXEC}" check-different-image "${control}" "${WORK}/${kind}_mesh.r_0.png" 129 128)
endforeach()
