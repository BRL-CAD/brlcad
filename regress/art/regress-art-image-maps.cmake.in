set(WORK "@CMAKE_CURRENT_BINARY_DIR@/image-maps-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders" "${WORK}/textures")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
foreach(shader IN ITEMS art_array_values art_image_field art_normal_reference art_bump_normal art_emission)
  configure_file("@CMAKE_CURRENT_BINARY_DIR@/${shader}.oso" "${WORK}/shaders/${shader}.oso" COPYONLY)
endforeach()
# Odd/even dimensions avoid the authored diagonal seam.  At this size the
# 16-texel ramps are magnified; clamped linear interpolation is analytic.
set(RENDER_ARGS -a 270 -P 2 -c "set samples=1" -w 129 -n 128)
set(MESH_OBJECTS mesh.r smooth_mesh.r mirror_u_mesh.r mirror_v_mesh.r)
set(CURVED_OBJECTS ball.r ellipsoid.r)
set(TEXTURE_SIZE 16)
# Keep height slopes visible after reducing the sampled chart region.
set(BUMP_DEPTH 20)
run("@ART_OIIOTOOL_EXECUTABLE@" --pattern
  "fill:topleft=0.25,0.375,1:topright=0.75,0.375,1:bottomleft=0.25,0.625,1:bottomright=0.75,0.625,1"
  "${TEXTURE_SIZE}x${TEXTURE_SIZE}" 3 -d float -o "${WORK}/textures/normal.tif")
run("@ART_OIIOTOOL_EXECUTABLE@" --pattern
  "fill:topleft=0.2:topright=0.6:bottomleft=0.4:bottomright=0.8"
  "${TEXTURE_SIZE}x${TEXTURE_SIZE}" 1 -d float -o "${WORK}/textures/height.tif")
foreach(kind IN ITEMS normal height)
  run("@ART_MAKETX_EXECUTABLE@" -d float --filter box --wrap clamp
    -o "${WORK}/textures/${kind}.tx" "${WORK}/textures/${kind}.tif")
endforeach()

function(compare_maps kind database reference prefix objects)
  foreach(object IN LISTS objects)
    if(object STREQUAL "ball.r")
      set(chart 1)
    elseif(object STREQUAL "ellipsoid.r")
      set(chart 2)
    else()
      set(chart 0)
    endif()
    run("${VEXEC}" set-material "${reference}" OSL.param.field.in_chart "int ${chart}")
    if(kind STREQUAL "normal")
      run("${VEXEC}" set-material "${reference}" OSL.param.in_chart "int ${chart}")
    endif()
    foreach(axis IN ITEMS u v)
      if(object STREQUAL "mirror_${axis}_mesh.r")
        set(mirror 1)
      else()
        set(mirror 0)
      endif()
      run("${VEXEC}" set-material "${reference}" "OSL.param.field.in_mirror_${axis}" "int ${mirror}")
      if(kind STREQUAL "normal")
        run("${VEXEC}" set-material "${reference}" "OSL.param.in_mirror_${axis}" "int ${mirror}")
      endif()
    endforeach()
    if(kind STREQUAL "normal")
      if(object STREQUAL "smooth_mesh.r")
        set(smooth 1)
      else()
        set(smooth 0)
      endif()
      run("${VEXEC}" set-material "${reference}" OSL.param.in_smooth "int ${smooth}")
    endif()
    if(chart)
      set(elevations 20 90)
    else()
      set(elevations 90)
    endif()
    foreach(elevation IN LISTS elevations)
      set(view "${object}")
      if(chart)
        string(APPEND view "_${elevation}")
      endif()
      foreach(perspective IN ITEMS 0 85)
        set(image "${WORK}/${prefix}_${view}_${perspective}.png")
        set(reference_image "${WORK}/${prefix}_reference_${view}_${perspective}.png")
        run("${EXEC}" ${RENDER_ARGS} -e ${elevation} -p ${perspective} -o "${image}" "${database}" "${object}")
        run("${EXEC}" ${RENDER_ARGS} -e ${elevation} -p ${perspective} -o "${reference_image}" "${reference}" "${object}")
        run("${VEXEC}" check-matching-image "${image}" "${reference_image}" 129 128)
      endforeach()
    endforeach()
  endforeach()
endfunction()

foreach(kind IN ITEMS color normal height)
  set(database "${WORK}/${kind}.g")
  set(reference "${WORK}/${kind}_reference.g")
  if(kind STREQUAL "color")
    set(actual_shader art_emission)
    set(reference_shader art_emission)
    set(reference_input in_color)
    set(reference_output out_color)
    set(filename normal)
  elseif(kind STREQUAL "normal")
    set(actual_shader art_bump_normal)
    set(reference_shader art_normal_reference)
    set(reference_input in_direction)
    set(reference_output out_direction)
    set(filename normal)
  else()
    set(actual_shader art_bump_normal)
    set(reference_shader art_bump_normal)
    set(reference_input in_normal)
    set(reference_output out_height_normal)
    set(filename height)
  endif()
  run("${VEXEC}" create-material "${database}" "${actual_shader}")
  run("${VEXEC}" create-material "${reference}" "${reference_shader}")
  foreach(db IN ITEMS "${database}" "${reference}")
    run("${VEXEC}" set-material "${db}" OSL.version 2)
  endforeach()
  run("${VEXEC}" set-material "${database}" OSL.node.image as_texture)
  run("${VEXEC}" set-material "${database}" OSL.param.image.in_filename "string textures/${filename}.tx")
  run("${VEXEC}" set-material "${database}" OSL.param.image.in_interpolation_method "int 2")
  if(kind STREQUAL "color")
    run("${VEXEC}" set-material "${database}" OSL.connect.material.in_color image.out_color)
  else()
    run("${VEXEC}" set-material "${database}" OSL.node.map as_bump)
    run("${VEXEC}" set-material "${database}" OSL.connect.material.in_normal map.out_normal)
    if(kind STREQUAL "normal")
      run("${VEXEC}" set-material "${database}" OSL.param.map.in_mode "string Normal Map")
      run("${VEXEC}" set-material "${database}" OSL.connect.map.in_normal_map image.out_color)
    else()
      run("${VEXEC}" set-material "${database}" OSL.param.map.in_bump_depth "float ${BUMP_DEPTH}")
      run("${VEXEC}" set-material "${database}" OSL.connect.map.in_bump_value image.out_channel)
    endif()
  endif()
  run("${VEXEC}" set-material "${reference}" OSL.node.field art_image_field)
  run("${VEXEC}" set-material "${reference}" OSL.param.field.in_size "float ${TEXTURE_SIZE}")
  run("${VEXEC}" set-material "${reference}" OSL.param.field.in_depth "float ${BUMP_DEPTH}")
  run("${VEXEC}" set-material "${reference}" "OSL.connect.material.${reference_input}" "field.${reference_output}")
  compare_maps("${kind}" "${database}" "${reference}" "${kind}" "${MESH_OBJECTS}")

  # The opposite image-row convention must visibly disagree for each map.
  foreach(axis IN ITEMS u v)
    run("${VEXEC}" set-material "${reference}" "OSL.param.field.in_mirror_${axis}" "int 0")
    if(kind STREQUAL "normal")
      run("${VEXEC}" set-material "${reference}" "OSL.param.in_mirror_${axis}" "int 0")
    endif()
  endforeach()
  run("${VEXEC}" set-material "${reference}" OSL.param.field.in_flip_t "int 0")
  if(kind STREQUAL "normal")
    run("${VEXEC}" set-material "${reference}" OSL.param.in_smooth "int 0")
  endif()
  set(control "${WORK}/${kind}_wrong_origin.png")
  run("${EXEC}" ${RENDER_ARGS} -e 90 -p 0 -o "${control}" "${reference}" mesh.r)
  run("${VEXEC}" check-different-image "${control}" "${WORK}/${kind}_mesh.r_0.png" 129 128)

  set(unplaced "${WORK}/${kind}_unplaced.g")
  configure_file("${database}" "${unplaced}" COPYONLY)

  # A native placement node feeds the image's float[2] coordinate input.
  # Its offset precedes tiling: these settings sample [0.25,0.75] in U
  # and [0.25,0.5] in V, without periodic seams.
  run("${VEXEC}" set-material "${reference}" OSL.param.field.in_flip_t "int 1")
  run("${VEXEC}" set-material "${database}" OSL.node.placement as_max_uv_transform)
  run("${VEXEC}" set-material "${database}" OSL.param.placement.in_tilingU "float 0.5")
  run("${VEXEC}" set-material "${database}" OSL.param.placement.in_tilingV "float 0.25")
  run("${VEXEC}" set-material "${database}" OSL.param.placement.in_offsetU "float -0.5")
  run("${VEXEC}" set-material "${database}" OSL.param.placement.in_offsetV "float -1")
  run("${VEXEC}" set-material "${database}" OSL.connect.image.in_texture_coords placement.out_outUV)
  run("${VEXEC}" set-material "${reference}" OSL.param.field.in_scale_u "float 0.5")
  run("${VEXEC}" set-material "${reference}" OSL.param.field.in_scale_v "float 0.25")
  run("${VEXEC}" set-material "${reference}" OSL.param.field.in_offset_u "float 0.25")
  run("${VEXEC}" set-material "${reference}" OSL.param.field.in_offset_v "float 0.25")
  compare_maps("${kind}" "${database}" "${reference}" "${kind}_placed" "${MESH_OBJECTS}")
  if(kind STREQUAL "height")
    # Loss of the connected height derivatives must fail the same oracle.
    set(disabled "${WORK}/height_disabled.g")
    configure_file("${database}" "${disabled}" COPYONLY)
    run("${VEXEC}" set-material "${disabled}" OSL.param.map.in_bump_depth "float 0")
    run("${EXEC}" ${RENDER_ARGS} -e 90 -p 0 -o "${WORK}/height_disabled.png" "${disabled}" smooth_mesh.r)
    expect_failure("${VEXEC}" check-matching-image "${WORK}/height_disabled.png"
      "${WORK}/height_placed_reference_smooth_mesh.r_0.png" 129 128)
  endif()
  # Independent curved charts cover oblique and near-pole views.
  compare_maps("${kind}" "${database}" "${reference}" "${kind}_curved_placed" "${CURVED_OBJECTS}")
  foreach(axis IN ITEMS u v)
    run("${VEXEC}" set-material "${reference}" "OSL.param.field.in_scale_${axis}" "float 1")
    run("${VEXEC}" set-material "${reference}" "OSL.param.field.in_offset_${axis}" "float 0")
  endforeach()
  if(kind STREQUAL "height")
    run("${VEXEC}" set-material "${reference}" OSL.param.field.in_height_filename "string textures/height.tx")
  endif()
  compare_maps("${kind}" "${unplaced}" "${reference}" "${kind}_curved_unplaced" "${CURVED_OBJECTS}")
  if(kind STREQUAL "height")
    # Halving the finite-difference step must retain the filtered reference.
    set(convergence "${WORK}/height_convergence.g")
    configure_file("${reference}" "${convergence}" COPYONLY)
    run("${VEXEC}" set-material "${convergence}" OSL.param.field.in_difference_step "float 0.00006103515625")
    run("${EXEC}" ${RENDER_ARGS} -e 90 -p 85 -o "${WORK}/height_convergence.png" "${convergence}" ellipsoid.r)
    run("${VEXEC}" check-matching-image "${WORK}/height_convergence.png"
      "${WORK}/height_curved_unplaced_reference_ellipsoid.r_90_85.png" 129 128)
  endif()

endforeach()

# Check array shape and element types before handing the graph to OSL.
set(ARRAY_DB "${WORK}/arrays.g")
run("${VEXEC}" create-material "${ARRAY_DB}" art_emission)
run("${VEXEC}" set-material "${ARRAY_DB}" OSL.version 2)
run("${VEXEC}" set-material "${ARRAY_DB}" OSL.node.image as_texture)
run("${VEXEC}" set-material "${ARRAY_DB}" OSL.param.image.in_filename "string textures/normal.tx")
run("${VEXEC}" set-material "${ARRAY_DB}" OSL.param.image.in_interpolation_method "int 2")
run("${VEXEC}" set-material "${ARRAY_DB}" OSL.node.values art_array_values)
run("${VEXEC}" set-material "${ARRAY_DB}" OSL.connect.image.in_texture_coords values.out_uv)
run("${VEXEC}" set-material "${ARRAY_DB}" OSL.connect.material.in_color image.out_color)
run("${EXEC}" ${RENDER_ARGS} -e 90 -p 0 -o "${WORK}/arrays.png" "${ARRAY_DB}" mesh.r)
run("${VEXEC}" check-matching-image "${WORK}/arrays.png" "${WORK}/color_mesh.r_0.png" 129 128)

function(invalid_array name destination source)
  set(database "${WORK}/${name}.g")
  set(image "${WORK}/${name}.png")
  set(LOG "${WORK}/${name}.log")
  configure_file("${ARRAY_DB}" "${database}" COPYONLY)
  run("${VEXEC}" set-material "${database}" "OSL.connect.${destination}" "${source}")
  expect_failure("${EXEC}" ${RENDER_ARGS} -e 90 -p 0 -o "${image}" "${database}" mesh.r)
  file(READ "${LOG}" diagnostic)
  if(EXISTS "${image}" OR NOT diagnostic MATCHES "has invalid OSL connection")
    message(FATAL_ERROR "Expected an array connection validation error: ${name}")
  endif()
endfunction()
invalid_array(array_length image.in_texture_coords values.out_three)
invalid_array(array_element_type image.in_texture_coords values.out_ints)
invalid_array(scalar_to_array image.in_texture_coords values.out_scalar)
invalid_array(array_to_scalar image.in_s_filter_width values.out_uv)
invalid_array(unsized_array values.in_unsized values.out_uv)
