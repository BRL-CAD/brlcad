set(WORK "@CMAKE_CURRENT_BINARY_DIR@/standard-materials-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders" "${WORK}/cache")
set(ENV{BU_DIR_CACHE} "${WORK}/cache")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_nested_test_commands.cmake")
configure_file("@CMAKE_CURRENT_BINARY_DIR@/art_glass_footprint_field.oso"
  "${WORK}/shaders/art_glass_footprint_field.oso" COPYONLY)
set(TOOL "@ART_OIIOTOOL_EXECUTABLE@")
set(SIZE 16)
set(TOLERANCE 0.0000005)
set(MIN_RADIANCE 0.0001)
set(RENDER_ARGS -P 1 -w ${SIZE} -n ${SIZE} -c "viewsize 20"
  -c "eye_pt 2 -2 40" -c "orientation 0 0 0 1"
  -c "set sampling=uniform samples=4 light_intensity=8 environment_intensity=1 environment_color=white background_color=black")

function(render_material label shape projection)
  set(image "${WORK}/${label}-${shape}-${projection}.exr")
  run_in("${WORK}" "${EXEC}" ${RENDER_ARGS} -p ${projection}
    -o "${image}" "${WORK}/${label}.g" "${shape}.r")
  run("${VEXEC}" check-image "${image}" ${SIZE} ${SIZE})
  if(label STREQUAL "disabled")
    run("${TOOL}" --fail 0 --hardfail 0 "${image}" --ch R,G,B
      --pattern constant:color=0,0,0 ${SIZE}x${SIZE} 3 --diff)
  else()
    # Require a positive mean in every channel, preventing agreement
    # between black images after a missing closure or rejected samples.
    run("${TOOL}" --fail 0 --hardfail 0 "${image}" --ch R,G,B --resize:filter=box 1x1
      --minc ${MIN_RADIANCE}
      --pattern "constant:color=${MIN_RADIANCE},${MIN_RADIANCE},${MIN_RADIANCE}" 1x1 3 --diff)
  endif()
endfunction()

foreach(label IN ITEMS default zero parameter connected substrate disabled diffuse maya)
  set(db "${WORK}/${label}.g")
  if(label STREQUAL "maya")
    run("${VEXEC}" create-material "${db}" as_maya_anisotropic out_outColor)
    foreach(pair IN ITEMS "in_diffuse|float 0" "in_roughness|float 0.25"
      "in_spreadX|float 0.5" "in_spreadY|float 1")
      string(REPLACE "|" ";" parameter "${pair}")
      list(GET parameter 0 name)
      list(GET parameter 1 value)
      run("${VEXEC}" set-material "${db}" "OSL.param.${name}" "${value}")
    endforeach()
  else()
    run("${VEXEC}" create-material "${db}" as_standard_surface out_outColor)
    run("${VEXEC}" set-material "${db}" OSL.param.in_diffuse_weight "float 0")
    run("${VEXEC}" set-material "${db}" OSL.param.in_specular_color "color 0 0 0")
    run("${VEXEC}" set-material "${db}" OSL.param.in_coating_reflectivity "float 1")
    run("${VEXEC}" set-material "${db}" OSL.param.in_coating_roughness "float 0.25")
    run("${VEXEC}" set-material "${db}" OSL.param.in_coating_ior "float 1.5")
    if(label STREQUAL "zero")
      run("${VEXEC}" set-material "${db}" OSL.param.in_bump_normal_coating "normal 0 0 0")
    elseif(label STREQUAL "parameter")
      run("${VEXEC}" set-material "${db}" OSL.param.in_bump_normal_coating "normal 0.5 0 1")
    elseif(label STREQUAL "connected")
      run("${VEXEC}" set-material "${db}" OSL.version 2)
      run("${VEXEC}" set-material "${db}" OSL.node.field art_glass_footprint_field)
      run("${VEXEC}" set-material "${db}" OSL.param.field.in_slope "float 0")
      run("${VEXEC}" set-material "${db}" OSL.param.field.in_base "float 0.5")
      run("${VEXEC}" set-material "${db}" OSL.connect.material.in_bump_normal_coating field.out_normal)
    elseif(label STREQUAL "substrate")
      run("${VEXEC}" set-material "${db}" OSL.param.in_bump_normal_substrate "normal 0.5 0 1")
    elseif(label STREQUAL "disabled" OR label STREQUAL "diffuse")
      run("${VEXEC}" set-material "${db}" OSL.param.in_coating_reflectivity "float 0")
      if(label STREQUAL "diffuse")
        run("${VEXEC}" set-material "${db}" OSL.param.in_diffuse_weight "float 1")
        run("${VEXEC}" set-material "${db}" OSL.param.in_color "color 0.5 0.5 0.5")
        run("${VEXEC}" set-material "${db}" OSL.param.in_diffuse_roughness "float 0.1")
      endif()
    endif()
  endif()
  foreach(shape IN ITEMS cube mesh)
    foreach(projection IN ITEMS 0 2)
      render_material("${label}" "${shape}" ${projection})
    endforeach()
  endforeach()
endforeach()

foreach(shape IN ITEMS cube mesh)
  foreach(projection IN ITEMS 0 2)
    set(suffix "${shape}-${projection}.exr")
    run("${TOOL}" --fail 0 --hardfail 0 "${WORK}/default-${suffix}" "${WORK}/zero-${suffix}" --diff)
    # A normalized node output and a literal normal may straddle an EXR
    # rounding boundary. Use the shared half-precision arithmetic bound.
    compare_optical_transport("${WORK}/parameter-${suffix}" "${WORK}/connected-${suffix}")
    compare_optical_transport("${WORK}/parameter-${suffix}" "${WORK}/substrate-${suffix}")
    expect_failure("${TOOL}" --fail 0 --hardfail 0
      "${WORK}/default-${suffix}" "${WORK}/parameter-${suffix}" --diff)
  endforeach()
endforeach()
