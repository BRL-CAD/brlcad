cmake_minimum_required(VERSION 3.22)
set(WORK "@CMAKE_CURRENT_BINARY_DIR@/photon-cancel-output")
include("@CMAKE_CURRENT_BINARY_DIR@/art_photon_test_commands.cmake")
set(ART_COMMAND_TIMEOUT 30)
set(LONG_PHOTONS 4000000)
set(long_tracing "tracing 4,000,000 sppm light photons")
set(PHOTON_SETTINGS "integrator=sppm passes=2 light_photons=${LONG_PHOTONS} environment_photons=0 max_bounces=0 photon_max_bounces=2 photon_importons=0")
set(sentinel "preserve existing photon image")
foreach(mode IN ITEMS single quiet framebuffer later-pass)
  set(output "${WORK}/${mode}.exr")
  file(WRITE "${output}" "${sentinel}")
  set(arguments)
  set(ready "${long_tracing}")
  if(mode STREQUAL quiet)
    list(APPEND arguments -c "set progress=0")
  elseif(mode STREQUAL framebuffer)
    list(APPEND arguments -F "${WORK}/display.fb")
  elseif(mode STREQUAL later-pass)
    list(APPEND arguments -c "set passes=100000 light_photons=1000")
    set(ready "--- beginning rendering pass #2 ---")
  endif()
  run("${VEXEC}" interrupt-render "${WORK}/${mode}.log" "${ready}" -
    "${EXEC}" ${BASE_ARGS} -c "set ${PHOTON_SETTINGS}" ${arguments}
    -o "${output}" "${ACTUAL_DB}" receiver.box.r key_light.r)
  file(READ "${output}" retained)
  if(NOT retained STREQUAL sentinel)
    message(FATAL_ERROR "Cancelled photon rendering replaced ${mode} output")
  endif()
  file(READ "${WORK}/${mode}.log" cancelled)
  if(cancelled MATCHES "art: frame 0 complete:")
    message(FATAL_ERROR "Cancelled photon rendering was reported complete")
  endif()
endforeach()
if(NOT EXISTS "${WORK}/display.fb")
  message(FATAL_ERROR "Photon cancellation did not exercise the framebuffer")
endif()
file(WRITE "${WORK}/frames.view"
  "start 0; set passes=1 light_photons=1000; end; start 1; set passes=2 light_photons=${LONG_PHOTONS}; end; start 2; end;\n")
foreach(frame IN ITEMS 1 2)
  file(WRITE "${WORK}/frames.${frame}.exr" "${sentinel}")
endforeach()
run("${VEXEC}" interrupt-render "${WORK}/frames.log" "${long_tracing}"
  "${WORK}/frames.view" "${EXEC}" ${BASE_ARGS} -M -c "set ${PHOTON_SETTINGS}"
  -o "${WORK}/frames.exr" "${ACTUAL_DB}" receiver.box.r key_light.r)
run("${VEXEC}" check-image "${WORK}/frames.exr" ${SIZE} ${SIZE})
foreach(frame IN ITEMS 1 2)
  file(READ "${WORK}/frames.${frame}.exr" retained)
  if(NOT retained STREQUAL sentinel)
    message(FATAL_ERROR "Photon cancellation replaced frame ${frame}")
  endif()
endforeach()
file(READ "${WORK}/frames.log" frame_output)
if(frame_output MATCHES "art: frame [12] complete:|art: frame 2 rendering")
  message(FATAL_ERROR "A cancelled photon frame stream continued rendering")
endif()
