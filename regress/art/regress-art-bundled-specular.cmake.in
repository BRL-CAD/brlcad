set(WORK "@CMAKE_CURRENT_BINARY_DIR@/bundled-specular-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders" "${WORK}/cache")
set(ENV{BU_DIR_CACHE} "${WORK}/cache")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_footprint_test_commands.cmake")
foreach(shader IN ITEMS art_glass_footprint_field art_glass_footprint_reference art_specular_footprint art_normal_vector)
  configure_file("@CMAKE_CURRENT_BINARY_DIR@/${shader}.oso" "${WORK}/shaders/${shader}.oso" COPYONLY)
endforeach()
file(READ "@CMAKE_CURRENT_SOURCE_DIR@/art_bundled_specular_cases.json" CASES)
set(TOOL "@ART_OIIOTOOL_EXECUTABLE@")
set(SIZE 16)
set(TOLERANCE 0.00002)
set(BINARY16_RELATIVE_BOUND 0.0009765625)
# Analytic paths and sampled first-order footprints have separate rounding
# and approximation budgets. Matched canonical paths need only rounding.
set(FOOTPRINT_RELATIVE_BOUND 0.0109765625)
set(RENDER_ARGS -P 1 -c "viewsize 0.5" -c "orientation 0 0 0 1"
  -c "set sampling=uniform samples=1 max_bounces=16 max_specular_bounces=16 rr_min_path_length=0 light_intensity=0 environment_intensity=0 background_color=black")
function(set_case_parameters db member)
  string(JSON count LENGTH "${CASES}" ${case} ${member})
  if(count EQUAL 0)
    return()
  endif()
  math(EXPR last "${count} - 1")
  foreach(index RANGE ${last})
    string(JSON name MEMBER "${CASES}" ${case} ${member} ${index})
    string(JSON value GET "${CASES}" ${case} ${member} "${name}")
    run("${VEXEC}" set-material "${db}" "OSL.param.${name}" "${value}")
  endforeach()
endfunction()
function(set_bundled_mapping mapping center curved)
  foreach(name IN ITEMS OSL.node.adapter OSL.connect.adapter.in_normal)
    run("${VEXEC}" remove-material "${ACTUAL_DB}" "${name}")
  endforeach()
  set(update_reference TRUE)
  if(canonical)
    set(update_reference FALSE)
  endif()
  set_footprint_mapping("${mapping}" "${center}" ${reflection} ${curved} "${normal_input}" ${update_reference})
  if(normal_input STREQUAL "Normal")
    # Max material interfaces expose legacy vector inputs. Keep strict
    # graph typing and convert explicitly, preserving the normal field.
    if(NOT mapping STREQUAL "unmapped")
      set(source field.out_normal)
      if(mapping STREQUAL "bump")
        set(source bump.out_normal)
      endif()
      run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.node.adapter art_normal_vector)
      run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.connect.adapter.in_normal "${source}")
      run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.connect.material.Normal adapter.out_vector)
    elseif(reflection AND NOT curved)
      run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.param.Normal "vector 0.3 0 1")
    endif()
  endif()
endfunction()
string(JSON count LENGTH "${CASES}")
math(EXPR last_case "${count} - 1")
run("${TOOL}" --pattern constant:color=0,0,0 ${SIZE}x${SIZE} 3 -o "${WORK}/black.exr")
foreach(case RANGE ${last_case})
  foreach(member IN ITEMS name shader normal output reflection unweighted canonical)
    string(JSON ${member} GET "${CASES}" ${case} ${member})
  endforeach()
  set(normal_input "${normal}")
  set(ACTUAL_DB "${WORK}/${name}.g")
  set(REFERENCE_DB "${WORK}/${name}-reference.g")
  run("${VEXEC}" create-material "${ACTUAL_DB}" "${shader}")
  set(reference_shader art_glass_footprint_reference)
  if(canonical)
    set(reference_shader "${canonical}")
  endif()
  run("${VEXEC}" create-material "${REFERENCE_DB}" "${reference_shader}")
  foreach(db IN ITEMS "${ACTUAL_DB}" "${REFERENCE_DB}")
    run("${VEXEC}" set-material "${db}" OSL.version 2)
  endforeach()
  run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.output "${output}")
  set_case_parameters("${ACTUAL_DB}" parameters)
  create_footprint_receivers()
  if(NOT canonical)
    set_footprint_reference(reflection "int ${reflection}")
    set_footprint_reference(ior "float 1.5")
  endif()
  set(unweighted_value 0)
  if(unweighted)
    set(unweighted_value 1)
  endif()
  if(NOT canonical)
    set_footprint_reference(unweighted "int ${unweighted_value}")
  endif()
  set(relative_bound ${FOOTPRINT_RELATIVE_BOUND})
  if(canonical)
    set(relative_bound ${BINARY16_RELATIVE_BOUND})
    run("${VEXEC}" set-material "${REFERENCE_DB}" OSL "${canonical}")
    string(JSON canonical_output GET "${CASES}" ${case} canonical_output)
    if(canonical_output)
      run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.output "${canonical_output}")
    endif()
    set_case_parameters("${REFERENCE_DB}" canonical_parameters)
  endif()
  foreach(shape IN ITEMS cube mesh ball ellipsoid)
    set(curved 0)
    set(center "0 0 0")
    set(eye_x 2)
    set(axes "10 10 10")
    set(target receiver.r)
    if(reflection)
      set(target front.r)
    endif()
    if(shape STREQUAL "ball" OR shape STREQUAL "ellipsoid")
      set(curved 1)
      set(center "-15 0 0")
      set(eye_x -13)
      if(reflection)
        set(target curved_front.r)
      endif()
    endif()
    if(shape STREQUAL "ellipsoid")
      set(axes "8 10 6")
    endif()
    if(NOT canonical)
      set_footprint_reference(curved "int ${curved}")
      set_footprint_reference(center "point ${center}")
      set_footprint_reference(axes "vector ${axes}")
    endif()
    foreach(mapping IN ITEMS unmapped direct bump)
      if(curved AND NOT mapping STREQUAL "unmapped")
        continue()
      endif()
      if(canonical)
        # Configure the two independent user graphs identically while
        # retaining their distinct shader roots and parameter interfaces.
        set(saved_actual "${ACTUAL_DB}")
        set(ACTUAL_DB "${REFERENCE_DB}")
        set_footprint_mapping("${mapping}" "${center}" ${reflection} ${curved} in_bump_normal FALSE)
        set(ACTUAL_DB "${saved_actual}")
      endif()
      set_bundled_mapping("${mapping}" "${center}" ${curved})
      foreach(mode IN ITEMS 0 1)
        if(NOT canonical)
          set_footprint_reference(mode "int ${mode}")
        else()
          run("${VEXEC}" set-named-material "${REFERENCE_DB}" receiver.material OSL.param.in_mode "int ${mode}")
        endif()
        run("${VEXEC}" set-named-material "${ACTUAL_DB}" receiver.material OSL.param.in_mode "int ${mode}")
        foreach(projection IN ITEMS 0 2)
          set(label "${name}-${shape}-${mapping}-${mode}-${projection}")
          compare_footprint_paths("${label}" ${SIZE} ${projection} ${eye_x}
            "${shape}" "${target}" ${mode} ${relative_bound})
        endforeach()
      endforeach()
    endforeach()
  endforeach()
endforeach()
