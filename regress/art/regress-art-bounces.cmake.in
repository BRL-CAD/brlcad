set(WORK "@CMAKE_CURRENT_BINARY_DIR@/bounces-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders" "${WORK}/cache")
set(ENV{BU_DIR_CACHE} "${WORK}/cache")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
set(TOOL "@ART_OIIOTOOL_EXECUTABLE@")
configure_file("@CMAKE_CURRENT_BINARY_DIR@/art_refraction_reference.oso"
  "${WORK}/shaders/art_refraction_reference.oso" COPYONLY)
set(RENDER_ARGS -P 1 -w 4 -n 4
  -c "set samples=16 light_intensity=0 environment_color=white environment_intensity=0.4 background_color=black next_event_estimation=0"
  -c "viewsize 4" -c "eye_pt 0 0 40" -c "orientation 0 0 0 1")
set(DIFF_ARGS --fail 0 --hardfail 0 --warn 0 --hardwarn 0)
run("${TOOL}" --pattern constant:color=0,0,0,1 4x4 4 -o "${WORK}/black.exr")
function(render name settings)
  run("${EXEC}" ${RENDER_ARGS} -c "set ${settings}"
    -o "${WORK}/${name}.exr" "${DB}" "${object}" ${extra_objects})
endfunction()
function(matches actual expected)
  run("${TOOL}" ${DIFF_ARGS} "${WORK}/${actual}.exr" "${WORK}/${expected}.exr" --diff)
endfunction()
function(nonblack actual)
  expect_failure("${TOOL}" ${DIFF_ARGS} "${WORK}/${actual}.exr" "${WORK}/black.exr" --diff)
endfunction()
foreach(kind IN ITEMS glossy glass)
  set(DB "${WORK}/${kind}.g")
  set(extra_objects)
  if(kind STREQUAL glossy)
    run("${VEXEC}" create-material "${DB}" as_metal)
    run("${VEXEC}" set-material "${DB}" OSL.param.in_face_reflectance "color 1 1 1")
    run("${VEXEC}" set-material "${DB}" OSL.param.in_roughness "float 0.3")
    set(cap max_glossy_bounces)
    set(required 1)
  else()
    run("${VEXEC}" create-material "${DB}" as_glass)
    run("${VEXEC}" set-material "${DB}" OSL.param.in_roughness "float 0")
    run("${VEXEC}" set-material "${DB}" OSL.param.in_transmittance_amount "float 1")
    run("${VEXEC}" set-material "${DB}" OSL.param.in_surface_transmittance "color 1 1 1")
    run("${VEXEC}" set-material "${DB}" OSL.param.in_volume_transmittance_distance "float 0")
    run("${VEXEC}" set-material "${DB}" OSL.param.in_reflection_tint "color 0 0 0")
    run("${VEXEC}" set-named-material "${DB}" receiver.material OSL.param.in_target "int 2")
    set(extra_objects receiver.r)
    set(cap max_specular_bounces)
    set(required 2)
  endif()
  foreach(object IN ITEMS cube.r mesh.r)
    set(label "${kind}-${object}")
    render("${label}-reference" "${cap}=inherit")
    nonblack("${label}-reference")
    render("${label}-zero" "${cap}=0")
    matches("${label}-zero" black)
    render("${label}-enough" "${cap}=${required}")
    matches("${label}-enough" "${label}-reference")
    render("${label}-unlimited" "${cap}=-1 max_bounces=-1 rr_min_path_length=0")
    matches("${label}-unlimited" "${label}-reference")
    if(kind STREQUAL glass)
      render("${label}-one" "${cap}=1")
      matches("${label}-one" black)
      # The native global limit excludes the first lighting bounce.
      render("${label}-global-zero" "max_bounces=0")
      matches("${label}-global-zero" black)
      render("${label}-global-one" "max_bounces=1")
      matches("${label}-global-one" "${label}-reference")
      file(WRITE "${WORK}/${label}.view"
        "start 0; set max_specular_bounces=0; end;\n"
        "start 1; set max_specular_bounces=2; end;\n"
        "start 2; clean; end;\n"
        "start 3; set max_specular_bounces=inherit; end;\n")
      run(INPUT_FILE "${WORK}/${label}.view" "${EXEC}" ${RENDER_ARGS} -M
        -o "${WORK}/${label}-frames.exr" "${DB}" "${object}" ${extra_objects})
      matches("${label}-frames" black)
      foreach(frame IN ITEMS 1 2 3)
        matches("${label}-frames.${frame}" "${label}-reference")
      endforeach()
    endif()
  endforeach()
endforeach()

set(controls max_bounces max_diffuse_bounces max_glossy_bounces max_specular_bounces
  rr_min_path_length next_event_estimation enable_caustics)
run_command("${CMAKE_CURRENT_BINARY_DIR}" FALSE "${EXEC}" -c "set inspect_materials=1"
  -c set "${DB}" cube.r)
foreach(control IN LISTS controls)
  if(NOT command_output MATCHES "${control}=inherit")
    message(FATAL_ERROR "Native default was overridden for ${control}")
  endif()
endforeach()
set(assignments "")
foreach(control IN LISTS controls)
  string(APPEND assignments " ${control}=0")
endforeach()
set(resets "")
foreach(control IN LISTS controls)
  string(APPEND resets " ${control}=inherit")
endforeach()
run_command("${CMAKE_CURRENT_BINARY_DIR}" FALSE "${EXEC}" -c "set inspect_materials=1"
  -c "set ${assignments}" -c "set ${resets}" -c set "${DB}" cube.r)
foreach(control IN LISTS controls)
  if(NOT command_output MATCHES "${control}=inherit")
    message(FATAL_ERROR "Reset missed ${control}")
  endif()
endforeach()
set(image "${WORK}/invalid.exr")
foreach(setting IN ITEMS "max_bounces=-2" "max_diffuse_bounces=-2" "max_glossy_bounces=2147483648"
    "max_specular_bounces=1junk" "max_bounces=1.5" "rr_min_path_length=-1"
    "next_event_estimation=-1" "next_event_estimation=2" "next_event_estimation=!"
    "max_bounces=0 next_event_estimation=2"
    "enable_caustics=-1" "enable_caustics=2" "enable_caustics=1junk"
    "max_bounces=0 enable_caustics=2")
  file(WRITE "${image}" "preserve existing output")
  expect_failure_matching("invalid setting" "${EXEC}" -c "set ${setting}"
    -o "${image}" "${DB}" cube.r)
  file(READ "${image}" retained)
  if(NOT retained STREQUAL "preserve existing output")
    message(FATAL_ERROR "Invalid bounce setting replaced existing output")
  endif()
endforeach()
