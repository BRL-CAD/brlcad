set(WORK "@CMAKE_CURRENT_BINARY_DIR@/metal-energy-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
configure_file("@CMAKE_CURRENT_BINARY_DIR@/art_emission.oso"
  "${WORK}/shaders/art_emission.oso" COPYONLY)
set(METAL_DB "${WORK}/metal.g")
run("${VEXEC}" create-material "${METAL_DB}" as_metal)
set(RENDER_ARGS -a 0 -e 90 -p 0 -E 2 -P 2 -w 64 -n 64 -C 255/255/255
  -c "viewsize 50")
# Compensated white metal must return the constant environment.  The
# uncompensated control also proves that the tested geometry is visible.
set(UNIFORM_DB "${WORK}/uniform.g")
run("${VEXEC}" create-material "${UNIFORM_DB}" art_emission)
run("${VEXEC}" set-material "${UNIFORM_DB}" OSL.param.in_color "color 0.4 0.4 0.4")
run("${EXEC}" ${RENDER_ARGS}
  -c "set samples=16 light_intensity=0"
  -o "${WORK}/uniform.png" "${UNIFORM_DB}" cube.r)
run("${VEXEC}" set-material "${METAL_DB}" OSL.param.in_face_reflectance "color 1 1 1")
run("${VEXEC}" set-material "${METAL_DB}" OSL.param.in_energy_compensation "float 1")
foreach(roughness IN ITEMS 0.35 0.8)
  run("${VEXEC}" set-material "${METAL_DB}" OSL.param.in_roughness "float ${roughness}")
  foreach(object IN ITEMS cube.r mesh.r)
    set(actual "${WORK}/furnace_${roughness}_${object}.png")
    run("${EXEC}" ${RENDER_ARGS}
      -c "set samples=1024 light_intensity=0"
      -o "${actual}" "${METAL_DB}" "${object}")
    run("${VEXEC}" check-uniform-image "${actual}" "${WORK}/uniform.png" 64 64)
  endforeach()
endforeach()
run("${VEXEC}" set-material "${METAL_DB}" OSL.param.in_energy_compensation "float 0")
run("${EXEC}" ${RENDER_ARGS}
  -c "set samples=1024 light_intensity=0"
  -o "${WORK}/uncompensated.png" "${METAL_DB}" cube.r)
expect_failure("${VEXEC}" check-uniform-image "${WORK}/uncompensated.png" "${WORK}/uniform.png" 64 64)
