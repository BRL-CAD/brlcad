cmake_minimum_required(VERSION 3.22)

set(WORK "@CMAKE_CURRENT_BINARY_DIR@/inspect-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/project/shaders" "${WORK}/elsewhere")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
foreach(shader IN ITEMS art_graph_value art_parameters art_texture art_diffuse)
  configure_file("@CMAKE_CURRENT_BINARY_DIR@/${shader}.oso"
    "${WORK}/project/shaders/${shader}.oso" COPYONLY)
endforeach()
set(DB "${WORK}/project/scene.g")
set(preserved "${WORK}/preserved.png")
file(WRITE "${preserved}" "Inspection must preserve an existing output.\n")
file(SHA256 "${preserved}" before)

# Keep stdout separate: a failed preflight must not publish a partial report.
function(inspect label should_fail diagnostic)
  execute_process(COMMAND "${EXEC}" -c "set inspect_materials=1"
    -F unsupported-framebuffer -o "${preserved}" "${DB}" ${ARGN}
    WORKING_DIRECTORY "${WORK}/elsewhere" RESULT_VARIABLE result
    OUTPUT_VARIABLE report ERROR_VARIABLE messages TIMEOUT 30)
  file(APPEND "${LOG}" "${label}: ${result}\n${report}\n${messages}\n")
  if(should_fail)
    if("${result}" STREQUAL "0" OR NOT "${result}" MATCHES "^[0-9]+$")
      message(FATAL_ERROR "${label}: expected a nonzero status, got '${result}'\n${messages}")
    endif()
    if(NOT report STREQUAL "" OR NOT messages MATCHES "${diagnostic}")
      message(FATAL_ERROR "${label}: published a partial report or missed '${diagnostic}'\n${report}\n${messages}")
    endif()
  elseif(NOT "${result}" STREQUAL "0" OR NOT report MATCHES "project_root ")
    message(FATAL_ERROR "${label}: inspection failed\n${report}\n${messages}")
  endif()
  if(messages MATCHES "wrote image file|rendering frame|FRAMEBUFFER IS ON")
    message(FATAL_ERROR "${label}: inspection attempted rendering or framebuffer output\n${messages}")
  endif()
  file(SHA256 "${preserved}" after)
  if(NOT before STREQUAL after)
    message(FATAL_ERROR "${label}: inspection replaced the existing image")
  endif()
  set(inspect_output "${report}" PARENT_SCOPE)
endfunction()
function(require_text expected)
  string(FIND "${inspect_output}" "${expected}" found)
  if(found LESS 0)
    message(FATAL_ERROR "Missing report text '${expected}'\n${inspect_output}")
  endif()
endfunction()

run("${VEXEC}" create "${DB}")
run("${VEXEC}" attr "${DB}" set ball.r color 255/0/0)
inspect(default FALSE "" ball.r)
require_text("region \"/ball.r\"\n  assignment default")
require_text("shader \"material\" \"as_plastic\" shader")
require_text("input \"in_color\" \"color 1 0 0\"")
require_text("connect \"material.out_outColor\" -> \"surface.in_input\"")
require_text("result \"surface.Ci\"")
inspect(empty_region FALSE "" empty.r)
require_text("region \"/empty.r\"")
inspect(light FALSE "" key_light.r)
require_text("light \"/key_light.r\" point shader \"light ")

run("${VEXEC}" material "${DB}" create base.material Base)
run("${VEXEC}" material "${DB}" set base.material optical OSL as_plastic)
run("${VEXEC}" material "${DB}" set base.material optical OSL.version 2)
run("${VEXEC}" material "${DB}" set base.material optical OSL.param.in_color "color 0.7 0.2 0.1")
run("${VEXEC}" material "${DB}" set base.material optical OSL.node.tint art_graph_value)
run("${VEXEC}" material "${DB}" set base.material optical OSL.connect.material.in_color tint.out_color)
run("${VEXEC}" material "${DB}" set base.material optical OSL.param.in_specular_roughness "float 0.35")
foreach(variant IN ITEMS left right)
  run("${VEXEC}" material "${DB}" create "${variant}.material" "${variant}")
  run("${VEXEC}" material "${DB}" set "${variant}.material" parent base.material)
  run("${VEXEC}" material "${DB}" assign "instance_${variant}.g" "${variant}.material")
endforeach()
run("${VEXEC}" material "${DB}" set left.material optical OSL.param.tint.in_color "color 0.2 0.4 0.6")
run("${VEXEC}" material "${DB}" set left.material optical OSL.param.in_specular_roughness "float 0.55")
run("${VEXEC}" material "${DB}" set right.material optical OSL.param.tint.in_color "color 0.6 0.4 0.2")
inspect(pair FALSE "" instances.g)
require_text("region \"/instances.g/instance_left.g/ball.r\"")
require_text("assignment \"left.material\" from \"/instances.g/instance_left.g\" inherit higher")
require_text("material_chain \"left.material\" \"base.material\"")
require_text("input \"in_specular_roughness\" \"float 0.55\"")
require_text("input \"in_specular_roughness\" \"float 0.35\"")
require_text("shader \"tint\" \"art_graph_value\" shader")
require_text("input \"in_color\" \"color 0.2 0.4 0.6\"")
require_text("input \"in_color\" \"color 0.7 0.2 0.1\" (overridden by connection)")
require_text("connect \"tint.out_color\" -> \"material.in_color\"")
require_text("assignment \"right.material\" from \"/instances.g/instance_right.g\" inherit higher")
inspect(path FALSE "" /instances.g/instance_left.g/ball.r)
require_text("assignment \"left.material\"")
inspect(region FALSE "" ball.r)
require_text("assignment default")
inspect(arcs FALSE "" arcs.g)
require_text("region \"/arcs.g/ball.r\"")
require_text("region \"/arcs.g/ball.r@1\"")

# An error after another valid region must discard the complete report.
run("${VEXEC}" material "${DB}" set right.material parent missing.material)
inspect(missing_parent TRUE "cannot read material" instances.g)
run("${VEXEC}" material "${DB}" set right.material parent base.material)
run("${VEXEC}" material "${DB}" set base.material optical OSL.param.in_specular_roughness "color 1 0 0")
inspect(wrong_type TRUE "declared type does not match" instances.g)
run("${VEXEC}" material "${DB}" set base.material optical OSL.param.in_specular_roughness "float 0.35")
run("${VEXEC}" material "${DB}" set base.material optical OSL.connect.material.in_color tint.missing)
inspect(missing_endpoint TRUE "invalid OSL connection" instances.g)
run("${VEXEC}" material "${DB}" set base.material optical OSL.connect.material.in_color tint.out_color)
run("${VEXEC}" material "${DB}" set base.material optical OSL.node.other art_graph_value)
run("${VEXEC}" material "${DB}" set base.material optical OSL.connect.tint.in_color other.out_color)
run("${VEXEC}" material "${DB}" set base.material optical OSL.connect.other.in_color tint.out_color)
inspect(cycle TRUE "OSL connection cycle" instances.g)
foreach(property IN ITEMS OSL.node.other OSL.connect.tint.in_color OSL.connect.other.in_color)
  run("${VEXEC}" material "${DB}" remove base.material optical "${property}")
endforeach()
inspect(missing_region TRUE "not found|not in database" ball.r absent.r)
inspect(primitive TRUE "selection contains no regions" ball.s)

# Surface shaders set Ci directly, and string values retain their quoting.
run("${VEXEC}" material "${DB}" create surface.material Surface)
run("${VEXEC}" material "${DB}" set surface.material optical OSL art_parameters)
run("${VEXEC}" material "${DB}" set surface.material optical OSL.param.in_string
  [=[string project "quoted"\wood.tx]=])
run("${VEXEC}" material "${DB}" assign ball.r surface.material)
inspect(surface FALSE "" ball.r)
require_text("shader \"material\" \"art_parameters\" surface")
require_text([=[input "in_string" "string project \"quoted\"\\wood.tx"]=])
require_text("result \"material.Ci\"")

# A static preflight does not execute texture lookups.
run("${VEXEC}" material "${DB}" set surface.material optical OSL art_texture)
run("${VEXEC}" material "${DB}" remove surface.material optical OSL.param.in_string)
run("${VEXEC}" material "${DB}" set surface.material optical OSL.param.in_filename "string missing.tx")
inspect(texture FALSE "" ball.r)
require_text("input \"in_filename\" \"string missing.tx\"")

# Moved projects must use the same shader search policy, ignoring caller assets.
set(moved "${WORK}/moved project")
file(RENAME "${WORK}/project" "${moved}")
set(DB "${moved}/scene.g")
configure_file("${moved}/shaders/art_diffuse.oso" "${WORK}/elsewhere/art_graph_value.oso" COPYONLY)
inspect(relocated FALSE "" instances.g)
require_text("project_root \"${moved}\"")
require_text("shader \"tint\" \"art_graph_value\" shader")
require_text("input \"in_color\" \"color 0.2 0.4 0.6\"")

# The stdin frame command shares the same inspection path.
file(WRITE "${WORK}/inspect.rt" "end;\n")
execute_process(COMMAND "${EXEC}" -M -c "set inspect_materials=1" "${DB}" instances.g
  INPUT_FILE "${WORK}/inspect.rt" WORKING_DIRECTORY "${WORK}/elsewhere"
  RESULT_VARIABLE result OUTPUT_VARIABLE report ERROR_VARIABLE messages TIMEOUT 30)
if(NOT "${result}" STREQUAL "0" OR NOT report STREQUAL inspect_output)
  message(FATAL_ERROR "Stdin inspection differs from command-line inspection\n${report}\n${messages}")
endif()
