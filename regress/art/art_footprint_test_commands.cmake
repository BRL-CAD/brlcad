include("${CMAKE_CURRENT_LIST_DIR}/art_nested_test_commands.cmake")

function(create_footprint_receivers)
  foreach(db IN ITEMS "${ACTUAL_DB}" "${REFERENCE_DB}")
    run("${VEXEC}" material "${db}" remove receiver.material optical OSL.param.in_target)
    run("${VEXEC}" set-named-material "${db}" receiver.material OSL art_glass_footprint_reference)
    run("${VEXEC}" set-named-material "${db}" receiver.material OSL.param.in_receiver "int 1")
    foreach(front IN ITEMS "front;5" "curved_front;-10")
      list(GET front 0 name)
      list(GET front 1 minimum)
      run("${VEXEC}" in "${db}" "${name}.s" rpp ${minimum} 200 -200 200 30 31)
      run("${VEXEC}" r "${db}" "${name}.r" u "${name}.s")
      run("${VEXEC}" material "${db}" assign "${name}.r" receiver.material)
    endforeach()
  endforeach()
endfunction()

function(set_footprint_reference name value)
  run("${VEXEC}" set-material "${REFERENCE_DB}" "OSL.param.in_${name}" "${value}")
endfunction()
function(set_footprint_mapping mapping center reflection curved normal_input)
  set(update_reference TRUE)
  if(ARGC GREATER 5)
    set(update_reference "${ARGV5}")
  endif()
  foreach(name IN ITEMS "OSL.connect.material.${normal_input}" "OSL.param.${normal_input}"
      OSL.connect.bump.in_normal_map OSL.node.bump OSL.node.field OSL.param.field.in_center
      OSL.param.field.in_base OSL.param.bump.in_mode OSL.param.bump.in_normal_map_mode
      OSL.param.bump.in_normal_map_coordsys)
    run("${VEXEC}" remove-material "${ACTUAL_DB}" "${name}")
  endforeach()
  set(mapped 0)
  set(slope 0.05)
  if(NOT mapping STREQUAL "unmapped")
    set(mapped 1)
    if(reflection)
      set(base 0.3)
    else()
      set(base 0)
    endif()
    run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.node.field art_glass_footprint_field)
    run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.param.field.in_center "point ${center}")
    run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.param.field.in_base "float ${base}")
    if(mapping STREQUAL "direct")
      run("${VEXEC}" set-material "${ACTUAL_DB}" "OSL.connect.material.${normal_input}" field.out_normal)
    else()
      foreach(parameter IN ITEMS "OSL.node.bump;as_bump" "OSL.param.bump.in_mode;string Normal Map"
          "OSL.param.bump.in_normal_map_mode;string Signed" "OSL.param.bump.in_normal_map_coordsys;string World Space"
          "OSL.connect.bump.in_normal_map;field.out_map" "OSL.connect.material.${normal_input};bump.out_normal")
        list(GET parameter 0 name)
        list(GET parameter 1 value)
        run("${VEXEC}" set-material "${ACTUAL_DB}" "${name}" "${value}")
      endforeach()
    endif()
  elseif(reflection AND NOT curved)
    # A constant tilt reaches the offset front receiver without blocking
    # the camera. It also checks an explicitly constant normal parameter.
    set(mapped 1)
    set(slope 0)
    run("${VEXEC}" set-material "${ACTUAL_DB}" "OSL.param.${normal_input}" "normal 0.3 0 1")
  endif()
  if(update_reference)
    set_footprint_reference(mapped "int ${mapped}")
    set_footprint_reference(slope "float ${slope}")
  endif()
endfunction()

function(compare_footprint_paths label size projection eye_x shape target mode relative_bound)
  set(actual "${WORK}/${label}.exr")
  set(reference "${WORK}/${label}-reference.exr")
  run("${EXEC}" ${RENDER_ARGS} -w ${size} -n ${size} -p ${projection} -c "eye_pt ${eye_x} -2 40"
    -o "${actual}" "${ACTUAL_DB}" "${shape}.r" "${target}")
  run("${EXEC}" ${RENDER_ARGS} -w ${size} -n ${size} -p ${projection} -c "eye_pt ${eye_x} -2 40"
    -o "${reference}" "${REFERENCE_DB}" "${shape}.r" "${target}")
  run("${VEXEC}" check-image "${actual}" ${size} ${size})
  if(mode EQUAL 0)
    compare_optical_transport("${actual}" "${reference}" ${relative_bound})
  else()
    compare_optical_transport("${actual}" "${reference}")
  endif()
  foreach(image IN ITEMS "${actual}" "${reference}")
    expect_failure("${TOOL}" --fail 0 --hardfail 0 "${image}" --ch R,G,B "${WORK}/black.exr" --diff)
  endforeach()
endfunction()
