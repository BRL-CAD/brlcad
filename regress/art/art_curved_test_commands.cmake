function(create_curved_pair shape)
  if(shape STREQUAL "sphere")
    set(axes 10 10 10)
  else()
    set(axes 10 8 6)
  endif()
  list(GET axes 2 outer_z)
  math(EXPR glass_z_tenths "${outer_z} * 8")
  math(EXPR glass_z_whole "${glass_z_tenths} / 10")
  math(EXPR glass_z_fraction "${glass_z_tenths} % 10")
  set(CURVED_GLASS_Z "${glass_z_whole}.${glass_z_fraction}" PARENT_SCOPE)
  file(REMOVE "${ACTUAL_DB}" "${REFERENCE_DB}")
  run("${VEXEC}" create-nested "${ACTUAL_DB}")
  foreach(layer priority IN ZIP_LISTS CURVED_LAYERS CURVED_PRIORITIES)
    if(layer STREQUAL "outer")
      set(divisor 1)
    else()
      set(divisor 2)
    endif()
    set(radii)
    foreach(axis IN LISTS axes)
      math(EXPR radius "${axis} / ${divisor}")
      list(APPEND radii ${radius})
    endforeach()
    list(GET radii 0 x)
    list(GET radii 1 y)
    list(GET radii 2 z)
    run("${VEXEC}" in "${ACTUAL_DB}" "curved.${layer}.s" ell
      0 0 0 ${x} 0 0 0 ${y} 0 0 0 ${z})
    run("${VEXEC}" r "${ACTUAL_DB}" "curved.${layer}.r" u "curved.${layer}.s")
    run("${VEXEC}" material "${ACTUAL_DB}" assign "curved.${layer}.r" "${layer}.material")
    run("${VEXEC}" set-named-material "${ACTUAL_DB}" "${layer}.material" OSL.medium_priority "${priority}")
    string(JOIN " " reference_axes ${radii})
    set(reference_${layer}_axes "${reference_axes}")
  endforeach()
  run("${VEXEC}" r "${ACTUAL_DB}" curved.shell.r u curved.outer.s - curved.inner.s)
  run("${VEXEC}" material "${ACTUAL_DB}" assign curved.shell.r outer.material)
  configure_file("${ACTUAL_DB}" "${REFERENCE_DB}" COPYONLY)
  run("${VEXEC}" set-named-material "${REFERENCE_DB}" outer.material OSL art_curved_reference)
  foreach(layer IN LISTS CURVED_LAYERS)
    run("${VEXEC}" material "${REFERENCE_DB}" assign "curved.${layer}.r" outer.material)
    set_nested_parameter("${REFERENCE_DB}" outer "in_${layer}_axes" "vector ${reference_${layer}_axes}")
  endforeach()
endfunction()
set(CURVED_LAYERS outer inner)
set(CURVED_PRIORITIES 1 2)

function(render_curved image db z orientation)
  run("${EXEC}" ${RENDER_ARGS} -c "eye_pt 1.5 0 ${z}" -c "orientation ${orientation}"
    ${CURVED_LIGHTING_ARGS} -o "${image}" "${db}" ${ARGN})
  run("${VEXEC}" check-image "${image}" ${SIZE} ${SIZE})
endfunction()

function(check_curved_reference image)
  expect_failure("${TOOL}" ${DIFF_ARGS} "${image}" --ch R,G,B "${WORK}/black.exr" --diff)
endfunction()
