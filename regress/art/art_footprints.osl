surface art_footprints()
{
    float du = filterwidth(u);
    float dv = filterwidth(v);
    color diagnostic = color(0, 0, 1);
    if (isfinite(du) && isfinite(dv)) {
        if (du > 0 && dv > 0)
            diagnostic = color(0, 1, 0);
        else if (du == 0 && dv == 0)
            diagnostic = color(1, 0, 0);
    }
    Ci = diagnostic * emission();
}
