set(WORK "@CMAKE_CURRENT_BINARY_DIR@/emission-medium-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders" "${WORK}/cache")
set(ENV{BU_DIR_CACHE} "${WORK}/cache")
set(ART_COMMAND_TIMEOUT 60)
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_nested_test_commands.cmake")
foreach(shader IN ITEMS art_diffuse art_emission_medium)
  configure_file("@CMAKE_CURRENT_BINARY_DIR@/${shader}.oso" "${WORK}/shaders/${shader}.oso" COPYONLY)
endforeach()
set(TOOL "@ART_OIIOTOOL_EXECUTABLE@")
set(BASE_ARGS -P 1 -w 1 -n 1 -p 0.02 -c "viewsize 0.001"
  -c "set light_intensity=0 environment_intensity=0 background_color=black")
set(CAMERA_CONTROLS "samples=4096 max_bounces=8 enable_caustics=1")
# This is a context diagnostic, not a finite-radius area-caustic energy test.
set(PHOTON_CONTROLS "integrator=sppm sampling=uniform samples=1 passes=1 light_photons=100000 environment_photons=0 photon_max_bounces=2 photon_rr_min_path_length=0 photon_max_estimate=10000 photon_importons=0 photon_radius_percent=1 enable_caustics=1 max_bounces=0 rr_min_path_length=0")
foreach(kind IN ITEMS box mesh)
  set(database "${WORK}/${kind}.g")
  run("${VEXEC}" create-emitter "${database}" "${kind}")
  run("${VEXEC}" set-named-material "${database}" emitter.material OSL art_emission_medium)
  run("${VEXEC}" material "${database}" create host.material Glass_host)
  run("${VEXEC}" set-named-material "${database}" host.material OSL as_glass)
  foreach(parameter IN ITEMS "in_ior;float 1.5" "in_roughness;float 0"
      "in_transmittance_amount;float 1" "in_surface_transmittance;color 1 1 1"
      "in_reflection_tint;color 1 1 1")
    list(GET parameter 0 name)
    list(GET parameter 1 value)
    set_nested_parameter("${database}" host "${name}" "${value}")
  endforeach()
  run("${VEXEC}" in "${database}" host.s rpp -20 20 2 5 -20 20)
  run("${VEXEC}" r "${database}" host.r u host.s)
  run("${VEXEC}" material "${database}" assign host.r host.material)
  # A neutral cover makes vacuum launches observable as caustic photons,
  # independently of SPPM's separate direct-light estimate.
  run("${VEXEC}" material "${database}" create cover.material Neutral_cover)
  run("${VEXEC}" set-named-material "${database}" cover.material OSL as_glass)
  foreach(parameter IN ITEMS "in_ior;float 1" "in_roughness;float 0"
      "in_transmittance_amount;float 1" "in_surface_transmittance;color 1 1 1"
      "in_reflection_tint;color 0 0 0")
    list(GET parameter 0 name)
    list(GET parameter 1 value)
    set_nested_parameter("${database}" cover "${name}" "${value}")
  endforeach()
  run("${VEXEC}" in "${database}" cover.s rpp -20 20 1 1.1 -20 20)
  run("${VEXEC}" r "${database}" cover.r u cover.s)
  run("${VEXEC}" material "${database}" assign cover.r cover.material)
  foreach(profile IN ITEMS camera-outside camera-inside photon-enclosed photon-vacuum)
    set(objects emitter.r host.r)
    set(eye 0.5)
    set(target 3)
    set(controls "${CAMERA_CONTROLS}")
    set(expected_ior 1.5)
    if(profile STREQUAL "camera-inside")
      set(eye 2.5)
    elseif(profile MATCHES "^photon-")
      set(target 0)
      set(controls "${PHOTON_CONTROLS}")
      list(APPEND objects receiver.r)
      if(profile STREQUAL "photon-vacuum")
        list(REMOVE_ITEM objects host.r)
        list(APPEND objects cover.r)
        set(expected_ior 1)
      endif()
    endif()
    set_nested_parameter("${database}" emitter in_expected_ior "float ${expected_ior}")
    foreach(constant IN ITEMS 0 1)
      set_nested_parameter("${database}" emitter in_constant "int ${constant}")
      set(image "${WORK}/${kind}-${profile}-${constant}.exr")
      run("${EXEC}" ${BASE_ARGS} -c "eye_pt 0 ${eye} 0" -c "lookat_pt 0 ${target} 0"
        -c "set ${controls}" -o "${image}" "${database}" ${objects})
      run("${VEXEC}" check-image "${image}" 1 1)
    endforeach()
    set(prefix "${WORK}/${kind}-${profile}")
    # Matching seeds and transport isolate only the shader's medium query.
    run("${TOOL}" --fail 0 --hardfail 0 "${prefix}-0.exr" "${prefix}-1.exr" --diff)
    run_command("${CMAKE_CURRENT_BINARY_DIR}" FALSE "${TOOL}" --info --stats "${prefix}-1.exr")
    if(NOT command_output MATCHES "Stats Avg: ([0-9.eE+-]+)")
      message(FATAL_ERROR "No control radiance statistics: ${kind}/${profile}")
    endif()
    if(CMAKE_MATCH_1 LESS 0.001)
      message(FATAL_ERROR "The medium-query comparison has no positive light: ${kind}/${profile}")
    endif()
  endforeach()
endforeach()
