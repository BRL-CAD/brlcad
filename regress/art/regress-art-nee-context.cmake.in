set(WORK "@CMAKE_CURRENT_BINARY_DIR@/nee-context-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders" "${WORK}/cache")
set(ENV{BU_DIR_CACHE} "${WORK}/cache")
set(ART_COMMAND_TIMEOUT 60)
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_nested_test_commands.cmake")
foreach(shader IN ITEMS art_diffuse art_alpha art_emission_medium)
  configure_file("@CMAKE_CURRENT_BINARY_DIR@/${shader}.oso" "${WORK}/shaders/${shader}.oso" COPYONLY)
endforeach()
set(TOOL "@ART_OIIOTOOL_EXECUTABLE@")
set(CONTEXT_SAMPLES 4096)
set(MINIMUM_CONTROL_RADIANCE 0.00001)
set(BASE_ARGS -P 1 -w 1 -n 1 -p 0.02 -c "viewsize 0.001"
  -c "eye_pt 0 0.5 0" -c "lookat_pt 0 0 0"
  -c "set samples=${CONTEXT_SAMPLES} max_bounces=1 max_diffuse_bounces=0 max_volume_bounces=0 rr_min_path_length=0 light_intensity=0 environment_intensity=0 background_color=black")
foreach(kind IN ITEMS box mesh)
  set(database "${WORK}/${kind}.g")
  run("${VEXEC}" create-emitter "${database}" "${kind}")
  run("${VEXEC}" set-named-material "${database}" emitter.material OSL art_emission_medium)
  set_nested_parameter("${database}" emitter in_require_path "int 1")
  run("${VEXEC}" material "${database}" create host.material Shared_host)
  run("${VEXEC}" set-named-material "${database}" host.material OSL as_glass)
  foreach(parameter IN ITEMS "in_ior;float 1.5" "in_roughness;float 0"
      "in_transmittance_amount;float 1" "in_surface_transmittance;color 1 1 1"
      "in_reflection_tint;color 1 1 1")
    list(GET parameter 0 name)
    list(GET parameter 1 value)
    set_nested_parameter("${database}" host "${name}" "${value}")
  endforeach()
  run("${VEXEC}" in "${database}" host.s rpp -20 20 -1 5 -20 20)
  run("${VEXEC}" r "${database}" host.r u host.s)
  run("${VEXEC}" material "${database}" assign host.r host.material)
  run("${VEXEC}" material "${database}" create cover.material Cutout)
  run("${VEXEC}" set-named-material "${database}" cover.material OSL art_alpha)
  set_nested_parameter("${database}" cover in_opacity "float 0.25")
  run("${VEXEC}" in "${database}" cover.s rpp -10 10 1 1.1 -10 10)
  run("${VEXEC}" r "${database}" cover.r u cover.s)
  run("${VEXEC}" material "${database}" assign cover.r cover.material)
  run("${VEXEC}" material "${database}" create fog.material Fog)
  run("${VEXEC}" set-named-material "${database}" fog.material OSL.volume homogeneous)
  run("${VEXEC}" set-named-material "${database}" fog.material OSL.volume.absorption "float 0.01")
  run("${VEXEC}" set-named-material "${database}" fog.material OSL.volume.scattering "float 0")
  run("${VEXEC}" set-named-material "${database}" fog.material OSL.medium_priority 1)
  run("${VEXEC}" in "${database}" fog.s rpp -19 19 -0.9 4.9 -19 19)
  run("${VEXEC}" r "${database}" fog.r u fog.s)
  run("${VEXEC}" material "${database}" assign fog.r fog.material)
  foreach(profile IN ITEMS clear alpha absorption scattering)
    set(objects receiver.r emitter.r host.r)
    set(nee_values 0 1)
    set(expected_ior 1.5)
    if(profile STREQUAL "alpha")
      list(APPEND objects cover.r)
    elseif(profile STREQUAL "absorption" OR profile STREQUAL "scattering")
      list(APPEND objects fog.r)
      set(expected_ior 1)
      set(scattering 0)
      if(profile STREQUAL "scattering")
        set(scattering 0.03)
        # With no visible receiver, light reaches the camera by scattering.
        # This exercises VolumeSampler rather than only BSDFSampler.
        list(REMOVE_ITEM objects receiver.r)
        set(nee_values 1)
      endif()
      run("${VEXEC}" set-named-material "${database}" fog.material OSL.volume.scattering "float ${scattering}")
    endif()
    set_nested_parameter("${database}" emitter in_expected_ior "float ${expected_ior}")
    foreach(nee IN LISTS nee_values)
      foreach(constant IN ITEMS 0 1)
        set_nested_parameter("${database}" emitter in_constant "int ${constant}")
        set(image "${WORK}/${kind}-${profile}-${nee}-${constant}.exr")
        run("${EXEC}" ${BASE_ARGS} -c "set next_event_estimation=${nee}"
          -o "${image}" "${database}" ${objects})
        run("${VEXEC}" check-image "${image}" 1 1)
      endforeach()
      set(prefix "${WORK}/${kind}-${profile}-${nee}")
      # Matched seeds isolate shader context from estimator noise.
      run("${TOOL}" --fail 0 --hardfail 0 "${prefix}-0.exr" "${prefix}-1.exr" --diff)
      run_command("${CMAKE_CURRENT_BINARY_DIR}" FALSE "${TOOL}" --info --stats "${prefix}-1.exr")
      if(NOT command_output MATCHES "Stats Avg: ([0-9.eE+-]+)")
        message(FATAL_ERROR "No reference radiance statistics: ${kind}/${profile}/${nee}")
      endif()
      if(CMAKE_MATCH_1 LESS MINIMUM_CONTROL_RADIANCE)
        message(FATAL_ERROR "Emitter-context comparison has no positive light: ${kind}/${profile}/${nee}")
      endif()
    endforeach()
  endforeach()
endforeach()
