cmake_minimum_required(VERSION 3.22)
set(WORK "@CMAKE_CURRENT_BINARY_DIR@/rough-glass-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders" "${WORK}/cache")
set(ENV{BU_DIR_CACHE} "${WORK}/cache")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_nested_test_commands.cmake")
configure_file("@CMAKE_CURRENT_BINARY_DIR@/art_rough_glass_reference.oso"
  "${WORK}/shaders/art_rough_glass_reference.oso" COPYONLY)
configure_file("@CMAKE_CURRENT_BINARY_DIR@/art_refraction_reference.oso"
  "${WORK}/shaders/art_refraction_reference.oso" COPYONLY)
set(TOOL "@ART_OIIOTOOL_EXECUTABLE@")
set(ACTUAL_DB "${WORK}/actual.g")
set(REFERENCE_DB "${WORK}/reference.g")
run("${VEXEC}" create-material "${ACTUAL_DB}" as_glass)
run("${VEXEC}" create-material "${REFERENCE_DB}" art_rough_glass_reference)
foreach(parameter IN ITEMS "in_transmittance_amount;float 1"
    "in_surface_transmittance;color 1 1 1"
    "in_reflection_tint;color 1 1 1" "in_refraction_tint;color 1 1 1"
    "in_volume_transmittance_distance;float 0")
  list(GET parameter 0 name)
  list(GET parameter 1 value)
  run("${VEXEC}" set-material "${ACTUAL_DB}" "OSL.param.${name}" "${value}")
endforeach()
set(light_names outside-invalid outside-transmission outside-reflection
  inside-invalid inside-transmission inside-reflection)
set(light_positions "9.8 0 8" "-6 0 2" "6 0 18" "9.8 0 12" "-6 0 18" "6 0 2")
foreach(db IN ITEMS "${ACTUAL_DB}" "${REFERENCE_DB}")
  foreach(name position IN ZIP_LISTS light_names light_positions)
    separate_arguments(coordinates UNIX_COMMAND "${position}")
    run("${VEXEC}" in "${db}" "${name}.s" sph ${coordinates} 0.01)
  endforeach()
endforeach()
set(previous_light key_light.s)
set(SIZE 6)
set(TOLERANCE 0.0005)
set(RENDER_ARGS -P 1 -w ${SIZE} -n ${SIZE} -p 2 -c "viewsize 0.5"
  -c "set samples=1 light_intensity=1000 environment_intensity=0 background_color=black max_bounces=0 rr_min_path_length=0 next_event_estimation=1")
run("${TOOL}" --pattern constant:color=0,0,0 ${SIZE}x${SIZE} 3 -o "${WORK}/black.exr")
foreach(object IN ITEMS cube.r mesh.r)
  foreach(ior IN ITEMS 1.5 2)
    run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.param.in_ior "float ${ior}")
    foreach(roughness IN ITEMS 0.35 0.7)
      foreach(db IN ITEMS "${ACTUAL_DB}" "${REFERENCE_DB}")
        run("${VEXEC}" set-material "${db}" OSL.param.in_roughness "float ${roughness}")
      endforeach()
      foreach(side IN ITEMS outside inside)
        if(side STREQUAL "outside")
          set(angles 0 25 65)
          # Camera origins are twenty millimeters from the +Z face center.
          set(eyes "0 0 30" "8.452365234813989 0 28.126155740732997" "18.126155740732997 0 18.45236523481399")
          set(orientations "0 0 0 1" "0 0.21643961393810288 0 0.9762960071199334"
            "0 0.5372996083468239 0 0.8433914458128857")
          set(ni 1)
          set(nt ${ior})
        else()
          set(angles 0 25)
          # Inside origins are three millimeters below that same face.
          set(eyes "0 0 7" "1.2678547852220984 0 7.28107663889005")
          set(orientations "0 1 0 0" "0 0.9762960071199334 0 0.21643961393810288")
          set(ni ${ior})
          set(nt 1)
        endif()
        run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_incident_ior "float ${ni}")
        run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_transmitted_ior "float ${nt}")
        foreach(angle eye orientation IN ZIP_LISTS angles eyes orientations)
          foreach(mode IN ITEMS invalid transmission reflection)
            set(light "${side}-${mode}")
            list(FIND light_names "${light}" light_index)
            list(GET light_positions ${light_index} position)
            foreach(db IN ITEMS "${ACTUAL_DB}" "${REFERENCE_DB}")
              run("${VEXEC}" comb "${db}" key_light.r rm "${previous_light}")
              run("${VEXEC}" comb "${db}" key_light.r u "${light}.s")
            endforeach()
            set(previous_light "${light}.s")
            run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_light "point ${position}")
            set(stem "${WORK}/${object}-${ior}-${roughness}-${side}-${angle}-${mode}")
            foreach(form IN ITEMS ACTUAL REFERENCE)
              run("${EXEC}" ${RENDER_ARGS} -c "eye_pt ${eye}" -c "orientation ${orientation}"
                -o "${stem}-${form}.exr" "${${form}_DB}" "${object}" key_light.r)
              run("${VEXEC}" check-image "${stem}-${form}.exr" ${SIZE} ${SIZE})
            endforeach()
            compare_optical_transport("${stem}-ACTUAL.exr" "${stem}-REFERENCE.exr")
            if(NOT mode STREQUAL "invalid")
              foreach(form IN ITEMS ACTUAL REFERENCE)
                expect_failure("${TOOL}" --fail 0.000001 --hardfail 0.000001
                  "${stem}-${form}.exr" --ch R,G,B "${WORK}/black.exr" --diff)
              endforeach()
            endif()
          endforeach()
        endforeach()
      endforeach()
    endforeach()
  endforeach()
endforeach()
