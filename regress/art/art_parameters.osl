surface art_parameters(
    float in_weight = 0,
    int in_count = 0,
    color in_color = color(0),
    point in_point = point(0),
    vector in_vector = vector(0),
    normal in_normal = normal(0, 0, 1),
    matrix in_matrix = matrix(0),
    string in_string = "",
    float in_array[2] = {0, 0},
    output float out_number = 0)
{
    float mismatch = abs(in_weight - 0.375) + abs(in_count - 7)
        + distance(point(in_color), point(0.2, 0.4, 0.6))
        + distance(in_point, point(1, 2, 3))
        + length(in_vector - vector(4, 5, 6))
        + length(in_normal - normal(0, 1, 0))
        + distance(transform(in_matrix, point(1, 2, 3)), point(7, 14, 23));
    int matches = mismatch < 1.0e-5 && in_string == "project assets/wood grain.tx";
    Ci = (matches ? color(0, 1, 0) : color(1, 0, 0)) * emission();
}
