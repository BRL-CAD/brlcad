set(WORK "@CMAKE_CURRENT_BINARY_DIR@/transparent-contact-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders" "${WORK}/cache")
set(ENV{BU_DIR_CACHE} "${WORK}/cache")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_nested_test_commands.cmake")
foreach(shader IN ITEMS art_alpha art_emission)
  configure_file("@CMAKE_CURRENT_BINARY_DIR@/${shader}.oso" "${WORK}/shaders/${shader}.oso" COPYONLY)
endforeach()
set(TOOL "@ART_OIIOTOOL_EXECUTABLE@")
set(DATABASE "${WORK}/contact.g")
run("${VEXEC}" create-material "${DATABASE}" art_emission)
set_nested_parameter("${DATABASE}" osl in_color "color 0.25 0.5 0.75")
run("${VEXEC}" material "${DATABASE}" create glass.material Glass)
run("${VEXEC}" set-named-material "${DATABASE}" glass.material OSL as_glass)
foreach(parameter IN ITEMS "in_ior;float 1.5" "in_roughness;float 0"
    "in_transmittance_amount;float 1" "in_surface_transmittance;color 1 1 1"
    "in_reflection_tint;color 1 1 1")
  list(GET parameter 0 name)
  list(GET parameter 1 value)
  set_nested_parameter("${DATABASE}" glass "${name}" "${value}")
endforeach()
run("${VEXEC}" material "${DATABASE}" create fog.material Fog)
run("${VEXEC}" set-named-material "${DATABASE}" fog.material OSL.volume homogeneous)
run("${VEXEC}" set-named-material "${DATABASE}" fog.material OSL.volume.absorption "float 0.01")
run("${VEXEC}" set-named-material "${DATABASE}" fog.material OSL.volume.scattering "float 0")
run("${VEXEC}" material "${DATABASE}" create cover.material Invisible_cover)
run("${VEXEC}" set-named-material "${DATABASE}" cover.material OSL art_alpha)
run("${VEXEC}" set-named-material "${DATABASE}" cover.material OSL.medium_priority 7)
set(BASE_ARGS -P 1 -w 1 -n 1 -p 0.02 -c "viewsize 0.001"
  -c "orientation 0 0 0 1"
  -c "set samples=128 max_bounces=32 max_specular_bounces=32 max_glossy_bounces=0 rr_min_path_length=0 light_intensity=0 environment_color=white environment_intensity=1 background_source=environment")
foreach(kind IN ITEMS cube mesh)
  run("${VEXEC}" r "${DATABASE}" "${kind}.cover.r" u "${kind}.s")
  run("${VEXEC}" material "${DATABASE}" assign "${kind}.cover.r" cover.material)
  foreach(profile IN ITEMS glass fog opaque)
    set(material glass.material)
    if(profile STREQUAL "opaque")
      set(material osl.material)
    elseif(profile STREQUAL "fog")
      set(material fog.material)
    endif()
    run("${VEXEC}" material "${DATABASE}" assign "${kind}.r" "${material}")
    foreach(eye IN ITEMS 0 40)
      set(prefix "${WORK}/${kind}-${profile}-${eye}")
      set_nested_parameter("${DATABASE}" cover in_opacity "float 0")
      run("${EXEC}" ${BASE_ARGS} -c "eye_pt 0 0 ${eye}" -o "${prefix}-reference.exr"
        "${DATABASE}" "${kind}.r")
      foreach(reverse IN ITEMS 0 1)
        set(objects "${kind}.r" "${kind}.cover.r")
        if(reverse)
          list(REVERSE objects)
        endif()
        set(image "${prefix}-${reverse}.exr")
        run("${EXEC}" ${BASE_ARGS} -c "eye_pt 0 0 ${eye}" -o "${image}"
          "${DATABASE}" ${objects})
        run("${VEXEC}" check-image "${image}" 1 1)
        run("${TOOL}" --fail 0 --hardfail 0 "${image}" "${prefix}-reference.exr" --diff)
        if(profile STREQUAL "glass")
          # Partial coverage at a shared dielectric needs a layer order.
          # Both hit orders must diagnose ambiguity and retain the output.
          set_nested_parameter("${DATABASE}" cover in_opacity "float 0.25")
          set(retained "${WORK}/retained.exr")
          file(WRITE "${retained}" "retain existing output")
          expect_failure_matching("shared optical interfaces require opaque coverage"
            "${EXEC}" ${BASE_ARGS} -c "eye_pt 0 0 ${eye}" -o "${retained}"
            "${DATABASE}" ${objects})
          file(READ "${retained}" contents)
          if(NOT contents STREQUAL "retain existing output")
            message(FATAL_ERROR "Ambiguous shared coverage replaced an existing output")
          endif()
          set_nested_parameter("${DATABASE}" cover in_opacity "float 0")
        endif()
      endforeach()
    endforeach()
  endforeach()
endforeach()
