set(WORK "@CMAKE_CURRENT_BINARY_DIR@/bump-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
foreach(shader IN ITEMS art_bump_field art_bump_normal)
  configure_file("@CMAKE_CURRENT_BINARY_DIR@/${shader}.oso" "${WORK}/shaders/${shader}.oso" COPYONLY)
endforeach()
set(RENDER_ARGS -a 270 -e 20 -P 2 -c "set samples=1" -w 65 -n 65)

# A constant nonzero height must retain both native and authored normals.
set(CONSTANT_DB "${WORK}/constant.g")
set(PLAIN_DB "${WORK}/plain.g")
run("${VEXEC}" create-material "${CONSTANT_DB}" art_bump_normal)
run("${VEXEC}" create-material "${PLAIN_DB}" art_bump_normal)
run("${VEXEC}" set-material "${CONSTANT_DB}" OSL.version 2)
run("${VEXEC}" set-material "${CONSTANT_DB}" OSL.node.bump as_bump)
run("${VEXEC}" set-material "${CONSTANT_DB}" OSL.param.bump.in_bump_value "float 0.5")
run("${VEXEC}" set-material "${CONSTANT_DB}" OSL.connect.material.in_normal "bump.out_normal")
foreach(object IN ITEMS ball.r ellipsoid.r box.r mesh.r smooth_mesh.r)
  set(reference "${WORK}/plain_${object}.png")
  set(image "${WORK}/constant_${object}.png")
  run("${EXEC}" ${RENDER_ARGS} -p 0 -o "${reference}" "${PLAIN_DB}" "${object}")
  run("${EXEC}" ${RENDER_ARGS} -p 0 -o "${image}" "${CONSTANT_DB}" "${object}")
  run("${VEXEC}" check-matching-image "${image}" "${reference}" 65 65)
endforeach()

set(BUMP_DEPTH 5)
set(ACTUAL_DB "${WORK}/slope.g")
set(REFERENCE_DB "${WORK}/slope_reference.g")
foreach(database IN ITEMS "${ACTUAL_DB}" "${REFERENCE_DB}")
  run("${VEXEC}" create-material "${database}" art_bump_normal)
  run("${VEXEC}" set-material "${database}" OSL.version 2)
  run("${VEXEC}" set-material "${database}" OSL.node.field art_bump_field)
  run("${VEXEC}" set-material "${database}" OSL.param.field.in_depth "float ${BUMP_DEPTH}")
endforeach()
run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.node.bump as_bump)
run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.param.bump.in_bump_depth "float ${BUMP_DEPTH}")
run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.connect.bump.in_bump_value "field.out_height")
run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.connect.bump.in_surface_point "field.out_position")
run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.connect.material.in_normal "bump.out_normal")
run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.connect.material.in_normal "field.out_reference")

# The oracle uses only the known affine gradient and N/Ng, with no screen
# derivatives or bump implementation shared with the native node.
foreach(object IN ITEMS ball.r ellipsoid.r box.r mesh.r smooth_mesh.r)
  if(object STREQUAL "ball.r" OR object STREQUAL "ellipsoid.r")
    set(origin "point -15 0 0")
  elseif(object STREQUAL "box.r")
    set(origin "point 15 0 0")
  else()
    set(origin "point 0 0 0")
  endif()
  foreach(database IN ITEMS "${ACTUAL_DB}" "${REFERENCE_DB}")
    run("${VEXEC}" set-material "${database}" OSL.param.field.in_origin "${origin}")
  endforeach()
  foreach(perspective IN ITEMS 0 85)
    set(image "${WORK}/slope_${object}_${perspective}.png")
    set(reference "${WORK}/slope_reference_${object}_${perspective}.png")
    run("${EXEC}" ${RENDER_ARGS} -p ${perspective} -o "${image}" "${ACTUAL_DB}" "${object}")
    run("${EXEC}" ${RENDER_ARGS} -p ${perspective} -o "${reference}" "${REFERENCE_DB}" "${object}")
    run("${VEXEC}" check-matching-image "${image}" "${reference}" 65 65)
    if(perspective STREQUAL "0")
      run("${VEXEC}" check-different-image "${reference}" "${WORK}/plain_${object}.png" 65 65)
    endif()
  endforeach()
endforeach()

# Offset does not alter an affine slope within the unsaturated range.
run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.param.field.in_offset "float 0.05")
run("${EXEC}" ${RENDER_ARGS} -p 0 -o "${WORK}/shifted_slope.png" "${ACTUAL_DB}" smooth_mesh.r)
run("${VEXEC}" check-matching-image "${WORK}/shifted_slope.png" "${WORK}/slope_reference_smooth_mesh.r_0.png" 65 65)

# Rescaling both position and bump depth changes units without changing
# the gradient. Include scales that expose cross-product normalization loss.
foreach(exponent IN ITEMS -25 -12 12 25)
  set(scale "1e${exponent}")
  set(database "${WORK}/scale_${scale}.g")
  configure_file("${ACTUAL_DB}" "${database}" COPYONLY)
  run("${VEXEC}" set-material "${database}" OSL.param.field.in_position_scale "float ${scale}")
  set(depth "${BUMP_DEPTH}e${exponent}")
  run("${VEXEC}" set-material "${database}" OSL.param.bump.in_bump_depth "float ${depth}")
  run("${EXEC}" ${RENDER_ARGS} -p 0 -o "${WORK}/scale_${scale}.png" "${database}" smooth_mesh.r)
  run("${VEXEC}" check-matching-image "${WORK}/scale_${scale}.png" "${WORK}/slope_reference_smooth_mesh.r_0.png" 65 65)
endforeach()

# Collinear or absent position derivatives deliberately preserve N.
foreach(mode IN ITEMS 1 2)
  set(database "${WORK}/degenerate_${mode}.g")
  configure_file("${ACTUAL_DB}" "${database}" COPYONLY)
  run("${VEXEC}" set-material "${database}" OSL.param.field.in_position_mode "int ${mode}")
  run("${EXEC}" ${RENDER_ARGS} -p 0 -o "${WORK}/degenerate_${mode}.png" "${database}" smooth_mesh.r)
  run("${VEXEC}" check-matching-image "${WORK}/degenerate_${mode}.png" "${WORK}/plain_smooth_mesh.r.png" 65 65)
endforeach()

# Negative depth reverses the gradient without changing the input normal.
set(NEGATIVE_DB "${WORK}/negative_depth.g")
configure_file("${ACTUAL_DB}" "${NEGATIVE_DB}" COPYONLY)
run("${VEXEC}" set-material "${NEGATIVE_DB}" OSL.param.bump.in_bump_depth "float -${BUMP_DEPTH}")
run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.field.in_depth "float -${BUMP_DEPTH}")
run("${EXEC}" ${RENDER_ARGS} -p 0 -o "${WORK}/negative_depth.png" "${NEGATIVE_DB}" smooth_mesh.r)
run("${EXEC}" ${RENDER_ARGS} -p 0 -o "${WORK}/negative_reference.png" "${REFERENCE_DB}" smooth_mesh.r)
run("${VEXEC}" check-matching-image "${WORK}/negative_depth.png" "${WORK}/negative_reference.png" 65 65)

# A sphere's central UV column has u=0.75. Height is exactly zero there
# while the azimuthal gradient is nonzero; compare to the analytic chart.
set(UV_DEPTH 20)
set(UV_DB "${WORK}/uv_zero_height.g")
set(UV_REFERENCE_DB "${WORK}/uv_zero_height_reference.g")
configure_file("${ACTUAL_DB}" "${UV_DB}" COPYONLY)
configure_file("${REFERENCE_DB}" "${UV_REFERENCE_DB}" COPYONLY)
foreach(database IN ITEMS "${UV_DB}" "${UV_REFERENCE_DB}")
  run("${VEXEC}" set-material "${database}" OSL.param.field.in_uv_height "int 1")
  run("${VEXEC}" set-material "${database}" OSL.param.field.in_origin "point -15 0 0")
  run("${VEXEC}" set-material "${database}" OSL.param.field.in_offset "float 0")
  run("${VEXEC}" set-material "${database}" OSL.param.field.in_depth "float ${UV_DEPTH}")
endforeach()
run("${VEXEC}" set-material "${UV_DB}" OSL.param.bump.in_bump_depth "float ${UV_DEPTH}")
run("${EXEC}" ${RENDER_ARGS} -p 0 -o "${WORK}/uv_zero_height.png" "${UV_DB}" ball.r)
run("${EXEC}" ${RENDER_ARGS} -p 0 -o "${WORK}/uv_zero_height_reference.png" "${UV_REFERENCE_DB}" ball.r)
run("${VEXEC}" check-matching-image "${WORK}/uv_zero_height.png" "${WORK}/uv_zero_height_reference.png" 65 65)
