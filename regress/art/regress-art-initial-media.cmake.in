cmake_minimum_required(VERSION 3.22)
set(WORK "@CMAKE_CURRENT_BINARY_DIR@/initial-media-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders" "${WORK}/cache")
set(ENV{BU_DIR_CACHE} "${WORK}/cache")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_nested_test_commands.cmake")
set(TOOL "@ART_OIIOTOOL_EXECUTABLE@")
foreach(shader IN ITEMS art_nested_reference art_refraction_reference art_emission)
  configure_file("@CMAKE_CURRENT_BINARY_DIR@/${shader}.oso"
    "${WORK}/shaders/${shader}.oso" COPYONLY)
endforeach()
set(ACTUAL_DB "${WORK}/actual.g")
set(REFERENCE_DB "${WORK}/reference.g")
foreach(db IN ITEMS "${ACTUAL_DB}" "${REFERENCE_DB}")
  run("${VEXEC}" create-nested "${db}")
endforeach()
set(layers outer inner core)
set(priorities 1 2 3)
foreach(layer priority IN ZIP_LISTS layers priorities)
  run("${VEXEC}" set-named-material "${ACTUAL_DB}" "${layer}.material" OSL.medium_priority "${priority}")
  foreach(kind IN ITEMS box mesh)
    run("${VEXEC}" material "${REFERENCE_DB}" assign "${kind}.${layer}.r" outer.material)
  endforeach()
endforeach()
run("${VEXEC}" set-named-material "${REFERENCE_DB}" outer.material OSL art_nested_reference)
set_nested_parameter("${REFERENCE_DB}" outer in_initial_camera "int 1")
set(SIZE 8)
set(TOLERANCE 0.0005)
set(DIFF_ARGS --fail ${TOLERANCE} --hardfail ${TOLERANCE}
  --warn ${TOLERANCE} --hardwarn ${TOLERANCE})
set(RENDER_ARGS -P 1 -w ${SIZE} -n ${SIZE} -c "viewsize 0.5"
  -c "set samples=1 light_intensity=0 environment_intensity=0 background_color=black max_bounces=-1 rr_min_path_length=0")
run("${TOOL}" --pattern constant:color=0,0,0 ${SIZE}x${SIZE} 3 -o "${WORK}/black.exr")
foreach(profile_name IN ITEMS equal clear absorbing)
  set_nested_profile("${profile_name}")
  foreach(kind IN ITEMS box mesh)
    foreach(location IN ITEMS outer inner core)
      if(location STREQUAL "outer")
        set(z 8)
      elseif(location STREQUAL "inner")
        set(z 4)
      else()
        set(z 0)
      endif()
      set(group nested)
      set(has_core 0)
      if(location STREQUAL "core")
        set(group core)
        set(has_core 1)
      endif()
      set_nested_parameter("${REFERENCE_DB}" outer in_core "int ${has_core}")
      foreach(tilt IN ITEMS 0 10)
        if(tilt EQUAL 0)
          set(quaternion "0 0 0 1")
        else()
          set(quaternion "0 0.08715574274765817 0 0.9961946980917455")
        endif()
        # Pinhole origins are inside. Orthographic origins are backed off by
        # a scene diameter and provide an outside-origin compatibility check.
        foreach(projection IN ITEMS 0 2)
          set(label "${profile_name}-${kind}-${location}-${tilt}-${projection}")
          set(actual "${WORK}/actual-${label}.exr")
          set(reference "${WORK}/reference-${label}.exr")
          run("${EXEC}" ${RENDER_ARGS} -p ${projection} -c "eye_pt 0 0 ${z}"
            -c "orientation ${quaternion}" -o "${actual}" "${ACTUAL_DB}" "${kind}.${group}.g")
          run("${EXEC}" ${RENDER_ARGS} -p ${projection} -c "eye_pt 0 0 ${z}"
            -c "orientation ${quaternion}" -o "${reference}" "${REFERENCE_DB}" "${kind}.${group}.g")
          run("${VEXEC}" check-image "${actual}" ${SIZE} ${SIZE})
          run("${TOOL}" ${DIFF_ARGS} "${actual}" "${reference}" --diff)
          expect_failure("${TOOL}" ${DIFF_ARGS} "${reference}" --ch R,G,B "${WORK}/black.exr" --diff)
        endforeach()
      endforeach()
    endforeach()
  endforeach()
endforeach()

# The initialized state is per ray and must survive worker assignment.
set(threaded "${WORK}/threaded.exr")
run("${EXEC}" ${RENDER_ARGS} -P 2 -p 2 -c "eye_pt 0 0 4"
  -c "orientation 0 0.08715574274765817 0 0.9961946980917455"
  -o "${threaded}" "${ACTUAL_DB}" mesh.nested.g)
run("${TOOL}" ${DIFF_ARGS} "${threaded}" "${WORK}/actual-absorbing-mesh-inner-10-2.exr" --diff)

# Equal indices isolate Beer attenuation for paths ending before the first
# enclosing exit, as well as paths crossing later layers and escaping.
set_nested_profile(equal)
run("${VEXEC}" material "${ACTUAL_DB}" create initial.emitter.material Emission)
run("${VEXEC}" material "${ACTUAL_DB}" set initial.emitter.material optical OSL art_emission)
run("${VEXEC}" material "${ACTUAL_DB}" set initial.emitter.material optical OSL.param.in_color "color 0 1 0")
run("${VEXEC}" material "${ACTUAL_DB}" set initial.emitter.material optical OSL.medium_priority 3)
foreach(kind IN ITEMS box mesh)
  run("${VEXEC}" material "${ACTUAL_DB}" assign "${kind}.core.r" initial.emitter.material)
endforeach()
set(CENTER_ARGS -P 1 -w 1 -n 1 -p 2 -c "viewsize 1" -c "orientation 0 0 0 1"
  -c "set samples=1 light_intensity=0 background_color=black rr_min_path_length=0")
foreach(kind IN ITEMS box mesh)
  foreach(case IN ITEMS outer_emitter inner_emitter inner_environment outer_through_inner single_environment)
    set(objects "${kind}.outer.r")
    set(environment 0.4)
    set(z 0)
    set(outer_exponent 0.25)
    set(inner_exponent 0.5)
    set(color "0.4,0.4,0.4")
    if(case STREQUAL "outer_emitter")
      set(z 8)
      set(outer_exponent 0.3) # Z=8 to Z=2, divided by 20.
      set(inner_exponent 0)
      set(environment 0)
      set(color "0,1,0")
      list(APPEND objects "${kind}.core.r")
    elseif(case STREQUAL "inner_emitter")
      set(z 4)
      set(outer_exponent 0)
      set(inner_exponent 0.2) # Z=4 to Z=2, divided by 10.
      set(environment 0)
      set(color "0,1,0")
      list(APPEND objects "${kind}.inner.r" "${kind}.core.r")
    elseif(case STREQUAL "outer_through_inner")
      set(z 8)
      set(outer_exponent 0.4) # Outer segments total 8 / 20.
      set(inner_exponent 1) # Complete inner path is 10 / 10.
      list(APPEND objects "${kind}.inner.r")
    elseif(case STREQUAL "single_environment")
      set(outer_exponent 0.5) # Z=0 to Z=-10, divided by 20.
      set(inner_exponent 0)
    else()
      list(APPEND objects "${kind}.inner.r")
    endif()
    set(reference "${WORK}/beer-${case}.exr")
    run("${TOOL}" --pattern constant:color=0.25,0.5,0.8 1x1 3 --powc ${outer_exponent}
      --pattern constant:color=0.8,0.6,0.4 1x1 3 --powc ${inner_exponent}
      --mul --mulc "${color}" -o "${reference}")
    set(image "${WORK}/beer-${kind}-${case}.exr")
    run("${EXEC}" ${CENTER_ARGS} -c "eye_pt 0 0 ${z}"
      -c "set environment_color=white environment_intensity=${environment}"
      -o "${image}" "${ACTUAL_DB}" ${objects})
    run("${TOOL}" ${DIFF_ARGS} "${image}" --ch R,G,B "${reference}" --diff)
  endforeach()
endforeach()

# A camera in the filling of a hollow shell must discover the filling's
# exit even when a shell entry occupies exactly the same ray distance.
# The emitter ends the path before that interface, isolating initialization.
set_nested_parameter("${ACTUAL_DB}" inner in_volume_transmittance "color 0.2 0.4 0.6")
set_nested_parameter("${ACTUAL_DB}" inner in_volume_transmittance_distance "float 2")
run("${TOOL}" --pattern constant:color=0,0.4,0 1x1 3 -o "${WORK}/shared-initial-reference.exr")
foreach(kind IN ITEMS box mesh)
  set(shell "${kind}.shell.r")
  run("${VEXEC}" r "${ACTUAL_DB}" "${shell}" u "${kind}.outer.r" - "${kind}.inner.r")
  run("${VEXEC}" material "${ACTUAL_DB}" assign "${shell}" outer.material)
  foreach(order IN ITEMS shell_first filling_first)
    if(order STREQUAL "shell_first")
      set(objects "${shell}" "${kind}.inner.r")
    else()
      set(objects "${kind}.inner.r" "${shell}")
    endif()
    set(image "${WORK}/shared-initial-${kind}-${order}.exr")
    run("${EXEC}" ${CENTER_ARGS} -c "eye_pt 0 0 4" -c "set environment_intensity=0"
      -o "${image}" "${ACTUAL_DB}" ${objects} "${kind}.core.r")
    run("${TOOL}" ${DIFF_ARGS} "${image}" --ch R,G,B "${WORK}/shared-initial-reference.exr" --diff)
  endforeach()
endforeach()

# Sixty unrelated closed solids have more than 100 crossings. They must
# not consume the discovery budget for the enclosing glass at the origin.
set(STRESS_DB "${WORK}/stress.g")
configure_file("${ACTUAL_DB}" "${STRESS_DB}" COPYONLY)
set(UNRELATED_SOLID_COUNT 60)
math(EXPR last "${UNRELATED_SOLID_COUNT} - 1")
set(members)
foreach(i RANGE 0 ${last})
  math(EXPR low "-12 - 2 * ${i}")
  math(EXPR high "${low} + 1")
  run("${VEXEC}" in "${STRESS_DB}" "stress${i}.s" rpp -2 2 -2 2 ${low} ${high})
  run("${VEXEC}" r "${STRESS_DB}" "stress${i}.r" u "stress${i}.s")
  list(APPEND members u "stress${i}.r")
endforeach()
run("${VEXEC}" comb "${STRESS_DB}" stress.g ${members})
set(image "${WORK}/unrelated-solids.exr")
run("${EXEC}" ${CENTER_ARGS} -c "eye_pt 0 0 8" -c "set environment_intensity=0"
  -o "${image}" "${STRESS_DB}" box.outer.r box.core.r stress.g)
run("${TOOL}" ${DIFF_ARGS} "${image}" --ch R,G,B "${WORK}/beer-outer_emitter.exr" --diff)

# Nine strictly nested optical volumes exceed the native eight-medium
# capacity. Failing to establish the complete state must retain old output.
set(members)
foreach(half_width RANGE 1 9)
  run("${VEXEC}" in "${STRESS_DB}" "stack${half_width}.s" rpp
    -${half_width} ${half_width} -${half_width} ${half_width} -${half_width} ${half_width})
  run("${VEXEC}" r "${STRESS_DB}" "stack${half_width}.r" u "stack${half_width}.s")
  run("${VEXEC}" material "${STRESS_DB}" assign "stack${half_width}.r" outer.material)
  list(APPEND members u "stack${half_width}.r")
endforeach()
run("${VEXEC}" comb "${STRESS_DB}" stack.g ${members})
set(image "${WORK}/preserved.exr")
file(WRITE "${image}" "preserve existing output")
expect_failure_matching("too many initial optical media" "${EXEC}" ${CENTER_ARGS}
  -c "eye_pt 0 0 0" -o "${image}" "${STRESS_DB}" stack.g)
file(READ "${image}" retained)
if(NOT retained STREQUAL "preserve existing output")
  message(FATAL_ERROR "Initial-medium discovery failure replaced existing output")
endif()
