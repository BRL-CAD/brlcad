shader art_glass_footprint_field(float in_slope = 0.05, float in_base = 0,
    point in_center = point(0), output normal out_normal = N, output color out_map = color(0, 0, 1))
{
    point p = P - in_center;
    out_map = color(in_base + in_slope * p[0], 0.8 * in_slope * p[1], 1);
    out_normal = normalize(normal(out_map));
}
