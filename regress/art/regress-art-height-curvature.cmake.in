set(WORK "@CMAKE_CURRENT_BINARY_DIR@/height-curvature-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders" "${WORK}/cache")
set(ENV{BU_DIR_CACHE} "${WORK}/cache")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_footprint_test_commands.cmake")
foreach(shader IN ITEMS art_height_field art_glass_footprint_reference art_specular_footprint)
  configure_file("@CMAKE_CURRENT_BINARY_DIR@/${shader}.oso" "${WORK}/shaders/${shader}.oso" COPYONLY)
endforeach()
set(TOOL "@ART_OIIOTOOL_EXECUTABLE@")
set(TOLERANCE 0.00002)
set(FOOTPRINT_RELATIVE_BOUND 0.0109765625)
set(REFINED_FOOTPRINT_RELATIVE_BOUND 0.0059765625)
set(ACTUAL_DB "${WORK}/height.g")
set(REFERENCE_DB "${WORK}/reference.g")
set(DIRECT_DB "${WORK}/direct.g")
run("${VEXEC}" create-material "${ACTUAL_DB}" art_specular_footprint)
run("${VEXEC}" create-material "${REFERENCE_DB}" art_glass_footprint_reference)
create_footprint_receivers()
foreach(parameter IN ITEMS "OSL.version|2" "OSL.param.in_ior|float 0"
    "OSL.node.field|art_height_field" "OSL.node.bump|as_bump"
    "OSL.param.bump.in_bump_depth|float 1"
    "OSL.connect.bump.in_bump_value|field.out_height"
    "OSL.connect.material.in_bump_normal|bump.out_normal")
  string(REPLACE "|" ";" parameter "${parameter}")
  list(GET parameter 0 name)
  list(GET parameter 1 value)
  run("${VEXEC}" set-material "${ACTUAL_DB}" "${name}" "${value}")
endforeach()
set_footprint_reference(reflection "int 1")
set_footprint_reference(unweighted "int 1")
set_footprint_reference(mapped "int 1")
set_footprint_reference(slope "float 0.05")
configure_file("${ACTUAL_DB}" "${DIRECT_DB}" COPYONLY)
foreach(name IN ITEMS OSL.node.bump OSL.param.bump.in_bump_depth OSL.connect.bump.in_bump_value)
  run("${VEXEC}" remove-material "${DIRECT_DB}" "${name}")
endforeach()
run("${VEXEC}" set-material "${DIRECT_DB}" OSL.connect.material.in_bump_normal field.out_reference)
set(RENDER_ARGS -P 1 -c "viewsize 0.5" -c "eye_pt 2 -2 40" -c "orientation 0 0 0 1"
  -c "set sampling=uniform samples=1 max_bounces=16 max_specular_bounces=16 rr_min_path_length=0 next_event_estimation=0 light_intensity=0 environment_intensity=0 background_color=black")
foreach(SIZE IN ITEMS 16 32)
  set(relative_bound ${FOOTPRINT_RELATIVE_BOUND})
  if(SIZE EQUAL 32)
    set(relative_bound ${REFINED_FOOTPRINT_RELATIVE_BOUND})
  endif()
  run("${TOOL}" --pattern constant:color=0,0,0 ${SIZE}x${SIZE} 3 -o "${WORK}/black.exr")
  foreach(shape IN ITEMS cube mesh)
    foreach(projection IN ITEMS 0 2)
      foreach(mode IN ITEMS 0 1)
        foreach(db IN ITEMS "${ACTUAL_DB}" "${DIRECT_DB}" "${REFERENCE_DB}")
          run("${VEXEC}" set-named-material "${db}" receiver.material OSL.param.in_mode "int ${mode}")
        endforeach()
        set_footprint_reference(mode "int ${mode}")
        foreach(kind IN ITEMS height direct reference)
          if(kind STREQUAL height)
            set(db "${ACTUAL_DB}")
          elseif(kind STREQUAL direct)
            set(db "${DIRECT_DB}")
          else()
            set(db "${REFERENCE_DB}")
          endif()
          set(image "${WORK}/${SIZE}-${shape}-${projection}-${mode}-${kind}.exr")
          run("${EXEC}" ${RENDER_ARGS} -w ${SIZE} -n ${SIZE} -p ${projection} -o "${image}" "${db}" "${shape}.r" front.r)
          run("${VEXEC}" check-image "${image}" ${SIZE} ${SIZE})
          expect_failure("${TOOL}" --fail 0 --hardfail 0 "${image}" --ch R,G,B "${WORK}/black.exr" --diff)
        endforeach()
        set(reference "${WORK}/${SIZE}-${shape}-${projection}-${mode}-reference.exr")
        foreach(kind IN ITEMS height direct)
          set(actual "${WORK}/${SIZE}-${shape}-${projection}-${mode}-${kind}.exr")
          if(mode EQUAL 0)
            compare_optical_transport("${actual}" "${reference}" ${relative_bound})
          else()
            compare_optical_transport("${actual}" "${reference}")
          endif()
        endforeach()
      endforeach()
    endforeach()
  endforeach()
endforeach()
