set(WORK "@CMAKE_CURRENT_BINARY_DIR@/directional-emission-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders" "${WORK}/cache")
set(ENV{BU_DIR_CACHE} "${WORK}/cache")
set(ART_COMMAND_TIMEOUT 240)
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_nested_test_commands.cmake")
foreach(shader IN ITEMS art_diffuse art_directional_emission)
  configure_file("@CMAKE_CURRENT_BINARY_DIR@/${shader}.oso" "${WORK}/shaders/${shader}.oso" COPYONLY)
endforeach()
set(TOOL "@ART_OIIOTOOL_EXECUTABLE@")
set(BASE_ARGS -P 2 -p 0.02 -w 1 -n 1 -c "viewsize 0.001"
  -c "eye_pt 0 0.5 0" -c "lookat_pt 0 0 0"
  -c "set sampling=uniform light_intensity=0 environment_intensity=0 background_color=black rr_min_path_length=0")
# The footprint averages independent photon neighborhoods, with a lookup
# radius small relative to the spatial variation of the incident light.
set(ENERGY_RELATIVE_BOUND 0.03)
set(PHOTON_PASSES 16)
set(PHOTONS_PER_PASS 1000000)
foreach(kind IN ITEMS box mesh)
  set(database "${WORK}/${kind}.g")
  run("${VEXEC}" create-emitter "${database}" "${kind}")
  run("${VEXEC}" set-named-material "${database}" emitter.material OSL art_directional_emission)
  run("${VEXEC}" material "${database}" create cover.material Clear_cover)
  run("${VEXEC}" set-named-material "${database}" cover.material OSL as_glass)
  foreach(parameter IN ITEMS "in_ior;float 1" "in_roughness;float 0"
      "in_transmittance_amount;float 1" "in_surface_transmittance;color 1 1 1"
      "in_reflection_tint;color 0 0 0")
    list(GET parameter 0 name)
    list(GET parameter 1 value)
    set_nested_parameter("${database}" cover "${name}" "${value}")
  endforeach()
  # Index-one glass leaves transport unchanged but makes these paths caustic.
  # SPPM must launch photons to illuminate the receiver through this cover.
  run("${VEXEC}" in "${database}" cover.s rpp -20 20 1 1.1 -20 20)
  run("${VEXEC}" r "${database}" cover.r u cover.s)
  run("${VEXEC}" material "${database}" assign cover.r cover.material)
  foreach(cone IN ITEMS 1 0.95)
    # At 0.95 the normal is dark and an annulus of oblique rays emits.
    # Its projected excluded disk fits wholly inside the square emitter.
    set_nested_parameter("${database}" emitter in_normal_cone_cosine "float ${cone}")
    set(prefix "${WORK}/${kind}-${cone}")
    run("${EXEC}" ${BASE_ARGS}
      -c "set samples=131072 max_bounces=1 max_diffuse_bounces=0"
      -o "${prefix}-center.exr" "${database}" receiver.r emitter.r)
    run("${VEXEC}" check-emitter-image "${prefix}-center.exr" "${kind}" "${cone}")
    set(reference "${prefix}-reference.exr")
    run("${EXEC}" ${BASE_ARGS} -p 90 -w 32 -n 32
      -c "set samples=2048 max_bounces=1 max_diffuse_bounces=0"
      -o "${reference}" "${database}" receiver.r emitter.r)
    set(image "${prefix}-photon.exr")
    run_command("${CMAKE_CURRENT_BINARY_DIR}" FALSE "${EXEC}" ${BASE_ARGS} -p 90 -w 32 -n 32
      -c "set integrator=sppm samples=1 passes=${PHOTON_PASSES} light_photons=${PHOTONS_PER_PASS} environment_photons=0 max_bounces=0 photon_max_bounces=3 photon_rr_min_path_length=0 photon_max_estimate=10000 photon_importons=0 photon_radius_percent=0.05 enable_caustics=1"
      -o "${image}" "${database}" receiver.r emitter.r cover.r)
    if(NOT command_output MATCHES "sppm pass ${PHOTON_PASSES} completed")
      message(FATAL_ERROR "Directional emission did not complete all photon passes")
    endif()
    run("${VEXEC}" check-image "${reference}" 32 32)
    run("${VEXEC}" check-image "${image}" 32 32)
    compare_radiance_mean("${image}" "${reference}" ${ENERGY_RELATIVE_BOUND} FALSE)
  endforeach()
endforeach()
