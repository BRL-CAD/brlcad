cmake_minimum_required(VERSION 3.22)

set(WORK "@CMAKE_CURRENT_BINARY_DIR@/materials-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
foreach(shader IN ITEMS art_emission art_graph_value art_instance_materials)
  configure_file("@CMAKE_CURRENT_BINARY_DIR@/${shader}.oso"
    "${WORK}/shaders/${shader}.oso" COPYONLY)
endforeach()
set(DB "${WORK}/inherited.g")
set(REFERENCE_DB "${WORK}/reference.g")
run("${VEXEC}" create-material "${DB}" art_emission)
run("${VEXEC}" create-material "${REFERENCE_DB}" art_emission)
run("${VEXEC}" material "${DB}" create base.material Base)
run("${VEXEC}" material "${DB}" set base.material optical OSL art_emission)
run("${VEXEC}" material "${DB}" set base.material optical OSL.param.in_color "color 0.2 0.4 0.6")
run("${VEXEC}" material "${DB}" set osl.material parent base.material)
run("${VEXEC}" remove-material "${DB}" OSL)
set(RENDER_ARGS -a 0 -e 65 -E 2 -P 2 -w 64 -n 64 -C 0/0/0
  -c "set samples=4 light_intensity=0" -c "viewsize 40")
function(compare_material label color)
  run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_color "${color}")
  foreach(object IN ITEMS cube.r mesh.r ball.r ellipsoid.r)
    foreach(perspective IN ITEMS 0 50)
      set(tag "${label}_${object}_${perspective}")
      run("${EXEC}" ${RENDER_ARGS} -p ${perspective}
        -o "${WORK}/actual_${tag}.png" "${DB}" "${object}")
      run("${EXEC}" ${RENDER_ARGS} -p ${perspective}
        -o "${WORK}/reference_${tag}.png" "${REFERENCE_DB}" "${object}")
      run("${VEXEC}" check-matching-image "${WORK}/actual_${tag}.png" "${WORK}/reference_${tag}.png" 64 64)
    endforeach()
  endforeach()
endfunction()
compare_material(inherited "color 0.2 0.4 0.6")
run("${VEXEC}" set-material "${DB}" OSL.param.in_color "color 0.1 0.7 0.3")
compare_material(overridden "color 0.1 0.7 0.3")
run("${VEXEC}" remove-material "${DB}" OSL.param.in_color)
compare_material(restored "color 0.2 0.4 0.6")

# A child can inherit and customize a complete version 2 network.
run("${VEXEC}" material "${DB}" create graph.material Graph)
run("${VEXEC}" material "${DB}" set graph.material parent base.material)
run("${VEXEC}" material "${DB}" set graph.material optical OSL.version 2)
run("${VEXEC}" material "${DB}" set graph.material optical OSL.node.tint art_graph_value)
run("${VEXEC}" material "${DB}" set graph.material optical OSL.param.tint.in_color "color 0.4 0.8 0.2")
run("${VEXEC}" material "${DB}" set graph.material optical OSL.param.tint.in_weight "float 0.5")
run("${VEXEC}" material "${DB}" set graph.material optical OSL.connect.material.in_color tint.out_color)
run("${VEXEC}" material "${DB}" set osl.material parent graph.material)
run("${VEXEC}" set-material "${DB}" OSL.param.tint.in_color "color 0.2 0.6 0.4")
compare_material(graph "color 0.1 0.3 0.2")

# An explicit root starts a fresh graph, even when its shader name is unchanged.
run("${VEXEC}" remove-material "${DB}" OSL.param.tint.in_color)
run("${VEXEC}" set-material "${DB}" OSL art_emission)
run("${VEXEC}" set-material "${DB}" OSL.param.in_color "color 0.6 0.2 0.4")
compare_material(reset "color 0.6 0.2 0.4")

# Check iterative parent resolution through a substantially longer chain.
set(PARENT_LINK_COUNT 32)
set(parent base.material)
foreach(index RANGE 1 ${PARENT_LINK_COUNT})
  set(child "level${index}.material")
  run("${VEXEC}" material "${DB}" create "${child}" Level)
  run("${VEXEC}" material "${DB}" set "${child}" parent "${parent}")
  set(parent "${child}")
endforeach()
run("${VEXEC}" material "${DB}" set osl.material parent "${parent}")
run("${VEXEC}" remove-material "${DB}" OSL)
run("${VEXEC}" remove-material "${DB}" OSL.param.in_color)
compare_material(long_chain "color 0.2 0.4 0.6")

# Parent links must remain valid even when the child supplies its own root.
run("${VEXEC}" set-material "${DB}" OSL art_emission)
# Every bad selected chain must fail before replacing an existing image.
set(preserved "${WORK}/preserved.png")
configure_file("${WORK}/actual_inherited_cube.r_0.png" "${preserved}" COPYONLY)
file(SHA256 "${preserved}" before)
foreach(failure IN ITEMS missing wrong_type self_cycle multi_cycle)
  if(failure STREQUAL "missing")
    set(parent missing.material)
    set(diagnostic "cannot read material")
  elseif(failure STREQUAL "wrong_type")
    set(parent ball.s)
    set(diagnostic "not a material object")
  elseif(failure STREQUAL "self_cycle")
    set(parent osl.material)
    set(diagnostic "parent cycle")
  else()
    set(parent graph.material)
    run("${VEXEC}" material "${DB}" set graph.material parent osl.material)
    set(diagnostic "parent cycle")
  endif()
  run("${VEXEC}" material "${DB}" set osl.material parent "${parent}")
  expect_failure_matching("${diagnostic}" "${EXEC}" ${RENDER_ARGS} -p 0 -o "${preserved}" "${DB}" cube.r)
  file(SHA256 "${preserved}" after)
  if(NOT before STREQUAL after)
    message(FATAL_ERROR "A failed material-parent lookup replaced the previous image")
  endif()
endforeach()

# One region occurs under two parents with independently assigned materials.
set(INSTANCE_DB "${WORK}/instances.g")
set(INSTANCE_REFERENCE_DB "${WORK}/instances-reference.g")
run("${VEXEC}" create-material "${INSTANCE_DB}" art_emission)
run("${VEXEC}" set-material "${INSTANCE_DB}" OSL.param.in_color "color 0.7 0.2 0.1")
run("${VEXEC}" create-material "${INSTANCE_REFERENCE_DB}" art_instance_materials)
run("${VEXEC}" material "${INSTANCE_DB}" create base.material Base)
run("${VEXEC}" material "${INSTANCE_DB}" set base.material optical OSL art_emission)
run("${VEXEC}" material "${INSTANCE_DB}" set base.material optical OSL.version 2)
run("${VEXEC}" material "${INSTANCE_DB}" set base.material optical OSL.node.tint art_graph_value)
run("${VEXEC}" material "${INSTANCE_DB}" set base.material optical OSL.connect.material.in_color tint.out_color)
foreach(variant IN ITEMS left right common)
  run("${VEXEC}" material "${INSTANCE_DB}" create "${variant}.material" "${variant}")
  run("${VEXEC}" material "${INSTANCE_DB}" set "${variant}.material" parent base.material)
endforeach()
set(LEFT_COLOR "color 0 1 0")
set(RIGHT_COLOR "color 0 0 1")
set(REGION_COLOR "color 0.7 0.2 0.1")
set(COMMON_COLOR "color 0.6 0.4 0.2")
foreach(variant IN ITEMS left right common)
  string(TOUPPER "${variant}" upper)
  run("${VEXEC}" material "${INSTANCE_DB}" set "${variant}.material" optical OSL.param.tint.in_color "${${upper}_COLOR}")
endforeach()
run("${VEXEC}" material "${INSTANCE_DB}" assign instance_left.g left.material)
run("${VEXEC}" material "${INSTANCE_DB}" assign instance_right.g right.material)
set(INSTANCE_ARGS -a 0 -e 65 -E 2 -P 2 -w 64 -n 64 -C 0/0/0
  -c "set samples=4 light_intensity=0" -c "viewsize 70")
function(compare_instances label left right object)
  run("${VEXEC}" set-material "${INSTANCE_REFERENCE_DB}" OSL.param.in_left "${left}")
  run("${VEXEC}" set-material "${INSTANCE_REFERENCE_DB}" OSL.param.in_right "${right}")
  foreach(perspective IN ITEMS 0 50)
    run("${EXEC}" ${INSTANCE_ARGS} -p ${perspective}
      -o "${WORK}/actual_${label}_${perspective}.png" "${INSTANCE_DB}" "${object}")
    run("${EXEC}" ${INSTANCE_ARGS} -p ${perspective}
      -o "${WORK}/reference_${label}_${perspective}.png" "${INSTANCE_REFERENCE_DB}" "${object}")
    run("${VEXEC}" check-matching-image "${WORK}/actual_${label}_${perspective}.png" "${WORK}/reference_${label}_${perspective}.png" 64 64)
  endforeach()
endfunction()
compare_instances(assigned "${LEFT_COLOR}" "${RIGHT_COLOR}" instances.g)
run("${VEXEC}" attr "${INSTANCE_DB}" set instance_left.g inherit 0)
compare_instances(lower_override "${REGION_COLOR}" "${RIGHT_COLOR}" instances.g)
run("${VEXEC}" attr "${INSTANCE_DB}" rm ball.r material_name)
compare_instances(fallback "${LEFT_COLOR}" "${RIGHT_COLOR}" instances.g)
run("${VEXEC}" attr "${INSTANCE_DB}" set ball.r material_name missing.material)
run("${VEXEC}" attr "${INSTANCE_DB}" set instance_left.g inherit yes)
compare_instances(ignored_bad_leaf "${LEFT_COLOR}" "${RIGHT_COLOR}" instances.g)
run("${VEXEC}" attr "${INSTANCE_DB}" set instance_left.g inherit 0)
expect_failure_matching("cannot read material" "${EXEC}" ${INSTANCE_ARGS}
  -o "${preserved}" "${INSTANCE_DB}" instances.g)
file(SHA256 "${preserved}" after)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "An invalid selected instance material replaced the previous image")
endif()
run("${VEXEC}" material "${INSTANCE_DB}" assign ball.r osl.material)
run("${VEXEC}" attr "${INSTANCE_DB}" set instance_left.g inherit yes)
run("${VEXEC}" material "${INSTANCE_DB}" assign instances.g common.material)
compare_instances(top_lower "${LEFT_COLOR}" "${RIGHT_COLOR}" instances.g)
run("${VEXEC}" attr "${INSTANCE_DB}" set instances.g inherit 1)
compare_instances(top_higher "${COMMON_COLOR}" "${COMMON_COLOR}" instances.g)
compare_instances(selected_path "${COMMON_COLOR}" "${COMMON_COLOR}" /instances.g/instance_right.g/ball.r)
compare_instances(selected_root "${LEFT_COLOR}" "${RIGHT_COLOR}" instance_right.g)
compare_instances(selected_region "${REGION_COLOR}" "${REGION_COLOR}" ball.r)
run("${VEXEC}" material "${INSTANCE_DB}" assign arcs.g common.material)
run("${VEXEC}" attr "${INSTANCE_DB}" set arcs.g inherit 1)
compare_instances(repeated_arcs "${COMMON_COLOR}" "${COMMON_COLOR}" arcs.g)
run("${VEXEC}" attr "${INSTANCE_DB}" rm instances.g material_name)
compare_instances(empty_higher "${LEFT_COLOR}" "${RIGHT_COLOR}" instances.g)
run("${VEXEC}" attr "${INSTANCE_DB}" set instances.g material_name missing.material inherit 0)
compare_instances(ignored_bad_parent "${LEFT_COLOR}" "${RIGHT_COLOR}" instances.g)
run("${VEXEC}" attr "${INSTANCE_DB}" set instances.g inherit 1)
expect_failure_matching("cannot read material" "${EXEC}" ${INSTANCE_ARGS}
  -o "${preserved}" "${INSTANCE_DB}" instances.g)
file(SHA256 "${preserved}" after)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "An invalid inherited instance material replaced the previous image")
endif()

# Parent definitions and their shader assets must survive project relocation.
run("${VEXEC}" attr "${INSTANCE_DB}" rm instances.g material_name)
set(project "${WORK}/parent project")
file(MAKE_DIRECTORY "${project}/shaders" "${WORK}/elsewhere")
foreach(shader IN ITEMS art_emission art_graph_value art_instance_materials)
  configure_file("${WORK}/shaders/${shader}.oso" "${project}/shaders/${shader}.oso" COPYONLY)
endforeach()
configure_file("${INSTANCE_DB}" "${project}/scene.g" COPYONLY)
configure_file("${INSTANCE_REFERENCE_DB}" "${project}/reference.g" COPYONLY)
set(moved "${WORK}/moved parent project")
file(RENAME "${project}" "${moved}")
foreach(perspective IN ITEMS 0 50)
  run_in("${WORK}/elsewhere" "${EXEC}" ${INSTANCE_ARGS} -p ${perspective}
    -o "${WORK}/moved_actual_${perspective}.png" "${moved}/scene.g" instances.g)
  run_in("${WORK}/elsewhere" "${EXEC}" ${INSTANCE_ARGS} -p ${perspective}
    -o "${WORK}/moved_reference_${perspective}.png" "${moved}/reference.g" instances.g)
  run("${VEXEC}" check-matching-image "${WORK}/moved_actual_${perspective}.png" "${WORK}/moved_reference_${perspective}.png" 64 64)
endforeach()
