cmake_minimum_required(VERSION 3.22)

set(WORK "@CMAKE_CURRENT_BINARY_DIR@/materials-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
foreach(shader IN ITEMS art_emission art_graph_value)
  configure_file("@CMAKE_CURRENT_BINARY_DIR@/${shader}.oso"
    "${WORK}/shaders/${shader}.oso" COPYONLY)
endforeach()
set(DB "${WORK}/inherited.g")
set(REFERENCE_DB "${WORK}/reference.g")
run("${VEXEC}" create-material "${DB}" art_emission)
run("${VEXEC}" create-material "${REFERENCE_DB}" art_emission)
run("${VEXEC}" material "${DB}" create base.material Base)
run("${VEXEC}" material "${DB}" set base.material optical OSL art_emission)
run("${VEXEC}" material "${DB}" set base.material optical OSL.param.in_color "color 0.2 0.4 0.6")
run("${VEXEC}" material "${DB}" set osl.material parent base.material)
run("${VEXEC}" remove-material "${DB}" OSL)
set(RENDER_ARGS -a 0 -e 65 -E 2 -P 2 -w 64 -n 64 -C 0/0/0
  -c "set samples=4 light_intensity=0" -c "viewsize 40")
function(compare_material label color)
  run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_color "${color}")
  foreach(object IN ITEMS cube.r mesh.r ball.r ellipsoid.r)
    foreach(perspective IN ITEMS 0 50)
      set(tag "${label}_${object}_${perspective}")
      run("${EXEC}" ${RENDER_ARGS} -p ${perspective}
        -o "${WORK}/actual_${tag}.png" "${DB}" "${object}")
      run("${EXEC}" ${RENDER_ARGS} -p ${perspective}
        -o "${WORK}/reference_${tag}.png" "${REFERENCE_DB}" "${object}")
      run("${VEXEC}" check-matching-image "${WORK}/actual_${tag}.png" "${WORK}/reference_${tag}.png" 64 64)
    endforeach()
  endforeach()
endfunction()
compare_material(inherited "color 0.2 0.4 0.6")
run("${VEXEC}" set-material "${DB}" OSL.param.in_color "color 0.1 0.7 0.3")
compare_material(overridden "color 0.1 0.7 0.3")
run("${VEXEC}" remove-material "${DB}" OSL.param.in_color)
compare_material(restored "color 0.2 0.4 0.6")

# A child can inherit and customize a complete version 2 network.
run("${VEXEC}" material "${DB}" create graph.material Graph)
run("${VEXEC}" material "${DB}" set graph.material parent base.material)
run("${VEXEC}" material "${DB}" set graph.material optical OSL.version 2)
run("${VEXEC}" material "${DB}" set graph.material optical OSL.node.tint art_graph_value)
run("${VEXEC}" material "${DB}" set graph.material optical OSL.param.tint.in_color "color 0.4 0.8 0.2")
run("${VEXEC}" material "${DB}" set graph.material optical OSL.param.tint.in_weight "float 0.5")
run("${VEXEC}" material "${DB}" set graph.material optical OSL.connect.material.in_color tint.out_color)
run("${VEXEC}" material "${DB}" set osl.material parent graph.material)
run("${VEXEC}" set-material "${DB}" OSL.param.tint.in_color "color 0.2 0.6 0.4")
compare_material(graph "color 0.1 0.3 0.2")

# An explicit root starts a fresh graph, even when its shader name is unchanged.
run("${VEXEC}" remove-material "${DB}" OSL.param.tint.in_color)
run("${VEXEC}" set-material "${DB}" OSL art_emission)
run("${VEXEC}" set-material "${DB}" OSL.param.in_color "color 0.6 0.2 0.4")
compare_material(reset "color 0.6 0.2 0.4")

# Check iterative parent resolution through a substantially longer chain.
set(PARENT_LINK_COUNT 32)
set(parent base.material)
foreach(index RANGE 1 ${PARENT_LINK_COUNT})
  set(child "level${index}.material")
  run("${VEXEC}" material "${DB}" create "${child}" Level)
  run("${VEXEC}" material "${DB}" set "${child}" parent "${parent}")
  set(parent "${child}")
endforeach()
run("${VEXEC}" material "${DB}" set osl.material parent "${parent}")
run("${VEXEC}" remove-material "${DB}" OSL)
run("${VEXEC}" remove-material "${DB}" OSL.param.in_color)
compare_material(long_chain "color 0.2 0.4 0.6")

# Every bad selected chain must fail before replacing an existing image.
set(preserved "${WORK}/preserved.png")
configure_file("${WORK}/actual_inherited_cube.r_0.png" "${preserved}" COPYONLY)
file(SHA256 "${preserved}" before)
foreach(failure IN ITEMS missing wrong_type self_cycle multi_cycle)
  if(failure STREQUAL "missing")
    set(parent missing.material)
    set(diagnostic "cannot read material")
  elseif(failure STREQUAL "wrong_type")
    set(parent ball.s)
    set(diagnostic "not a material object")
  elseif(failure STREQUAL "self_cycle")
    set(parent osl.material)
    set(diagnostic "parent cycle")
  else()
    set(parent graph.material)
    run("${VEXEC}" material "${DB}" set graph.material parent osl.material)
    set(diagnostic "parent cycle")
  endif()
  run("${VEXEC}" material "${DB}" set osl.material parent "${parent}")
  expect_failure_matching("${diagnostic}" "${EXEC}" ${RENDER_ARGS} -p 0 -o "${preserved}" "${DB}" cube.r)
  file(SHA256 "${preserved}" after)
  if(NOT before STREQUAL after)
    message(FATAL_ERROR "A failed material-parent lookup replaced the previous image")
  endif()
endforeach()
