set(WORK "@CMAKE_CURRENT_BINARY_DIR@/trace-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders" "${WORK}/cache")
set(ENV{BU_DIR_CACHE} "${WORK}/cache")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
foreach(shader IN ITEMS art_trace_queries art_diffuse)
  configure_file("@CMAKE_CURRENT_BINARY_DIR@/${shader}.oso"
    "${WORK}/shaders/${shader}.oso" COPYONLY)
endforeach()
set(DB "${WORK}/trace.g")
run("${VEXEC}" create-lit-glass "${DB}")
run("${VEXEC}" set-named-material "${DB}" glass.material OSL art_trace_queries)
run("${VEXEC}" set-named-material "${DB}" glass.material OSL.param.in_target "int 1")
set(SIZE 8)
set(TOOL "@ART_OIIOTOOL_EXECUTABLE@")
set(PIXEL_TOLERANCE 0.000001)
run("${TOOL}" --pattern constant:color=0,0,0 ${SIZE}x${SIZE} 3 -o "${WORK}/black.exr")
set(RENDER_ARGS -w ${SIZE} -n ${SIZE} -p 0.02
  -c "viewsize 1" -c "eye_pt 0 0 2" -c "orientation 0 0 0 1"
  -c "set samples=1 max_bounces=0 light_intensity=1000 environment_intensity=0 background_color=black")
foreach(workers IN ITEMS 1 2)
  foreach(object IN ITEMS box mesh)
    foreach(form IN ITEMS reference query)
      if(form STREQUAL "reference")
	set(shader art_diffuse)
      else()
	set(shader art_trace_queries)
      endif()
      run("${VEXEC}" set-named-material "${DB}" receiver.material OSL "${shader}")
      set(image "${WORK}/${workers}-${object}-${form}.exr")
      run_in("${WORK}" "${EXEC}" ${RENDER_ARGS} -P ${workers} -o "${image}" "${DB}"
	"receiver.${object}.r" "slab.${object}.r" key_light.r)
      run("${VEXEC}" check-image "${image}" ${SIZE} ${SIZE})
    endforeach()
    run("${TOOL}" --fail ${PIXEL_TOLERANCE} --hardfail ${PIXEL_TOLERANCE}
      "${WORK}/${workers}-${object}-query.exr" "${WORK}/${workers}-${object}-reference.exr" --diff)
    expect_failure_matching("FAILURE" "${TOOL}" --fail ${PIXEL_TOLERANCE} --hardfail ${PIXEL_TOLERANCE}
      "${WORK}/${workers}-${object}-reference.exr" "${WORK}/black.exr" --diff)
  endforeach()
endforeach()
