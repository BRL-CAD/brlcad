set(WORK "@CMAKE_CURRENT_BINARY_DIR@/output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")

include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")

run("${VEXEC}" create "${WORK}/scene.g")
set(RENDER_ARGS -a 270 -e 20 -P 2 -c "set samples=4")
function(render_case name width height perspective extension)
  set(image "${WORK}/${name}.${extension}")
  run("${EXEC}" ${RENDER_ARGS} -w ${width} -n ${height} -p ${perspective} -o "${image}" "${WORK}/scene.g" all.g)
  run("${VEXEC}" check "${image}" ${width} ${height})
endfunction()

render_case(perspective_landscape 128 96 85 png)
render_case(perspective_portrait 96 128 85 png)
render_case(orthographic_landscape 128 96 0 png)
render_case(orthographic_portrait 96 128 0 png)
render_case(native_pix 128 96 85 pix)

# Exercise BOT hits through librt as well as native CSG boundaries.
foreach(workers IN ITEMS 1 2)
  set(image "${WORK}/mesh_${workers}.png")
  run("${EXEC}" ${RENDER_ARGS} -P ${workers} -w 96 -n 96 -o "${image}" "${WORK}/scene.g" mesh.r)
  run("${VEXEC}" check-mesh "${image}" 96 96)
endforeach()

run("${EXEC}" ${RENDER_ARGS} -w 128 -n 96 -p 0 -o "${WORK}/instances.png" "${WORK}/scene.g" instances.g)
run("${VEXEC}" check "${WORK}/instances.png" 128 96)
run("${EXEC}" ${RENDER_ARGS} -w 128 -n 96 -p 0 -o "${WORK}/arcs.png" "${WORK}/scene.g" arcs.g)
run("${VEXEC}" check-pair "${WORK}/arcs.png" 128 96)

# Material-object selection must use the same validated closure graph.
run("${VEXEC}" create-material "${WORK}/material.g" as_plastic)
run("${EXEC}" ${RENDER_ARGS} -w 128 -n 96 -p 85 -o "${WORK}/material.png" "${WORK}/material.g" all.g)
run("${VEXEC}" check "${WORK}/material.png" 128 96)
run("${EXEC}" ${RENDER_ARGS} -w 96 -n 96 -o "${WORK}/material_mesh.png" "${WORK}/material.g" mesh.r)
run("${VEXEC}" check-mesh "${WORK}/material_mesh.png" 96 96)

# Assets live beside the database, including in directories containing spaces.
set(PORTABLE_PROJECT "${WORK}/portable project")
file(MAKE_DIRECTORY "${PORTABLE_PROJECT}/shaders")
foreach(shader IN ITEMS @ART_TEST_SHADER_NAMES@)
  configure_file("@CMAKE_CURRENT_BINARY_DIR@/${shader}.oso" "${PORTABLE_PROJECT}/shaders/${shader}.oso" COPYONLY)
endforeach()
run("${VEXEC}" create-material "${PORTABLE_PROJECT}/scene.g" art_diffuse)
run("${EXEC}" ${RENDER_ARGS} -w 128 -n 96 -p 85 -o "${PORTABLE_PROJECT}/surface.png" "${PORTABLE_PROJECT}/scene.g" all.g)
run("${VEXEC}" check "${PORTABLE_PROJECT}/surface.png" 128 96)
run("${EXEC}" ${RENDER_ARGS} -w 96 -n 96 -o "${PORTABLE_PROJECT}/surface_mesh.png" "${PORTABLE_PROJECT}/scene.g" mesh.r)
run("${VEXEC}" check-mesh "${PORTABLE_PROJECT}/surface_mesh.png" 96 96)

# Diagnostic emission exposes the supplied UV values independently of lighting.
run("${VEXEC}" create-material "${PORTABLE_PROJECT}/uv.g" art_uv)
foreach(object IN ITEMS ball.r box.r mesh.r)
  set(image "${WORK}/uv_${object}.png")
  run("${EXEC}" ${RENDER_ARGS} -w 96 -n 96 -p 0 -o "${image}" "${PORTABLE_PROJECT}/uv.g" "${object}")
  run("${VEXEC}" check-uv "${image}" 96 96)
endforeach()

# Smooth normals must reach OSL separately from the facet normal.
run("${VEXEC}" create-material "${PORTABLE_PROJECT}/normals.g" art_normals)
run("${EXEC}" ${RENDER_ARGS} -w 96 -n 96 -p 0 -o "${WORK}/normals.png" "${PORTABLE_PROJECT}/normals.g" smooth_mesh.r)
run("${VEXEC}" check-normals "${WORK}/normals.png" 96 96)
run("${EXEC}" ${RENDER_ARGS} -w 96 -n 96 -p 0 -o "${WORK}/flat_normals.png" "${PORTABLE_PROJECT}/normals.g" mesh.r)
run("${VEXEC}" check-flat-normals "${WORK}/flat_normals.png" 96 96)

# OSL must receive ray footprints for supported charts and zero for others.
run("${VEXEC}" create-material "${PORTABLE_PROJECT}/footprints.g" art_footprints)
foreach(perspective IN ITEMS 0 85)
  foreach(object IN ITEMS ball.r ellipsoid.r mesh.r smooth_mesh.r)
    set(image "${WORK}/footprints_${object}_${perspective}.png")
    run("${EXEC}" ${RENDER_ARGS} -w 96 -n 96 -p ${perspective} -o "${image}" "${PORTABLE_PROJECT}/footprints.g" "${object}")
    run("${VEXEC}" check-footprints "${image}" 96 96)
  endforeach()
  set(image "${WORK}/zero_footprints_${perspective}.png")
  run("${EXEC}" ${RENDER_ARGS} -w 96 -n 96 -p ${perspective} -o "${image}" "${PORTABLE_PROJECT}/footprints.g" box.r)
  run("${VEXEC}" check-zero-footprints "${image}" 96 96)
endforeach()

function(invalid_material name shader output)
  run("${VEXEC}" create-material "${PORTABLE_PROJECT}/${name}.g" "${shader}" "${output}")
  expect_failure("${EXEC}" ${RENDER_ARGS} -w 32 -n 32 -o "${WORK}/${name}.png" "${PORTABLE_PROJECT}/${name}.g" all.g)
  if(EXISTS "${WORK}/${name}.png")
    message(FATAL_ERROR "Invalid material produced an image: ${name}")
  endif()
endfunction()
invalid_material(missing_shader art_shader_that_does_not_exist out_outColor)
invalid_material(missing_output as_plastic output_that_does_not_exist)
invalid_material(nonclosure_output art_color out_color)
invalid_material(surface_output as_closure2surface in_input)

# Persist typed inputs through the material command, then reopen for rendering.
set(PARAMETER_DB "${PORTABLE_PROJECT}/parameters.g")
run("${VEXEC}" create-material "${PARAMETER_DB}" art_parameters)
run("${VEXEC}" set-material "${PARAMETER_DB}" OSL.version 1)
run("${VEXEC}" set-material "${PARAMETER_DB}" OSL.param.in_weight "float 0.375")
run("${VEXEC}" set-material "${PARAMETER_DB}" OSL.param.in_count "int 7")
run("${VEXEC}" set-material "${PARAMETER_DB}" OSL.param.in_color "color 0.2 0.4 0.6")
run("${VEXEC}" set-material "${PARAMETER_DB}" OSL.param.in_point "point 1 2 3")
run("${VEXEC}" set-material "${PARAMETER_DB}" OSL.param.in_vector "vector 4 5 6")
run("${VEXEC}" set-material "${PARAMETER_DB}" OSL.param.in_normal "normal 0 1 0")
run("${VEXEC}" set-material "${PARAMETER_DB}" OSL.param.in_matrix "matrix 2 1 0 0 0 3 0 0 0 0 4 0 5 7 11 1")
run("${VEXEC}" set-material "${PARAMETER_DB}" OSL.param.in_string "  string project assets/wood grain.tx  ")
foreach(object IN ITEMS ball.r box.r mesh.r)
  set(image "${WORK}/parameters_${object}.png")
  run("${EXEC}" ${RENDER_ARGS} -w 96 -n 96 -o "${image}" "${PARAMETER_DB}" "${object}")
  run("${VEXEC}" check-parameters "${image}" 96 96)
endforeach()

set(DEFAULT_DB "${PORTABLE_PROJECT}/default_parameter.g")
configure_file("${PARAMETER_DB}" "${DEFAULT_DB}" COPYONLY)
run("${VEXEC}" remove-material "${DEFAULT_DB}" OSL.param.in_weight)
run("${EXEC}" ${RENDER_ARGS} -w 96 -n 96 -o "${WORK}/default_parameter.png" "${DEFAULT_DB}" ball.r)
run("${VEXEC}" check-default-parameters "${WORK}/default_parameter.png" 96 96)

# Version 1 also applies when its optional explicit version property is absent.
run("${VEXEC}" remove-material "${DEFAULT_DB}" OSL.version)
run("${VEXEC}" set-material "${DEFAULT_DB}" OSL.param.in_weight "float 0.375")
run("${EXEC}" ${RENDER_ARGS} -w 96 -n 96 -o "${WORK}/implicit_version.png" "${DEFAULT_DB}" ball.r)
run("${VEXEC}" check-parameters "${WORK}/implicit_version.png" 96 96)

# Explicit values also override region colors through the library closure graph.
run("${VEXEC}" set-material "${WORK}/material.g" OSL.param.in_color "color 1 0 0")
run("${EXEC}" ${RENDER_ARGS} -w 96 -n 96 -o "${WORK}/material_override.png" "${WORK}/material.g" mesh.r)
run("${VEXEC}" check-material-red "${WORK}/material_override.png" 96 96)

function(invalid_material_property source name key value)
  set(database "${PORTABLE_PROJECT}/${name}.g")
  configure_file("${source}" "${database}" COPYONLY)
  run("${VEXEC}" set-material "${database}" "${key}" "${value}")
  expect_failure("${EXEC}" ${RENDER_ARGS} -w 32 -n 32 -o "${WORK}/${name}.png" "${database}" ball.r)
  if(EXISTS "${WORK}/${name}.png")
    message(FATAL_ERROR "Invalid material input produced an image: ${name}")
  endif()
endfunction()
function(invalid_parameter name key value)
  invalid_material_property("${PARAMETER_DB}" "${name}" "${key}" "${value}")
endfunction()
invalid_parameter(unknown_parameter OSL.param.no_such_input "float 1")
invalid_parameter(wrong_parameter_type OSL.param.in_color "float 1")
invalid_parameter(incomplete_parameter OSL.param.in_color "color 1 2")
invalid_parameter(extra_parameter_components OSL.param.in_weight "float 1 2")
invalid_parameter(nonfinite_parameter OSL.param.in_weight "float nan")
invalid_parameter(overflow_parameter OSL.param.in_weight "float 1e100")
invalid_parameter(fractional_integer OSL.param.in_count "int 7.5")
invalid_parameter(overflow_integer OSL.param.in_count "int 99999999999999")
invalid_parameter(missing_parameter_value OSL.param.in_weight "float")
invalid_parameter(empty_parameter_name OSL.param. "float 1")
invalid_parameter(short_matrix OSL.param.in_matrix "matrix 1 0 0 0")
invalid_parameter(output_parameter OSL.param.out_number "float 1")
invalid_parameter(array_parameter OSL.param.in_array "float[] 1 2")
invalid_parameter(unknown_osl_property OSL.parameters "float 1")
invalid_parameter(unknown_osl_version OSL.version 99)

# Version 2 adds named utility nodes while preserving the terminal shader.
set(GRAPH_DB "${PORTABLE_PROJECT}/network.g")
set(GRAPH_REFERENCE_DB "${PORTABLE_PROJECT}/network_reference.g")
run("${VEXEC}" create-material "${GRAPH_DB}" as_plastic)
run("${VEXEC}" set-material "${GRAPH_DB}" OSL.version 2)
# Attribute order and lexical layer order must not determine execution order.
run("${VEXEC}" set-material "${GRAPH_DB}" OSL.connect.material.in_color "amix.out_color")
run("${VEXEC}" set-material "${GRAPH_DB}" OSL.connect.amix.in_color "zsource.out_color")
run("${VEXEC}" set-material "${GRAPH_DB}" OSL.node.amix art_graph_value)
run("${VEXEC}" set-material "${GRAPH_DB}" OSL.node.zsource art_graph_value)
run("${VEXEC}" set-material "${GRAPH_DB}" OSL.param.zsource.in_color "color 0.2 0.4 0.6")
run("${VEXEC}" set-material "${GRAPH_DB}" OSL.param.zsource.in_weight "float 0.5")
# A connection overrides a literal on the same input.
run("${VEXEC}" set-material "${GRAPH_DB}" OSL.param.in_color "color 1 0 0")
run("${VEXEC}" create-material "${GRAPH_REFERENCE_DB}" as_plastic)
run("${VEXEC}" set-material "${GRAPH_REFERENCE_DB}" OSL.param.in_color "color 0.1 0.2 0.3")
foreach(object IN ITEMS ball.r box.r mesh.r smooth_mesh.r ellipsoid.r)
  set(image "${WORK}/network_${object}.png")
  set(reference "${WORK}/network_reference_${object}.png")
  run("${EXEC}" ${RENDER_ARGS} -w 64 -n 64 -p 0 -o "${image}" "${GRAPH_DB}" "${object}")
  run("${EXEC}" ${RENDER_ARGS} -w 64 -n 64 -p 0 -o "${reference}" "${GRAPH_REFERENCE_DB}" "${object}")
  run("${VEXEC}" check-matching-image "${image}" "${reference}" 64 64)
endforeach()

# An auxiliary library closure can feed a surface shader without an implicit
# terminal connection. This exercises closure types as well as numeric inputs.
set(CLOSURE_DB "${PORTABLE_PROJECT}/closure_network.g")
run("${VEXEC}" create-material "${CLOSURE_DB}" as_closure2surface)
run("${VEXEC}" set-material "${CLOSURE_DB}" OSL.version 2)
run("${VEXEC}" set-material "${CLOSURE_DB}" OSL.node.paint as_plastic)
run("${VEXEC}" set-material "${CLOSURE_DB}" OSL.param.paint.in_color "color 0.1 0.2 0.3")
run("${VEXEC}" set-material "${CLOSURE_DB}" OSL.param.paint.in_specular_weight "float 0.06")
run("${VEXEC}" set-material "${CLOSURE_DB}" OSL.param.paint.in_specular_roughness "float 0.08")
run("${VEXEC}" set-material "${CLOSURE_DB}" OSL.param.paint.in_ior "float 1.5")
run("${VEXEC}" set-material "${CLOSURE_DB}" OSL.connect.material.in_input "paint.out_outColor")
run("${EXEC}" ${RENDER_ARGS} -w 64 -n 64 -p 0 -o "${WORK}/closure_network.png" "${CLOSURE_DB}" mesh.r)
run("${VEXEC}" check-matching-image "${WORK}/closure_network.png" "${WORK}/network_reference_mesh.r.png" 64 64)

# Exercise the documented native blend node and the native normal-map node.
set(NATIVE_GRAPH_DB "${PORTABLE_PROJECT}/native_network.g")
run("${VEXEC}" create-material "${NATIVE_GRAPH_DB}" as_plastic)
run("${VEXEC}" set-material "${NATIVE_GRAPH_DB}" OSL.version 2)
run("${VEXEC}" set-material "${NATIVE_GRAPH_DB}" OSL.node.tint as_blend_color)
run("${VEXEC}" set-material "${NATIVE_GRAPH_DB}" OSL.param.tint.in_color "color 0.2 0.4 0.6")
run("${VEXEC}" set-material "${NATIVE_GRAPH_DB}" OSL.param.tint.in_color2 "color 0.5 0.5 0.5")
run("${VEXEC}" set-material "${NATIVE_GRAPH_DB}" OSL.param.tint.in_blend_mode "string Multiply")
run("${VEXEC}" set-material "${NATIVE_GRAPH_DB}" OSL.connect.material.in_color "tint.out_color")
run("${VEXEC}" set-material "${NATIVE_GRAPH_DB}" OSL.node.bump as_bump)
run("${VEXEC}" set-material "${NATIVE_GRAPH_DB}" OSL.param.bump.in_mode "string Normal Map")
run("${VEXEC}" set-material "${NATIVE_GRAPH_DB}" OSL.param.bump.in_normal_map "color 0.5 0.5 1")
run("${VEXEC}" set-material "${NATIVE_GRAPH_DB}" OSL.connect.material.in_bump_normal "bump.out_normal")
foreach(object IN ITEMS ball.r mesh.r smooth_mesh.r)
  set(image "${WORK}/native_network_${object}.png")
  run("${EXEC}" ${RENDER_ARGS} -w 64 -n 64 -p 0 -o "${image}" "${NATIVE_GRAPH_DB}" "${object}")
  run("${VEXEC}" check-matching-image "${image}" "${WORK}/network_reference_${object}.png" 64 64)
endforeach()

# A disabled downstream perturbation must preserve an upstream mapped normal.
set(NORMAL_REFERENCE_DB "${PORTABLE_PROJECT}/mapped_normal_reference.g")
configure_file("${NATIVE_GRAPH_DB}" "${NORMAL_REFERENCE_DB}" COPYONLY)
run("${VEXEC}" set-material "${NORMAL_REFERENCE_DB}" OSL.param.bump.in_normal_map "color 0.85 0.65 1")
foreach(object IN ITEMS ball.r mesh.r smooth_mesh.r)
  set(image "${WORK}/mapped_normal_reference_${object}.png")
  run("${EXEC}" ${RENDER_ARGS} -w 64 -n 64 -p 0 -o "${image}" "${NORMAL_REFERENCE_DB}" "${object}")
  run("${VEXEC}" check-different-image "${image}" "${WORK}/native_network_${object}.png" 64 64)
endforeach()
foreach(disabled IN ITEMS zero_value zero_depth zero_weight)
  set(database "${PORTABLE_PROJECT}/normal_${disabled}.g")
  configure_file("${NORMAL_REFERENCE_DB}" "${database}" COPYONLY)
  run("${VEXEC}" set-material "${database}" OSL.node.pass as_bump)
  run("${VEXEC}" set-material "${database}" OSL.connect.pass.in_surface_normal "bump.out_normal")
  run("${VEXEC}" set-material "${database}" OSL.connect.material.in_bump_normal "pass.out_normal")
  if(disabled STREQUAL "zero_depth")
    run("${VEXEC}" set-material "${database}" OSL.param.pass.in_bump_value "float 0.5")
    run("${VEXEC}" set-material "${database}" OSL.param.pass.in_bump_depth "float 0")
  elseif(disabled STREQUAL "zero_weight")
    run("${VEXEC}" set-material "${database}" OSL.param.pass.in_mode "string Normal Map")
    run("${VEXEC}" set-material "${database}" OSL.param.pass.in_normal_map_weight "float 0")
  endif()
  foreach(object IN ITEMS ball.r mesh.r smooth_mesh.r)
    set(image "${WORK}/normal_${disabled}_${object}.png")
    run("${EXEC}" ${RENDER_ARGS} -w 64 -n 64 -p 0 -o "${image}" "${database}" "${object}")
    run("${VEXEC}" check-matching-image "${image}" "${WORK}/mapped_normal_reference_${object}.png" 64 64)
  endforeach()
endforeach()

function(invalid_network name key value)
  invalid_material_property("${GRAPH_DB}" "${name}" "${key}" "${value}")
endfunction()
invalid_network(missing_node_shader OSL.node.zsource art_shader_that_does_not_exist)
invalid_network(reserved_layer OSL.node.material art_graph_value)
invalid_network(invalid_layer_identifier OSL.node.bad.layer art_graph_value)
invalid_network(unknown_node_parameter OSL.param.missing.in_color "color 1 0 0")
invalid_network(invalid_node_parameter OSL.param.zsource.in_color "float 1")
invalid_network(missing_connection_source OSL.connect.amix.in_color "missing.out_color")
invalid_network(missing_connection_destination OSL.connect.missing.in_color "zsource.out_color")
invalid_network(input_connection_source OSL.connect.amix.in_color "zsource.in_color")
invalid_network(output_connection_destination OSL.connect.amix.out_color "zsource.out_color")
invalid_network(connection_type_mismatch OSL.connect.amix.in_color "zsource.out_weight")
invalid_network(connection_cycle OSL.connect.zsource.in_color "amix.out_color")
invalid_network(unused_node OSL.node.unused art_graph_value)
invalid_network(auxiliary_surface_shader OSL.node.zsource art_emission)
invalid_network(malformed_connection OSL.connect.material.in_color "amix")
invalid_network(network_without_version OSL.version 1)

# Unhandled runtime texture errors must not publish a successful image.
set(TEXTURE_DB "${PORTABLE_PROJECT}/texture.g")
run("${VEXEC}" create-material "${TEXTURE_DB}" art_texture)
run("${VEXEC}" set-material "${TEXTURE_DB}" OSL.param.in_filename "string textures/absent image.tx")
expect_failure("${EXEC}" ${RENDER_ARGS} -w 32 -n 32 -o "${WORK}/missing_texture.png" "${TEXTURE_DB}" ball.r)
if(EXISTS "${WORK}/missing_texture.png")
  message(FATAL_ERROR "An unhandled texture error produced an image")
endif()

# Preserve an existing output as well as avoiding creation of a new image.
set(EXISTING_OUTPUT "${WORK}/existing_texture_output.png")
set(OUTPUT_SENTINEL "previous render output")
file(WRITE "${EXISTING_OUTPUT}" "${OUTPUT_SENTINEL}")
expect_failure("${EXEC}" ${RENDER_ARGS} -w 32 -n 32 -o "${EXISTING_OUTPUT}" "${TEXTURE_DB}" ball.r)
file(READ "${EXISTING_OUTPUT}" preserved)
if(NOT preserved STREQUAL OUTPUT_SENTINEL)
  message(FATAL_ERROR "An unhandled texture error modified an existing output")
endif()

# A shader may handle the error and warn while supplying its own fallback.
run("${VEXEC}" set-material "${TEXTURE_DB}" OSL.param.in_handle_error "int 1")
run("${EXEC}" ${RENDER_ARGS} -w 96 -n 96 -o "${WORK}/handled_texture_error.png" "${TEXTURE_DB}" ball.r)
run("${VEXEC}" check-texture-fallback "${WORK}/handled_texture_error.png" 96 96)

# A mipmapped one-texel checker must converge to its linear 0.5 mean.
file(MAKE_DIRECTORY "${PORTABLE_PROJECT}/textures")
run("${VEXEC}" create-checker-texture "${WORK}/checker.ppm")
run("@ART_MAKETX_EXECUTABLE@" -d float --filter box --wrap periodic
  -o "${PORTABLE_PROJECT}/textures/checker texture.tx" "${WORK}/checker.ppm")
set(FILTER_DB "${PORTABLE_PROJECT}/filtering.g")
set(REFERENCE_DB "${PORTABLE_PROJECT}/filter_reference.g")
run("${VEXEC}" create-material "${FILTER_DB}" art_texture)
run("${VEXEC}" set-material "${FILTER_DB}" OSL.param.in_filename "string textures/checker texture.tx")
# Keep even the smallest perspective footprints above the finest mip levels.
run("${VEXEC}" set-material "${FILTER_DB}" OSL.param.in_uv_scale "float 4")
run("${VEXEC}" create-material "${REFERENCE_DB}" art_emission)
run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_color "color 0.5 0.5 0.5")
foreach(perspective IN ITEMS 0 85)
  foreach(object IN ITEMS ball.r ellipsoid.r mesh.r smooth_mesh.r)
    set(reference "${WORK}/filter_reference_${object}_${perspective}.png")
    set(image "${WORK}/filtered_${object}_${perspective}.png")
    run("${EXEC}" ${RENDER_ARGS} -c "set samples=1" -w 64 -n 64 -p ${perspective} -o "${reference}" "${REFERENCE_DB}" "${object}")
    run("${EXEC}" ${RENDER_ARGS} -c "set samples=1" -w 64 -n 64 -p ${perspective} -o "${image}" "${FILTER_DB}" "${object}")
    run("${VEXEC}" check-filtered-texture "${image}" "${reference}" 64 64)
  endforeach()
endforeach()

# Forcing zero UV footprints must fail the gray-reference expectation.
set(ALIASED_DB "${PORTABLE_PROJECT}/aliased.g")
configure_file("${FILTER_DB}" "${ALIASED_DB}" COPYONLY)
run("${VEXEC}" set-material "${ALIASED_DB}" OSL.param.in_zero_footprints "int 1")
foreach(perspective IN ITEMS 0 85)
  set(image "${WORK}/aliased_${perspective}.png")
  run("${EXEC}" ${RENDER_ARGS} -c "set samples=1" -w 64 -n 64 -p ${perspective} -o "${image}" "${ALIASED_DB}" mesh.r)
  run("${VEXEC}" check-aliased-texture "${image}" "${WORK}/filter_reference_mesh.r_${perspective}.png" 64 64)
endforeach()

# A moved project must resolve its own relative texture with the old asset absent.
set(RELOCATED_PROJECT "${WORK}/relocated texture project")
file(COPY "${PORTABLE_PROJECT}/" DESTINATION "${RELOCATED_PROJECT}")
set(ORIGINAL_TEXTURE "${PORTABLE_PROJECT}/textures/checker texture.tx")
file(RENAME "${ORIGINAL_TEXTURE}" "${ORIGINAL_TEXTURE}.unavailable")
run("${EXEC}" ${RENDER_ARGS} -c "set samples=1" -w 64 -n 64 -p 0 -o "${WORK}/relocated_texture.png" "${RELOCATED_PROJECT}/filtering.g" mesh.r)
run("${VEXEC}" check-filtered-texture "${WORK}/relocated_texture.png" "${WORK}/filter_reference_mesh.r_0.png" 64 64)
file(RENAME "${ORIGINAL_TEXTURE}.unavailable" "${ORIGINAL_TEXTURE}")

# Caller-directory textures must not override project assets or fill missing ones.
set(TEXTURE_CWD "${WORK}/cwd texture shadows")
file(MAKE_DIRECTORY "${TEXTURE_CWD}/textures")
run("${VEXEC}" create-black-texture "${WORK}/black.ppm")
set(SHADOW_TEXTURE "${TEXTURE_CWD}/textures/checker texture.tx")
run("@ART_MAKETX_EXECUTABLE@" -d float -o "${SHADOW_TEXTURE}" "${WORK}/black.ppm")
foreach(name IN ITEMS "alternate checker texture.tx" "cwd only.tx" "environment texture.tx" "alternate environment texture.tx")
  configure_file("${SHADOW_TEXTURE}" "${TEXTURE_CWD}/textures/${name}" COPYONLY)
endforeach()
configure_file("${ORIGINAL_TEXTURE}" "${PORTABLE_PROJECT}/textures/alternate checker texture.tx" COPYONLY)

set(PATH_DB "${PORTABLE_PROJECT}/texture_paths.g")
configure_file("${FILTER_DB}" "${PATH_DB}" COPYONLY)
run("${VEXEC}" set-material "${PATH_DB}" OSL.param.in_alternate_filename "string textures/alternate checker texture.tx")
foreach(dynamic_name IN ITEMS 0 1)
  run("${VEXEC}" set-material "${PATH_DB}" OSL.param.in_dynamic_name "int ${dynamic_name}")
  set(image "${WORK}/texture_path_${dynamic_name}.png")
  run_in("${TEXTURE_CWD}" "${EXEC}" ${RENDER_ARGS} -c "set samples=1" -w 64 -n 64 -p 0 -o "${image}" "${PATH_DB}" mesh.r)
  run("${VEXEC}" check-matching-image "${image}" "${WORK}/filter_reference_mesh.r_0.png" 64 64)
endforeach()

# A valid caller-directory shader with a different interface must not supply
# metadata for the project shader that OSL will actually execute.
configure_file("@CMAKE_CURRENT_BINARY_DIR@/art_color.oso" "${TEXTURE_CWD}/art_texture.oso" COPYONLY)
foreach(dynamic_name IN ITEMS 0 1)
  run("${VEXEC}" set-material "${PATH_DB}" OSL.param.in_dynamic_name "int ${dynamic_name}")
  set(image "${WORK}/shader_path_${dynamic_name}.png")
  run_in("${TEXTURE_CWD}" "${EXEC}" ${RENDER_ARGS} -c "set samples=1" -w 64 -n 64 -p 0 -o "${image}" "${PATH_DB}" mesh.r)
  run("${VEXEC}" check-matching-image "${image}" "${WORK}/filter_reference_mesh.r_0.png" 64 64)
endforeach()
file(REMOVE "${TEXTURE_CWD}/art_texture.oso")

# Both metadata-query variants must use the same policy with dynamic filenames.
foreach(info_mode IN ITEMS 1 2)
  run("${VEXEC}" set-material "${PATH_DB}" OSL.param.in_check_info "int ${info_mode}")
  set(image "${WORK}/texture_info_${info_mode}.png")
  run_in("${TEXTURE_CWD}" "${EXEC}" ${RENDER_ARGS} -c "set samples=1" -w 64 -n 64 -p 0 -o "${image}" "${PATH_DB}" mesh.r)
  run("${VEXEC}" check-matching-image "${image}" "${WORK}/filter_reference_mesh.r_0.png" 64 64)
endforeach()
run("${VEXEC}" set-material "${PATH_DB}" OSL.param.in_check_info "int 0")

# Environment lookups also take filenames independently of 2D texture calls.
run("${VEXEC}" create-gray-texture "${WORK}/gray.ppm")
run("@ART_MAKETX_EXECUTABLE@" --envlatl -d float -o "${PORTABLE_PROJECT}/textures/environment texture.tx" "${WORK}/gray.ppm")
configure_file("${PORTABLE_PROJECT}/textures/environment texture.tx" "${PORTABLE_PROJECT}/textures/alternate environment texture.tx" COPYONLY)
set(ENV_PATH_DB "${PORTABLE_PROJECT}/environment_paths.g")
configure_file("${PATH_DB}" "${ENV_PATH_DB}" COPYONLY)
run("${VEXEC}" set-material "${ENV_PATH_DB}" OSL.param.in_filename "string textures/environment texture.tx")
run("${VEXEC}" set-material "${ENV_PATH_DB}" OSL.param.in_alternate_filename "string textures/alternate environment texture.tx")
run("${VEXEC}" set-material "${ENV_PATH_DB}" OSL.param.in_lookup_mode "int 1")
foreach(dynamic_name IN ITEMS 0 1)
  run("${VEXEC}" set-material "${ENV_PATH_DB}" OSL.param.in_dynamic_name "int ${dynamic_name}")
  set(image "${WORK}/environment_path_${dynamic_name}.png")
  run_in("${TEXTURE_CWD}" "${EXEC}" ${RENDER_ARGS} -c "set samples=1" -w 64 -n 64 -p 0 -o "${image}" "${ENV_PATH_DB}" mesh.r)
  run("${VEXEC}" check-matching-image "${image}" "${WORK}/filter_reference_mesh.r_0.png" 64 64)
endforeach()

foreach(dynamic_name IN ITEMS 0 1)
  set(database "${PORTABLE_PROJECT}/missing_project_texture_${dynamic_name}.g")
  configure_file("${PATH_DB}" "${database}" COPYONLY)
  run("${VEXEC}" set-material "${database}" OSL.param.in_dynamic_name "int ${dynamic_name}")
  if(dynamic_name)
    run("${VEXEC}" set-material "${database}" OSL.param.in_alternate_filename "string textures/cwd only.tx")
  else()
    run("${VEXEC}" set-material "${database}" OSL.param.in_filename "string textures/cwd only.tx")
  endif()
  set(image "${WORK}/missing_project_texture_${dynamic_name}.png")
  expect_failure_in("${TEXTURE_CWD}" "${EXEC}" ${RENDER_ARGS} -w 32 -n 32 -o "${image}" "${database}" mesh.r)
  if(EXISTS "${image}")
    message(FATAL_ERROR "A missing project texture used a working-directory replacement")
  endif()
  run("${VEXEC}" set-material "${database}" OSL.param.in_handle_error "int 1")
  set(fallback "${WORK}/missing_project_fallback_${dynamic_name}.png")
  run_in("${TEXTURE_CWD}" "${EXEC}" ${RENDER_ARGS} -w 96 -n 96 -p 0 -o "${fallback}" "${database}" mesh.r)
  run("${VEXEC}" check-texture-fallback "${fallback}" 96 96)
endforeach()

# Explicit absolute filenames retain their meaning even outside the project.
set(ABS_PATH_DB "${PORTABLE_PROJECT}/absolute_texture.g")
configure_file("${FILTER_DB}" "${ABS_PATH_DB}" COPYONLY)
run("${VEXEC}" set-material "${ABS_PATH_DB}" OSL.param.in_filename "string ${SHADOW_TEXTURE}")
set(BLACK_REF_DB "${PORTABLE_PROJECT}/black_reference.g")
configure_file("${REFERENCE_DB}" "${BLACK_REF_DB}" COPYONLY)
run("${VEXEC}" set-material "${BLACK_REF_DB}" OSL.param.in_color "color 0 0 0")
run("${EXEC}" ${RENDER_ARGS} -c "set samples=1" -w 64 -n 64 -p 0 -o "${WORK}/black_reference.png" "${BLACK_REF_DB}" mesh.r)
run_in("${TEXTURE_CWD}" "${EXEC}" ${RENDER_ARGS} -c "set samples=1" -w 64 -n 64 -p 0 -o "${WORK}/absolute_texture.png" "${ABS_PATH_DB}" mesh.r)
run("${VEXEC}" check-matching-image "${WORK}/absolute_texture.png" "${WORK}/black_reference.png" 64 64)

# A directory at the output file's path must produce a regular error exit.
file(MAKE_DIRECTORY "${WORK}/blocked.png")
expect_failure("${EXEC}" ${RENDER_ARGS} -w 32 -n 32 -o "${WORK}/blocked.png" "${WORK}/scene.g" all.g)
expect_failure("${EXEC}" ${RENDER_ARGS} -w 32 -n 32 -o "${WORK}/absent.png" "${WORK}/scene.g" absent.r)
if(EXISTS "${WORK}/absent.png")
  message(FATAL_ERROR "A missing object produced an image")
endif()
