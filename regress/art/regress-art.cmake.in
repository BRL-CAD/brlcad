set(WORK "@CMAKE_CURRENT_BINARY_DIR@/output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")

function(run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE output TIMEOUT 30)
  file(APPEND "${LOG}" "${ARGV}\n${output}\n")
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Command failed (${result}): ${ARGV}\n${output}")
  endif()
  if(output MATCHES "(error|fatal)[ \t]+[|]")
    message(FATAL_ERROR "Renderer reported an error: ${ARGV}\n${output}")
  endif()
endfunction()

function(expect_failure)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE output TIMEOUT 30)
  file(APPEND "${LOG}" "${ARGV}\n${output}\n")
  if("${result}" STREQUAL "0" OR NOT "${result}" MATCHES "^[0-9]+$")
    message(FATAL_ERROR "Expected a nonzero exit status, received '${result}': ${ARGV}\n${output}")
  endif()
endfunction()

run("${VEXEC}" create "${WORK}/scene.g")
set(RENDER_ARGS -a 270 -e 20 -P 2 -c "set samples=4")
function(render_case name width height perspective extension)
  set(image "${WORK}/${name}.${extension}")
  run("${EXEC}" ${RENDER_ARGS} -w ${width} -n ${height} -p ${perspective} -o "${image}" "${WORK}/scene.g" all.g)
  run("${VEXEC}" check "${image}" ${width} ${height})
endfunction()

render_case(perspective_landscape 128 96 85 png)
render_case(perspective_portrait 96 128 85 png)
render_case(orthographic_landscape 128 96 0 png)
render_case(orthographic_portrait 96 128 0 png)
render_case(native_pix 128 96 85 pix)

# Exercise BOT hits through librt as well as native CSG boundaries.
foreach(workers IN ITEMS 1 2)
  set(image "${WORK}/mesh_${workers}.png")
  run("${EXEC}" ${RENDER_ARGS} -P ${workers} -w 96 -n 96 -o "${image}" "${WORK}/scene.g" mesh.r)
  run("${VEXEC}" check-mesh "${image}" 96 96)
endforeach()

# Material-object selection must use the same validated closure graph.
run("${VEXEC}" create-material "${WORK}/material.g" as_plastic)
run("${EXEC}" ${RENDER_ARGS} -w 128 -n 96 -p 85 -o "${WORK}/material.png" "${WORK}/material.g" all.g)
run("${VEXEC}" check "${WORK}/material.png" 128 96)
run("${EXEC}" ${RENDER_ARGS} -w 96 -n 96 -o "${WORK}/material_mesh.png" "${WORK}/material.g" mesh.r)
run("${VEXEC}" check-mesh "${WORK}/material_mesh.png" 96 96)

function(invalid_material name shader output)
  run("${VEXEC}" create-material "${WORK}/${name}.g" "${shader}" "${output}")
  expect_failure("${EXEC}" ${RENDER_ARGS} -w 32 -n 32 -o "${WORK}/${name}.png" "${WORK}/${name}.g" all.g)
  if(EXISTS "${WORK}/${name}.png")
    message(FATAL_ERROR "Invalid material produced an image: ${name}")
  endif()
endfunction()
invalid_material(missing_shader art_shader_that_does_not_exist out_outColor)
invalid_material(missing_output as_plastic output_that_does_not_exist)
invalid_material(nonclosure_output as_plastic in_color)
invalid_material(surface_output as_closure2surface in_input)

# A directory at the output file's path must produce a regular error exit.
file(MAKE_DIRECTORY "${WORK}/blocked.png")
expect_failure("${EXEC}" ${RENDER_ARGS} -w 32 -n 32 -o "${WORK}/blocked.png" "${WORK}/scene.g" all.g)
expect_failure("${EXEC}" ${RENDER_ARGS} -w 32 -n 32 -o "${WORK}/absent.png" "${WORK}/scene.g" absent.r)
if(EXISTS "${WORK}/absent.png")
  message(FATAL_ERROR "A missing object produced an image")
endif()
