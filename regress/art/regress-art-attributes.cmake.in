cmake_minimum_required(VERSION 3.22)
set(WORK "@CMAKE_CURRENT_BINARY_DIR@/attributes-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders" "${WORK}/cache")
set(ENV{BU_DIR_CACHE} "${WORK}/cache")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
foreach(shader IN ITEMS art_attributes art_emission)
  configure_file("@CMAKE_CURRENT_BINARY_DIR@/${shader}.oso"
    "${WORK}/shaders/${shader}.oso" COPYONLY)
endforeach()
set(DB "${WORK}/attributes.g")
set(REFERENCE_DB "${WORK}/reference.g")
run("${VEXEC}" create-material "${DB}" art_attributes)
run("${VEXEC}" create-material "${REFERENCE_DB}" art_emission)
set(OBJECTS cube.r mesh.r ball.r box.r)
foreach(object IN LISTS OBJECTS)
  foreach(database IN ITEMS "${DB}" "${REFERENCE_DB}")
    run("${VEXEC}" attr "${database}" set "${object}" region_id 1701 material_id 42 los 75
      label "painted panel" part_number 00042)
    run("${VEXEC}" attr "${database}" rm "${object}" color rgb)
  endforeach()
endforeach()
foreach(database IN ITEMS "${DB}" "${REFERENCE_DB}")
  run("${VEXEC}" color "${database}" 1700 1799 0 0 255)
  run("${VEXEC}" attr "${database}" set instance_left.g label "parent label")
endforeach()
set(SIZE 32)
set(RENDER_ARGS -a 0 -e 65 -E 2 -w ${SIZE} -n ${SIZE} -C 0/0/0
  -c "set samples=1 light_intensity=0")
function(compare_attributes label object viewsize path other_path)
  run("${VEXEC}" set-material "${DB}" OSL.param.in_expected_name "string ${object}")
  run("${VEXEC}" set-material "${DB}" OSL.param.in_expected_path "string ${path}")
  if(other_path)
    run("${VEXEC}" set-material "${DB}" OSL.param.in_split_paths "int 1")
    run("${VEXEC}" set-material "${DB}" OSL.param.in_expected_other_path "string ${other_path}")
  else()
    run("${VEXEC}" set-material "${DB}" OSL.param.in_split_paths "int 0")
  endif()
  foreach(workers IN ITEMS 1 2)
    foreach(perspective IN ITEMS 0 50)
      if(perspective)
	set(projection perspective)
      else()
	set(projection orthographic)
      endif()
      run("${VEXEC}" set-material "${DB}" OSL.param.in_expected_projection "string ${projection}")
      foreach(form IN ITEMS actual reference)
	if(form STREQUAL "actual")
	  set(database "${DB}")
	else()
	  set(database "${REFERENCE_DB}")
	endif()
	run_in("${WORK}" "${EXEC}" ${RENDER_ARGS} -P ${workers} -p ${perspective}
	  -c "viewsize ${viewsize}" -o "${WORK}/${label}-${workers}-${perspective}-${form}.exr"
	  "${database}" "${CURRENT_SELECTION}")
      endforeach()
      run("${VEXEC}" check-matching-image "${WORK}/${label}-${workers}-${perspective}-actual.exr"
	"${WORK}/${label}-${workers}-${perspective}-reference.exr" ${SIZE} ${SIZE})
    endforeach()
  endforeach()
endfunction()
foreach(object IN LISTS OBJECTS)
  set(CURRENT_SELECTION "${object}")
  compare_attributes("table-${object}" "${object}" 40 "/${object}" "")
endforeach()
# The same region has distinct paths and inherited colors in these instances.
set(CURRENT_SELECTION instances.g)
compare_attributes(instances ball.r 80 "/instances.g/instance_left.g/ball.r"
  "/instances.g/instance_right.g/ball.r")
set(CURRENT_SELECTION arcs.g)
compare_attributes(arcs ball.r 80 "/arcs.g/ball.r" "/arcs.g/ball.r@1")

# Resolved color is independent of the shader's material parameters.
set(CURRENT_SELECTION cube.r)
foreach(database IN ITEMS "${DB}" "${REFERENCE_DB}")
  run("${VEXEC}" attr "${database}" set cube.r color 128/64/32)
endforeach()
compare_attributes(explicit-color cube.r 40 "/cube.r" "")

# A locked parent assignment overrides the material named on the leaf region.
run("${VEXEC}" material "${DB}" create parent.material Parent)
run("${VEXEC}" material "${DB}" set parent.material parent osl.material)
run("${VEXEC}" material "${DB}" set parent.material optical OSL.param.in_expected_material "string parent.material")
run("${VEXEC}" material "${DB}" assign instances.g parent.material)
foreach(database IN ITEMS "${DB}" "${REFERENCE_DB}")
  run("${VEXEC}" attr "${database}" set instances.g inherit 1)
endforeach()
set(CURRENT_SELECTION instances.g)
compare_attributes(inherited-material ball.r 80 "/instances.g/instance_left.g/ball.r"
  "/instances.g/instance_right.g/ball.r")
run("${VEXEC}" attr "${DB}" rm instances.g material_name)
foreach(database IN ITEMS "${DB}" "${REFERENCE_DB}")
  run("${VEXEC}" attr "${database}" set instances.g inherit 0)
endforeach()
set(CURRENT_SELECTION arcs.g)
compare_attributes(restored ball.r 80 "/arcs.g/ball.r" "/arcs.g/ball.r@1")

# A shader cannot silently substitute a wrong ID or missing raw attribute.
run("${VEXEC}" set-material "${DB}" OSL.param.in_expected_region_id "int 1702")
run_in("${WORK}" "${EXEC}" ${RENDER_ARGS} -P 1 -p 50 -c "viewsize 80"
  -o "${WORK}/wrong-id.exr" "${DB}" arcs.g)
run("${VEXEC}" check-image "${WORK}/wrong-id.exr" ${SIZE} ${SIZE})
expect_failure_matching("FAILURE" "@ART_OIIOTOOL_EXECUTABLE@" --fail 0.001 --hardfail 0.001
  "${WORK}/wrong-id.exr" "${WORK}/arcs-1-50-reference.exr" --diff)
run("${VEXEC}" set-material "${DB}" OSL.param.in_expected_region_id "int 1701")
run("${VEXEC}" attr "${DB}" rm ball.r label)
run_in("${WORK}" "${EXEC}" ${RENDER_ARGS} -P 1 -p 50 -c "viewsize 80"
  -o "${WORK}/missing-attribute.exr" "${DB}" arcs.g)
run("${VEXEC}" check-image "${WORK}/missing-attribute.exr" ${SIZE} ${SIZE})
expect_failure_matching("FAILURE" "@ART_OIIOTOOL_EXECUTABLE@" --fail 0.001 --hardfail 0.001
  "${WORK}/missing-attribute.exr" "${WORK}/arcs-1-50-reference.exr" --diff)

# Query context must follow the receiver after two transparent boundaries.
foreach(database IN ITEMS "${DB}" "${REFERENCE_DB}")
  run("${VEXEC}" in "${database}" front.s rpp -100 100 -100 100 15 16)
  run("${VEXEC}" r "${database}" front.r u front.s)
  run("${VEXEC}" material "${database}" create front.material Glass)
  run("${VEXEC}" material "${database}" set front.material optical OSL as_glass)
  run("${VEXEC}" material "${database}" set front.material optical OSL.param.in_ior "float 1.5")
  run("${VEXEC}" material "${database}" set front.material optical OSL.param.in_volume_transmittance_distance "float 0")
  run("${VEXEC}" material "${database}" assign front.r front.material)
endforeach()
foreach(parameter IN ITEMS "in_expected_name;string cube.r" "in_expected_path;string /cube.r"
    "in_split_paths;int 0" "in_expected_projection;string orthographic" "in_min_depth;int 2")
  list(GET parameter 0 name)
  list(GET parameter 1 value)
  run("${VEXEC}" set-material "${DB}" "OSL.param.${name}" "${value}")
endforeach()
foreach(form IN ITEMS actual reference)
  if(form STREQUAL "actual")
    set(database "${DB}")
  else()
    set(database "${REFERENCE_DB}")
  endif()
  run_in("${WORK}" "${EXEC}" -P 2 -w ${SIZE} -n ${SIZE} -c "viewsize 40"
    -c "eye_pt 0 0 30" -c "orientation 0 0 0 1"
    -c "set samples=1 max_bounces=8 background_color=black light_intensity=0"
    -o "${WORK}/secondary-${form}.exr" "${database}" cube.r front.r)
endforeach()
run("${VEXEC}" check-matching-image "${WORK}/secondary-actual.exr"
  "${WORK}/secondary-reference.exr" ${SIZE} ${SIZE})
