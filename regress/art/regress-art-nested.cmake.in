cmake_minimum_required(VERSION 3.22)

set(WORK "@CMAKE_CURRENT_BINARY_DIR@/nested-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders" "${WORK}/cache")
set(ENV{BU_DIR_CACHE} "${WORK}/cache")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
set(TOOL "@ART_OIIOTOOL_EXECUTABLE@")
foreach(shader IN ITEMS art_nested_reference art_refraction_reference)
  configure_file("@CMAKE_CURRENT_BINARY_DIR@/${shader}.oso"
    "${WORK}/shaders/${shader}.oso" COPYONLY)
endforeach()
set(ACTUAL_DB "${WORK}/actual.g")
set(REFERENCE_DB "${WORK}/reference.g")
foreach(db IN ITEMS "${ACTUAL_DB}" "${REFERENCE_DB}")
  run("${VEXEC}" create-nested "${db}")
endforeach()
run("${VEXEC}" set-named-material "${REFERENCE_DB}" outer.material OSL art_nested_reference)
set(RENDER_ARGS -P 1 -w 16 -n 16
  -c "set samples=4 light_intensity=0 environment_intensity=0 background_color=black max_bounces=-1 max_specular_bounces=8 rr_min_path_length=0"
  -c "viewsize 1")
# Both paths end in air, so the radiance eta factors cancel.  The reference
# retains each Fresnel transmission and each medium's geometric path length.
set(TOLERANCE 0.0005)
set(DIFF_ARGS --fail ${TOLERANCE} --hardfail ${TOLERANCE}
  --warn ${TOLERANCE} --hardwarn ${TOLERANCE})
run("${TOOL}" --pattern constant:color=0,0,0,1 16x16 4 -o "${WORK}/black.exr")
function(matches actual reference)
  run("${TOOL}" ${DIFF_ARGS} "${actual}" "${reference}" --diff)
endfunction()
function(differs actual reference)
  expect_failure("${TOOL}" ${DIFF_ARGS} "${actual}" "${reference}" --diff)
endfunction()
function(set_parameter db material name value)
  run("${VEXEC}" set-named-material "${db}" "${material}.material" "OSL.param.${name}" "${value}")
endfunction()
function(priorities outer inner core)
  foreach(layer IN ITEMS outer inner core)
    run("${VEXEC}" set-named-material "${ACTUAL_DB}" "${layer}.material"
      OSL.medium_priority "${${layer}}")
  endforeach()
endfunction()
function(profile name)
  foreach(layer IN ITEMS outer inner core)
    if(name STREQUAL "equal" OR layer STREQUAL "core")
      set(ior 1)
    elseif(layer STREQUAL "outer")
      set(ior 1.5)
    else()
      set(ior 2.4)
    endif()
    if(name STREQUAL "clear")
      set(color "1 1 1")
      set(distance 0)
    elseif(layer STREQUAL "outer")
      set(color "0.25 0.5 0.8")
      set(distance 20)
    elseif(layer STREQUAL inner)
      set(color "0.8 0.6 0.4")
      set(distance 10)
    else()
      set(color "0.4 0.9 0.7")
      set(distance 4)
    endif()
    set_parameter("${ACTUAL_DB}" "${layer}" in_ior "float ${ior}")
    set_parameter("${ACTUAL_DB}" "${layer}" in_roughness "float 0")
    set_parameter("${ACTUAL_DB}" "${layer}" in_transmittance_amount "float 1")
    set_parameter("${ACTUAL_DB}" "${layer}" in_surface_transmittance "color 1 1 1")
    set_parameter("${ACTUAL_DB}" "${layer}" in_reflection_tint "color 0 0 0")
    set_parameter("${ACTUAL_DB}" "${layer}" in_volume_transmittance "color ${color}")
    set_parameter("${ACTUAL_DB}" "${layer}" in_volume_transmittance_distance "float ${distance}")
    set_parameter("${REFERENCE_DB}" outer "in_${layer}_ior" "float ${ior}")
    set_parameter("${REFERENCE_DB}" outer "in_${layer}_transmittance" "color ${color}")
    set_parameter("${REFERENCE_DB}" outer "in_${layer}_distance" "float ${distance}")
  endforeach()
endfunction()
function(camera angle)
  if(angle STREQUAL "zero")
    set(eye "0 0 40")
    set(quaternion "0 0 0 1")
  elseif(angle STREQUAL "ten")
    set(eye "6.945927106677213 0 39.39231012048832")
    set(quaternion "0 0.08715574274765817 0 0.9961946980917455")
  else()
    set(eye "16.90473046962798 0 36.252311481466")
    set(quaternion "0 0.2164396139381029 0 0.9762960071199334")
  endif()
  set(CAMERA_ARGS -c "eye_pt ${eye}" -c "orientation ${quaternion}" PARENT_SCOPE)
endfunction()

priorities(1 2 3)
foreach(profile_name IN ITEMS equal clear absorbing)
  profile("${profile_name}")
  foreach(kind IN ITEMS box mesh)
    foreach(layers IN ITEMS nested core)
      if(layers STREQUAL "core")
        set(has_core 1)
        set(tilt ten)
      else()
        set(has_core 0)
        set(tilt twentyfive)
      endif()
      set_parameter("${REFERENCE_DB}" outer in_core "int ${has_core}")
      foreach(angle IN ITEMS zero "${tilt}")
        camera("${angle}")
        foreach(perspective IN ITEMS 0 2)
          set(label "${profile_name}-${kind}-${layers}-${angle}-${perspective}")
          set(actual "${WORK}/${label}.exr")
          set(reference "${WORK}/reference-${label}.exr")
          run("${EXEC}" ${RENDER_ARGS} ${CAMERA_ARGS} -p ${perspective}
            -o "${actual}" "${ACTUAL_DB}" "${kind}.${layers}.g")
          run("${EXEC}" ${RENDER_ARGS} ${CAMERA_ARGS} -p ${perspective}
            -o "${reference}" "${REFERENCE_DB}" "${kind}.${layers}.g")
          matches("${actual}" "${reference}")
          # Every view must actually see the opaque analytic reference.
          run("${TOOL}" --fail 0 --hardfail 0 --warn 0 --hardwarn 0
            "${reference}" --ch A "${WORK}/black.exr" --ch A --diff)
          differs("${reference}" "${WORK}/black.exr")

        endforeach()
      endforeach()
    endforeach()
  endforeach()
endforeach()

# A physically different inner index must fail the oblique transport check.
profile(clear)
set_parameter("${REFERENCE_DB}" outer in_core "int 0")
set_parameter("${REFERENCE_DB}" outer in_inner_ior "float 1")
camera(twentyfive)
run("${EXEC}" ${RENDER_ARGS} ${CAMERA_ARGS}
  -o "${WORK}/wrong-index.exr" "${REFERENCE_DB}" box.nested.g)
differs("${WORK}/wrong-index.exr" "${WORK}/clear-box-nested-twentyfive-0.exr")

# Unspecified equal priorities cannot supply the nested absorption ordering.
profile(equal)
priorities(0 0 0)
camera(zero)
run("${EXEC}" ${RENDER_ARGS} ${CAMERA_ARGS}
  -o "${WORK}/unordered.exr" "${ACTUAL_DB}" box.core.g)
differs("${WORK}/unordered.exr" "${WORK}/equal-box-core-zero-0.exr")
# A lower-priority contained region is optically displaced by the outer medium.
priorities(2 1 0)
run("${EXEC}" ${RENDER_ARGS} ${CAMERA_ARGS}
  -o "${WORK}/hidden.exr" "${ACTUAL_DB}" box.core.g)
run("${EXEC}" ${RENDER_ARGS} ${CAMERA_ARGS}
  -o "${WORK}/outer-only.exr" "${ACTUAL_DB}" box.outer.r target.r)
matches("${WORK}/hidden.exr" "${WORK}/outer-only.exr")
# Signed endpoints preserve the same strict ordering for the BOT case.
priorities(-128 0 127)
run("${EXEC}" ${RENDER_ARGS} ${CAMERA_ARGS}
  -o "${WORK}/signed.exr" "${ACTUAL_DB}" mesh.core.g)
matches("${WORK}/signed.exr" "${WORK}/equal-mesh-core-zero-0.exr")

# Priority metadata inherits through material objects and can be overridden.
run("${VEXEC}" material "${ACTUAL_DB}" create priority.parent Priority)
run("${VEXEC}" material "${ACTUAL_DB}" set priority.parent optical OSL as_glass)
run("${VEXEC}" material "${ACTUAL_DB}" set priority.parent optical OSL.medium_priority 2)
run("${VEXEC}" material "${ACTUAL_DB}" remove inner.material optical OSL)
run("${VEXEC}" material "${ACTUAL_DB}" remove inner.material optical OSL.medium_priority)
run("${VEXEC}" material "${ACTUAL_DB}" set inner.material parent priority.parent)
priorities(1 2 3)
run("${VEXEC}" material "${ACTUAL_DB}" remove inner.material optical OSL.medium_priority)
run_command("${CMAKE_CURRENT_BINARY_DIR}" FALSE "${EXEC}" -c "set inspect_materials=1"
  "${ACTUAL_DB}" box.inner.r)
if(NOT command_output MATCHES "medium_priority 2" OR NOT command_output MATCHES "priority[.]parent")
  message(FATAL_ERROR "Inspection lost inherited medium priority")
endif()
run("${EXEC}" ${RENDER_ARGS} ${CAMERA_ARGS}
  -o "${WORK}/inherited.exr" "${ACTUAL_DB}" box.core.g)
matches("${WORK}/inherited.exr" "${WORK}/equal-box-core-zero-0.exr")
run("${VEXEC}" set-named-material "${ACTUAL_DB}" inner.material OSL.medium_priority 4)
run_command("${CMAKE_CURRENT_BINARY_DIR}" FALSE "${EXEC}" -c "set inspect_materials=1"
  "${ACTUAL_DB}" box.inner.r)
if(NOT command_output MATCHES "medium_priority 4")
  message(FATAL_ERROR "Child priority did not override its parent")
endif()
run("${EXEC}" ${RENDER_ARGS} ${CAMERA_ARGS}
  -o "${WORK}/overridden.exr" "${ACTUAL_DB}" box.core.g)
run("${EXEC}" ${RENDER_ARGS} ${CAMERA_ARGS}
  -o "${WORK}/without-core.exr" "${ACTUAL_DB}" box.nested.g)
matches("${WORK}/overridden.exr" "${WORK}/without-core.exr")

foreach(value IN ITEMS -129 128 1.5 1junk nan inf 2147483648 "int 2")
  run("${VEXEC}" set-named-material "${ACTUAL_DB}" inner.material OSL.medium_priority "${value}")
  set(image "${WORK}/invalid.exr")
  file(WRITE "${image}" "preserve existing output")
  expect_failure_matching("invalid OSL[.]medium_priority" "${EXEC}" ${RENDER_ARGS}
    -o "${image}" "${ACTUAL_DB}" box.nested.g)
  file(READ "${image}" retained)
  if(NOT retained STREQUAL "preserve existing output")
    message(FATAL_ERROR "Invalid medium priority replaced output")
  endif()
endforeach()
