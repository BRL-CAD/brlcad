set(WORK "@CMAKE_CURRENT_BINARY_DIR@/height-jets-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders" "${WORK}/cache")
set(ENV{BU_DIR_CACHE} "${WORK}/cache")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_nested_test_commands.cmake")
foreach(shader IN ITEMS art_height_field art_height_jets)
  configure_file("@CMAKE_CURRENT_BINARY_DIR@/${shader}.oso" "${WORK}/shaders/${shader}.oso" COPYONLY)
endforeach()
set(TOOL "@ART_OIIOTOOL_EXECUTABLE@")
set(TOLERANCE 0.00002)
set(ACTUAL_DB "${WORK}/height.g")
set(REFERENCE_DB "${WORK}/reference.g")
run("${VEXEC}" create-material "${ACTUAL_DB}" art_height_jets)
foreach(parameter IN ITEMS "OSL.version|2" "OSL.node.field|art_height_field" "OSL.node.bump|as_bump"
    "OSL.connect.bump.in_bump_value|field.out_height"
    "OSL.connect.material.in_normal|bump.out_normal")
  string(REPLACE "|" ";" parameter "${parameter}")
  list(GET parameter 0 name)
  list(GET parameter 1 value)
  run("${VEXEC}" set-material "${ACTUAL_DB}" "${name}" "${value}")
endforeach()
configure_file("${ACTUAL_DB}" "${REFERENCE_DB}" COPYONLY)
foreach(name IN ITEMS OSL.node.bump OSL.connect.bump.in_bump_value)
  run("${VEXEC}" remove-material "${REFERENCE_DB}" "${name}")
endforeach()
run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.connect.material.in_normal field.out_reference)
set(RENDER_ARGS -P 1 -c "viewsize 0.5" -c "orientation 0 0 0 1"
  -c "set sampling=uniform samples=1 max_bounces=4 rr_min_path_length=0 next_event_estimation=0 light_intensity=0 environment_intensity=0 background_color=black")
foreach(profile IN ITEMS regular constant disabled global_shift critical)
  set(SIZE 16)
  set(eye "2 -2 40")
  set(base 0.3)
  set(slope 0.05)
  set(depth 1)
  set(shift "0 0 0")
  set(shapes cube mesh ball ellipsoid)
  set(modes 0 1 2)
  if(profile STREQUAL constant)
    set(base 0)
    set(slope 0)
  elseif(profile STREQUAL disabled)
    set(depth 0)
  elseif(profile STREQUAL global_shift)
    set(shift "0.25 0 0")
    set(shapes cube mesh)
  elseif(profile STREQUAL critical)
    set(base 0)
    set(SIZE 1)
    set(eye "0 0 40")
    set(shapes cube mesh)
    set(modes 1 2)
  endif()
  foreach(db IN ITEMS "${ACTUAL_DB}" "${REFERENCE_DB}")
    run("${VEXEC}" set-material "${db}" OSL.param.field.in_base "float ${base}")
    run("${VEXEC}" set-material "${db}" OSL.param.field.in_slope "float ${slope}")
    run("${VEXEC}" set-material "${db}" OSL.param.field.in_depth "float ${depth}")
    run("${VEXEC}" set-material "${db}" OSL.param.field.in_global_shift "vector ${shift}")
  endforeach()
  run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.param.bump.in_bump_depth "float ${depth}")
  foreach(shape IN LISTS shapes)
    foreach(projection IN ITEMS 0 2)
      foreach(mode IN LISTS modes)
        foreach(db IN ITEMS "${ACTUAL_DB}" "${REFERENCE_DB}")
          run("${VEXEC}" set-material "${db}" OSL.param.in_mode "int ${mode}")
        endforeach()
        set(actual "${WORK}/${profile}-${shape}-${projection}-${mode}.exr")
        set(reference "${WORK}/${profile}-${shape}-${projection}-${mode}-reference.exr")
        run("${EXEC}" ${RENDER_ARGS} -c "eye_pt ${eye}" -w ${SIZE} -n ${SIZE} -p ${projection}
          -o "${actual}" "${ACTUAL_DB}" "${shape}.r")
        run("${EXEC}" ${RENDER_ARGS} -c "eye_pt ${eye}" -w ${SIZE} -n ${SIZE} -p ${projection}
          -o "${reference}" "${REFERENCE_DB}" "${shape}.r")
        run("${VEXEC}" check-image "${actual}" ${SIZE} ${SIZE})
        compare_optical_transport("${actual}" "${reference}")
      endforeach()
    endforeach()
  endforeach()
endforeach()
