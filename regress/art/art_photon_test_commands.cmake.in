set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders" "${WORK}/cache")
set(ENV{BU_DIR_CACHE} "${WORK}/cache")
# A statistically useful photon batch takes longer than a small PT render.
if(PHOTON_LIGHT_INSIDE)
  set(ART_COMMAND_TIMEOUT 720)
else()
  set(ART_COMMAND_TIMEOUT 360)
endif()
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_nested_test_commands.cmake")
foreach(shader IN ITEMS art_diffuse art_photon_reference)
  configure_file("@CMAKE_CURRENT_BINARY_DIR@/${shader}.oso" "${WORK}/shaders/${shader}.oso" COPYONLY)
endforeach()
set(TOOL "@ART_OIIOTOOL_EXECUTABLE@")
set(ACTUAL_DB "${WORK}/actual.g")
set(REFERENCE_DB "${WORK}/reference.g")
if(PHOTON_LIGHT_INSIDE)
  set(SIZE 32)
  set(REFERENCE_SIZE ${SIZE})
  set(FIELD_OF_VIEW 90)
else()
  set(SIZE 16)
  set(REFERENCE_SIZE 1)
  set(FIELD_OF_VIEW 0.02)
endif()
set(POINT_POWER 1000)
set(BASE_ARGS -P 2 -w ${SIZE} -n ${SIZE} -p ${FIELD_OF_VIEW} -c "viewsize 1"
  -c "eye_pt 0 0 2" -c "orientation 0 0 0 1"
  -c "set sampling=uniform samples=1 light_intensity=${POINT_POWER} environment_intensity=0 background_color=black")
if(PHOTON_LIGHT_INSIDE)
  run("${VEXEC}" create-lit-glass-inside "${ACTUAL_DB}")
else()
  run("${VEXEC}" create-lit-glass "${ACTUAL_DB}")
endif()
configure_file("${ACTUAL_DB}" "${REFERENCE_DB}" COPYONLY)
run("${VEXEC}" set-named-material "${REFERENCE_DB}" receiver.material OSL art_photon_reference)
foreach(parameter IN ITEMS "in_roughness;float 0" "in_transmittance_amount;float 1"
    "in_surface_transmittance;color 1 1 1" "in_reflection_tint;color 1 1 1"
    "in_refraction_tint;color 1 1 1" "in_volume_transmittance_distance;float 0")
  list(GET parameter 0 name)
  list(GET parameter 1 value)
  set_nested_parameter("${ACTUAL_DB}" glass "${name}" "${value}")
endforeach()
function(render_photon_reference ior output)
  set_nested_parameter("${REFERENCE_DB}" receiver in_ior "float ${ior}")
  run_command("${CMAKE_CURRENT_BINARY_DIR}" FALSE "${EXEC}" ${BASE_ARGS} -w ${REFERENCE_SIZE} -n ${REFERENCE_SIZE} -c "set max_bounces=0 light_intensity=0"
    -o "${output}" "${REFERENCE_DB}" receiver.box.r)
  run("${VEXEC}" check-image "${output}" ${REFERENCE_SIZE} ${REFERENCE_SIZE})
endfunction()
function(render_photon_image kind photon_bounces output)
  # Separate camera and photon limits isolate the first transmitted bundle.
  run_command("${CMAKE_CURRENT_BINARY_DIR}" FALSE "${EXEC}" ${BASE_ARGS}
    -c "set integrator=sppm passes=${PHOTON_PASSES} light_photons=${PHOTONS_PER_PASS} environment_photons=0 max_bounces=0 rr_min_path_length=0 photon_max_bounces=${photon_bounces} photon_rr_min_path_length=0 photon_max_estimate=10000 photon_importons=0 photon_radius_percent=${PHOTON_RADIUS_PERCENT} photon_alpha=0.7 enable_caustics=1"
    -o "${output}" "${ACTUAL_DB}" "receiver.${kind}.r" "slab.${kind}.r" key_light.r)
  if(NOT command_output MATCHES "sppm pass ${PHOTON_PASSES} completed" OR
      NOT command_output MATCHES "complete: ${PHOTON_PASSES}/${PHOTON_PASSES} tiles")
    message(FATAL_ERROR "Photon mapping did not complete every configured pass")
  endif()
  run("${VEXEC}" check-image "${output}" ${SIZE} ${SIZE})
endfunction()
function(qualify_photon_energy kind ior)
  set(PHOTON_RADIUS_PERCENT 0.05)
  set(PHOTON_PASSES 32)
  set(PHOTONS_PER_PASS 1000000)
  set(ENERGY_RELATIVE_BOUND 0.01)
  set_nested_parameter("${ACTUAL_DB}" glass in_ior "float ${ior}")
  set(reference "${WORK}/reference.exr")
  render_photon_reference(${ior} "${reference}")
  set(image "${WORK}/actual.exr")
  render_photon_image("${kind}" 2 "${image}")
  compare_radiance_mean("${image}" "${reference}" ${ENERGY_RELATIVE_BOUND} FALSE)
  if(ior LESS 2)
    set(wrong_ior 2)
  else()
    set(wrong_ior 1.5)
  endif()
  render_photon_reference(${wrong_ior} "${WORK}/wrong-ior.exr")
  compare_radiance_mean("${image}" "${WORK}/wrong-ior.exr" ${ENERGY_RELATIVE_BOUND} TRUE)
endfunction()

function(qualify_photon_initial_media kind ior)
  # Interior refraction magnifies finite-radius averaging in the axial reference.
  set(PHOTON_RADIUS_PERCENT 0.02)
  # A wider view averages independent neighborhoods across the photon map.
  set(PHOTON_PASSES 32)
  set(PHOTONS_PER_PASS 500000)
  set(ENERGY_RELATIVE_BOUND 0.01)
  set_nested_parameter("${ACTUAL_DB}" glass in_ior "float ${ior}")
  foreach(parameter IN ITEMS "in_source_inside;int 1" "in_external_distance;float 5"
      "in_thickness;float 0.5")
    list(GET parameter 0 name)
    list(GET parameter 1 value)
    set_nested_parameter("${REFERENCE_DB}" receiver "${name}" "${value}")
  endforeach()
  # At index one the Snell/Jacobian reference must match direct illumination in air.
  render_photon_reference(1 "${WORK}/air-reference.exr")
  run_command("${CMAKE_CURRENT_BINARY_DIR}" FALSE "${EXEC}" ${BASE_ARGS} -c "set max_bounces=0"
    -o "${WORK}/air.exr" "${ACTUAL_DB}" "receiver.${kind}.r" key_light.r)
  run("${VEXEC}" check-image "${WORK}/air.exr" ${SIZE} ${SIZE})
  set(TOLERANCE 0.00002)
  compare_optical_transport("${WORK}/air.exr" "${WORK}/air-reference.exr")
  set(clear "${WORK}/clear.exr")
  render_photon_reference(${ior} "${WORK}/clear-reference.exr")
  render_photon_image("${kind}" 1 "${clear}")
  compare_radiance_mean("${clear}" "${WORK}/clear-reference.exr" ${ENERGY_RELATIVE_BOUND} FALSE)
  if(ior LESS 2)
    set(wrong_ior 2)
  else()
    set(wrong_ior 1.5)
  endif()
  render_photon_reference(${wrong_ior} "${WORK}/wrong-ior.exr")
  compare_radiance_mean("${clear}" "${WORK}/wrong-ior.exr" ${ENERGY_RELATIVE_BOUND} TRUE)
  foreach(material IN ITEMS glass receiver)
    if(material STREQUAL glass)
      set(database "${ACTUAL_DB}")
    else()
      set(database "${REFERENCE_DB}")
    endif()
    set_nested_parameter("${database}" "${material}" in_volume_transmittance "color 0.25 0.5 0.8")
    set_nested_parameter("${database}" "${material}" in_volume_transmittance_distance "float 0.5")
  endforeach()
  render_photon_reference(${ior} "${WORK}/absorbing-reference.exr")
  render_photon_image("${kind}" 1 "${WORK}/absorbing.exr")
  compare_radiance_mean("${WORK}/absorbing.exr" "${WORK}/absorbing-reference.exr" ${ENERGY_RELATIVE_BOUND} FALSE)
  compare_radiance_mean("${WORK}/absorbing.exr" "${clear}" ${ENERGY_RELATIVE_BOUND} TRUE)
endfunction()
