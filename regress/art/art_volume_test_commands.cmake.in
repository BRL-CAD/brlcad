set(TOOL "@ART_OIIOTOOL_EXECUTABLE@")
foreach(shader IN ITEMS art_emission art_alpha)
  configure_file("@CMAKE_CURRENT_BINARY_DIR@/${shader}.oso" "${WORK}/shaders/${shader}.oso" COPYONLY)
endforeach()
set(DB "${WORK}/fog.g")
run("${VEXEC}" create-material "${DB}" art_emission)
run("${VEXEC}" material "${DB}" create fog.material Fog)
run("${VEXEC}" set-named-material "${DB}" fog.material OSL.volume homogeneous)
run("${VEXEC}" set-named-material "${DB}" fog.material OSL.volume.absorption "color 0.01 0.02 0.03")
run("${VEXEC}" set-named-material "${DB}" fog.material OSL.volume.scattering "float 0")
foreach(object IN ITEMS cube.r mesh.r)
  run("${VEXEC}" material "${DB}" assign "${object}" fog.material)
endforeach()
run("${VEXEC}" material "${DB}" remove receiver.material optical OSL.param.in_target)
run("${VEXEC}" set-named-material "${DB}" receiver.material OSL art_emission)
run("${VEXEC}" set-named-material "${DB}" receiver.material OSL.param.in_color "color 1 1 1")
set(RENDER_ARGS -P 1 -w 1 -n 1 -c "viewsize 0.01" -c "orientation 0 0 0 1"
  -c "set samples=16 max_volume_bounces=0 light_intensity=0 environment_intensity=0 background_color=black")
# Per-millimeter Beer factors exp(-0.01), exp(-0.02), exp(-0.03).
set(UNIT_BEER_RGB "0.9900498337491681,0.9801986733067553,0.9704455335485082")
set(HALF_RELATIVE_BOUND 0.001)
function(check_beer image length coverage)
  run("${TOOL}" --pattern "constant:color=${UNIT_BEER_RGB}" 1x1 3 -d float
    --powc ${length} --mulc ${coverage} -o "${WORK}/reference.exr")
  compare_radiance_mean("${image}" "${WORK}/reference.exr" ${HALF_RELATIVE_BOUND} FALSE)
endfunction()
function(render_beer label object eye projection length coverage)
  set(image "${WORK}/${label}.exr")
  run("${EXEC}" ${RENDER_ARGS} -p ${projection} -c "eye_pt 0 0 ${eye}"
    -o "${image}" "${DB}" "${object}" ${ARGN})
  run("${VEXEC}" check-image "${image}" 1 1)
  check_beer("${image}" ${length} ${coverage})
endfunction()
