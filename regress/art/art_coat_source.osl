shader art_coat_source(color in_color = color(0.7, 0.5, 0.3), int in_diffuse = 0,
    output closure color out_color = 0)
{
    if (in_diffuse)
        out_color = in_color * diffuse(N);
    else out_color = in_color * emission();
}
