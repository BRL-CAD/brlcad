set(WORK "@CMAKE_CURRENT_BINARY_DIR@/aovs-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders" "${WORK}/cache")
set(ENV{BU_DIR_CACHE} "${WORK}/cache")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
set(TOOL "@ART_OIIOTOOL_EXECUTABLE@")
foreach(shader IN ITEMS art_emission art_diffuse art_uv art_refraction_reference art_sampling art_color_check)
  configure_file("@CMAKE_CURRENT_BINARY_DIR@/${shader}.oso"
    "${WORK}/shaders/${shader}.oso" COPYONLY)
endforeach()
# Half-float color passes allow rounding, while geometry passes remain float.
set(TOLERANCE 0.0005)
set(DIFF_ARGS --fail ${TOLERANCE} --hardfail ${TOLERANCE}
  --warn ${TOLERANCE} --hardwarn ${TOLERANCE})
set(AOVS depth,normal,position,uv,albedo,diffuse,direct_diffuse,indirect_diffuse,glossy,direct_glossy,indirect_glossy,emission)
set(RENDER_ARGS -P 1 -w 1 -n 1 -c "set samples=1 light_intensity=0 environment_intensity=0"
  -c "viewsize 4" -c "eye_pt 0 0 40" -c "orientation 0 0 0 1")

function(constant name color channels)
  run("${TOOL}" --pattern "constant:color=${color}" 1x1 ${channels} -d float ${ARGN}
    -o "${WORK}/${name}.exr")
endfunction()
function(matches actual expected channels)
  run("${TOOL}" ${DIFF_ARGS} "${WORK}/${actual}.exr" --ch "${channels}"
    "${WORK}/${expected}.exr" --ch "${channels}" --diff)
endfunction()
function(render name settings)
  run("${EXEC}" ${RENDER_ARGS} -c "set ${settings}"
    -o "${WORK}/${name}.exr" "${DB}" "${object}" ${extra_objects})
endfunction()
constant(depth 30,1 2 --chnames Z,A)
constant(miss-depth 0,0 2 --chnames Z,A)
constant(normal 0.5,0.5,1 3)
constant(back-normal 0.5,0.5,0 3)
constant(miss-normal 0.5,0.5,0.5 3)
constant(position 0,0,10 3)
constant(back-position 0,0,-10 3)
constant(uv 0.5,0.5,0 3)
constant(black 0,0,0,1 4)
constant(emission 4,0.5,0.25,1 4)
constant(albedo 0.25,0.5,0.75,1 4)
constant(diffuse 0.1,0.2,0.3,1 4)
constant(glass 0.32256,0.32256,0.32256,1 4)

set(UV_DB "${WORK}/uv.g")
run("${VEXEC}" create-material "${UV_DB}" art_uv)
set(DB "${WORK}/emission.g")
run("${VEXEC}" create-material "${DB}" art_emission)
run("${VEXEC}" set-material "${DB}" OSL.param.in_color "color 4 0.5 0.25")
foreach(object IN ITEMS cube.r mesh.r)
  set(label "emission-${object}")
  render("${label}-plain" "aovs=none")
  render("${label}" "aovs=${AOVS}")
  matches("${label}" "${label}-plain" R,G,B,A)
  matches("${label}.emission" emission R,G,B,A)
  foreach(name IN ITEMS depth normal position)
    if(name STREQUAL depth)
      set(channels Z,A)
    else()
      set(channels R,G,B)
    endif()
    matches("${label}.${name}" "${name}" "${channels}")
  endforeach()
  # BOT UVs are authored per triangle, rather than the CSG box projection.
  run("${EXEC}" ${RENDER_ARGS} -o "${WORK}/${label}-uv-reference.exr" "${UV_DB}" "${object}")
  matches("${label}.uv" "${label}-uv-reference" R,G,B)
  if(object STREQUAL cube.r)
    matches("${label}.uv" uv R,G,B)
  endif()
  foreach(name IN ITEMS albedo diffuse direct_diffuse indirect_diffuse glossy direct_glossy indirect_glossy)
    matches("${label}.${name}" black R,G,B,A)
  endforeach()
  run_command("${CMAKE_CURRENT_BINARY_DIR}" FALSE "${TOOL}" --info "${WORK}/${label}.depth.exr")
  if(NOT command_output MATCHES "2 channel, float openexr")
    message(FATAL_ERROR "Depth lost its full float Z/A data: ${command_output}")
  endif()
  # Reversing the requested order must leave color and geometry untouched.
  render("${label}-reverse" "aovs=emission,depth")
  matches("${label}-reverse.emission" "${label}.emission" R,G,B,A)
  matches("${label}-reverse.depth" depth Z,A)
  run("${EXEC}" ${RENDER_ARGS} -c "set aovs=depth,normal,position,uv"
    -c "eye_pt 40 0 40" -o "${WORK}/${label}-miss.exr" "${DB}" "${object}")
  matches("${label}-miss.depth" miss-depth Z,A)
  matches("${label}-miss.normal" miss-normal R,G,B)
  foreach(name IN ITEMS position uv)
    matches("${label}-miss.${name}" black R,G,B)
  endforeach()
  run("${EXEC}" ${RENDER_ARGS} -c "set aovs=depth,normal,position"
    -c "eye_pt 0 0 -40" -c "orientation 0 1 0 0"
    -o "${WORK}/${label}-back.exr" "${DB}" "${object}")
  matches("${label}-back.depth" depth Z,A)
  matches("${label}-back.normal" back-normal R,G,B)
  matches("${label}-back.position" back-position R,G,B)
  # Perspective center rays have the same camera-space Z on this slab.
  run("${EXEC}" ${RENDER_ARGS} -p 50 -c "set aovs=depth"
    -o "${WORK}/${label}-perspective.exr" "${DB}" "${object}")
  matches("${label}-perspective.depth" depth Z,A)
endforeach()

foreach(shader IN ITEMS art_diffuse as_metal as_plastic as_glass)
  set(DB "${WORK}/${shader}.g")
  set(extra_objects)
  run("${VEXEC}" create-material "${DB}" "${shader}")
  if(shader STREQUAL art_diffuse)
    run("${VEXEC}" set-material "${DB}" OSL.param.in_color "color 0.25 0.5 0.75")
  elseif(shader STREQUAL as_metal)
    run("${VEXEC}" set-material "${DB}" OSL.param.in_face_reflectance "color 1 1 1")
    run("${VEXEC}" set-material "${DB}" OSL.param.in_roughness "float 0.3")
  elseif(shader STREQUAL as_glass)
    run("${VEXEC}" set-material "${DB}" OSL.param.in_roughness "float 0")
    run("${VEXEC}" set-material "${DB}" OSL.param.in_transmittance_amount "float 1")
    run("${VEXEC}" set-material "${DB}" OSL.param.in_surface_transmittance "color 1 1 1")
    run("${VEXEC}" set-material "${DB}" OSL.param.in_volume_transmittance_distance "float 0")
    run("${VEXEC}" set-material "${DB}" OSL.param.in_reflection_tint "color 0 0 0")
    run("${VEXEC}" set-named-material "${DB}" receiver.material OSL.param.in_target "int 2")
    set(extra_objects receiver.r)
  endif()
  foreach(object IN ITEMS cube.r mesh.r)
    set(label "${shader}-${object}")
    render("${label}" "aovs=${AOVS} samples=16 next_event_estimation=0 environment_color=white environment_intensity=0.4")
    run("${TOOL}" "${WORK}/${label}.diffuse.exr" --ch R,G,B
      "${WORK}/${label}.glossy.exr" --ch R,G,B --add
      "${WORK}/${label}.emission.exr" --ch R,G,B --add -o "${WORK}/sum.exr")
    matches(sum "${label}" R,G,B)
    foreach(kind IN ITEMS diffuse glossy)
      run("${TOOL}" "${WORK}/${label}.direct_${kind}.exr" --ch R,G,B
        "${WORK}/${label}.indirect_${kind}.exr" --ch R,G,B --add -o "${WORK}/sum.exr")
      matches(sum "${label}.${kind}" R,G,B)
    endforeach()
    if(shader STREQUAL art_diffuse)
      matches("${label}.albedo" albedo R,G,B)
      matches("${label}" diffuse R,G,B)
      matches("${label}.diffuse" diffuse R,G,B)
    elseif(shader STREQUAL as_metal)
      matches("${label}.glossy" "${label}" R,G,B)
      expect_failure("${TOOL}" ${DIFF_ARGS} "${WORK}/${label}.glossy.exr" --ch R,G,B
        "${WORK}/black.exr" --ch R,G,B --diff)
    elseif(shader STREQUAL as_glass)
      matches("${label}" glass R,G,B)
      matches("${label}.indirect_glossy" glass R,G,B)
      matches("${label}.emission" black R,G,B)
      # Depth remains the primary glass boundary, not the transmitted receiver.
      matches("${label}.depth" depth Z,A)
    endif()
  endforeach()
endforeach()

set(DB "${WORK}/emission.g")
set(object cube.r)
set(extra_objects)
file(WRITE "${WORK}/frames.view"
  "start 0; set aovs=normal; end;\n"
  "start 1; set aovs=depth; end;\n"
  "start 2; clean; end;\n"
  "start 3; set aovs=none; end;\n")
run(INPUT_FILE "${WORK}/frames.view" "${EXEC}" ${RENDER_ARGS} -M
  -o "${WORK}/frames.exr" "${DB}" cube.r)
matches(frames.normal normal R,G,B)
foreach(frame IN ITEMS 1 2)
  matches("frames.${frame}.depth" depth Z,A)
endforeach()
foreach(path IN ITEMS frames.depth.exr frames.1.normal.exr frames.2.normal.exr frames.3.depth.exr frames.3.normal.exr)
  if(EXISTS "${WORK}/${path}")
    message(FATAL_ERROR "AOV selection leaked across frames: ${path}")
  endif()
endforeach()
run(INPUT_FILE "${WORK}/frames.view" "${EXEC}" ${RENDER_ARGS} -M -D 2 -K 2
  -o "${WORK}/skipped.exr" "${DB}" cube.r)
matches(skipped.2.depth depth Z,A)
if(EXISTS "${WORK}/skipped.exr" OR EXISTS "${WORK}/skipped.normal.exr" OR EXISTS "${WORK}/skipped.1.depth.exr")
  message(FATAL_ERROR "Skipped frames wrote AOV output")
endif()
# Sidecars follow the beauty filename even when its format is not OpenEXR.
foreach(extension IN ITEMS png pix)
  run("${EXEC}" ${RENDER_ARGS} -c "set aovs=normal,depth"
    -o "${WORK}/image with spaces.${extension}" "${DB}" cube.r)
  matches("image with spaces.normal" normal R,G,B)
  matches("image with spaces.depth" depth Z,A)
endforeach()
run_command("${CMAKE_CURRENT_BINARY_DIR}" FALSE "${EXEC}" -c "set inspect_materials=1"
  -c "set aovs=depth,normal" -c set "${DB}" cube.r)
if(NOT command_output MATCHES "aovs=depth,normal")
  message(FATAL_ERROR "AOV query lost the requested order")
endif()
run_command("${CMAKE_CURRENT_BINARY_DIR}" FALSE "${EXEC}" -c "set inspect_materials=1"
  -c set "${DB}" cube.r)
if(NOT command_output MATCHES "aovs=none")
  message(FATAL_ERROR "Default rendering unexpectedly requests AOVs")
endif()
foreach(setting IN ITEMS "aovs=unknown" "aovs=depth,depth" "aovs=depth,,normal"
    "aovs=depth," "aovs=none,depth" "aovs=depth samples=0")
  file(WRITE "${WORK}/invalid.exr" "preserve existing output")
  expect_failure_matching("invalid setting" "${EXEC}" ${RENDER_ARGS} -c "set ${setting}"
    -o "${WORK}/invalid.exr" "${DB}" cube.r)
  file(READ "${WORK}/invalid.exr" retained)
  if(NOT retained STREQUAL "preserve existing output" OR EXISTS "${WORK}/invalid.depth.exr")
    message(FATAL_ERROR "Invalid settings wrote beauty or AOV output")
  endif()
endforeach()
# A sidecar write failure must fail the command before replacing the beauty.
file(WRITE "${WORK}/failure.exr" "preserve existing output")
file(MAKE_DIRECTORY "${WORK}/failure.depth.exr")
expect_failure_matching("could not save requested AOV" "${EXEC}" ${RENDER_ARGS}
  -c "set aovs=depth" -o "${WORK}/failure.exr" "${DB}" cube.r)
file(READ "${WORK}/failure.exr" retained)
if(NOT retained STREQUAL "preserve existing output")
  message(FATAL_ERROR "AOV write failure replaced the beauty")
endif()
set(ERROR_DB "${WORK}/error.g")
run("${VEXEC}" create-material "${ERROR_DB}" art_color_check)
run("${VEXEC}" set-material "${ERROR_DB}" OSL.param.in_expected "color 1 1 1")
foreach(path IN ITEMS error.exr error.depth.exr error.emission.exr)
  file(WRITE "${WORK}/${path}" "preserve existing output")
endforeach()
expect_failure_matching("Color mismatch" "${EXEC}" ${RENDER_ARGS}
  -c "set aovs=depth,emission renderer_log=error" -o "${WORK}/error.exr" "${ERROR_DB}" cube.r)
foreach(path IN ITEMS error.exr error.depth.exr error.emission.exr)
  file(READ "${WORK}/${path}" retained)
  if(NOT retained STREQUAL "preserve existing output")
    message(FATAL_ERROR "Shader error replaced ${path}")
  endif()
endforeach()
if(UNIX)
  set(CANCEL_DB "${WORK}/cancel.g")
  run("${VEXEC}" create-material "${CANCEL_DB}" art_sampling)
  foreach(path IN ITEMS cancel.exr cancel.depth.exr cancel.emission.exr)
    file(WRITE "${WORK}/${path}" "preserve existing output")
  endforeach()
  run("${VEXEC}" interrupt-render "${WORK}/cancel.log" art_sampling_evaluation -
    "${EXEC}" ${RENDER_ARGS} -c "set aovs=depth,emission samples=2000000000 renderer_log=debug"
    -o "${WORK}/cancel.exr" "${CANCEL_DB}" cube.r)
  foreach(path IN ITEMS cancel.exr cancel.depth.exr cancel.emission.exr)
    file(READ "${WORK}/${path}" retained)
    if(NOT retained STREQUAL "preserve existing output")
      message(FATAL_ERROR "Cancellation replaced ${path}")
    endif()
  endforeach()
endif()
