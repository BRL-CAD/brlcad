set(WORK "@CMAKE_CURRENT_BINARY_DIR@/mixture-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
foreach(shader IN ITEMS art_mirror_mixture art_mirror_node art_emission)
  configure_file("@CMAKE_CURRENT_BINARY_DIR@/${shader}.oso"
    "${WORK}/shaders/${shader}.oso" COPYONLY)
endforeach()
set(SINGLE_DB "${WORK}/single.g")
set(NETWORK_DB "${WORK}/network.g")
set(REFERENCE_DB "${WORK}/reference.g")
run("${VEXEC}" create-material "${SINGLE_DB}" art_mirror_mixture)
run("${VEXEC}" set-material "${SINGLE_DB}" OSL.param.in_color "color 0.5 0.5 0.5")
run("${VEXEC}" create-material "${NETWORK_DB}" as_blend_shader out_color)
run("${VEXEC}" set-material "${NETWORK_DB}" OSL.version 2)
foreach(node IN ITEMS straight tilted)
  run("${VEXEC}" set-material "${NETWORK_DB}" "OSL.node.${node}" art_mirror_node)
  run("${VEXEC}" set-material "${NETWORK_DB}" "OSL.param.${node}.in_color" "color 0.5 0.5 0.5")
endforeach()
run("${VEXEC}" set-material "${NETWORK_DB}" OSL.param.tilted.in_tilt "float 0.2")
run("${VEXEC}" set-material "${NETWORK_DB}" OSL.connect.material.in_color straight.out_color)
run("${VEXEC}" set-material "${NETWORK_DB}" OSL.connect.material.in_color1 tilted.out_color)
run("${VEXEC}" set-material "${NETWORK_DB}" OSL.param.in_layer_visibility1 "int 1")
run("${VEXEC}" create-material "${REFERENCE_DB}" art_emission)
# A white constant environment has radiance 0.4.  Half-reflecting mixtures
# must return 0.2 regardless of which mirror closure is sampled.
run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_color "color 0.2 0.2 0.2")
set(RENDER_ARGS -a 0 -e 65 -E 2 -P 2 -w 64 -n 64 -C 255/255/255
  -c "set samples=16 light_intensity=0" -c "viewsize 40")
foreach(object IN ITEMS cube.r mesh.r ball.r ellipsoid.r)
  foreach(perspective IN ITEMS 0 50)
    set(reference "${WORK}/reference_${object}_${perspective}.png")
    run("${EXEC}" ${RENDER_ARGS} -p ${perspective}
      -o "${reference}" "${REFERENCE_DB}" "${object}")
    foreach(weight IN ITEMS 0 0.25 0.5 0.75 1)
      run("${VEXEC}" set-material "${SINGLE_DB}" OSL.param.in_weight "float ${weight}")
      run("${VEXEC}" set-material "${NETWORK_DB}" OSL.param.in_weight1 "float ${weight}")
      foreach(form IN ITEMS SINGLE NETWORK)
        set(actual "${WORK}/${form}_${object}_${perspective}_${weight}.png")
        run("${EXEC}" ${RENDER_ARGS} -p ${perspective}
          -o "${actual}" "${${form}_DB}" "${object}")
        run("${VEXEC}" check-matching-image "${actual}" "${reference}" 64 64)
      endforeach()
    endforeach()
  endforeach()
endforeach()

# An intentionally lower reflectance must fail the energy reference.
run("${VEXEC}" set-material "${SINGLE_DB}" OSL.param.in_color "color 0.25 0.25 0.25")
run("${EXEC}" ${RENDER_ARGS} -p 0 -o "${WORK}/dark.png" "${SINGLE_DB}" cube.r)
run("${VEXEC}" check-different-image "${WORK}/dark.png" "${WORK}/reference_cube.r_0.png" 64 64)
expect_failure("${VEXEC}" check-matching-image "${WORK}/dark.png" "${WORK}/reference_cube.r_0.png" 64 64)
