cmake_minimum_required(VERSION 3.22)

set(WORK "@CMAKE_CURRENT_BINARY_DIR@/coat-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
foreach(shader IN ITEMS art_coat_source art_coat_reference)
  configure_file("@CMAKE_CURRENT_BINARY_DIR@/${shader}.oso"
    "${WORK}/shaders/${shader}.oso" COPYONLY)
endforeach()
set(REFERENCE_DB "${WORK}/reference.g")
run("${VEXEC}" create-material "${REFERENCE_DB}" art_coat_reference)
run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_color "color 0.7 0.5 0.3")
set(RENDER_ARGS -a 0 -e 65 -E 2 -P 2 -w 64 -n 64 -C 0/0/0
  -c "set samples=16 light_intensity=0" -c "viewsize 40")

function(create_coat_network db depth)
  run("${VEXEC}" create-material "${db}" as_glossy_layer out_color)
  run("${VEXEC}" set-material "${db}" OSL.version 2)
  run("${VEXEC}" set-material "${db}" OSL.node.source art_coat_source)
  run("${VEXEC}" set-material "${db}" OSL.param.source.in_color "color 0.7 0.5 0.3")
  set(parent material)
  if(depth GREATER 1)
    math(EXPR last "${depth} - 1")
    foreach(layer RANGE 1 ${last})
      set(child "coat${layer}")
      run("${VEXEC}" set-material "${db}" "OSL.node.${child}" as_glossy_layer)
      run("${VEXEC}" set-material "${db}" "OSL.connect.${parent}.in_substrate" "${child}.out_color")
      set(parent "${child}")
    endforeach()
  endif()
  run("${VEXEC}" set-material "${db}" "OSL.connect.${parent}.in_substrate" source.out_color)
endfunction()

foreach(case IN ITEMS single double smooth disabled zero_channel four fixed_inner diffuse)
  set(depth 1)
  set(ior 1)
  set(roughness 0.55)
  set(thickness 0.4)
  set(transmittance "color 0.25 0.5 0.8")
  set(fixed_inner 0)
  set(diffuse 0)
  set(light_objects)
  set(case_args ${RENDER_ARGS})
  if(case STREQUAL "double" OR case STREQUAL "fixed_inner")
    set(depth 2)
  elseif(case STREQUAL "smooth")
    set(ior 1.5)
    set(roughness 0)
    set(thickness 0)
  elseif(case STREQUAL "zero_channel")
    set(transmittance "color 0 0.5 0.8")
    set(thickness 0.05)
  elseif(case STREQUAL "four")
    set(depth 4)
    set(thickness 0.1)
  endif()
  if(case STREQUAL "fixed_inner")
    set(fixed_inner 1)
  elseif(case STREQUAL "diffuse")
    set(depth 2)
    set(diffuse 1)
    set(light_objects key_light.r)
    list(APPEND case_args -c "set light_intensity=1000")
  endif()
  set(db "${WORK}/${case}.g")
  create_coat_network("${db}" "${depth}")
  run("${VEXEC}" set-material "${db}" OSL.param.source.in_diffuse "int ${diffuse}")
  set(nodes material)
  if(depth GREATER 1)
    math(EXPR last "${depth} - 1")
    foreach(layer RANGE 1 ${last})
      list(APPEND nodes "coat${layer}")
    endforeach()
  endif()
  foreach(node IN LISTS nodes)
    if(node STREQUAL "material")
      set(prefix "OSL.param.")
    else()
      set(prefix "OSL.param.${node}.")
    endif()
    run("${VEXEC}" set-material "${db}" "${prefix}in_ior" "float ${ior}")
    run("${VEXEC}" set-material "${db}" "${prefix}in_roughness" "float ${roughness}")
    run("${VEXEC}" set-material "${db}" "${prefix}in_transmittance" "${transmittance}")
    run("${VEXEC}" set-material "${db}" "${prefix}in_thickness" "float ${thickness}")
  endforeach()
  if(fixed_inner)
    run("${VEXEC}" set-material "${db}" OSL.param.coat1.in_normal "normal 0 0 1")
  endif()
  if(case STREQUAL "disabled")
    run("${VEXEC}" set-material "${db}" OSL.param.in_enable "int 0")
    set(depth 0)
  endif()
  foreach(property IN ITEMS ior thickness transmittance)
    if(property STREQUAL "transmittance")
      set(value "${transmittance}")
    else()
      set(value "float ${${property}}")
    endif()
    run("${VEXEC}" set-material "${REFERENCE_DB}" "OSL.param.in_${property}" "${value}")
  endforeach()
  run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_depth "int ${depth}")
  run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_fixed_inner "int ${fixed_inner}")
  run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_diffuse "int ${diffuse}")
  foreach(object IN ITEMS cube.r mesh.r ball.r ellipsoid.r)
    foreach(perspective IN ITEMS 0 50)
      set(label "${case}_${object}_${perspective}")
      run("${EXEC}" ${case_args} -p ${perspective}
        -o "${WORK}/actual_${label}.png" "${db}" "${object}" ${light_objects})
      run("${EXEC}" ${case_args} -p ${perspective}
        -o "${WORK}/reference_${label}.png" "${REFERENCE_DB}" "${object}" ${light_objects})
      run("${VEXEC}" check-matching-image "${WORK}/actual_${label}.png" "${WORK}/reference_${label}.png" 64 64)
    endforeach()
  endforeach()
endforeach()

# Disabled absorption must fail the absorbing reference.
run("${VEXEC}" check-different-image "${WORK}/actual_disabled_cube.r_0.png" "${WORK}/reference_single_cube.r_0.png" 64 64)
expect_failure("${VEXEC}" check-matching-image "${WORK}/actual_disabled_cube.r_0.png" "${WORK}/reference_single_cube.r_0.png" 64 64)

# A fifth coat must fail cleanly without replacing a successful image.
set(deep "${WORK}/too_deep.g")
create_coat_network("${deep}" 5)
set(output "${WORK}/preserved.png")
configure_file("${WORK}/actual_single_cube.r_0.png" "${output}" COPYONLY)
file(SHA256 "${output}" before)
expect_failure_matching("maximum number of coating layers" "${EXEC}" ${RENDER_ARGS}
  -p 0 -o "${output}" "${deep}" cube.r)
file(SHA256 "${output}" after)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "An over-deep coating network replaced the previous image")
endif()

# A smooth coat without a substrate reflects the constant environment with
# the independent Fresnel weight, exercising its specular sampling path.
set(REFLECTOR_DB "${WORK}/reflector.g")
run("${VEXEC}" create-material "${REFLECTOR_DB}" as_glossy_layer out_color)
run("${VEXEC}" set-material "${REFLECTOR_DB}" OSL.param.in_roughness "float 0")
run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_reflection "int 1")
run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_ior "float 1.5")
foreach(object IN ITEMS cube.r mesh.r ball.r ellipsoid.r)
  foreach(perspective IN ITEMS 0 50)
    set(label "reflection_${object}_${perspective}")
    foreach(form IN ITEMS actual reference)
      if(form STREQUAL "actual")
        set(db "${REFLECTOR_DB}")
      else()
        set(db "${REFERENCE_DB}")
      endif()
      run("${EXEC}" ${RENDER_ARGS} -C 255/255/255 -p ${perspective}
        -o "${WORK}/${form}_${label}.png" "${db}" "${object}")
    endforeach()
    run("${VEXEC}" check-matching-image "${WORK}/actual_${label}.png" "${WORK}/reference_${label}.png" 64 64)
  endforeach()
endforeach()

# A null coat over the native plastic node must preserve both plastic lobes.
set(PLASTIC_DB "${WORK}/plastic.g")
set(IDENTITY_DB "${WORK}/identity.g")
run("${VEXEC}" create-material "${PLASTIC_DB}" as_plastic)
run("${VEXEC}" create-material "${IDENTITY_DB}" as_glossy_layer out_color)
run("${VEXEC}" set-material "${IDENTITY_DB}" OSL.version 2)
run("${VEXEC}" set-material "${IDENTITY_DB}" OSL.node.base as_plastic)
run("${VEXEC}" set-material "${IDENTITY_DB}" OSL.connect.material.in_substrate base.out_outColor)
run("${VEXEC}" set-material "${IDENTITY_DB}" OSL.param.in_ior "float 1")
foreach(form IN ITEMS PLASTIC IDENTITY)
  if(form STREQUAL "PLASTIC")
    set(prefix "OSL.param.")
  else()
    set(prefix "OSL.param.base.")
  endif()
  set(db "${${form}_DB}")
  run("${VEXEC}" set-material "${db}" "${prefix}in_color" "color 0.3 0.5 0.7")
  run("${VEXEC}" set-material "${db}" "${prefix}in_specular_color" "color 1 1 1")
  run("${VEXEC}" set-material "${db}" "${prefix}in_specular_weight" "float 1")
  run("${VEXEC}" set-material "${db}" "${prefix}in_specular_roughness" "float 0.35")
  run("${VEXEC}" set-material "${db}" "${prefix}in_scattering" "float 1")
endforeach()
foreach(object IN ITEMS cube.r mesh.r ball.r ellipsoid.r)
  foreach(perspective IN ITEMS 0 50)
    set(label "identity_${object}_${perspective}")
    foreach(form IN ITEMS PLASTIC IDENTITY)
      run("${EXEC}" ${RENDER_ARGS} -C 255/255/255 -p ${perspective}
        -c "set samples=256"
        -o "${WORK}/${form}_${label}.png" "${${form}_DB}" "${object}")
    endforeach()
    run("${VEXEC}" check-matching-image "${WORK}/IDENTITY_${label}.png" "${WORK}/PLASTIC_${label}.png" 64 64)
  endforeach()
endforeach()
