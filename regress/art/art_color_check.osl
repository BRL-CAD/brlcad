surface art_color_check(
    color in_color = color(0),
    color in_expected = color(0))
{
    // Check linear values before display conversion and quantization.
    // Allow the JIT's float power approximation while detecting toe errors.
    float tolerance = 1.0e-5;
    color difference = abs(in_color - in_expected);
    float max_error = max(difference[0], max(difference[1], difference[2]));
    if (!isfinite(in_color[0]) || !isfinite(in_color[1]) ||
        !isfinite(in_color[2]) || max_error > tolerance)
        error("Color mismatch: got (%g,%g,%g), expected (%g,%g,%g).",
            in_color[0], in_color[1], in_color[2],
            in_expected[0], in_expected[1], in_expected[2]);
    Ci = in_color * emission();
}
