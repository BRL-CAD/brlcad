surface art_directional_emission(
    color in_color = color(1),
    float in_normal_cone_cosine = 1)
{
    float cosine = abs(dot(normalize(Ng), -normalize(I)));
    float strength = in_normal_cone_cosine >= 1 || cosine < in_normal_cone_cosine ? 1 : 0;
    Ci = in_color * strength * emission();
}
