surface art_texture(string in_filename = "", int in_handle_error = 0)
{
    color texel;
    if (in_handle_error) {
        string texture_error;
        texel = texture(in_filename, u, v, "errormessage", texture_error);
        if (texture_error != "") {
            warning("Using explicit texture fallback: %s", texture_error);
            texel = color(0, 1, 0);
        }
    } else {
        texel = texture(in_filename, u, v);
    }
    Ci = texel * emission();
}
