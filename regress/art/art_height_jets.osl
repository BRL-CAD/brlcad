#include "appleseed/as_osl_extensions.h"

surface art_height_jets(normal in_normal = as_shading_normal(), int in_mode = 0)
{
    vector value = vector(in_normal);
    // Magnify differential errors while keeping all fixture radiance positive.
    float differential_scale = 32;
    if (in_mode == 1)
        value = differential_scale * Dx(in_normal);
    else if (in_mode == 2)
        value = differential_scale * Dy(in_normal);
    Ci = emission() * (color(2) + color(value));
}
