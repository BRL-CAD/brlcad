set(WORK "@CMAKE_CURRENT_BINARY_DIR@/standard-microfacet-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders" "${WORK}/cache")
set(ENV{BU_DIR_CACHE} "${WORK}/cache")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_nested_test_commands.cmake")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_rough_test_commands.cmake")
configure_file("@CMAKE_CURRENT_BINARY_DIR@/art_rough_footprint_reference.oso"
  "${WORK}/shaders/art_rough_footprint_reference.oso" COPYONLY)
set(TOOL "@ART_OIIOTOOL_EXECUTABLE@")
set(ACTUAL_DB "${WORK}/actual.g")
set(REFERENCE_DB "${WORK}/reference.g")
# Keep the existing independent-estimator budget and positive receiver gate.
set(SAMPLES 131072)
set(RELATIVE_BOUND 0.01)
set(MIN_RADIANCE 0.001)
set(ART_COMMAND_TIMEOUT 120)

function(set_standard_view eye_x)
  set(RENDER_ARGS -P 1 -w 1 -n 1 -c "viewsize 0.05"
    -c "eye_pt ${eye_x} -2 40" -c "orientation 0 0 0 1"
    -c "set sampling=uniform samples=${SAMPLES} next_event_estimation=0 max_bounces=4 light_intensity=0 environment_intensity=0 background_color=black"
    PARENT_SCOPE)
endfunction()

foreach(beckmann IN ITEMS 0 1)
  set_standard_view(2)
  set(REFLECTION_HOLE_BOUNDS 1 3 -3 -1 29 32)
  create_rough_databases(0)
  set_rough_parameter(in_standard "int 1")
  set_rough_parameter(in_beckmann "int ${beckmann}")
  foreach(widths IN ITEMS "0.36|0.1" "0.2|0.2")
    string(REPLACE "|" ";" axes "${widths}")
    list(GET axes 0 alpha_x)
    list(GET axes 1 alpha_y)
    set_rough_parameter(in_alpha_x "float ${alpha_x}")
    set_rough_parameter(in_alpha_y "float ${alpha_y}")
    foreach(shape IN ITEMS cube mesh)
      foreach(projection IN ITEMS 0 2)
        foreach(position IN ITEMS 1 0)
          render_rough_pair("${beckmann}-${alpha_x}-${alpha_y}-${shape}-${projection}-${position}"
            "${shape}" ${projection} ${position})
        endforeach()
      endforeach()
    endforeach()
  endforeach()

  set_standard_view(-13)
  set(REFLECTION_HOLE_BOUNDS -14 -12 -3 -1 29 32)
  foreach(shape IN ITEMS ball ellipsoid)
    set(axes "10 10 10")
    if(shape STREQUAL "ellipsoid")
      set(axes "8 10 6")
    endif()
    create_rough_databases(0)
    set_rough_parameter(in_standard "int 1")
    set_rough_parameter(in_beckmann "int ${beckmann}")
    set_rough_parameter(in_curved "int 1")
    set_rough_parameter(in_axes "vector ${axes}")
    set_rough_parameter(in_mapped_normal "int 1")
    foreach(projection IN ITEMS 0 2)
      # Default and authored tangents exercise distinct frame derivatives.
      foreach(tangent IN ITEMS 0 2)
        set_rough_parameter(in_tangent_source "int ${tangent}")
        foreach(position IN ITEMS 1 0)
          render_rough_pair("${beckmann}-${shape}-${projection}-${tangent}-${position}"
            "${shape}" ${projection} ${position})
        endforeach()
      endforeach()
    endforeach()
  endforeach()
endforeach()
