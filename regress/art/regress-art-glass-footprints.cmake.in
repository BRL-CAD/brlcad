set(WORK "@CMAKE_CURRENT_BINARY_DIR@/glass-footprints-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders" "${WORK}/cache")
set(ENV{BU_DIR_CACHE} "${WORK}/cache")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_nested_test_commands.cmake")
foreach(shader IN ITEMS art_glass_footprint_field art_glass_footprint_reference)
  configure_file("@CMAKE_CURRENT_BINARY_DIR@/${shader}.oso" "${WORK}/shaders/${shader}.oso" COPYONLY)
endforeach()
set(TOOL "@ART_OIIOTOOL_EXECUTABLE@")
set(ACTUAL_DB "${WORK}/actual.g")
set(REFERENCE_DB "${WORK}/reference.g")
set(TOLERANCE 0.00002)
# Ray differentials approximate neighboring paths to first order. Halving
# the footprint halves this budget; binary16 rounding is separate.
set(FOOTPRINT_RELATIVE_BOUND 0.0109765625)
set(REFINED_FOOTPRINT_RELATIVE_BOUND 0.0059765625)
set(RENDER_ARGS -P 1 -c "viewsize 0.5" -c "orientation 0 0 0 1"
  -c "set sampling=uniform samples=1 max_bounces=16 max_specular_bounces=16 rr_min_path_length=0 light_intensity=0 environment_intensity=0 background_color=black")
run("${VEXEC}" create-material "${ACTUAL_DB}" as_glass)
run("${VEXEC}" create-material "${REFERENCE_DB}" art_glass_footprint_reference)
foreach(db IN ITEMS "${ACTUAL_DB}" "${REFERENCE_DB}")
  run("${VEXEC}" material "${db}" remove receiver.material optical OSL.param.in_target)
  run("${VEXEC}" set-named-material "${db}" receiver.material OSL art_glass_footprint_reference)
  run("${VEXEC}" set-named-material "${db}" receiver.material OSL.param.in_receiver "int 1")
  foreach(front IN ITEMS "front;5" "curved_front;-10")
    list(GET front 0 name)
    list(GET front 1 minimum)
    run("${VEXEC}" in "${db}" "${name}.s" rpp ${minimum} 200 -200 200 30 31)
    run("${VEXEC}" r "${db}" "${name}.r" u "${name}.s")
    run("${VEXEC}" material "${db}" assign "${name}.r" receiver.material)
  endforeach()
endforeach()
foreach(parameter IN ITEMS "OSL.version;2" "OSL.param.in_roughness;float 0"
    "OSL.param.in_transmittance_amount;float 1" "OSL.param.in_surface_transmittance;color 1 1 1"
    "OSL.param.in_volume_transmittance_distance;float 0")
  list(GET parameter 0 name)
  list(GET parameter 1 value)
  run("${VEXEC}" set-material "${ACTUAL_DB}" "${name}" "${value}")
endforeach()
function(set_reference name value)
  run("${VEXEC}" set-material "${REFERENCE_DB}" "OSL.param.in_${name}" "${value}")
endfunction()
function(set_mapping mapping center reflection curved)
  foreach(name IN ITEMS OSL.connect.material.in_bump_normal OSL.param.in_bump_normal
      OSL.connect.bump.in_normal_map OSL.node.bump OSL.node.field OSL.param.field.in_center
      OSL.param.field.in_base OSL.param.bump.in_mode OSL.param.bump.in_normal_map_mode
      OSL.param.bump.in_normal_map_coordsys)
    run("${VEXEC}" remove-material "${ACTUAL_DB}" "${name}")
  endforeach()
  set(mapped 0)
  set(slope 0.05)
  if(NOT mapping STREQUAL "unmapped")
    set(mapped 1)
    if(reflection)
      set(base 0.3)
    else()
      set(base 0)
    endif()
    run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.node.field art_glass_footprint_field)
    run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.param.field.in_center "point ${center}")
    run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.param.field.in_base "float ${base}")
    if(mapping STREQUAL "direct")
      run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.connect.material.in_bump_normal field.out_normal)
    else()
      foreach(parameter IN ITEMS "OSL.node.bump;as_bump" "OSL.param.bump.in_mode;string Normal Map"
          "OSL.param.bump.in_normal_map_mode;string Signed" "OSL.param.bump.in_normal_map_coordsys;string World Space"
          "OSL.connect.bump.in_normal_map;field.out_map" "OSL.connect.material.in_bump_normal;bump.out_normal")
        list(GET parameter 0 name)
        list(GET parameter 1 value)
        run("${VEXEC}" set-material "${ACTUAL_DB}" "${name}" "${value}")
      endforeach()
    endif()
  elseif(reflection AND NOT curved)
    # A constant tilt reaches the offset front receiver without blocking
    # the camera. It also checks an explicitly constant normal parameter.
    set(mapped 1)
    set(slope 0)
    run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.param.in_bump_normal "normal 0.3 0 1")
  endif()
  set_reference(mapped "int ${mapped}")
  set_reference(slope "float ${slope}")
endfunction()
foreach(SIZE IN ITEMS 16 32)
  run("${TOOL}" --pattern constant:color=0,0,0 ${SIZE}x${SIZE} 3 -o "${WORK}/black.exr")
  if(SIZE EQUAL 16)
    set(relative_bound ${FOOTPRINT_RELATIVE_BOUND})
  else()
    set(relative_bound ${REFINED_FOOTPRINT_RELATIVE_BOUND})
  endif()
  foreach(shape IN ITEMS cube mesh ball ellipsoid)
    set(curved 0)
    set(center "0 0 0")
    set(eye_x 2)
    set(axes "10 10 10")
    if(shape STREQUAL "ball" OR shape STREQUAL "ellipsoid")
      set(curved 1)
      set(center "-15 0 0")
      set(eye_x -13)
    endif()
    if(shape STREQUAL "ellipsoid")
      set(axes "8 10 6")
    endif()
    if(SIZE EQUAL 32 AND NOT curved)
      continue()
    endif()
    set_reference(curved "int ${curved}")
    set_reference(center "point ${center}")
    set_reference(axes "vector ${axes}")
    foreach(ior IN ITEMS 1.5 2)
      run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.param.in_ior "float ${ior}")
      set_reference(ior "float ${ior}")
      foreach(reflection IN ITEMS 0 1)
        if(SIZE EQUAL 32 AND NOT reflection)
          continue()
        endif()
        set(reflection_tint "0 0 0")
        set(refraction_tint "1 1 1")
        set(target receiver.r)
        if(reflection)
          set(reflection_tint "1 1 1")
          set(refraction_tint "0 0 0")
          set(target front.r)
          if(curved)
            set(target curved_front.r)
          endif()
        endif()
        run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.param.in_reflection_tint "color ${reflection_tint}")
        run("${VEXEC}" set-material "${ACTUAL_DB}" OSL.param.in_refraction_tint "color ${refraction_tint}")
        set_reference(reflection "int ${reflection}")
        foreach(mapping IN ITEMS unmapped direct bump)
          set_mapping("${mapping}" "${center}" ${reflection} ${curved})
          foreach(mode IN ITEMS 0 1)
            if(SIZE EQUAL 32 AND mode EQUAL 1)
              continue()
            endif()
            set_reference(mode "int ${mode}")
            run("${VEXEC}" set-named-material "${ACTUAL_DB}" receiver.material OSL.param.in_mode "int ${mode}")
            foreach(projection IN ITEMS 0 2)
              if(SIZE EQUAL 32 AND projection EQUAL 0)
                continue()
              endif()
              set(label "${SIZE}-${shape}-${ior}-${reflection}-${mapping}-${mode}-${projection}")
              set(actual "${WORK}/${label}.exr")
              set(reference "${WORK}/${label}-reference.exr")
              run("${EXEC}" ${RENDER_ARGS} -w ${SIZE} -n ${SIZE} -p ${projection} -c "eye_pt ${eye_x} -2 40"
                -o "${actual}" "${ACTUAL_DB}" "${shape}.r" "${target}")
              run("${EXEC}" ${RENDER_ARGS} -w ${SIZE} -n ${SIZE} -p ${projection} -c "eye_pt ${eye_x} -2 40"
                -o "${reference}" "${REFERENCE_DB}" "${shape}.r" "${target}")
              run("${VEXEC}" check-image "${actual}" ${SIZE} ${SIZE})
              if(mode EQUAL 0)
                compare_optical_transport("${actual}" "${reference}" ${relative_bound})
              else()
                compare_optical_transport("${actual}" "${reference}")
              endif()
              foreach(image IN ITEMS "${actual}" "${reference}")
                expect_failure("${TOOL}" --fail 0 --hardfail 0 "${image}" --ch R,G,B "${WORK}/black.exr" --diff)
              endforeach()
            endforeach()
          endforeach()
        endforeach()
      endforeach()
    endforeach()
  endforeach()
endforeach()
