#include "appleseed/as_osl_extensions.h"

shader art_npr(
    color in_color = color(0.5),
    float in_opacity = 1,
    int in_contours = 1,
    int in_object_edges = 1,
    int in_crease_edges = 1,
    output closure color out_outColor = 0)
{
    out_outColor = (1 - in_opacity) * transparent();
    if (raytype("transparency") || raytype("shadow"))
        return;
    if (raytype("npr")) {
        out_outColor = in_color * as_npr_shading();
        if (in_contours && (in_opacity >= 1 || !backfacing()))
            out_outColor += as_npr_contour(color(0), 1, 1,
                in_object_edges, 0, 0, 1, in_crease_edges, 30);
    } else {
        out_outColor += in_color * emission();
    }
}
