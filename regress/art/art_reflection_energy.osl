surface art_reflection_energy(float in_ior = 0, int in_reference = 0)
{
    if (!in_reference) {
        Ci = reflection(N, in_ior);
        return;
    }
    // Zero selects OSL's unweighted mirror overload.
    float reflectance = 1;
    if (in_ior > 0) {
        float cosine = abs(dot(normalize(N), normalize(I)));
        float sine_transmitted_squared = (1 - cosine * cosine) / (in_ior * in_ior);
        if (sine_transmitted_squared < 1) {
            float transmitted_cosine = sqrt(1 - sine_transmitted_squared);
            float perpendicular = (cosine - in_ior * transmitted_cosine) /
                (cosine + in_ior * transmitted_cosine);
            float parallel = (in_ior * cosine - transmitted_cosine) /
                (in_ior * cosine + transmitted_cosine);
            reflectance = 0.5 * (perpendicular * perpendicular + parallel * parallel);
        }
    }
    Ci = reflectance * emission();
}
