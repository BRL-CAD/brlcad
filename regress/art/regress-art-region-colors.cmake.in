cmake_minimum_required(VERSION 3.22)
set(WORK "@CMAKE_CURRENT_BINARY_DIR@/region-colors-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
configure_file("@CMAKE_CURRENT_BINARY_DIR@/art_emission.oso" "${WORK}/shaders/art_emission.oso" COPYONLY)
set(DB "${WORK}/scene.g")
set(REFERENCE_DB "${WORK}/reference.g")
run("${VEXEC}" create-material "${DB}" art_emission)
run("${VEXEC}" create-material "${REFERENCE_DB}" art_emission)
set(OBJECTS ball.r ellipsoid.r cube.r mesh.r smooth_mesh.r)
foreach(object IN LISTS OBJECTS)
  run("${VEXEC}" attr "${DB}" set "${object}" region_id 1500)
  run("${VEXEC}" attr "${DB}" rm "${object}" color rgb)
endforeach()
run("${VEXEC}" color "${DB}" 1000 1999 0 0 255)
set(RENDER_ARGS -a 0 -e 65 -E 2 -P 2 -w 64 -n 64 -C 0/0/0
  -c "set samples=4 light_intensity=0" -c "viewsize 40")
function(compare_region label color object)
  run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_color "${color}")
  foreach(perspective IN ITEMS 0 50)
    set(tag "${label}_${object}_${perspective}")
    run("${EXEC}" ${RENDER_ARGS} -p ${perspective}
      -o "${WORK}/actual_${tag}.png" "${DB}" "${object}")
    run("${EXEC}" ${RENDER_ARGS} -p ${perspective}
      -o "${WORK}/reference_${tag}.png" "${REFERENCE_DB}" "${object}")
    run("${VEXEC}" check-matching-image "${WORK}/actual_${tag}.png" "${WORK}/reference_${tag}.png" 64 64)
  endforeach()
endfunction()
foreach(object IN LISTS OBJECTS)
  compare_region(table "color 0 0 1" "${object}")
endforeach()

# The table is a fallback after explicit and inherited combination colors.
run("${VEXEC}" attr "${DB}" set ball.r color 0/0/0)
run_command("${CMAKE_CURRENT_BINARY_DIR}" FALSE "${EXEC}"
  -c "set inspect_materials=1" "${DB}" ball.r)
string(FIND "${command_output}" "input \"in_color\" \"color 0 0 0\"" black)
if(black LESS 0)
  message(FATAL_ERROR "An explicit black region color was replaced by the table\n${command_output}")
endif()
run("${VEXEC}" attr "${DB}" set ball.r color 255/0/0)
compare_region(explicit "color 1 0 0" ball.r)
run("${VEXEC}" attr "${DB}" rm ball.r color rgb)
run("${VEXEC}" attr "${DB}" set instance_left.g color 255/0/0)
compare_region(inherited "color 1 0 0" instance_left.g)
run("${VEXEC}" color "${DB}" 1000 1999 0 255 0)
compare_region(updated "color 0 1 0" ball.r)
run("${VEXEC}" attr "${DB}" set ball.r region_id 3000)
compare_region(unmapped "color 1 1 1" ball.r)
expect_failure("${VEXEC}" check-matching-image "${WORK}/actual_table_ball.r_0.png"
  "${WORK}/reference_unmapped_ball.r_0.png" 64 64)

# Explicit OSL parameters take precedence over the resolved region color.
run("${VEXEC}" attr "${DB}" set ball.r region_id 1500)
run("${VEXEC}" set-material "${DB}" OSL.param.in_color "color 1 0 0")
compare_region(parameter "color 1 0 0" ball.r)

# Light regions need the same inherited and table-resolved colors as surfaces.
foreach(database IN ITEMS "${DB}" "${REFERENCE_DB}")
  run("${VEXEC}" set-material "${database}" OSL as_plastic)
  run("${VEXEC}" set-material "${database}" OSL.param.in_color "color 0.5 0.5 0.5")
  run("${VEXEC}" set-material "${database}" OSL.param.in_specular_weight "float 0")
  run("${VEXEC}" attr "${database}" set key_light.r region_id 2500)
endforeach()
run("${VEXEC}" attr "${DB}" rm key_light.r color rgb)
run("${VEXEC}" color "${DB}" 2000 2999 0 0 255)
run("${VEXEC}" attr "${REFERENCE_DB}" set key_light.r color 0/0/255)
function(compare_light label light)
  foreach(perspective IN ITEMS 0 50)
    set(tag "${label}_${perspective}")
    foreach(variant IN ITEMS actual reference)
      if(variant STREQUAL "actual")
        set(database "${DB}")
      else()
        set(database "${REFERENCE_DB}")
      endif()
      run("${EXEC}" ${RENDER_ARGS} -c "set samples=16 light_intensity=200" -p ${perspective}
        -o "${WORK}/${variant}_${tag}.png" "${database}" cube.r "${light}")
    endforeach()
    run("${VEXEC}" check-matching-image "${WORK}/actual_${tag}.png" "${WORK}/reference_${tag}.png" 64 64)
  endforeach()
endfunction()
compare_light(light_table key_light.r)
run("${VEXEC}" attr "${DB}" set key_light.g color 255/0/0)
run("${VEXEC}" attr "${REFERENCE_DB}" rm key_light.g color rgb)
run("${VEXEC}" attr "${REFERENCE_DB}" set key_light.r color 255/0/0)
compare_light(light_inherited key_light.g)
run("${VEXEC}" attr "${DB}" set key_light.r color 0/0/255)
compare_light(light_higher key_light.g)
run("${VEXEC}" attr "${DB}" set key_light.g inherit 0)
run("${VEXEC}" attr "${REFERENCE_DB}" set key_light.r color 0/0/255)
compare_light(light_lower key_light.g)
