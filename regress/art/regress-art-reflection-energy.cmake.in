set(WORK "@CMAKE_CURRENT_BINARY_DIR@/reflection-energy-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders" "${WORK}/cache")
set(ENV{BU_DIR_CACHE} "${WORK}/cache")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_nested_test_commands.cmake")
foreach(shader IN ITEMS art_reflection_energy art_refraction_reference)
  configure_file("@CMAKE_CURRENT_BINARY_DIR@/${shader}.oso" "${WORK}/shaders/${shader}.oso" COPYONLY)
endforeach()
set(TOOL "@ART_OIIOTOOL_EXECUTABLE@")
set(SIZE 1)
set(TOLERANCE 0.00002)
set(ACTUAL_DB "${WORK}/actual.g")
set(REFERENCE_DB "${WORK}/reference.g")
run("${VEXEC}" create-material "${ACTUAL_DB}" art_reflection_energy)
configure_file("${ACTUAL_DB}" "${REFERENCE_DB}" COPYONLY)
run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_reference "int 1")
set(ARGS -P 1 -w ${SIZE} -n ${SIZE} -p 0.00002 -c "viewsize 0.001"
  -c "set sampling=uniform samples=1 max_bounces=4 max_specular_bounces=4 light_intensity=0 environment_intensity=1 environment_color=white background_color=black")
foreach(shape IN ITEMS cube mesh)
  foreach(ior IN ITEMS 0 0.5 1 1.5 2)
    foreach(db IN ITEMS "${ACTUAL_DB}" "${REFERENCE_DB}")
      run("${VEXEC}" set-material "${db}" OSL.param.in_ior "float ${ior}")
    endforeach()
    foreach(view IN ITEMS normal oblique)
      set(eye "0 0 40")
      set(orientation "0 0 0 1")
      if(view STREQUAL "oblique")
        # cos(theta)=0.6, sin(theta)=0.8; the central ray hits (0,0,10).
        set(eye "40 0 40")
        set(orientation "0 0.4472135954999579 0 0.8944271909999159")
      endif()
      set(actual "${WORK}/${shape}-${ior}-${view}.exr")
      set(reference "${WORK}/${shape}-${ior}-${view}-reference.exr")
      run("${EXEC}" ${ARGS} -c "eye_pt ${eye}" -c "orientation ${orientation}"
        -o "${actual}" "${ACTUAL_DB}" "${shape}.r")
      run("${EXEC}" ${ARGS} -c "eye_pt ${eye}" -c "orientation ${orientation}"
        -o "${reference}" "${REFERENCE_DB}" "${shape}.r")
      foreach(image IN ITEMS "${actual}" "${reference}")
        run("${VEXEC}" check-image "${image}" ${SIZE} ${SIZE})
      endforeach()
      compare_optical_transport("${actual}" "${reference}")
    endforeach()
  endforeach()
endforeach()
