shader art_image_field(
    int in_mirror_u = 0, int in_mirror_v = 0, int in_flip_t = 1,
    float in_size = 16, float in_depth = 5,
    float in_scale_u = 1, float in_scale_v = 1,
    float in_offset_u = 0, float in_offset_v = 0,
    output color out_color = color(0), output vector out_direction = vector(0),
    output normal out_height_normal = N)
{
    // Recover the authored +Z-face chart from position, without renderer UVs.
    float face_span = 20;
    float half_span = face_span / 2;
    float chart_u, chart_v;
    vector grad_u, grad_v;
    if (P[1] <= P[0]) {
        chart_u = (P[0] - P[1]) / face_span;
        chart_v = (P[1] + half_span) / face_span;
        grad_u = vector(1, -1, 0) / face_span;
        grad_v = vector(0, 1, 0) / face_span;
    } else {
        chart_u = (P[0] + half_span) / face_span;
        chart_v = (P[1] - P[0]) / face_span;
        grad_u = vector(1, 0, 0) / face_span;
        grad_v = vector(-1, 1, 0) / face_span;
    }
    if (in_mirror_u) { chart_u = 1 - chart_u; grad_u = -grad_u; }
    if (in_mirror_v) { chart_v = 1 - chart_v; grad_v = -grad_v; }
    chart_u = chart_u * in_scale_u + in_offset_u;
    chart_v = chart_v * in_scale_v + in_offset_v;
    grad_u *= in_scale_u;
    grad_v *= in_scale_v;
    // Image rows run downward; Appleseed texture T runs upward.
    if (in_flip_t) { chart_v = 1 - chart_v; grad_v = -grad_v; }
    // OIIO's fill ramp spans endpoint pixel centers, not image edges.
    float s = (in_size * chart_u - 0.5) / (in_size - 1);
    float t = (in_size * chart_v - 0.5) / (in_size - 1);
    // The height ramp's known ambient gradient is projected onto the
    // supplied normal's plane along Ng, including smooth BOT normals.
    vector gradient = in_depth * in_size / (in_size - 1) *
        ((s > 0 && s < 1 ? 0.4 : 0) * grad_u + (t > 0 && t < 1 ? 0.2 : 0) * grad_v);
    gradient -= vector(Ng) * dot(gradient, N) / dot(Ng, N);
    out_height_normal = normalize(N - normal(gradient));
    s = clamp(s, 0, 1);
    t = clamp(t, 0, 1);
    out_color = color(0.25 + 0.5 * s, 0.375 + 0.25 * t, 1);
    out_direction = vector(s - 0.5, 0.5 * t - 0.25, 1);
}
