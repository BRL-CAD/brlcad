set(WORK "@CMAKE_CURRENT_BINARY_DIR@/frame-derivatives-output")
set(LOG "${WORK}/art.log")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/shaders" "${WORK}/cache")
set(ENV{BU_DIR_CACHE} "${WORK}/cache")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_test_commands.cmake")
include("@CMAKE_CURRENT_SOURCE_DIR@/art_nested_test_commands.cmake")
configure_file("@CMAKE_CURRENT_BINARY_DIR@/art_frame_reference.oso"
  "${WORK}/shaders/art_frame_reference.oso" COPYONLY)
set(TOOL "@ART_OIIOTOOL_EXECUTABLE@")
set(SIZE 16)
set(TOLERANCE 0.00002)
set(ACTUAL_DB "${WORK}/actual.g")
set(REFERENCE_DB "${WORK}/reference.g")
run("${VEXEC}" create-material "${ACTUAL_DB}" art_frame_reference)
configure_file("${ACTUAL_DB}" "${REFERENCE_DB}" COPYONLY)
run("${VEXEC}" set-material "${REFERENCE_DB}" OSL.param.in_reference "int 1")
set(RENDER_ARGS -P 1 -w ${SIZE} -n ${SIZE} -c "viewsize 0.5"
  -c "eye_pt -13 -2 40" -c "orientation 0 0 0 1"
  -c "set sampling=uniform samples=1 light_intensity=0 environment_intensity=0 background_color=black")
foreach(shape IN ITEMS ball ellipsoid)
  set(axes "10 10 10")
  if(shape STREQUAL "ellipsoid")
    set(axes "8 10 6")
  endif()
  foreach(db IN ITEMS "${ACTUAL_DB}" "${REFERENCE_DB}")
    run("${VEXEC}" set-material "${db}" OSL.param.in_axes "vector ${axes}")
  endforeach()
  foreach(projection IN ITEMS 0 2)
    # Paired value/gradient modes cover tangent, UV-oriented bitangent and
    # unit shading normal. The independent normal controls isolate frame data.
    foreach(mode RANGE 0 5)
      foreach(variant IN ITEMS actual reference)
        string(TOUPPER "${variant}" upper_variant)
        set(db "${${upper_variant}_DB}")
        run("${VEXEC}" set-material "${db}" OSL.param.in_mode "int ${mode}")
        set(image "${WORK}/${shape}-${projection}-${mode}-${variant}.exr")
        run_in("${WORK}" "${EXEC}" ${RENDER_ARGS} -p ${projection}
          -o "${image}" "${db}" "${shape}.r")
        run("${VEXEC}" check-image "${image}" ${SIZE} ${SIZE})
      endforeach()
      compare_optical_transport("${WORK}/${shape}-${projection}-${mode}-actual.exr"
        "${WORK}/${shape}-${projection}-${mode}-reference.exr")
    endforeach()
  endforeach()
endforeach()
