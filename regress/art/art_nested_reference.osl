#include "art_glass_reference.h"

surface art_nested_reference(
    int in_initial_camera = 0,
    point in_offset = point(0),
    float in_outer_ior = 1.5,
    float in_inner_ior = 2.4,
    float in_core_ior = 1,
    int in_core = 0,
    color in_outer_transmittance = color(1),
    color in_inner_transmittance = color(1),
    color in_core_transmittance = color(1),
    float in_outer_distance = 0,
    float in_inner_distance = 0,
    float in_core_distance = 0)
{
    // The fixture is three concentric boxes with half widths 10, 5, and 2.
    // Tested cameras cross their Z faces, away from all edges.
    float planes[6] = {10, 5, 2, -2, -5, -10};
    float indices[7] = {1, in_outer_ior, in_inner_ior, in_core_ior,
        in_inner_ior, in_outer_ior, 1};
    color transmittance[6] = {in_outer_transmittance, in_inner_transmittance,
        in_core_transmittance, in_inner_transmittance, in_outer_transmittance, color(1)};
    float reference_distance[6] = {in_outer_distance, in_inner_distance, in_core_distance,
        in_inner_distance, in_outer_distance, 0};
    float extent[6] = {10, 5, 2, 2, 5, 10};
    int count = 6;
    if (!in_core) {
        count = 4;
        planes[2] = -5;
        planes[3] = -10;
        indices[3] = in_outer_ior;
        indices[4] = 1;
        transmittance[2] = in_outer_transmittance;
        reference_distance[2] = in_outer_distance;
        extent[2] = 5;
        extent[3] = 10;
    }
    point position = P - in_offset;
    vector direction = normalize(I);
    color weight = color(1);
    int first_boundary = 0;
    if (in_initial_camera) {
        float ray_length = 0;
        if (!getattribute("path:ray_length", ray_length)) {
            error("Missing primary ray length for initial-medium reference");
            Ci = 0;
            return;
        }
        position -= ray_length * direction;
        while (first_boundary < count && planes[first_boundary] >= position[2])
            ++first_boundary;
    }
    for (int i = first_boundary; i < count; ++i) {
        if (in_initial_camera || i > 0) {
            float segment_length = (planes[i] - position[2]) / direction[2];
            position += segment_length * direction;
            if (i > 0 && reference_distance[i - 1] > 0)
                weight *= pow(transmittance[i - 1], segment_length / reference_distance[i - 1]);
        }
        if (abs(position[2] - planes[i]) > 1.0e-4 ||
            abs(position[0]) >= extent[i] || abs(position[1]) >= extent[i]) {
            error("Nested reference ray left its supported slab faces");
            Ci = 0;
            return;
        }
        vector transmitted = refract(direction, normal(0, 0, 1), indices[i] / indices[i + 1]);
        if (dot(transmitted, transmitted) == 0) {
            Ci = 0;
            return;
        }
        weight *= interface_radiance_transmission(indices[i], indices[i + 1], -direction[2], -transmitted[2]);
        direction = transmitted;
    }
    // The finite receiver's top is Z=-30 and its half width is 200.
    position += (-30 - position[2]) / direction[2] * direction;
    if (abs(position[0]) > 200 || abs(position[1]) > 200) {
        Ci = 0;
        return;
    }
    Ci = weight * target_color(position + in_offset) * emission();
}
